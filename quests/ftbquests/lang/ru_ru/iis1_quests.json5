  ],
  "quest.1A000000000004EE.title": "[об] Просеиватель (IV)",
  "quest.1A000000000004EF.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A000000000004EF.title": "[об] Просеиватель (LuV)",
  "quest.1A000000000004F0.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A000000000004F0.title": "[об] Просеиватель (ZPM)",
  "quest.1A000000000004F2.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
