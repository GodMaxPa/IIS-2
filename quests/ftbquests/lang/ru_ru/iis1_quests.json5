  "quest.1A00000000000697.quest_desc": [
    "Доступно с: UV.",
    "",
    "Один из многих одноблочных механизмов.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__monster_repellent_uv.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000697.title": "[об] Отпугиватель монстров (UV)",
  "quest.1A0000000000069B.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Воспользуйтесь пильным станком, чтобы изготовить оболочку с наивысшей эффективностью.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__item_casing_bronze.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000069B.title": "Бронзовая оболочка",
  "quest.1A0000000000069D.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Консервирующий станок: 8 × Натриевая пыль, 1 × Корпус батареи. 2 EU/т, 20 с.",
    "",
    "Дешёвая батарея уровня MV."
  ],
  "quest.1A0000000000069D.title": "Натриевая батарея",
  "quest.1A0000000000069E.quest_desc": [
    "Доступно с: MV.",
    "",
    "Его хорошо брать с собой в шахту, если вы собираетесь добывать руду электрическим буром.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__adv_batpack.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000069E.title": "Продвинутый аккумуляторный ранец",
  "quest.1A0000000000069F.quest_desc": [
    "Доступно с: MV.",
    "",
    "Теперь, когда у вас есть нержавеющая сталь, вы можете создать ваш первый электрический шахтёрский инструмент - бур.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__drill_lv_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000069F.title": "Бур (LV)",
  "quest.1A000000000006A0.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Улучшение хранилища, увеличивающее лимит хранимых предметов в бочке. Обратите внимание, что применить его можно только после того, как было применено структурное улучшение."
  ],
  "quest.1A000000000006A0.title": "Улучшение хранилища (1)",
  "quest.1A000000000006A4.quest_desc": [
    "Доступно с: LV.",
    "",
    "Эти очки позволят вам видеть линии сигналов между двумя связанными сигнальными блоками. Чтобы включить эту функцию, возьмите очки в руку и нажимайте ПКМ до тех пор, пока не увидите в чате надпись \"Текущая аура: Сигнал\". Тогда вы можете надевать их и наблюдать линии сигналов.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__trackman_goggles.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006A4.title": "Очки обходчика путей",
  "quest.1A000000000006A5.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик: 1 × Логическая интегральная электросхема, 4 × Электрумовая проволока, 1 × Покрытая печатная плата, 144 мБ Расплавленный паяльный сплав, схема 3. 5 EU/т, 6 с.",
    "",
    "Компонент некоторых предметов из Railcraft."
  ],
  "quest.1A000000000006A5.title": "Сигнальная схема",
  "quest.1A000000000006A6.quest_desc": [
    "Доступно с: LV.",
    "",
    "Если расположить два сигнальных блока возле ж/д путей и связать их друг с другом посредством блока сигнальной привязки, то они смогут распознавать стоящие или двигающиеся вагонетки и поезда. Чтобы преобразовать распознавание поезда в красный сигнал, используйте настройщик сигнала на одном из связанных сигнальных блоков, а затем кликните по приёмнику сигнала. После этого, если между связанными сигнальными блоками проедет поезд, то он спровоцирует излучение красного сигнала из привязанного приёмника.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__block_signal.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006A6.title": "Сигнальный блок",
  "quest.1A000000000006A7.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Устройство, связывающее друг с другом два сигнальных блока."
  ],
  "quest.1A000000000006A7.title": "Блок сигнальной привязки",
  "quest.1A000000000006A8.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик: 1 × Деревянное полотно, 6 × Улучшенный рельс, 144 мБ Расплавленная красная пыль. 4 EU/т, 20 с.",
    "",
    "Полезный путь для железной дороги, подталкивающий ваш поезд или вагонетку вперёд по направлению движения."
  ],
  "quest.1A000000000006A8.title": "Ускоряющий путь",
  "quest.1A000000000006A9.quest_desc": [
    "Доступно с: LV.",
    "",
    "Путь, останавливающий и удерживающий вагонетку или поезд до тех пор, пока не получит красный сигнал. Может работать в нескольких режимах - для вагонеток и для поездов. Вы также можете выбрать направление, в котором ускорится вагонетка или поезд, когда на путь будет подан красный сигнал. Для поезда это сработает только в том случае, если выбранное направление совпадает с направлением движения поезда. Чтобы изменить настройки, используйте монтировку.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__track_locking.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006A9.title": "Замыкающий путь",
  "quest.1A000000000006AA.quest_desc": [
    "Доступно с: LV.",
    "",
    "Путь, меняющий режим работы поезда. Срабатывает при получении красного сигнала. Чтобы изменить настройки, используйте монтировку.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__track_locomotive.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006AA.title": "Локомотивный путь",
  "quest.1A000000000006AB.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Компонент замыкающего пути.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__stone_pressure_plate.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006AB.title": "Нажимная плита",
  "quest.1A000000000006AC.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Может быть создана из золотого провода в протяжном стане, либо из золотой фольги при помощи кусачек.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_fine_gold.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006AC.title": "Золотая проволока",
  "quest.1A000000000006AE.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Компонент некоторых предметов из Railcraft.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__signal_lamp.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006AE.title": "Сигнальная лампа",
  "quest.1A000000000006AF.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Его можно использовать для получения каучука из латекса, либо для более эффективной вытяжки красителей из цветов. Однако §cнастоятельно рекомендуется§r использовать именно §aцентрифугу§r для производства каучука, так как в этом случае вы также будете получать клей."
  ],
  "quest.1A000000000006AF.title": "Паровой экстрактор",
  "quest.1A000000000006B0.quest_desc": [
    "Доступно с: LV.",
    "",
    "Воспользуйтесь любым из известных вам способов, чтобы сделать пластину из слитка.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__plate_redstone_alloy.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006B0.title": "Пластина сплава из красного камня",
  "quest.1A000000000006B1.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Кузнечный молот: 1 × Лазурит. 16 EU/т, 1,4 с.",
    "",
    "Подготовьте пластину из лазурита, содалита, либо ляпис-лазури. Используйте компрессор, чтобы сделать блок, а затем распилите его на пластины."
  ],
  "quest.1A000000000006B1.title": "Одна из синих пластин",
  "quest.1A000000000006B2.quest_desc": [
    "Доступно с: LV.",
    "",
    "Вы можете сделать его из пластины при помощи прокатного стана или молота.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__foil_plastic.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006B2.title": "Тонкий лист полиэтилена",
  "quest.1A000000000006B3.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Формовочный пресс: 1 × Алюминиевая фольга, 1 × Тонкий лист полиэтилена. 16 EU/т, 24 с.",
    "",
    "Одноразовое хранилище информации для записи и чтения данных сейсмического разведчика."
  ],
  "quest.1A000000000006B3.title": "Компакт-диск",
  "quest.1A000000000006B4.quest_desc": [
    "Доступно с: MV.",
    "",
    "Отличное портативное устройство для сканирования и чтения данных с компакт-дисков или флешек.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__data_reader_mv.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006B4.title": "Базовый считыватель данных",
  "quest.1A000000000006B5.quest_desc": [
    "Доступно с: LV.",
    "",
    "Простой сканер руд и жидкостей под коренной породой. Для работы требуется взрывчатка, а для считывания результата работы — компакт-диск или флешка. Позже, на уровне EV, у вас будет возможность создать и использовать усовершенствованный сейсморазведчик, обладающий лучшими свойствами для сканирования, такими как больший радиус. Обратите внимание, что сейсморазведчики этого и следующего уровня водонепроницаемы, поэтому они могут работать под водой и дождём.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__seismic_prospector_lv.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006B5.title": "Сейсмический разведчик",
  "quest.1A000000000006B6.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Вы можете сделать его из стальных пластин и молота.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__hull_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006B6.title": "Стальной корпус",
  "quest.1A000000000006B8.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Компонент оловянной электронной лампы.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__bolt_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006B8.title": "Железный болт",
  "quest.1A000000000006BA.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Дробитель: 1 × Полированный туф. 2 EU/т, 20 с.",
    "",
    "Может быть полезен для нескольких рецептов, например, для некоторых слитков из EnderIO. Есть множество способов его получения (см. JEI).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_ash.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006BA.title": "Пепел",
  "quest.1A000000000006BB.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Дробитель: 1 × Слиток соулярия. 2 EU/т, 20 с.",
    "",
    "Смешайте в миксере песок душ, пепел и золотую пыль.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_soularium.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006BB.title": "Пыль соулярия",
  "quest.1A000000000006BC.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Миксер: 1 × Стальная пыль, 1 × Угольная пыль, 1 × Кремниевая пыль, схема 3. 8 EU/т, 15 с.",
    "",
    "Смешайте в миксере пыль стали, угля и кремния.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_electrical_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006BC.title": "Пыль электрической стали",
  "quest.1A000000000006BD.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Миксер: 1 × Пыль электрической стали, 1 × Угольная пыль, 1 × Обсидиановая пыль, схема 3. 8 EU/т, 15 с.",
    "",
    "Это смесь пылей электрической стали, угля и обсидиана (используйте миксер).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_dark_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006BD.title": "Пыль тёмной стали",
  "quest.1A000000000006BE.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Дробитель: 1 × Обсидиан. 2 EU/т, 20 с.",
    "",
    "Отправьте сыпучий обсидиан обратно в дробитель, чтобы получить пыль.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_obsidian.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006BE.title": "Обсидиановая пыль",
  "quest.1A000000000006C0.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Миксер: 1 × Железная пыль, 1 × Дроблёный жемчуг Края, 1 × Пыль сплава из красного камня, схема 3. 8 EU/т, 15 с.",
    "",
    "Смесь пыли сплава из красного камня, железной пыли и дроблёного жемчуга Края (используйте миксер).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_pulsating_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006C0.title": "Пыль пульсирующего железа",
  "quest.1A000000000006C1.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Миксер: 1 × Пыль энергетического сплава, 1 × Дроблёное око Края, 1 × Хромовая пыль, схема 3. 8 EU/т, 15 с.",
    "",
    "Смесь пыли энергетического сплава, хромовой пыли и дроблёного ока Края (используйте миксер).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_vibrant_alloy.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006C1.title": "Пыль вибрирующего сплава",
  "quest.1A000000000006C2.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Миксер: 1 × Пыль проводящего железа, 1 × Золотая пыль, 1 × Пыль чёрной стали, схема 3. 8 EU/т, 15 с.",
    "",
    "Смесь пыли проводящего железа, пыли чёрной стали и золотой пыли (используйте миксер).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_energetic_alloy.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006C2.title": "Пыль энергетического сплава",
  "quest.1A000000000006C3.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Дробитель: 1 × Слиток проводящего железа. 2 EU/т, 20 с.",
    "",
    "Смесь пыли сплава из красного камня, а также пыли железа и серебра (используйте миксер).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_conductive_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006C3.title": "Пыль проводящего железа",
  "quest.1A000000000006C7.quest_desc": [
    "Доступно с: без электричества.",
    "Где искать: Край, Луна, Верхний мир, Y -32…16 (жила: Шеелит); Марс, Y -56…0 (жила: Графит); Верхний мир, Y -56…-32 (жила: Графит).",
    "",
    "Но найти её будет сложно, так что вы можете использовать MV+ центрифугу, чтобы разделять лаву на несколько компонентов, среди которых с небольшим шансом могут оказаться маленькие кучки вольфрамата (вероятность 2,5%% на каждые 100 л лавы).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_scheelite.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006C7.title": "Шеелит",
  "quest.1A000000000006C8.quest_desc": [
    "Доступно с: EV.",
    "Один из способов: Протяжный стан: 1 × Вольфрамовый слиток. 4 EU/т, 5 с.",
    "",
    "Воспользуйтесь протяжным станом, чтобы сделать провод.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_tungsten_1x.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006C8.title": "1х Вольфрамовый провод",
  "quest.1A000000000006C9.quest_desc": [
    "Доступно с: EV.",
    "",
    "Хранилище энергии EV уровня.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__mfsu.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006C9.title": "МФЭХ",
  "quest.1A000000000006CB.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Токарный станок: 1 × Изысканный оливин. 24 EU/т, 1,4 с.",
    "",
    "Есть несколько способов её изготовления."
  ],
  "quest.1A000000000006CB.title": "Оливиновая линза",
  "quest.1A000000000006CC.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Печь: Оливиновая руда (глубинный сланец)",
    "",
    "Вам нужно найти девять оливинов.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__gem_olivine.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006CC.title": "Оливин",
  "quest.1A000000000006CD.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Просеиватель: 1 × Промытая измельчённая оливиновая руда. 16 EU/т, 40 с.",
    "",
    "Вы можете использовать просеиватель, чтобы получить изысканный оливин из промытой измельчённой оливиновой руды."
  ],
  "quest.1A000000000006CD.title": "Изысканный оливин",
  "quest.1A000000000006CF.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Пильный станок: 1 × Блок: Оливин, 26 мБ Вода. 30 EU/т, 28 с.",
    "",
    "Разрежьте блок на пластины в пильном станке."
  ],
  "quest.1A000000000006CF.title": "Оливиновая пластина",
  "quest.1A000000000006D0.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Компрессор: 9 × Оливин. 2 EU/т, 15 с.",
    "",
    "Воспользуйтесь компрессором, чтобы сделать оливиновый блок"
  ],
  "quest.1A000000000006D0.title": "Оливиновый блок",
  "quest.1A000000000006D4.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Медь + красная пыль (в печи сплавов) дают на выходе слиток красного сплава. Затем сделайте из него пластину.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__plate_red_alloy.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006D4.title": "Пластина красного сплава",
  "quest.1A000000000006D5.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Улучшение хранилища, поднимающее лимит хранимых предметов в бочке."
  ],
  "quest.1A000000000006D5.title": "Улучшение хранилища х3",
  "quest.1A000000000006D6.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Улучшение хранилища, поднимающее лимит хранимых предметов в бочке."
  ],
  "quest.1A000000000006D6.title": "Улучшение хранилища х9",
  "quest.1A000000000006D7.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Улучшение хранилища, поднимающее лимит хранимых предметов в бочке."
  ],
  "quest.1A000000000006D7.title": "Улучшение хранилища х27",
  "quest.1A000000000006D8.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Улучшение хранилища, поднимающее лимит хранимых предметов в бочке."
  ],
  "quest.1A000000000006D8.title": "Улучшение хранилища х27",
  "quest.1A000000000006D9.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Улучшение хранилища, поднимающее лимит хранимых предметов в бочке."
  ],
  "quest.1A000000000006D9.title": "Улучшение хранилища х27",
  "quest.1A000000000006E5.quest_desc": [
    "Доступно с: EV.",
    "Один из способов: Химический реактор: 7 × Вольфрамовая кислота, схема 1. 90 EU/т, 10 с.",
    "",
    "Используйте EV+ химический реактор, чтобы выделить триоксид вольфрама из вольфрамата или шеелита.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_tungsten_trioxide.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006E5.title": "Триоксид вольфрама",
  "quest.1A000000000006E6.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Вы можете изготовить её из пластины при помощи молота. Заметьте, что это самый простой и быстрый способ, но далеко не самый выгодный. Другие рецепты ищите в JEI.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__item_casing_copper.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006E6.title": "Медная оболочка",
  "quest.1A000000000006E7.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Изготовьте его из стали. Наиболее выгодный способ - в экструдере, с получением двух стержней из одного слитка, затем распиливание стержня в пильном станке для получения четырёх болтов, затем их обработка напильником или на токарном станке. Есть способ изготовить болты напрямую из слитка - в экструдере с соответствующей формой.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__screw_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006E7.title": "Стальной винт",
  "quest.1A000000000006E8.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Большинство видов камня подходят для изготовления каменных кирпичей, которые являются компонентом блоков фермы.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__stone_bricks.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006E8.title": "Каменные кирпичи",
  "quest.1A000000000006E9.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Урожай культуры: выращивается на палочках для грядки и выводится скрещиванием",
    "",
    "Ранний простой способ распознать, какое растение было получено в результате скрещивания.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__crop_lens.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006E9.title": "Зерновая лупа",
  "quest.1A000000000006EA.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Компонент корпуса пиролизной печи.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__frame_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006EA.title": "Железный каркас",
  "quest.1A000000000006EB.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Часть пиролизной печи.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__pyrolyse_casing.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006EB.title": "Корпус пиролизной печи",
  "quest.1A000000000006ED.quest_desc": [
    "Доступно с: LV.",
    "",
    "Её можно создать из пластины при помощи молота, но если у вас есть MV+ экструдер, то используйте его для изготовления маленьких шестерёнок напрямую из слитков.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__small_gear_aluminium.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006ED.title": "Маленькая алюминиевая шестерёнка",
  "quest.1A000000000006EE.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Токарный станок: 1 × Алюминиевый слиток. 16 EU/т, 6,5 с.",
    "",
    "Используйте напильник или токарный станок, чтобы сделать стержень из слитка. Если у вас есть MV+ экструдер, он будет наилучшим выбором для изготовления любых стержней.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__rod_aluminium.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006EE.title": "Алюминиевый стержень",
  "quest.1A000000000006EF.quest_desc": [
    "Доступно с: MV.",
    "",
    "Многоблок, позволяющий выплавлять более одного предмета за операцию. Сколько именно - зависит от катушек.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__multi_smelter.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006EF.title": "Мультиплавильня",
  "quest.1A000000000006F0.quest_desc": [
    "Доступно с: MV.",
    "",
    "Многоблок, способный заполнять бетоном свободное пространство под собой.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__concrete_backfiller_1.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006F0.title": "Бетонный заполнитель",
  "quest.1A000000000006F1.quest_desc": [
    "Доступно с: EV.",
    "",
    "Многоблок, способный заполнять бетоном свободное пространство под собой. Лучше, чем обычная версия.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__concrete_backfiller_2.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006F1.title": "Улучшенный бетонный заполнитель",
  "quest.1A000000000006F2.quest_desc": [
    "Доступно с: LV.",
    "",
    "Лучше, чем большой бронзовый паровой котёл.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__large_boiler_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006F2.title": "Большой стальной паровой котёл",
  "quest.1A000000000006F3.quest_desc": [
    "Доступно с: HV.",
    "",
    "Лучше, чем большой стальной паровой котёл.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__large_boiler_titanium.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006F3.title": "Большой титановый паровой котёл",
  "quest.1A000000000006F4.quest_desc": [
    "Доступно с: EV.",
    "",
    "Лучше, чем большой титановый паровой котёл.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__large_boiler_tungstensteel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006F4.title": "Большой паровой котёл из вольфрамовой стали",
  "quest.1A000000000006F5.quest_desc": [
    "Доступно с: MV.",
    "",
    "Фильтрующий корпус механизма необходим в том случае, если вы хотите построить чистую комнату площадью более чем 3 на 3 блока.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__filter_casing.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006F5.title": "Фильтрующий корпус механизма",
  "quest.1A000000000006F7.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Простой способ изготовления маленьких катушек. Другой способ заключается в использовании болтов из никель-цинкового феррита вместо стальных - в этом случае получится больше катушек.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__bolt_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006F7.title": "Маленькая катушка - простой способ",
  "quest.1A000000000006F8.quest_desc": [
    "Доступно с: LuV.",
    "Один из способов: Сборщик: 1 × Портативный сканер, 1 × Сенсор (LuV), 1 × Излучатель (LuV), 2 × Мейнфрейм на базе нанопроцессоров, 4 × Осмиридиевая пластина. 7680 EU/т, 30 с.",
    "",
    "Великолепное устройство для поиска рудных жил, а также жидкостей под коренной породой. У него есть несколько режимов работы, которые можно менять, нажимая Shift+ПКМ по воздуху. Заметьте, что есть ещё два сканера более высоких уровней (ZPM и UV)."
  ],
  "quest.1A000000000006F8.title": "Сканер старателя (LuV)",
  "quest.1A000000000006F9.quest_desc": [
    "Доступно с: EV.",
    "Один из способов: Протяжный стан: 1 × Слиток вольфрамовой стали. 4 EU/т, 5 с.",
    "",
    "Изготовьте его в протяжном стане.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_tungsten_steel_1x.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006F9.title": "Провод из вольфрамовой стали",
  "quest.1A000000000006FA.quest_desc": [
    "Доступно с: EV.",
    "Один из способов: Сборщик: 1 × 1x Провод из вольфрамовой стали, 1 × Фольга из вольфрамовой стали, 72 мБ Расплавленная силиконовая резина, схема 24. 8 EU/т, 5 с.",
    "",
    "Используйте изоляцию, предназначенную для кабелей под напряжение 8k+ eu/t."
  ],
  "quest.1A000000000006FA.title": "Кабель из вольфрамовой стали",
  "quest.1A000000000006FB.quest_desc": [
    "Доступно с: MV.",
    "",
    "Энергохранилище, способное принимать ток любого напряжения, а отдавать ток MV-напряжения (128 eu/t).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__cesu.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006FB.title": "МЭХ",
  "quest.1A000000000006FC.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Сборщик: 3 × Резиновый лист, 3 × Углеткань, 300 мБ Клей. 64 EU/т, 5 с.",
    "",
    "Невероятный по своей мощи расходный материал, способный починить любые поломки в ваших многоблоках. Он просто обязан у вас быть!"
  ],
  "quest.1A000000000006FC.title": "Сверхтехнологичная изолента",
  "quest.1A000000000006FD.quest_desc": [
    "Доступно с: HV.",
    "Один из способов: Сборщик: 4 × Сверхтехнологичная изолента, 4 × Стальной винт, 16 × Проволока из паяльного сплава, 2 × Улучшенная электросхема, 2000 мБ Смазка. 384 EU/т, 4 с.",
    "",
    "Положите четыре стака этих наборов в полуавтоматический люк для обслуживания, чтобы забыть о любых проблемах с этим многоблоком (по крайней мере, на месяц)."
  ],
  "quest.1A000000000006FD.title": "Автоматический ремонтный набор",
  "quest.1A000000000006FE.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Протяжный стан: 1 × 1x Провод из паяльного сплава. 8 EU/т, 10 с.",
    "",
    "Изготовьте её в протяжном стане из слитка."
  ],
  "quest.1A000000000006FE.title": "Проволока из паяльного сплава",
  "quest.1A000000000006FF.quest_desc": [
    "Доступно с: IV.",
    "",
    "Отличный люк, в который можно положить пару стаков автоматических ремонтных наборов для автоматического ремонта многоблока. Но на каждую автопочинку будет затрачен один набор.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__hatch_maintenance_semiauto.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000006FF.title": "Полуавтоматический люк для обслуживания",
  "quest.1A00000000000700.quest_desc": [
    "Доступно с: ZPM.",
    "Один из способов: Сборочная линия: 1 × Корпус механизма (ZPM), 2 × Роборука (ZPM), 4 × Мейнфрейм на базе кристаллических процессоров, 64 × Автоматический ремонтный набор, Полуавтоматический люк для обслуживания, 500 мБ Смазка. 30000 EU/т, 30 с.",
    "",
    "Лучший выбор, чтобы навсегда забыть о любых проблемах в вашем многоблоке."
  ],
  "quest.1A00000000000700.title": "Автоматический люк для обслуживания",
  "quest.1A00000000000703.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Хороший способ переименовать МЭ интерфейс. Новое имя интерфейса будет отображаться в МЭ терминале."
  ],
  "quest.1A00000000000703.title": "Нож из истинного кварца",
  "quest.1A00000000000706.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Шаблон под логику. Может быть изменён и использован несколько раз."
  ],
  "quest.1A00000000000706.title": "Чертёж микросхемы",
  "quest.1A00000000000707.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Микросхема, хранящая в себе вашу логическую схему. Для записи понадобится принтер."
  ],
  "quest.1A00000000000707.title": "Микросхема",
  "quest.1A00000000000708.quest_desc": [
    "Доступно с: LV.",
    "",
    "Стол для работы с чертежами микросхем. Здесь вы можете разработать умную логику на красной пыли."
  ],
  "quest.1A00000000000708.title": "Микросхемный верстак",
  "quest.1A00000000000709.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик: 1 × Покрытая печатная плата, 2 × Пластина красного сплава, 1 × Пластина кварца Нижнего мира, 144 мБ Расплавленная красная пыль. 16 EU/т, 10 с.",
    "",
    "Поместите сюда ваш чертёж, пустую микросхему, а также прочие необходимые материалы, и принтер начнёт работу. В итоге вы получите микросхему с готовой логикой, однако она пока ещё не готова к использованию. Последний шаг - изготовление IC gate в верстаке, из микросхемы по центру и восьми печатных плат вокруг неё."
  ],
  "quest.1A00000000000709.title": "Принтер микросхем",
  "quest.1A0000000000070A.quest_desc": [
    "Доступно с: LV.",
    "",
    "Компонент большинства предметов из мода Project Red."
  ],
  "quest.1A0000000000070A.title": "Печатная плата",
  "quest.1A0000000000070B.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Отвердитель жидкостей: Шаблон (Пластина), 144 мБ Сырой цемент. 8 EU/т, 1 с.",
    "",
    "Пластина из бетона. Её можно отлить из сырого цемента в жидкостном формовщике."
  ],
  "quest.1A0000000000070B.title": "Бетонная пластина",
  "quest.1A0000000000070C.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Компонент для изготовления красного провода из Project Red.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_red_alloy_2x.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000070C.title": "2х Провод из красного сплава",
  "quest.1A0000000000070D.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Провод из красного сплава из мода Project Red. Работает аналогично красной пыли, помещённой на землю, но в отличие от обычной дорожки из красной пыли, этот провод можно размещать на стенах и потолках."
  ],
  "quest.1A0000000000070D.title": "Провод из красного сплава (PR)",
  "quest.1A0000000000070E.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик: 1 × Мультиметр, 1 × Железная пластина, 1 × Оловянный слиток. 16 EU/т, 40 с.",
    "",
    "Нет описания."
  ],
  "quest.1A0000000000070E.title": "Энергетический детектор",
  "quest.1A0000000000070F.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Компонент энергетического детектора.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__multimeter.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000070F.title": "Ваттметр",
  "quest.1A00000000000710.quest_desc": [
    "Доступно с: LV.",
    "",
    "Компонент большинства IC Gate."
  ],
  "quest.1A00000000000710.title": "Токопроводящая плата",
  "quest.1A00000000000711.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Печь: Золотая конская броня",
    "",
    "Компонент большинства IC Gate. Вы можете получить его из золотого слитка в обычной печи."
  ],
  "quest.1A00000000000711.title": "Золотой самородок",
  "quest.1A00000000000712.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Компонент большинства IC Gate."
  ],
  "quest.1A00000000000712.title": "Анод",
  "quest.1A00000000000713.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Нет описания."
  ],
  "quest.1A00000000000713.title": "Катод",
  "quest.1A00000000000715.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Если хотите, то можете получить пример чертежа микросхемы с готовой логикой для контроля генераторов, например, большого парового котла. На нижней стороне расположен вход для аналогового красного сигнала. Вам нужно поставить эту сторону к батарейному буферу с прикреплённым к нему энергетическим детектором. В этом примере чертёж настроен на распознавание силы сигнала, излучаемого энергетическим детектором, и в зависимости от неё он будет (или не будет) посылать сигнал на включение генераторов. Диапазон в данном случае установлен между 6%% и 100%% - это значит, что если уровень энергии в батарейном буфере упадёт ниже 6%%, то схема будет излучать сигнал до тех пор, пока буфер не зарядится на 100%%. Обратите внимание! После того, как вы установите энергетический детектор на батарейный буфер, его нужно переключить в режим \"Нормальное энергохранилище (включая батареи)\". Только в этом режиме он будет корректно работать в паре с IC Gate."
  ],
  "quest.1A00000000000715.title": "Покажите мне пример",
  "quest.1A00000000000716.quest_desc": [
    "Доступно с: LV.",
    "",
    "Продвинутая версия промышленной информационной панели.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__advanced_information_panel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000716.title": "Продвинутая информационная панель",
  "quest.1A00000000000717.quest_desc": [
    "Доступно с: LV.",
    "",
    "Может отображать основную информацию о любом механизме из Gregtech. Обычно используется для наблюдения за состоянием многоблоков. Это вполне удобно - иметь возможность отслеживать поломки или уровень эффективности, если вы находитесь далеко от многоблока, в вашей мастерской.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__information_panel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000717.title": "Промышленная информационная панель",
  "quest.1A00000000000718.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик: 1 × Сенсор (LV), 1 × Излучатель (LV). 2 EU/т, 80 с.",
    "",
    "Устройство, которое можно привязать к любому механизму из Gregtech, чтобы считывать информацию о нём на расстоянии. Используется в связке с информационной панелью, и позволяет отслеживать различные параметры механизма или многоблока - его эффективность, поломки, статус работы и т. д."
  ],
  "quest.1A00000000000718.title": "Набор с датчиком Gregtech",
  "quest.1A00000000000719.quest_desc": [
    "Доступно с: LV.",
    "",
    "Компонент продвинутой информационной панели.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__color_upgrade.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000719.title": "Улучшение \"Цветность\"",
  "quest.1A0000000000071A.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик: 1 × 1x Медный кабель, 1 × Логическая интегральная электросхема. 8 EU/т, 5 с.",
    "",
    "Компонент улучшения \"Усиление сигнала\"."
  ],
  "quest.1A0000000000071A.title": "Частотный связыватель",
  "quest.1A0000000000071B.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик: 1 × Сенсор (LV), 1 × Передатчик частоты. 2 EU/т, 80 с.",
    "",
    "Компонент продвинутой информационной панели. Вы также можете поместить его в информационную панель, чтобы увеличить радиус её работы."
  ],
  "quest.1A0000000000071B.title": "Улучшение \"Усиление сигнала\"",
  "quest.1A0000000000071C.quest_desc": [
    "Доступно с: LV.",
    "",
    "Блок, расширяющий видимую рабочую поверхность продвинутой информационной панели.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__advanced_panel_extender.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000071C.title": "Расширитель продвинутой информационной панели",
  "quest.1A0000000000071D.quest_desc": [
    "Доступно с: LV.",
    "",
    "Блок, расширяющий видимую рабочую поверхность информационной панели.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__information_panel_extender.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000071D.title": "Расширитель информационной панели",
  "quest.1A0000000000071E.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Пригодится, если найдёте лошадь.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__saddle.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000071E.title": "Седло",
  "quest.1A0000000000071F.quest_desc": [
    "Доступно с: EV.",
    "",
    "Весьма полезный сундук. Может втягивать в себя выпавшие на землю предметы."
  ],
  "quest.1A0000000000071F.title": "Вакуумный сундук",
  "quest.1A00000000000721.quest_desc": [
    "Доступно с: LV.",
    "",
    "Изготовьте любой электрический компрессор (LV - IV).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__compressor_lv.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000721.title": "Любой электрический компрессор",
  "quest.1A00000000000722.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Электрическая доменная печь: 1 × Кобальтин, 3000 мБ Кислород. 120 EU/т, 6 с.",
    "",
    "Чтобы получить его, вам нужно расплавить пыль кобальтина с большим количеством кислорода в ЭДП.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_arsenic_trioxide.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000722.title": "Пыль триоксида мышьяка",
  "quest.1A00000000000723.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Электрическая доменная печь: 1 × Галлиевый слиток, 1 × Мышьяковый слиток. 120 EU/т, 30 с.",
    "",
    "Положите слитки галлия и мышьяка в ЭДП, чтобы получить их сплав."
  ],
  "quest.1A00000000000723.title": "Слиток арсенида галлия",
  "quest.1A00000000000726.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Может быть изготовлена из резинового бруска путём обработки его на токарном станке.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__rod_rubber.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000726.title": "Резиновая палка",
  "quest.1A00000000000727.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Печь сплавов: 3 × Каучук, 1 × Серная пыль. 8 EU/т, 10 с.",
    "",
    "Скрафтить его можно из жидкой резины."
  ],
  "quest.1A00000000000727.title": "Резиновый брусок",
  "quest.1A00000000000728.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Разборочный станок: 1 × Разрушитель камня (LV). 16 EU/т, 120 с.",
    "",
    "Это компонент разрушителя камня. Но вы также можете использовать его, чтобы сделать другие ваши машины водонепроницаемыми."
  ],
  "quest.1A00000000000728.title": "Комплект влагозащиты",
  "quest.1A00000000000729.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Дробитель: 1 × Глауконит (глубинный сланец). 2 EU/т, 20 с.",
    "",
    "Используйте электролизёр, чтобы получить натрий из соли.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_sodium.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000729.title": "Натриевая пыль",
  "quest.1A0000000000072A.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Вы можете использовать дробитель уровня HV или выше, чтобы получить крошечную кучку вольфрамовой пыли."
  ],
  "quest.1A0000000000072A.title": "Камень Края",
  "quest.1A0000000000072D.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Используется в некоторых механизмах для настройки получаемого в рецепте результата.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__programmed_circuit.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000072D.title": "Запрограммированная микросхема",
  "quest.1A00000000000731.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Ваш первый полуавтоматический майнер. Он очень поможет вам найти и добыть малые руды.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__primitive_small_ore_miner.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000731.title": "Примитивный добытчик малых руд",
  "quest.1A00000000000732.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Очень удобный и быстрый механизм для рытья ям. Крайне полезен для быстрой разведки жил руды.",
    "",
    "Открывается сразу после бронзового корпуса. Работает на мускульной силе: положите примитивный бур и лестницы, жмите кнопку в окне (тратит сытость). Копает шахту вниз, ставит лестницу и останавливается на руде. Удобно искать жилы.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__primitive_mine_digger.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000732.title": "Примитивный шахтокопатель",
  "quest.1A00000000000733.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Обычная деревянная миска, которую можно изготовить ножом из деревянной доски или на токарном станке из деревянной плиты.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__bowl.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000733.title": "Миска",
  "quest.1A00000000000734.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Расходуемое топливо для базового сейсморазведчика, чтобы получить немного информации только об одном типе руды рудной жилы, которая будет записана на перфокарту.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__small_gunpowder_bundle.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000734.title": "Маленькая пачка пороха",
  "quest.1A00000000000735.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Гибочный станок: 2 × Бумага, схема 2. 24 EU/т, 2 с.",
    "",
    "Создаётся в сборочном станке из бумаги и клея."
  ],
  "quest.1A00000000000735.title": "Картон",
  "quest.1A00000000000736.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Пильный станок: 1 × Картон. 4 EU/т, 0,8 с.",
    "",
    "Вырезается из картона ножом либо на пильном станке.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__punch_card.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000736.title": "Пустая перфокарта",
  "quest.1A0000000000073B.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Блок, который может загружать предметы в тележки или локомотивы (например, уголь). Необходимо размещать над рельсами (вагонетками).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__item_loader.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000073B.title": "Погрузчик предметов",
  "quest.1A0000000000078A.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Блок, который может выгружать предметы из тележек. Необходимо размещать под рельсами (вагонетками).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__item_unloader.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000078A.title": "Разгрузчик предметов",
  "quest.1A0000000000078B.quest_desc": [
    "Доступно с: LV.",
    "",
    "Рабочую сторону можно менять щёлкнув ПКМ с красной монтировкой в руке.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__item_loader_advanced.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000078B.title": "Продвинутый погрузчик предметов",
  "quest.1A0000000000078C.quest_desc": [
    "Доступно с: LV.",
    "",
    "Рабочую сторону можно менять щёлкнув ПКМ с красной монтировкой в руке.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__item_unloader_advanced.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000078C.title": "Продвинутый разгрузчик предметов",
  "quest.1A0000000000078D.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Любой красный краситель.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__red_dye.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000078D.title": "Красный краситель",
  "quest.1A0000000000078E.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Красная монтировка из мода Railcraft может менять активную сторону механизмов или детекторов из этого же мода.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__crowbar_red.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000078E.title": "Красная монтировка",
  "quest.1A00000000000793.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Просеиватель: 1 × Промытая измельчённая изумрудная руда. 16 EU/т, 40 с.",
    "",
    "Ранний, но нестабильный способ получить Сферу данных. Вы можете использовать один из 3-х изысканных зелёных драгоценных камней с тритием в HV автоклаве, чтобы получить сферу данных с шансом всего 5%."
  ],
  "quest.1A00000000000793.title": "Путь драгоценных камней",
  "quest.1A00000000000797.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Часть кремневой стрелы, которая может быть дешёвым и эффективным боеприпасом для лука.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__arrow_head_flint.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000797.title": "Кремневый наконечник",
  "quest.1A00000000000798.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Расходный материал для двух важных примитивных машин: Примитивного добытчика малых руд и Примитивного шахтокопателя.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__primitive_drill.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000798.title": "Примитивный бур",
  "quest.1A00000000100000.quest_desc": [
    "Эта глава идёт рядом с основной книгой и ничего в ней не закрывает. Столбцы — эпохи: пар, LV, MV, HV, EV, IV, LuV, ZPM, UV. Сверху оружие и патроны, посередине броня, внизу транспорт.",
    "",
    "Оружие: ПКМ — выстрел, удержание — очередь у автомата, R — перезарядка, присесть — прицел. Числа видны в подсказке предмета.",
    "",
    "Машины: ПКМ — сесть, с топливом в руке — заправить, Shift+ПКМ — окно с баком и грузом, Shift — выйти."
  ],
  "quest.1A00000000100000.title": "Оружие и транспорт",
  "quest.1A00000000100001.quest_desc": [
    "Порох и свинцовая пуля в бумаге: всё, что нужно ружьям паровой эпохи. Делается на верстаке."
  ],
  "quest.1A00000000100001.title": "Бумажный патрон",
  "quest.1A00000000100002.quest_desc": [
    "Один выстрел, потом долгая перезарядка: R и несколько секунд терпения. После выстрела остаётся облако дыма."
  ],
  "quest.1A00000000100002.title": "Кремнёвый пистолет",
  "quest.1A00000000100003.quest_desc": [
    "Бьёт сильнее и дальше пистолета, заряжается ещё дольше. Присядьте: разброс станет вдвое меньше."
  ],
  "quest.1A00000000100003.title": "Мушкет",
  "quest.1A00000000100004.quest_desc": [
    "Нарезной ствол: точный дальний выстрел."
  ],
  "quest.1A00000000100004.title": "Штуцер",
  "quest.1A00000000100005.quest_desc": [
    "Широкий раструб и горсть дроби: страшно вблизи и бесполезно вдали."
  ],
  "quest.1A00000000100005.title": "Мушкетон",
  "quest.1A00000000100006.quest_desc": [
    "Первый патрон в гильзе: латунь, порох и свинец собирает сборщик."
  ],
  "quest.1A00000000100006.title": "Пистолетные патроны",
  "quest.1A00000000100007.quest_desc": [
    "Двенадцать выстрелов в магазине. После пороха кажется чудом."
  ],
  "quest.1A00000000100007.title": "Пистолет",
  "quest.1A00000000100008.quest_desc": [
    "Держите ПКМ: очередь. Патроны те же, что у пистолета, расходуются быстро."
  ],
  "quest.1A00000000100008.title": "Пистолет-пулемёт",
  "quest.1A00000000100009.quest_desc": [
    "Длинная гильза и стальная пуля. Они же идут в снайперскую винтовку и пулемёт."
  ],
  "quest.1A00000000100009.title": "Винтовочные патроны",
  "quest.1A0000000010000A.quest_desc": [
    "Точный и скорострельный: главное оружие эпохи HV."
  ],
  "quest.1A0000000010000A.title": "Автомат",
  "quest.1A0000000010000B.quest_desc": [
    "Нужны и ружьё, и патроны к нему. Дробь разлетается широко: в упор сильнее всего, что есть в эту эпоху."
  ],
  "quest.1A0000000010000B.title": "Помповое ружьё",
  "quest.1A0000000010000C.quest_desc": [
    "Граната летит дугой и взрывается при ударе. Блоки не ломает, но и вас заденет: половиной урона."
  ],
  "quest.1A0000000010000C.title": "Гранатомёт",
  "quest.1A0000000010000D.quest_desc": [
    "Присядьте, и прицел приблизит цель вчетверо. Пуля проходит сквозь первую цель."
  ],
  "quest.1A0000000010000D.title": "Снайперская винтовка",
  "quest.1A0000000010000E.quest_desc": [
    "Сто патронов в ленте и долгая перезарядка. С ним медленнее ходите."
  ],
  "quest.1A0000000010000E.title": "Пулемёт",
  "quest.1A0000000010000F.quest_desc": [
    "Ракета идёт по прямой и рвётся широким взрывом. Выстрел один, перезарядка долгая."
  ],
  "quest.1A0000000010000F.title": "Ручная ракетная пушка",
  "quest.1A00000000100010.quest_desc": [
    "Патроны больше не нужны: стреляет зарядом. Заряжается в зарядниках машин и от ранцев, как электроинструмент. Цель загорается."
  ],
  "quest.1A00000000100010.title": "Лазерный пистолет",
  "quest.1A00000000100011.quest_desc": [
    "Луч очередью, насквозь через одну цель."
  ],
  "quest.1A00000000100011.title": "Лазерная винтовка",
  "quest.1A00000000100012.quest_desc": [
    "Один тяжёлый луч пробивает целый ряд врагов."
  ],
  "quest.1A00000000100012.title": "Лазерная пушка",
  "quest.1A00000000100013.quest_desc": [
    "Стреляет плазмой из своего бака, а не зарядом: R заливает капсулу плазмы. Чем тяжелее плазма, тем сильнее выстрел: гелий слабее, никель сильнее. Нужна наквада."
  ],
  "quest.1A00000000100013.title": "Плазменная винтовка",
  "quest.1A00000000100014.quest_desc": [
    "Самое сильное оружие в игре: сто литров плазмы за выстрел."
  ],
  "quest.1A00000000100014.title": "Плазменная пушка",
  "quest.1A00000000100015.quest_desc": [
    "Кожа и бронза, все четыре детали. Защищает как железо, держится дольше.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__musketeer_helmet.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000100015.title": "Мундир мушкетёра",
  "quest.1A00000000100016.quest_desc": [
    "Алюминий и резина: защита как у алмазной брони.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__ballistic_helmet.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000100016.title": "Бронежилет",
  "quest.1A00000000100017.quest_desc": [
    "Титан и углеродные пластины: как незерит, удары отбрасывают меньше.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__assault_helmet.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000100017.title": "Штурмовая броня",
  "quest.1A00000000100018.quest_desc": [
    "Поглощает весь урон за заряд, пока он есть. Огонь не страшен, бег быстрее, шаг на блок, ночное зрение на N."
  ],
  "quest.1A00000000100018.title": "Силовая броня",
  "quest.1A00000000100019.quest_desc": [
    "То же, что силовая, но дешевле на единицу урона и ёмче. Ещё даёт воздух и снимает отравы и радиацию."
  ],
  "quest.1A00000000100019.title": "Плазменная броня",
  "quest.1A0000000010001A.quest_desc": [
    "Дерево и обод из бронзы."
  ],
  "quest.1A0000000010001A.title": "Деревянное колесо",
  "quest.1A0000000010001B.quest_desc": [
    "Сердце первой самоходной машины."
  ],
  "quest.1A0000000010001B.title": "Паровая машина",
  "quest.1A0000000010001C.quest_desc": [
    "Ещё не быстро, зато уже не пешком. Топливо — то, что горит в печи: ПКМ углём по машине. Едет на W, S, рулит на A, D, пробел — тормоз."
  ],
  "quest.1A0000000010001C.title": "Паровой тягач",
  "quest.1A0000000010001D.quest_desc": [
    "Резина и стальное кольцо. Идёт почти на всю технику."
  ],
  "quest.1A0000000010001D.title": "Резиновое колесо",
  "quest.1A0000000010001E.quest_desc": [
    "Сталь, поршни и мотор своей эпохи."
  ],
  "quest.1A0000000010001E.title": "Двигатель LV",
  "quest.1A0000000010001F.quest_desc": [
    "Жидкое топливо: ведро или капсула того, что горит в дизельном генераторе. ПКМ с ним по машине."
  ],
  "quest.1A0000000010001F.title": "Квадроцикл",
  "quest.1A00000000100020.quest_desc": [
    "На нём едет сразу несколько машин."
  ],
  "quest.1A00000000100020.title": "Двигатель MV",
  "quest.1A00000000100021.quest_desc": [
    "Самый быстрый на земле, но один седок и никакого груза."
  ],
  "quest.1A00000000100021.title": "Мотоцикл",
  "quest.1A00000000100022.quest_desc": [
    "Четыре места и немного груза в багажнике: Shift+ПКМ. Наезд на моба его ранит, удар о стену портит машину."
  ],
  "quest.1A00000000100022.title": "Автомобиль",
  "quest.1A00000000100023.quest_desc": [
    "Ставится на воду и только по воде ходит. Четыре места."
  ],
  "quest.1A00000000100023.title": "Катер",
  "quest.1A00000000100024.quest_desc": [
    "Хватит и на грузовик, и на самолёт."
  ],
  "quest.1A00000000100024.title": "Двигатель HV",
  "quest.1A00000000100025.quest_desc": [
    "Медленный, зато 54 слота груза."
  ],
  "quest.1A00000000100025.title": "Грузовик",
  "quest.1A00000000100026.quest_desc": [
    "W и S двигают рычаг газа, летит туда, куда смотрите. Нужен разбег: ниже скорости сваливания машина проседает. Удар о землю на скорости опасен и для пилота."
  ],
  "quest.1A00000000100026.title": "Самолёт",
  "quest.1A00000000100027.quest_desc": [
    "Титан и детали уровня EV."
  ],
  "quest.1A00000000100027.title": "Двигатель EV",
  "quest.1A00000000100028.quest_desc": [
    "Пробел — вверх, Ctrl — вниз, W, A, S, D — движение, поворот мышью. Винт раскручивается несколько секунд. Кончилось топливо — садится, а не падает."
  ],
  "quest.1A00000000100028.title": "Вертолёт",
  "quest.1A00000000100029.quest_desc": [
    "Разворачивается на месте, башня смотрит туда же, куда вы. Снаряды кладутся в груз, клавиша G — выстрел. Пули ему не страшны."
  ],
  "quest.1A00000000100029.title": "Танк",
  "quest.1A0000000010002A.quest_desc": [
    "Вольфрамовая сталь и моторы IV."
  ],
  "quest.1A0000000010002A.title": "Реактивная турбина",
  "quest.1A0000000010002B.quest_desc": [
    "Самая высокая скорость в игре и длинный разбег. Летает только на высокооктановом бензине, жжёт быстро."
  ],
  "quest.1A0000000010002B.title": "Реактивный самолёт",
  "quest.1A0000000010002C.quest_desc": [
    "Заезжает на три блока сразу и ломает листву. Там, где встанет автомобиль, он пройдёт."
  ],
  "quest.1A0000000010002C.title": "Вездеход",
  "quest.1A0000000010002D.quest_desc": [
    "Залейте топливо трубой или капсулой: подъехавшая машина заправится сама, если топливо ей подходит."
  ],
  "quest.1A0000000010002D.title": "Заправщик машин",
  "quest.1A0000000010002E.quest_desc": [
    "ПКМ по любой машине: багажник вдвое больше, зато она медленнее и прожорливее. Снять нельзя."
  ],
  "quest.1A0000000010002E.title": "Грузовой комплект",
  "quest.1A0000000010002F.quest_desc": [
    "Патроны с гильзой делает только он. Бумажные патроны по-прежнему собираются в руках.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__cartridge_press_lv.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000010002F.title": "Патронный станок",
  "quest.1A00000000100030.quest_desc": [
    "Держите ПКМ: магазин набивается патронами из инвентаря. R на оружии меняет его на самый полный, снятый возвращается к вам."
  ],
  "quest.1A00000000100030.title": "Магазин",
  "quest.1A00000000100031.quest_desc": [
    "Бумажный патрон — кремнёвый пистолет, мушкет, штуцер и мушкетон.",
    "Пистолетный патрон — пистолет и пистолет-пулемёт.",
    "Винтовочный патрон — автомат, снайперская винтовка, пулемёт и пулемётная турель.",
    "Ружейный патрон — помповое ружьё.",
    "Граната — гранатомёт и гранатомётная турель.",
    "Ракета — ручная ракетная пушка и ракетная турель.",
    "Танковый снаряд — только танк, кладётся в его груз, G — выстрел.",
    "Лазеры стреляют зарядом, плазменное оружие — плазмой из капсулы.",
    "",
    "Патроны с гильзой делает патронный станок, бумажные — верстак."
  ],
  "quest.1A00000000100031.title": "Какие патроны к чему",
  "quest.1A00000000100032.quest_desc": [
    "Пистолетные патроны для пистолета-пулемёта. Набивается так же, как пистолетный: держите ПКМ."
  ],
  "quest.1A00000000100032.title": "Магазин пистолета-пулемёта",
  "quest.1A00000000100033.quest_desc": [
    "Винтовочные патроны для автомата."
  ],
  "quest.1A00000000100033.title": "Автоматный магазин",
  "quest.1A00000000100034.quest_desc": [
    "Немного винтовочных патронов для снайперской винтовки."
  ],
  "quest.1A00000000100034.title": "Магазин снайперской винтовки",
  "quest.1A00000000100035.quest_desc": [
    "Сто винтовочных патронов для пулемёта: перезарядка долгая, зато надолго."
  ],
  "quest.1A00000000100035.title": "Короб с лентой",
  "quest.1A00000000100036.quest_desc": [
    "Патроны кладутся в базу турели, энергия тоже берётся из неё.",
    "Одноразовая — булыжник. Картофельная пушка — картошка.",
    "Пулемётная — винтовочные патроны. Зажигательная — огненный порошок.",
    "Гранатомётная — гранаты. Ракетная — ракеты.",
    "Рельсотрон — ферросердечники.",
    "Релятивистская, лазерная и телепортатор патронов не берут: только энергию.",
    "Утилизатор в базе иногда возвращает патрон."
  ],
  "quest.1A00000000100036.title": "Чем стреляют турели",
  "quest.1A00000000100037.quest_desc": [
    "Снаряд рельсотрона: самый тяжёлый выстрел турелей.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__ferro_slug.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000100037.title": "Ферросердечник",
  "quest.1A00000000110000.quest_desc": [
    "Эта глава собирает то, чего нет в книге ИИС 1 или что спрятано глубоко. Столбцы — эпохи: пар, LV, MV, HV, EV, IV. Глава ничего не закрывает в основной книге.",
    "",
    "Мир сам сохраняется в архив каждый игровой день (20 минут): папка iis-world-backups рядом с saves, хранятся 20 последних."
  ],
  "quest.1A00000000110000.title": "Что ещё есть в ИИС 2",
  "quest.1A00000000110001.quest_desc": [
    "Жетоны за квесты тратятся здесь. Еда продаётся сразу, сырьё — когда оно хоть раз побывало у вас в инвентаре.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__reward_shop.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110001.title": "Магазин наград",
  "quest.1A00000000110002.quest_desc": [
    "Стойка BiblioCraft держит любые инструменты GT, электроинструменты тоже. Есть из любого дерева."
  ],
  "quest.1A00000000110002.title": "Стойка для инструментов",
  "quest.1A00000000110003.quest_desc": [
    "Уголь из брёвен в печи не получить, как в ИИС 1. Сложите брёвна кучей до 11×6×11 на кирпичи, обложите землёй со всех сторон и сверху, без пустот, поставьте запальник сверху и подайте сигнал. Брёвна станут ломким углём.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__charcoal_pile.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110003.title": "Угольная яма",
  "quest.1A00000000110004.quest_desc": [
    "Кокс из угля и креозот из брёвен без всякого электричества.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__coke_oven.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110004.title": "Коксовая печь",
  "quest.1A00000000110005.quest_desc": [
    "Копает шахту вниз сам, на паре. Вставьте в него буровые трубы.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__primitive_mine_digger.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110005.title": "Примитивный шахтокопатель",
  "quest.1A00000000110006.quest_desc": [
    "Втрое больше пара, чем у бронзового: 360 л/с, после накипи 120 л/с. Сломайте и поставьте заново, чтобы убрать накипь."
  ],
  "quest.1A00000000110006.title": "Солнечный котёл высокого давления",
  "quest.1A00000000110007.quest_desc": [
    "Как каменные в ванили, а каменные теперь хуже.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__flint_pickaxe.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110007.title": "Кремнёвые инструменты",
  "quest.1A00000000110008.quest_desc": [
    "Срезает траву, посевы и листву вокруг одним взмахом.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__sense_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110008.title": "Коса",
  "quest.1A00000000110009.quest_desc": [
    "ПКМ вспахивает землю 3×3.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__plow_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110009.title": "Плуг",
  "quest.1A0000000011000A.quest_desc": [
    "С каждой срезанной листвы падает саженец.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__branch_cutter_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011000A.title": "Сучкорез",
  "quest.1A0000000011000B.quest_desc": [
    "С существа, убитого им, падает вдвое больше.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__butchery_knife_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011000B.title": "Разделочный нож",
  "quest.1A0000000011000C.quest_desc": [
    "Лопата, пила и монтировка в одном.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__universal_spade_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011000C.title": "Универсальная лопата",
  "quest.1A0000000011000D.quest_desc": [
    "Многоблок 5×5×5: внизу поле земли 3×3 и люки, стенки из стекла, сверху каркасы. Саженец и вода дают брёвна и новые саженцы, удобрение ускоряет вдвое. Каркасы LV, MV, HV, EV, IV вместо ULV: каждый уровень вдвое быстрее и +50 % брёвен. Брёвна — в угольную яму или пиролизную печь.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__tree_farm.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011000D.title": "Автоферма дерева",
  "quest.1A0000000011000E.quest_desc": [
    "Огромный запас одного предмета в одном блоке.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__quantum_chest_lv.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011000E.title": "Квантовый сундук",
  "quest.1A0000000011000F.quest_desc": [
    "Краник на заряде: смола без износа.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__electric_treetap.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011000F.title": "Электрокраник",
  "quest.1A00000000110010.quest_desc": [
    "Снимает машины и служит ключом в рецептах, тратит заряд вместо прочности.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__electric_wrench.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110010.title": "Электроключ",
  "quest.1A00000000110011.quest_desc": [
    "Пила для верстака на заряде.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__buzzsaw_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110011.title": "Циркулярная пила",
  "quest.1A00000000110012.quest_desc": [
    "Отвёртка для верстака на заряде.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__screwdriver_lv_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110012.title": "Шуруповёрт",
  "quest.1A00000000110013.quest_desc": [
    "База держит энергию и патроны, турель ставится сверху. Одноразовая стреляет булыжником.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__turret_base_t1.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110013.title": "Первая турель",
  "quest.1A00000000110014.quest_desc": [
    "Вдвое быстрее и прочнее бура LV.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__drill_mv_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110014.title": "Бур MV",
  "quest.1A00000000110015.quest_desc": [
    "Валит деревья целиком.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__chainsaw_mv_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110015.title": "Цепная пила MV",
  "quest.1A00000000110016.quest_desc": [
    "Держит пули и удары спереди целиком, взрывы наполовину."
  ],
  "quest.1A00000000110016.title": "Баллистический щит",
  "quest.1A00000000110017.quest_desc": [
    "Стреляет винтовочными патронами.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__turret_base_t2.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110017.title": "Пулемётная турель",
  "quest.1A00000000110018.quest_desc": [
    "Самый быстрый бур GT.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__drill_hv_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110018.title": "Бур HV",
  "quest.1A00000000110019.quest_desc": [
    "Крушит камень быстрее любого бура.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__jackhammer_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110019.title": "Отбойный молоток",
  "quest.1A0000000011001A.quest_desc": [
    "Ключ, отвёртка, краник и мотыга в одном. В рецептах — ключ и отвёртка, по ПКМ — смола или пашня.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__gravitool.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011001A.title": "Гравитул",
  "quest.1A0000000011001B.quest_desc": [
    "Ищет руду и нефть далеко под землёй.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__seismic_prospector_ev.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011001B.title": "Сейсмический разведчик",
  "quest.1A0000000011001C.quest_desc": [
    "Shift+ПКМ включает копку 3×3.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__advanced_drill.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011001C.title": "Продвинутый бур",
  "quest.1A0000000011001D.quest_desc": [
    "Стреляет ракетами.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__turret_base_t4.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011001D.title": "Ракетная турель",
  "quest.1A0000000011001E.quest_desc": [
    "Энергия из наквады.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__naquadah_reactor_ev.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011001E.title": "Наквадовый реактор",
  "quest.1A0000000011001F.quest_desc": [
    "Ломает любой блок мгновенно. Shift+ПКМ — режим «блоки целиком».",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__vajra.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000011001F.title": "Ваджра",
  "quest.1A00000000110020.quest_desc": [
    "Держит всё спереди за заряд."
  ],
  "quest.1A00000000110020.title": "Силовой щит",
  "quest.1A00000000110021.quest_desc": [
    "Ферросердечник насквозь.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__turret_base_t5.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000110021.title": "Рельсотрон",
  "quest.1A00000000120000.quest_desc": [
    "Челнок упал, и он ваш: один на игрока на весь мир. После смерти новый не появится.",
    "",
    "Электроника в нём сгорела, корпус сверхпрочный. Сейчас он почти бесполезен, но не ломайте и не теряйте его: позже корпус можно переработать, а на крыше живёт очаг, с которого начинается путь Био.",
    "",
    "Эта глава и следующая написаны для ИИС 2. Дальше идёт книга ИИС 1."
  ],
  "quest.1A00000000120000.title": "Аварийная посадка",
  "quest.1A00000000120001.quest_desc": [
    "Кибер — машины: камень, бронза, пар, электричество от LV до UV. Эта книга ведёт по нему.",
    "",
    "Био — живая колония. Она начинается с ядра и пасти на крыше вашего челнока: накормите пасть едой, и ткань начнёт расти.",
    "",
    "Дуо — когда развиты обе ветви.",
    "",
    "Пути не мешают друг другу и не требуют друг друга. Выбирать навсегда не нужно: можно идти одним, а к другому вернуться позже."
  ],
  "quest.1A00000000120001.title": "Три пути",
  "quest.1A00000000120002.quest_desc": [
    "Рецепт верстака нарисован прямо в тексте квеста. Остальные рецепты смотрите в JEI: R по предмету — как сделать, U — где используется.",
    "",
    "За квесты дают жетоны. Их принимает магазин наград (глава «Что ещё есть в ИИС 2»).",
    "",
    "Главы с пометкой [О] — общие: прогресс, удобства, все машины и многоблоки.",
    "",
    "Мир сам сохраняется в архив каждый игровой день, хранятся последние 20 копий."
  ],
  "quest.1A00000000120002.title": "Как читать книгу",
  "quest.1A00000000120003.quest_desc": [
    "Срубите любое дерево."
  ],
  "quest.1A00000000120003.title": "Древесина",
  "quest.1A00000000120004.quest_desc": [
    "Из бревна в сетке крафта выходит только две доски. Пила даст больше — она в следующей главе.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__oak_planks.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120004.title": "Доски",
  "quest.1A00000000120005.quest_desc": [
    "Почти всё начало игры делается на нём.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__crafting_table.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120005.title": "Верстак",
  "quest.1A00000000120006.quest_desc": [
    "Рукояти инструментов и факелы.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__stick.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120006.title": "Палки",
  "quest.1A00000000120007.quest_desc": [
    "Гравий лежит у воды и в пещерах. Из него выпадает кремень.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__gravel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120007.title": "Гравий",
  "quest.1A00000000120008.quest_desc": [
    "Кремень выпадает не с каждого блока: ставьте гравий и копайте снова.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__flint.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120008.title": "Кремень",
  "quest.1A00000000120009.quest_desc": [
    "Первая настоящая кирка. Кремнёвые инструменты здесь как каменные в обычной игре, а каменные хуже.",
    "",
    "Железную кирку из слитков на верстаке не сделать: нужна головка, выкованная молотом. Это следующая глава.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__flint_pickaxe.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120009.title": "Кремнёвая кирка",
  "quest.1A0000000012000A.quest_desc": [
    "Рубит дерево заметно быстрее рук.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__flint_axe.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012000A.title": "Кремнёвый топор",
  "quest.1A0000000012000B.quest_desc": [
    "Гравий, песок и глина пойдут быстрее.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__flint_shovel.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012000B.title": "Кремнёвая лопата",
  "quest.1A0000000012000C.quest_desc": [
    "Ночью пригодится.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__flint_sword.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012000C.title": "Кремнёвый меч",
  "quest.1A0000000012000D.quest_desc": [
    "Восемь штук — на печь.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__cobblestone.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012000D.title": "Булыжник",
  "quest.1A0000000012000E.quest_desc": [
    "Плавит руду и готовит еду.",
    "",
    "Древесный уголь из брёвен в печи не получается: его жгут в угольной яме (глава «Пар и сталь»). Пока топите досками и углём.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__furnace.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012000E.title": "Печь",
  "quest.1A0000000012000F.quest_desc": [
    "Обожгите булыжник. Камень нужен для ступки и каменных деталей."
  ],
  "quest.1A0000000012000F.title": "Камень",
  "quest.1A00000000120010.quest_desc": [
    "Пожарьте любое мясо или рыбу."
  ],
  "quest.1A00000000120010.title": "Горячий ужин",
  "quest.1A00000000120011.quest_desc": [
    "Сундук и дверь. Любая коробка с дверью защитит от ночных гостей; челнок тоже подойдёт как ориентир.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__chest.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120011.title": "Укрытие",
  "quest.1A00000000120012.quest_desc": [
    "Три блока шерсти любого цвета — с овец.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__white_wool.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120012.title": "Шерсть",
  "quest.1A00000000120013.quest_desc": [
    "Пропускает ночь и запоминает место возрождения.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__red_bed.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120013.title": "Кровать",
  "quest.1A00000000120014.quest_desc": [
    "Нужен, чтобы собирать смолу с каучуковых деревьев.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__treetap.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120014.title": "Краник",
  "quest.1A00000000120015.quest_desc": [
    "Найдите каучуковое дерево: у его ствола на одной стороне есть отверстие со смолой. ПКМ краником по полному отверстию даёт смолу, со временем оно наполняется снова. Поставленное вами бревно смолы не даёт."
  ],
  "quest.1A00000000120015.title": "Смола",
  "quest.1A00000000120016.quest_desc": [
    "Первые факелы делаются из смолы и палки.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__torch.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120016.title": "Факел",
  "quest.1A00000000120017.quest_desc": [
    "Обычной руды в мире нет. Руда собрана в большие жилы: нашли одну — хватит надолго. Между жилами попадаются одиночные малые руды.",
    "",
    "Где искать в Верхнем мире (высоты ИИС 2, в старых квестах книги они другие):",
    "Y 0 … 128: олово (касситерит)",
    "Y 64 … 128: медь (тетраэдрит), сурьма",
    "Y -48 … -16: медь (халькопирит), пирит, железо",
    "Y -48 … 0: железо (лимониты, полосчатое железо), малахит",
    "Y 16 … 128: железо (магнетит)",
    "Y 16 … 64: уголь",
    "Y 16 … 144: бурый уголь",
    "Y -16 … 32: свинец и серебро (галенит)",
    "Y -48 … 0: красная пыль, рубин, киноварь",
    "Y -48 … 0: никель, кобальт",
    "Y -56 … -32: алмазы, графит"
  ],
  "quest.1A00000000120017.title": "Руда лежит жилами",
  "quest.1A00000000120018.quest_desc": [
    "Жила касситерита — самая частая и лежит почти на любой высоте. Руду плавит печь."
  ],
  "quest.1A00000000120018.title": "Олово",
  "quest.1A00000000120019.quest_desc": [
    "Тетраэдрит в горах или халькопирит глубоко под землёй."
  ],
  "quest.1A00000000120019.title": "Медь",
  "quest.1A0000000012001A.quest_desc": [
    "Магнетит выше уровня моря или лимониты в глубине."
  ],
  "quest.1A0000000012001A.title": "Железо",
  "quest.1A0000000012001B.quest_desc": [
    "Топливо для печи и будущих котлов."
  ],
  "quest.1A0000000012001B.title": "Уголь",
  "quest.1A0000000012001C.quest_desc": [
    "Серебро лежит в жиле галенита вместе со свинцом. Оно понадобится для солнечного котла."
  ],
  "quest.1A0000000012001C.title": "Серебряная руда",
  "quest.1A0000000012001D.quest_desc": [
    "Для стекла.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__sand.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012001D.title": "Песок",
  "quest.1A0000000012001E.quest_desc": [
    "Песок в печи."
  ],
  "quest.1A0000000012001E.title": "Стекло",
  "quest.1A0000000012001F.quest_desc": [
    "Шесть блоков стекла на верстаке."
  ],
  "quest.1A0000000012001F.title": "Стеклянная панель",
  "quest.1A00000000120020.quest_desc": [
    "Глина лежит под водой в реках и на пляжах."
  ],
  "quest.1A00000000120020.title": "Глина",
  "quest.1A00000000120021.quest_desc": [
    "Комок глины в печи."
  ],
  "quest.1A00000000120021.title": "Кирпич",
  "quest.1A00000000120022.quest_desc": [
    "Кирпичи пойдут на первый паровой котёл и угольную яму.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__bricks.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120022.title": "Кирпичный блок",
  "quest.1A00000000120023.quest_desc": [
    "Со слизней на болотах. Понадобится для обшивки водонапорной башни.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__slime_ball.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120023.title": "Слизь",
  "quest.1A00000000120024.quest_desc": [
    "Дальше почти всё делается инструментом в сетке крафта: молот куёт пластины, напильник точит стержни, пила режет, ключ собирает корпуса. Инструмент не тратится, а изнашивается.",
    "",
    "Сами инструменты — в главе «[О] Качество жизни»: начните с молота, напильника и пилы. Подойдёт инструмент из любого металла."
  ],
  "quest.1A00000000120024.title": "Инструменты GregTech",
  "quest.1A00000000120025.quest_desc": [
    "Растирает слитки и камни в пыль прямо в сетке крафта.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__mortar_flint.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120025.title": "Ступка",
  "quest.1A00000000120026.quest_desc": [
    "Разотрите слитки ступкой и смешайте три медные пыли с одной оловянной.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_bronze.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120026.title": "Бронзовая пыль",
  "quest.1A00000000120027.quest_desc": [
    "Пыль в печь. Бронза — металл всей паровой эпохи."
  ],
  "quest.1A00000000120027.title": "Бронза",
  "quest.1A00000000120028.quest_desc": [
    "Слитки и молот в сетке крафта.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__plate_bronze.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120028.title": "Бронзовая пластина",
  "quest.1A00000000120029.quest_desc": [
    "Основа паровых машин. С ним открывается и примитивный шахтокопатель (глава «Пар и сталь»).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__hull_bronze.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120029.title": "Бронзовый корпус",
  "quest.1A0000000012002A.quest_desc": [
    "Слиток и напильник.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__rod_bronze.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012002A.title": "Бронзовый стержень",
  "quest.1A0000000012002B.quest_desc": [
    "Выкуйте железную или бронзовую головку кирки и соедините с палкой. Такая кирка берёт руду, которую кремнёвая не возьмёт.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__pickaxe_head_bronze.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012002B.title": "Кирка получше",
  "quest.1A0000000012002C.quest_desc": [
    "Железные слитки и молот.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__plate_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012002C.title": "Железная пластина",
  "quest.1A0000000012002D.quest_desc": [
    "Слиток и напильник. Позже стержни точит токарный станок.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__rod_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012002D.title": "Железный стержень",
  "quest.1A0000000012002E.quest_desc": [
    "Снимает машины GregTech, соединяет трубы и нужен почти в каждом рецепте корпуса.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wrench_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012002E.title": "Гаечный ключ",
  "quest.1A0000000012002F.quest_desc": [
    "Стержни, пластины и ключ.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__gear_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012002F.title": "Железная шестерня",
  "quest.1A00000000120030.quest_desc": [
    "Три железные пластины и молот: из слитков ведро не делается.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__bucket.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120030.title": "Ведро",
  "quest.1A00000000120031.quest_desc": [
    "Семь железных пластин и молот.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__cauldron.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120031.title": "Котёл",
  "quest.1A00000000120032.quest_desc": [
    "Жила красной пыли лежит глубоко: вместе с ней идут рубин и киноварь.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__redstone.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120032.title": "Красная пыль",
  "quest.1A00000000120033.quest_desc": [
    "Доски, булыжник, красная пыль и бронзовый слиток. Деталь первых паровых машин.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__piston.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120033.title": "Поршень",
  "quest.1A00000000120034.quest_desc": [
    "Серебряная руда в печи."
  ],
  "quest.1A00000000120034.title": "Серебряный слиток",
  "quest.1A00000000120035.quest_desc": [
    "Для солнечного котла.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__plate_silver.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120035.title": "Серебряная пластина",
  "quest.1A00000000120036.quest_desc": [
    "С пауков или из шерсти."
  ],
  "quest.1A00000000120036.title": "Нить",
  "quest.1A00000000120037.quest_desc": [
    "Бьёт издалека.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__bow.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120037.title": "Лук",
  "quest.1A00000000120038.quest_desc": [
    "Доска и пила.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__small_gear_wood.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120038.title": "Малая деревянная шестерня",
  "quest.1A00000000120039.quest_desc": [
    "Деревянные шестерни, палка, доски, нить, булыжник и ведро. Даёт воду без реки под боком: будущим котлам её нужно много.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__well.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120039.title": "Колодец",
  "quest.1A0000000012003A.quest_desc": [
    "Из камня.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__stone_button.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012003A.title": "Каменная кнопка",
  "quest.1A0000000012003B.quest_desc": [
    "Гладкий камень (камень, обожжённый ещё раз) и напильник.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__small_gear_stone.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012003B.title": "Каменная шестерня",
  "quest.1A0000000012003C.quest_desc": [
    "Слабое оружие, зато режет бумажные кольца и многое другое.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__knife_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012003C.title": "Нож",
  "quest.1A0000000012003D.quest_desc": [
    "Режут пластины на провода, а фольгу на проволоку.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_cutter_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012003D.title": "Кусачки",
  "quest.1A0000000012003E.quest_desc": [
    "Доски и пила.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__oak_slab.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012003E.title": "Деревянная плита",
  "quest.1A0000000012003F.quest_desc": [
    "Самый дешёвый водопровод. Пар по деревянным трубам не пускайте.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__pipe_medium_wood.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012003F.title": "Деревянная труба",
  "quest.1A00000000120040.quest_desc": [
    "Шерсть, доска и палки.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__scoop.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120040.title": "Сачок",
  "quest.1A00000000120041.quest_desc": [
    "На крыше вашего челнока — ядро колонии и пасть. С них начинается путь Био: живая колония вместо машин. Он не требует ничего из Кибера и ничем ему не мешает.",
    "",
    "Цвет и пульс ядра показывают состояние колонии: спит, голодает, сыта, растёт, встревожена. ПКМ по ядру открывает его пищеварительный карман.",
    "",
    "Не ломайте ткань колонии без нужды: она тревожится. Рецепты всех мест и органов Био смотрите в JEI.",
    "",
    "Всё выше ступени LV в Био — черновик: числа и рецепты ещё будут меняться."
  ],
  "quest.1A00000000120041.title": "Очаг на челноке",
  "quest.1A00000000120042.quest_desc": [
    "ПКМ любой едой по пасти. Сырая еда даёт 10 мБ питания N0 за каждое очко сытости.",
    "",
    "Сытая колония растит ткань по корпусу и вокруг него, клетка за клеткой. Без еды ткань увядает и отступает с дальнего края. Всё, что оторвано от ядра, отмирает."
  ],
  "quest.1A00000000120042.title": "Накормить пасть",
  "quest.1A00000000120043.quest_desc": [
    "Кремень и палка. Животное, убитое этим ножом, оставляет тушу вместо обычной добычи. Им же снимают соскоб с ткани колонии.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__bio_knife.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120043.title": "Каменный разделочный нож",
  "quest.1A00000000120044.quest_desc": [
    "Малая, средняя или большая — по размеру животного."
  ],
  "quest.1A00000000120044.title": "Туша",
  "quest.1A00000000120045.quest_desc": [
    "Ручное место: туша расходится на мясную массу, волокно и кость. Здесь же собирают простые вещи: ростовую подложку, щуп, скребок.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__butcher_block.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120045.title": "Разделочная площадка",
  "quest.1A00000000120046.quest_desc": [
    "Перетирает еду и растения в массы. Масса с водой в кармане ядра даёт намного больше питания, чем сырая еда, и ещё ростовую фракцию.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__stone_mortar.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120046.title": "Каменная ступа",
  "quest.1A00000000120047.quest_desc": [
    "Жар под варочным сосудом.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__stone_hearth.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120047.title": "Очаг",
  "quest.1A00000000120048.quest_desc": [
    "Ставится на очаг. Варит связующее и другие смеси.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__stone_pot.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120048.title": "Каменный варочный сосуд",
  "quest.1A00000000120049.quest_desc": [
    "Переносит жидкости Био между местами. Воду носит и ведро. Капсулы и резервуары Кибера тоже подходят ко всем местам и органам.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__measuring_ladle.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120049.title": "Мерный ковш",
  "quest.1A0000000012004A.quest_desc": [
    "Смешивает жидкости вручную: концентрат, среды N1, E1 и G1.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__measuring_vessel.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000012004A.title": "Мерный смесительный сосуд",
  "quest.1A0000000012004B.quest_desc": [
    "Соскоб ножом с живой ткани колонии."
  ],
  "quest.1A0000000012004B.title": "Неразвитая культура",
  "quest.1A0000000012004C.quest_desc": [
    "Карман ядра в режиме почкования: мясная и растительная масса на ростовой фракции. Посев идёт в каждый живой орган."
  ],
  "quest.1A0000000012004C.title": "Базовый посев колонии",
  "quest.1A0000000012004D.quest_desc": [
    "Первое живое место: на нём растут мягкая ткань и мембрана. Питается N0 колонии, поэтому ставьте её на ткань колонии."
  ],
  "quest.1A0000000012004D.title": "Ручная ростовая подложка",
  "quest.1A0000000012004E.quest_desc": [
    "Растёт на подложке. Основа всех органов; заплатка для изношенного сосуда."
  ],
  "quest.1A0000000012004E.title": "Мягкая ткань",
  "quest.1A0000000012004F.quest_desc": [
    "Мягкая ткань на среде G0."
  ],
  "quest.1A0000000012004F.title": "Живая мембрана",
  "quest.1A00000000120050.quest_desc": [
    "Растит органы: новую пасть, волокнистую ткань, первые органы LV."
  ],
  "quest.1A00000000120050.title": "Ростовое ложе",
  "quest.1A00000000120051.quest_desc": [
    "Цикл замкнулся: колония вырастила собственный орган. Пасть работает вплотную к ядру или к ткани колонии."
  ],
  "quest.1A00000000120051.title": "Новая пасть",
  "quest.1A00000000120052.quest_desc": [
    "Отжимает экстракт из масс.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__stone_press.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120052.title": "Ручной отжим",
  "quest.1A00000000120053.quest_desc": [
    "Чистит воду до W0. Прокладка сменная.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__filter_vessel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000120053.title": "Гравитационный фильтр",
  "quest.1A00000000120054.quest_desc": [
    "Сосуды соединяются сами и живут на N0 колонии. Жидкость качает насос: ядро колонии вплотную к сети или мышечный насос LV. Без насоса она только стекает вниз.",
    "",
    "ПКМ по сосуду показывает давление, поток и износ. Выше безопасного давления стенка изнашивается, на разрывном лопается: насос LV в сосуды ULV не подключайте."
  ],
  "quest.1A00000000120054.title": "Сосуды",
  "quest.1A00000000120055.quest_desc": [
    "Первый орган LV: в нём растут остальные органы этой ступени. Буферы N1 и E1 наполняются ковшом или капсулой."
  ],
  "quest.1A00000000120055.title": "Формовочное гнездо",
  "quest.1A00000000120056.quest_desc": [
    "Готовит среды N1, E1 и G1 без ручного смешивания."
  ],
  "quest.1A00000000120056.title": "Питательная железа",
  "quest.1A00000000120057.quest_desc": [
    "Чистая вода W0 потоком."
  ],
  "quest.1A00000000120057.title": "Мембранный фильтр",
  "quest.1A00000000120058.quest_desc": [
    "Насос LV: берёт сзади, подаёт вперёд."
  ],
  "quest.1A00000000120058.title": "Мышечный насос",
  "quest.1A00000000120059.quest_desc": [
    "8000 мБ. Shift+ПКМ переключает приём и выдачу."
  ],
  "quest.1A00000000120059.title": "Живой резервуар",
  "quest.1A0000000012005A.quest_desc": [
    "27 ячеек."
  ],
  "quest.1A0000000012005A.title": "Живое хранилище",
  "quest.1A0000000012005B.quest_desc": [
    "Переносит предметы между хранилищами, органами и каналами. В орган кладёт только то, что входит в его рецепты."
  ],
  "quest.1A0000000012005B.title": "Перистальтический канал",
  "quest.1A0000000012005C.quest_desc": [
    "Хитиновая культура в гнезде даёт чешуйки, уплотнитель прессует их в пластину."
  ],
  "quest.1A0000000012005C.title": "Хитин",
  "quest.1A0000000012005D.quest_desc": [
    "Руда → две дроблёные. Первый шаг Био к металлу."
  ],
  "quest.1A0000000012005D.title": "Разрыхлитель",
  "quest.1A0000000012005E.quest_desc": [
    "Мутанты — живые животные с рабочей линией. Осмотрите животное щупом, затем дайте агент воздействия не дальше 4 блоков от площадки вивария. Через 2 минуты линия проявится: у животного сменится имя и размер."
  ],
  "quest.1A0000000012005E.title": "Виварий",
  "quest.1A0000000012005F.quest_desc": [
    "Свинья даёт свою тушу (толстая жила), корова — секрет, овца — длинное волокно, курица — плотную оболочку. Сбор скребком раз в 5 минут."
  ],
  "quest.1A0000000012005F.title": "Продукт линии",
  "quest.1A00000000120060.quest_desc": [
    "Вход в MV: из продукта любой одной линии."
  ],
  "quest.1A00000000120060.title": "Армированная оболочка",
  "quest.1A00000000120061.quest_desc": [
    "MV. Дроблёная руда на кислоте → пыль металла и три крошечные кучки. Слиток из пыли плавит обычная печь."
  ],
  "quest.1A00000000120061.title": "Рудный желудок",
  "quest.1A00000000120062.quest_desc": [
    "MV. Растит зародыши органов и первые органы HV."
  ],
  "quest.1A00000000120062.title": "Инкубатор",
  "quest.1A00000000120063.quest_desc": [
    "MV. Кислота, ферментная культура, среда G2."
  ],
  "quest.1A00000000120063.title": "Изолятор культур",
  "quest.1A00000000120064.quest_desc": [
    "HV. Две пыли с одной дроблёной руды."
  ],
  "quest.1A00000000120064.title": "Биохимический реактор",
  "quest.1A00000000120065.quest_desc": [
    "HV. Ткани за десятки секунд вместо минут."
  ],
  "quest.1A00000000120065.title": "Ускоритель роста",
  "quest.1A00000000130000.quest_desc": [
    "Первые машины работают на паре: котёл греет воду, пар идёт по бронзовым трубам в машины.",
    "",
    "Древесный уголь жгут в угольной яме, кокс и креозот даёт коксовая печь, сталь варит кирпичная доменная печь. Примитивный шахтокопатель и добытчик малых руд помогают искать жилы.",
    "",
    "Здесь собрано всё, что делается без электричества. Цель — сталь и каркас механизма LV."
  ],
  "quest.1A00000000130000.title": "Пар и сталь",
  "quest.1A00000000130001.quest_desc": [
    "Напряжение LV — до 32 EU/т. Первый генератор — паровая турбина: пар у вас уже есть.",
    "",
    "Программируемая схема в слоте машины выбирает рецепт, когда из одного и того же делается разное. В гибочном станке: слиток гнётся в пластину без схемы, схема 2 — двойная пластина, 4 — фольга, 12 — капсулы.",
    "",
    "Машина сама берёт рецепт, которому нужно больше всего из лежащего в слотах.",
    "",
    "Здесь собрано всё, чему хватает LV."
  ],
  "quest.1A00000000130001.title": "LV: первое электричество",
  "quest.1A00000000130002.quest_desc": [
    "Напряжение MV — до 128 EU/т. Здесь собрано всё, чему нужна ступень MV: её машины, материалы и многоблоки."
  ],
  "quest.1A00000000130002.title": "MV",
  "quest.1A00000000130003.quest_desc": [
    "Напряжение HV — до 512 EU/т. Здесь собрано всё, чему нужна ступень HV."
  ],
  "quest.1A00000000130003.title": "HV",
  "quest.1A00000000130004.quest_desc": [
    "Напряжение EV — до 2048 EU/т. Здесь собрано всё, чему нужна ступень EV."
  ],
  "quest.1A00000000130004.title": "EV",
  "quest.1A00000000130005.quest_desc": [
    "Напряжение IV — до 8192 EU/т. Здесь собрано всё, чему нужна ступень IV."
  ],
  "quest.1A00000000130005.title": "IV",
  "quest.1A00000000130006.quest_desc": [
    "Напряжение LuV — до 32 768 EU/т. Здесь собрано всё, чему нужна ступень LuV."
  ],
  "quest.1A00000000130006.title": "LuV",
  "quest.1A00000000130007.quest_desc": [
    "Напряжение ZPM — до 131 072 EU/т. Здесь собрано всё, чему нужна ступень ZPM."
  ],
  "quest.1A00000000130007.title": "ZPM",
  "quest.1A00000000130008.quest_desc": [
    "Напряжение UV — до 524 288 EU/т. Вершина пути Кибера: здесь собрано всё, чему нужна ступень UV."
  ],
  "quest.1A00000000130008.title": "UV"
}
