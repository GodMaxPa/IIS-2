    "{image:iis:textures/quest_recipe/iis__rod_blue_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000041E.title": "Стержень из синей стали",
  "quest.1A0000000000041F.quest_desc": [
    "Доступно с: без электричества.",
