  "quest.1A0000000000048F.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A0000000000048F.title": "[об] Дробитель (HV)",
  "quest.1A00000000000490.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
