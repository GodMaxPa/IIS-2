  ],
  "quest.1A00000000000494.title": "[об] Рудопромывочная машина (ZPM)",
  "quest.1A00000000000496.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A00000000000496.title": "[об] Рудопромывочная машина (LV)",
  "quest.1A00000000000497.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A00000000000497.title": "[об] Рудопромывочная машина (MV)",
  "quest.1A00000000000498.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A00000000000498.title": "[об] Рудопромывочная машина (HV)",
  "quest.1A00000000000499.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A00000000000499.title": "[об] Рудопромывочная машина (EV)",
  "quest.1A0000000000049A.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A0000000000049A.title": "[об] Рудопромывочная машина (IV)",
  "quest.1A0000000000049B.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A0000000000049B.title": "[об] Рудопромывочная машина (LuV)",
  "quest.1A0000000000049E.quest_desc": [
    "Можно сделать из четырёх комочков глины."
  ],
  "quest.1A0000000000049E.title": "Глина (блок)",
  "quest.1A0000000000049F.quest_desc": [
    "Воспользуйтесь ступкой (или дробителем, если у вас таковой имеется), чтобы сделать глиняную пыль из блока глины."
  ],
  "quest.1A0000000000049F.title": "Глиняная пыль",
  "quest.1A000000000004A0.quest_desc": [
    "Смешайте глиняную и кирпичную пыль, чтобы получить пыль огнеупорной глины."
  ],
  "quest.1A000000000004A0.title": "Пыль огнеупорной глины",
  "quest.1A000000000004A1.quest_desc": [
    "Воспользуйтесь компрессором, чтобы получить кирпичи спрессованной огнеупорной глины."
  ],
  "quest.1A000000000004A1.title": "Спрессованная огнеупорная глина",
  "quest.1A000000000004A2.quest_desc": [
    "Чтобы изготовить огнеупорный кирпич, отправьте спрессованную огнеупорную глину в печь."
  ],
  "quest.1A000000000004A2.title": "Огнеупорный кирпич",
  "quest.1A000000000004A3.quest_desc": [
    "Для получения кирпичной пыли измельчите кирпичи в дробителе. С каждого кирпича вы получите по маленькой кучке кирпичной пыли. После вы сможете объединить четыре маленьких кучки в одну пыль обычного размера."
  ],
  "quest.1A000000000004A3.title": "Кирпичная пыль",
  "quest.1A000000000004A4.quest_desc": [
    "Чтобы сделать оловянный стержень, обработайте оловянный слиток напильником."
  ],
  "quest.1A000000000004A4.title": "Оловянный стержень",
  "quest.1A000000000004A5.quest_desc": [
    "Разрежьте оловянный стержень пилой, чтобы получить оловянные болты."
  ],
  "quest.1A000000000004A5.title": "Оловянный болт",
  "quest.1A000000000004A6.quest_desc": [
    "Обработайте оловянный стержень молотом, чтобы сделать оловянное кольцо."
  ],
  "quest.1A000000000004A6.title": "Оловянное кольцо",
  "quest.1A000000000004A7.quest_desc": [
    "Вам нужно найти любую овцу (с шерстью любого цвета). Но чтобы получить именно чёрную шерсть, вам нужно покрасить её в этот цвет любым подходящим красителем, например, чернильным мешком. Кстати, от двух овец можно получить потомство, покормив их пшеницей. И если обе овцы были чёрными, то и детёныш будет чёрным."
  ],
  "quest.1A000000000004A7.title": "Чёрная шерсть",
  "quest.1A000000000004A9.quest_desc": [
    "Вы моете использовать его, чтобы делать слитки из маленьких и крошечных кучек пыли, а также из самородков."
  ],
  "quest.1A000000000004A9.title": "Шаблон (Слиток)",
  "quest.1A000000000004AA.quest_desc": [
    "Воспользуйтесь напильником или токарным станком (или MV экструдером, если таковой имеется), чтобы изготовить стальной стержень из стального слитка."
  ],
  "quest.1A000000000004AA.title": "Стальной стержень",
  "quest.1A000000000004AB.quest_desc": [
    "Может быть сделан из двух 1х оловянных проводов."
  ],
  "quest.1A000000000004AB.title": "2х Оловянный провод",
  "quest.1A000000000004AD.quest_desc": [
    "Отличный механизм, способный выполнять полезную работу за вас, к примеру: распиливать древесину на доски, раскраивать пластины на оболочки, расстригать шерсть на ковры, разрезать стержни на болты, и т. д. Всё это он делает эффективнее, чем если бы вы делали это вручную (в большинстве случаев)."
  ],
  "quest.1A000000000004AD.title": "Пильный станок (LV)",
  "quest.1A000000000004B0.quest_desc": [
    "Может быть сделано из стального стержня при помощи молота."
  ],
  "quest.1A000000000004B0.title": "Стальное кольцо",
  "quest.1A000000000004B1.quest_desc": [
    "Используйте три деревянных доски и три блока шерсти, чтобы изготовить кровать. Она даст вам возможность пропускать ночь (если вы играете в одиночку)."
  ],
  "quest.1A000000000004B1.title": "Кровать",
  "quest.1A000000000004B2.quest_desc": [
    "Найдите и убейте несколько овец, чтобы в итоге получить три блока шерсти."
  ],
  "quest.1A000000000004B2.title": "Шерсть (любого цвета)",
  "quest.1A000000000004B3.quest_desc": [
    "Распилите любую древесину при помощи пилы, чтобы получить деревянные плиты."
  ],
  "quest.1A000000000004B3.title": "Деревянная плита",
  "quest.1A000000000004B5.quest_desc": [
    "Разрежьте оловянную пластину кусачками."
  ],
  "quest.1A000000000004B5.title": "1х Оловянный провод",
  "quest.1A000000000004B9.quest_desc": [
    "Разрежьте нужный блок в пильном станке, чтобы получить пластину."
  ],
  "quest.1A000000000004B9.title": "Пластина жёлтого граната",
  "quest.1A000000000004BB.quest_desc": [
    "Быстрее, чем LV, и может работать со всеми рецептами."
  ],
  "quest.1A000000000004BB.title": "Прокатный стан (MV)",
  "quest.1A000000000004BC.quest_desc": [
    "Может быть сделана из кремниевого слитка несколькими способами."
  ],
  "quest.1A000000000004BC.title": "Кремниевая пластина",
  "quest.1A000000000004BD.quest_desc": [
    "Вы можете получить его из кремниевой пыли в обычной печи."
  ],
  "quest.1A000000000004BD.title": "Кремниевый слиток",
  "quest.1A000000000004C1.quest_desc": [
    "Может быть сделан из слитка из HSS-E."
  ],
  "quest.1A000000000004C1.title": "Стержень из HSS-E",
  "quest.1A000000000004C3.quest_desc": [
    "Поместите его в токарный станок (любого уровня), чтобы получить линзу."
  ],
  "quest.1A000000000004C3.title": "Изысканный изумруд",
  "quest.1A000000000004C4.quest_desc": [
    "Разрежьте изумрудный блок в пильном станке, чтобы получить пластину."
  ],
  "quest.1A000000000004C4.title": "Изумрудная пластина",
  "quest.1A000000000004C5.quest_desc": [
    "Спрессуйте 9 изумрудов, чтобы получить изумрудный блок."
  ],
  "quest.1A000000000004C5.title": "Изумрудный блок",
  "quest.1A000000000004C6.quest_desc": [
    "Подготовьте девять изумрудов. Ещё одно требование для этой ветки квестов - наличие токарного станка уровня HV."
  ],
  "quest.1A000000000004C6.title": "Девять изумрудов",
  "quest.1A000000000004C9.quest_desc": [
    "Компонент загрузчика/разгрузчика предметов. Также можно использовать её по прямому назначению."
  ],
  "quest.1A000000000004C9.title": "Воронка",
  "quest.1A000000000004CA.quest_desc": [
    "Необходим для производства хладагента."
  ],
  "quest.1A000000000004CA.title": "Миксер (MV или лучше)",
  "quest.1A000000000004CF.quest_desc": [
    "Сделайте её из досок."
  ],
  "quest.1A000000000004CF.title": "Палка",
  "quest.1A000000000004D1.quest_desc": [
    "Высота для поиска: 20 - 50 жила ВОЛЬФРАМАТА (шеелит, вольфрамат, литиевая руда). Но есть и ещё один способ получить этот достаточно редкий материал. В любом случае, если вы нашли жилу вольфрамата - вам повезло!"
  ],
  "quest.1A000000000004D1.title": "Вольфрамат - удачливый способ",
  "quest.1A000000000004D2.quest_desc": [
    "Вы можете поставить его как покрытие на трубу или входной/выходной люк, чтобы настроить объёмный расход. Отрицательные значения подразумевают, что регулятор закачивает жидкость или газ в блок, на который установлен. Положительные - наоборот, означают откачку жидкости или газа в сторону, куда направлен регулятор. Вы можете настраивать расход, кликая ПКМ пустой рукой или с отвёрткой в руке."
  ],
  "quest.1A000000000004D2.title": "Жидкостный регулятор",
  "quest.1A000000000004D5.quest_desc": [
    "Создайте любой упаковщик уровня от LV до IV включительно. Он способен не только изготавливать LV кабели при помощи ковров, но также объединять крошечные и маленькие кучки пыли в пыль нормального размера. Заметьте, что для этого ему нужен предмет \"Схема (Пыль)\"."
  ],
  "quest.1A000000000004D5.title": "Упаковщик (LV - IV)",
  "quest.1A000000000004D6.quest_desc": [
    "Создайте любой супербуфер уровня от LV до IV включительно. Его инвентарь недоступен для просмотра, но он может хранить в себе большое количество стеков. Но самое главное - он может отдавать предметы в том количестве, которые вы задали (настраивается отвёрткой). Также требует немного энергии для работы. Отличный пример его использования - передача маленьких кучек пыли по 4 штуки или крошечных кучек пыли по 9 штук в упаковщик (со схемой на пыль), чтобы тот собирал их в пыль нормального размера."
  ],
  "quest.1A000000000004D6.title": "Супербуфер (LV - IV)",
  "quest.1A000000000004D7.quest_desc": [
    "Компонент механизма \"жидкостный фильтр\"."
  ],
  "quest.1A000000000004D7.title": "Простой жидкостный фильтр",
  "quest.1A000000000004D8.quest_desc": [
    "Компонент простого жидкостного фильтра. Вы также можете использовать её по прямому назначению - как трубу для передачи жидкостей."
  ],
  "quest.1A000000000004D8.title": "Маленькая медная жидкостная труба",
  "quest.1A000000000004D9.quest_desc": [
    "Используется в тандеме с рудопромывочной машиной для получения простой воды и небольшого количества побочных продуктов. Также можно просто фильтровать воду без побочных продуктов. Используйте запрограммированную схему для выбора режима."
  ],
  "quest.1A000000000004D9.title": "Жидкостный фильтр (LV)",
  "quest.1A000000000004DA.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A000000000004DA.title": "[об] Электромагнитный сепаратор (LV)",
  "quest.1A000000000004DB.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A000000000004DB.title": "[об] Центрифуга (MV)",
  "quest.1A000000000004DC.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A000000000004DC.title": "[об] Центрифуга (HV)",
  "quest.1A000000000004DD.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A000000000004DD.title": "[об] Центрифуга (EV)",
  "quest.1A000000000004DE.quest_desc": [
