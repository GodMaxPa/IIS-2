  ],
  "quest.1A0000000000068E.title": "Титановая пластина",
  "quest.1A0000000000069D.quest_desc": [
    "Дешёвая батарея уровня MV."
  ],
  "quest.1A0000000000069D.title": "Натриевая батарея",
  "quest.1A000000000006A4.quest_desc": [
    "Эти очки позволят вам видеть линии сигналов между двумя связанными сигнальными блоками. Чтобы включить эту функцию, возьмите очки в руку и нажимайте ПКМ до тех пор, пока не увидите в чате надпись \"Текущая аура: Сигнал\". Тогда вы можете надевать их и наблюдать линии сигналов."
  ],
  "quest.1A000000000006A4.title": "Очки обходчика путей",
  "quest.1A000000000006A5.quest_desc": [
    "Компонент некоторых предметов из Railcraft."
  ],
  "quest.1A000000000006A5.title": "Сигнальная схема",
  "quest.1A000000000006A6.quest_desc": [
    "Если расположить два сигнальных блока возле ж/д путей и связать их друг с другом посредством блока сигнальной привязки, то они смогут распознавать стоящие или двигающиеся вагонетки и поезда. Чтобы преобразовать распознавание поезда в красный сигнал, используйте настройщик сигнала на одном из связанных сигнальных блоков, а затем кликните по приёмнику сигнала. После этого, если между связанными сигнальными блоками проедет поезд, то он спровоцирует излучение красного сигнала из привязанного приёмника."
  ],
  "quest.1A000000000006A6.title": "Сигнальный блок",
  "quest.1A000000000006A7.quest_desc": [
    "Устройство, связывающее друг с другом два сигнальных блока."
  ],
  "quest.1A000000000006A7.title": "Блок сигнальной привязки",
  "quest.1A000000000006A8.quest_desc": [
    "Полезный путь для железной дороги, подталкивающий ваш поезд или вагонетку вперёд по направлению движения."
  ],
  "quest.1A000000000006A8.title": "Ускоряющий путь",
  "quest.1A000000000006A9.quest_desc": [
    "Путь, останавливающий и удерживающий вагонетку или поезд до тех пор, пока не получит красный сигнал. Может работать в нескольких режимах - для вагонеток и для поездов. Вы также можете выбрать направление, в котором ускорится вагонетка или поезд, когда на путь будет подан красный сигнал. Для поезда это сработает только в том случае, если выбранное направление совпадает с направлением движения поезда. Чтобы изменить настройки, используйте монтировку."
  ],
  "quest.1A000000000006A9.title": "Замыкающий путь",
  "quest.1A000000000006AA.quest_desc": [
    "Путь, меняющий режим работы поезда. Срабатывает при получении красного сигнала. Чтобы изменить настройки, используйте монтировку."
  ],
  "quest.1A000000000006AA.title": "Локомотивный путь",
  "quest.1A000000000006AB.quest_desc": [
    "Компонент замыкающего пути."
  ],
  "quest.1A000000000006AB.title": "Нажимная плита",
  "quest.1A000000000006AC.quest_desc": [
    "Может быть создана из золотого провода в протяжном стане, либо из золотой фольги при помощи кусачек."
  ],
  "quest.1A000000000006AC.title": "Золотая проволока",
  "quest.1A000000000006AE.quest_desc": [
    "Компонент некоторых предметов из Railcraft."
  ],
  "quest.1A000000000006AE.title": "Сигнальная лампа",
  "quest.1A000000000006AF.quest_desc": [
    "Его можно использовать для получения каучука из латекса, либо для более эффективной вытяжки красителей из цветов. Однако §cнастоятельно рекомендуется§r использовать именно §aцентрифугу§r для производства каучука, так как в этом случае вы также будете получать клей."
  ],
  "quest.1A000000000006AF.title": "Паровой экстрактор",
  "quest.1A000000000006B1.quest_desc": [
    "Подготовьте пластину из лазурита, содалита, либо ляпис-лазури. Используйте компрессор, чтобы сделать блок, а затем распилите его на пластины."
  ],
  "quest.1A000000000006B1.title": "Одна из синих пластин",
  "quest.1A000000000006B2.quest_desc": [
    "Вы можете сделать его из пластины при помощи прокатного стана или молота."
  ],
  "quest.1A000000000006B2.title": "Тонкий лист полиэтилена",
  "quest.1A000000000006B6.quest_desc": [
    "Вы можете сделать его из стальных пластин и молота."
  ],
  "quest.1A000000000006B6.title": "Стальной корпус",
  "quest.1A000000000006B8.quest_desc": [
    "Компонент оловянной электронной лампы."
  ],
  "quest.1A000000000006B8.title": "Железный болт",
  "quest.1A000000000006BA.quest_desc": [
    "Может быть полезен для нескольких рецептов, например, для некоторых слитков из EnderIO. Есть множество способов его получения (см. NEI)."
  ],
  "quest.1A000000000006BA.title": "Пепел",
  "quest.1A000000000006C7.quest_desc": [
    "Высота для поиска: 20 - 50 жила ВОЛЬФРАМАТА (шеелит, вольфрамат, литиевая руда). Но найти её будет сложно, так что вы можете использовать MV+ центрифугу, чтобы разделять лаву на несколько компонентов, среди которых с небольшим шансом могут оказаться маленькие кучки вольфрамата (вероятность 2,5%% на каждые 100 л лавы)."
  ],
  "quest.1A000000000006C7.title": "Шеелит",
  "quest.1A000000000006CB.quest_desc": [
    "Есть несколько способов её изготовления."
  ],
  "quest.1A000000000006CB.title": "Оливиновая линза",
  "quest.1A000000000006CC.quest_desc": [
    "Вам нужно найти девять оливинов."
  ],
  "quest.1A000000000006CC.title": "Оливин",
  "quest.1A000000000006CD.quest_desc": [
    "Вы можете использовать просеиватель, чтобы получить изысканный оливин из промытой измельчённой оливиновой руды."
  ],
  "quest.1A000000000006CD.title": "Изысканный оливин",
  "quest.1A000000000006CF.quest_desc": [
    "Разрежьте блок на пластины в пильном станке."
  ],
  "quest.1A000000000006CF.title": "Оливиновая пластина",
  "quest.1A000000000006D4.quest_desc": [
    "Медь + красная пыль (в печи сплавов) дают на выходе слиток красного сплава. Затем сделайте из него пластину."
  ],
  "quest.1A000000000006D4.title": "Пластина красного сплава",
  "quest.1A000000000006E5.quest_desc": [
    "Используйте EV+ химический реактор, чтобы выделить триоксид вольфрама из вольфрамата или шеелита."
  ],
  "quest.1A000000000006E5.title": "Триоксид вольфрама",
  "quest.1A000000000006E7.quest_desc": [
    "Изготовьте его из стали. Наиболее выгодный способ - в экструдере, с получением двух стержней из одного слитка, затем распиливание стержня в пильном станке для получения четырёх болтов, затем их обработка напильником или на токарном станке. Есть способ изготовить болты напрямую из слитка - в экструдере с соответствующей формой."
  ],
  "quest.1A000000000006E7.title": "Стальной винт",
  "quest.1A000000000006E8.quest_desc": [
    "Большинство видов камня подходят для изготовления каменных кирпичей, которые являются компонентом блоков фермы."
  ],
  "quest.1A000000000006E8.title": "Каменные кирпичи",
  "quest.1A000000000006ED.quest_desc": [
    "Её можно создать из пластины при помощи молота, но если у вас есть MV+ экструдер, то используйте его для изготовления маленьких шестерёнок напрямую из слитков."
  ],
  "quest.1A000000000006ED.title": "Маленькая алюминиевая шестерёнка",
  "quest.1A000000000006EE.quest_desc": [
    "Используйте напильник или токарный станок, чтобы сделать стержень из слитка. Если у вас есть MV+ экструдер, он будет наилучшим выбором для изготовления любых стержней."
  ],
  "quest.1A000000000006EE.title": "Алюминиевый стержень",
  "quest.1A000000000006EF.quest_desc": [
    "Многоблок, позволяющий выплавлять более одного предмета за операцию. Сколько именно - зависит от катушек."
  ],
  "quest.1A000000000006EF.title": "Мультиплавильня",
  "quest.1A000000000006F2.quest_desc": [
    "Лучше, чем большой бронзовый паровой котёл."
  ],
  "quest.1A000000000006F2.title": "Большой стальной паровой котёл",
  "quest.1A000000000006F3.quest_desc": [
    "Лучше, чем большой стальной паровой котёл."
  ],
  "quest.1A000000000006F3.title": "Большой титановый паровой котёл",
  "quest.1A000000000006F4.quest_desc": [
    "Лучше, чем большой титановый паровой котёл."
  ],
  "quest.1A000000000006F4.title": "Большой паровой котёл из вольфрамовой стали",
  "quest.1A000000000006F5.quest_desc": [
    "Фильтрующий корпус механизма необходим в том случае, если вы хотите построить чистую комнату площадью более чем 3 на 3 блока."
  ],
  "quest.1A000000000006F5.title": "Фильтрующий корпус механизма",
  "quest.1A000000000006F7.quest_desc": [
    "Простой способ изготовления маленьких катушек. Другой способ заключается в использовании болтов из никель-цинкового феррита вместо стальных - в этом случае получится больше катушек."
  ],
  "quest.1A000000000006F7.title": "Маленькая катушка - простой способ",
  "quest.1A000000000006FE.quest_desc": [
    "Изготовьте её в протяжном стане из слитка."
  ],
  "quest.1A000000000006FE.title": "Проволока из паяльного сплава",
  "quest.1A00000000000705.quest_desc": [
    "Пока что вы можете делать только по две доски из одного блока древесины в сетке крафта. Но позже вам станут доступны режущие инструменты и механизмы, которые значительно повысят выход досок с блока древесины."
  ],
  "quest.1A00000000000705.title": "Доски",
  "quest.1A0000000000070E.quest_desc": [
    "Нет описания."
  ],
  "quest.1A0000000000070E.title": "Энергетический детектор",
  "quest.1A0000000000070F.quest_desc": [
    "Компонент энергетического детектора."
  ],
  "quest.1A0000000000070F.title": "Ваттметр",
  "quest.1A00000000000711.quest_desc": [
    "Компонент большинства IC Gate. Вы можете получить его из золотого слитка в обычной печи."
  ],
  "quest.1A00000000000711.title": "Золотой самородок",
  "quest.1A0000000000071E.quest_desc": [
    "Пригодится, если найдёте лошадь."
  ],
  "quest.1A0000000000071E.title": "Седло",
  "quest.1A00000000000721.quest_desc": [
    "Изготовьте любой электрический компрессор (LV - IV)."
  ],
  "quest.1A00000000000721.title": "Любой электрический компрессор",
  "quest.1A00000000000726.quest_desc": [
    "Может быть изготовлена из резинового бруска путём обработки его на токарном станке."
  ],
  "quest.1A00000000000726.title": "Резиновая палка",
  "quest.1A00000000000727.quest_desc": [
    "Скрафтить его можно из жидкой резины."
  ],
  "quest.1A00000000000727.title": "Резиновый брусок",
  "quest.1A00000000000729.quest_desc": [
    "Используйте электролизёр, чтобы получить натрий из соли."
  ],
  "quest.1A00000000000729.title": "Натриевая пыль",
  "quest.1A0000000000072A.quest_desc": [
    "Вы можете использовать дробитель уровня HV или выше, чтобы получить крошечную кучку вольфрамовой пыли."
  ],
  "quest.1A0000000000072A.title": "Камень Края",
  "quest.1A0000000000072B.quest_desc": [
    "Создаётся из железных стержней и пластин с помощью ключа."
  ],
  "quest.1A0000000000072B.title": "Железная шестерня",
  "quest.1A0000000000072C.quest_desc": [
    "Обычная каменная кнопка, можно сделать из камня, а камень из булыжника в печке."
  ],
  "quest.1A0000000000072C.title": "Кнопка",
  "quest.1A00000000000733.quest_desc": [
    "Обычная деревянная миска, которую можно изготовить ножом из деревянной доски или на токарном станке из деревянной плиты."
  ],
  "quest.1A00000000000733.title": "Миска",
  "quest.1A0000000000073B.quest_desc": [
    "Блок, который может загружать предметы в тележки или локомотивы (например, уголь). Необходимо размещать над рельсами (вагонетками)."
  ],
  "quest.1A0000000000073B.title": "Погрузчик предметов",
  "quest.1A00000000000741.quest_desc": [
    "Найдите овцу и спросите её, где можно найти шерсть."
  ],
  "quest.1A00000000000741.title": "Шерсть любого цвета",
  "quest.1A00000000000744.title": "Путь Флинтмэна",
  "quest.1A00000000000745.title": "Путь Флинтмэна",
  "quest.1A00000000000746.title": "Путь Флинтмэна",
  "quest.1A00000000000747.title": "Путь Флинтмэна",
  "quest.1A00000000000748.title": "Путь Флинтмэна",
  "quest.1A00000000000749.title": "Путь Флинтмэна",
  "quest.1A0000000000074A.title": "Путь Флинтмэна",
  "quest.1A0000000000074B.title": "Путь Флинтмэна",
  "quest.1A0000000000074C.title": "Путь Флинтмэна",
  "quest.1A0000000000074D.title": "Путь Флинтмэна",
  "quest.1A0000000000074E.title": "Путь Флинтмэна",
  "quest.1A0000000000074F.title": "Путь Флинтмэна",
  "quest.1A00000000000750.title": "Путь Флинтмэна",
  "quest.1A00000000000751.title": "Путь Флинтмэна",
  "quest.1A00000000000752.title": "Путь Флинтмэна",
  "quest.1A00000000000753.title": "Путь Флинтмэна",
  "quest.1A00000000000754.quest_desc": [
    "Поздравляем, Вы - Плюшкин. Поставьте галочку для подтверждения, если Вы согласны с этим утверждением."
  ],
  "quest.1A00000000000754.title": "Путь Флинтмэна",
  "quest.1A0000000000076D.quest_desc": [
    "Обычный лук, позволяющий атаковать на расстоянии"
  ],
  "quest.1A0000000000076D.title": "Лук (не репчатый)",
  "quest.1A0000000000078A.quest_desc": [
    "Блок, который может выгружать предметы из тележек. Необходимо размещать под рельсами (вагонетками)."
  ],
  "quest.1A0000000000078A.title": "Разгрузчик предметов",
  "quest.1A0000000000078B.quest_desc": [
    "Рабочую сторону можно менять щёлкнув ПКМ с красной монтировкой в руке."
  ],
  "quest.1A0000000000078B.title": "Продвинутый погрузчик предметов",
  "quest.1A0000000000078C.quest_desc": [
    "Рабочую сторону можно менять щёлкнув ПКМ с красной монтировкой в руке."
  ],
  "quest.1A0000000000078C.title": "Продвинутый разгрузчик предметов",
  "quest.1A0000000000078D.quest_desc": [
    "Любой красный краситель."
  ],
  "quest.1A0000000000078D.title": "Красный краситель",
  "quest.1A0000000000078E.quest_desc": [
    "Красная монтировка из мода Railcraft может менять активную сторону механизмов или детекторов из этого же мода."
  ],
  "quest.1A0000000000078E.title": "Красная монтировка",
  "quest.1A00000000000793.quest_desc": [
    "Ранний, но нестабильный способ получить Сферу данных. Вы можете использовать один из 3-х изысканных зелёных драгоценных камней с тритием в HV автоклаве, чтобы получить сферу данных с шансом всего 5%."
  ],
  "quest.1A00000000000793.title": "Путь драгоценных камней",
  "quest.1A00000000000799.quest_desc": [
    "Обычная деревянная лестница, по которой можно подняться."
  ],
  "quest.1A00000000000799.title": "Лестница"
}
