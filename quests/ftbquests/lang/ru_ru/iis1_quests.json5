  ],
  "quest.1A000000000003B8.title": "Титановый ротор",
  "quest.1A000000000003B9.quest_desc": [
    "Доступно с: HV.",
    "",
    "Деталь дизельного двигателя (многоблока).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__gear_box_titanium.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003B9.title": "Титановый корпус коробки передач",
  "quest.1A000000000003BA.quest_desc": [
    "Доступно с: HV.",
    "",
    "Деталь дизельного двигателя (многоблока).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__small_gear_titanium.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003BA.title": "Титановая шестерня",
  "quest.1A000000000003BB.quest_desc": [
    "Доступно с: EV.",
    "",
    "Большой двигатель, способный производить энергию, работая на жидком топливе. Требует смазку. При помощи кислорода можно повысить мощность двигателя, в этом случае он будет производить 6144 eu/t (необходим IV динамо-люк).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__combustion_engine.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003BB.title": "Дизельный двигатель",
  "quest.1A000000000003BD.quest_desc": [
    "Доступно с: IV.",
    "",
    "Используется в качестве блока, вырабатывающего энергию в составе многоблочного генератора. Может выдавать до 8192 eu/t без взрыва.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__hatch_dynamo_iv.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003BD.title": "Динамо-люк (IV)",
  "quest.1A000000000003BE.quest_desc": [
    "Доступно с: EV.",
    "",
    "Многоблоки, как правило, производят больше, чем 512 eu/t, так что им необходим как минимум EV динамо-люк.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__hatch_dynamo_ev.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003BE.title": "Динамо-люк (EV)",
  "quest.1A000000000003BF.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Дистиллятор: 3 мБ Креозотовое масло, схема 4. 24 EU/т, 0,8 с.",
    "",
    "Простейший способ получения - дистилляция креозота."
  ],
  "quest.1A000000000003BF.title": "Смазка",
  "quest.1A000000000003C0.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Ранний способ получения - из опилок в жидкостном экстракторе. Информацию о других способах ищите в JEI, как и всегда."
  ],
  "quest.1A000000000003C0.title": "Креозот",
  "quest.1A000000000003C1.quest_desc": [
    "Доступно с: EV.",
    "",
    "Может потреблять большинство видов газообразного топлива, чтобы производить энергию.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__large_gas_turbine.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003C1.title": "Большая газовая турбина",
  "quest.1A000000000003C2.quest_desc": [
    "Доступно с: EV.",
    "",
    "Компонент большого турбинного ротора.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__long_rod_tungsten_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003C2.title": "Длинный стержень из вольфрамовой стали",
  "quest.1A000000000003C3.quest_desc": [
    "Доступно с: EV.",
    "Один из способов: Сборщик: 12 × Алюминиевая лопасть турбины, 1 × Длинный стержень из вольфрамовой стали. 1600 EU/т, 32 с.",
    "",
    "Используется в многоблочных турбинах в качестве расходуемого компонента. Может быть изготовлен из длинного стержня из вольфрамовой стали и 12-ти любых лопастей турбины."
  ],
  "quest.1A000000000003C3.title": "Большой турбинный ротор",
  "quest.1A000000000003C4.quest_desc": [
    "Доступно с: EV.",
    "",
    "Лучше чем модель предыдущего уровня, так как может работать с напряжением 2048 eu/t.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__assembler_ev.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003C4.title": "Сборочный станок (EV)",
  "quest.1A000000000003C5.quest_desc": [
    "Доступно с: MV.",
    "",
    "Компонент большой газовой турбины.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__small_gear_stainless_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003C5.title": "Шестерня из нержавеющей стали",
  "quest.1A000000000003C6.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Может быть изготовлен в протяжном стане из золотого слитка.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_gold_1x.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003C6.title": "Золотой провод",
  "quest.1A000000000003C7.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Смесь пылей золота и меди.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_rose_gold.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003C7.title": "Розовое золото",
  "quest.1A000000000003C8.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Сложная смесь пылей чёрных и цветных металлов.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_blue_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003C8.title": "Пыль синей стали",
  "quest.1A000000000003C9.quest_desc": [
    "Доступно с: MV.",
    "",
    "Компонент турбинного корпуса. Используйте гаечный ключ или сборочный станок, чтобы изготовить каркас из стержней из синей стали.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__frame_blue_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003C9.title": "Каркас из синей стали",
  "quest.1A000000000003CA.quest_desc": [
    "Доступно с: MV.",
    "",
    "Компонент турбины.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__turbine_casing.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003CA.title": "Турбинный корпус",
  "quest.1A000000000003CB.quest_desc": [
    "Доступно с: MV.",
    "",
    "Компонент большой турбины.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__turbine_casing_stainless.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003CB.title": "Турбинный корпус из нержавеющей стали",
  "quest.1A000000000003CC.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Кузнечный молот: 3 × Магналиевый слиток. 16 EU/т, 1,25 с.",
    "",
    "Сплав магния и алюминия. Может быть получен в печи сплавов.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__plate_magnalium.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003CC.title": "Магналиевая пластина",
  "quest.1A000000000003CD.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Может демонтировать резервуары из истинного кварца, не уничтожая хранящуюся в них жидкость.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wrench_iron.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003CD.title": "Гаечный ключ (из BuildCraft)",
  "quest.1A000000000003CE.quest_desc": [
    "Доступно с: EV.",
    "",
    "Основа для всех механизмов уровня EV.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__hull_ev.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003CE.title": "Корпус механизма (EV)",
  "quest.1A000000000003CF.quest_desc": [
    "Доступно с: HV.",
    "Один из способов: Пильный станок: 1 × Монокристалл кремния легированный светопылью, 80 мБ Вода. 64 EU/т, 40 с.",
    "",
    "Воспользуйтесь пильным станком (как минимум уровня MV)."
  ],
  "quest.1A000000000003CF.title": "Кремниевая пластина, легированная светопылью",
  "quest.1A000000000003D0.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Вы можете изготовить его из пустого шаблона.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__mold_casing.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003D0.title": "Шаблон (Оболочка)",
  "quest.1A000000000003D1.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Печь: Константановая пыль",
    "",
    "Сплав меди и никеля. Может быть получен в печи сплавов. Вам нужно подготовить два полных стака медных и никелевых слитков (или пыли), по одному на каждый слиток константана."
  ],
  "quest.1A000000000003D1.title": "Константан",
  "quest.1A000000000003D2.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Используйте протяжный стан, чтобы изготавливать провода с наибольшей эффективностью.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_cupronickel_2x.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003D2.title": "2х Константановый провод",
  "quest.1A000000000003D5.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Токарный станок: 1 × Око Эндера. 16 EU/т, 1,4 с.",
    "",
    "Поместите око Края в токарный станок."
  ],
  "quest.1A000000000003D5.title": "Стержень из ока Края",
  "quest.1A000000000003D6.quest_desc": [
    "Доступно с: MV.",
    "",
    "Используется в качестве компонента для некоторых предметов и механизмов."
  ],
  "quest.1A000000000003D6.title": "Беспроводной приёмник",
  "quest.1A000000000003D7.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Компрессор: 4 × Истинный кварц. 2 EU/т, 20 с.",
    "",
    "Можно получить его, сжав 4 кристалла истинного кварца."
  ],
  "quest.1A000000000003D7.title": "Блок истинного кварца",
  "quest.1A000000000003D8.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Пильный станок: 1 × Блок: Истинный кварц, 91 мБ Вода. 30 EU/т, 98 с.",
    "",
    "Просто разрежьте блок истинного кварца в пильном станке."
  ],
  "quest.1A000000000003D8.title": "Пластина истинного кварца",
  "quest.1A000000000003D9.quest_desc": [
    "Доступно с: HV.",
    "",
    "Продвинутая энергетическая ячейка."
  ],
  "quest.1A000000000003D9.title": "Плотная энергетическая ячейка",
  "quest.1A000000000003DA.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Компрессор: 4 × Незерский кварц. 2 EU/т, 15 с.",
    "",
    "Можно получить его, сжав 4 кристалла кварца."
  ],
  "quest.1A000000000003DA.title": "Кварцевый блок",
  "quest.1A000000000003DB.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Пильный станок: 1 × Кварцевый блок. 30 EU/т, 40 с.",
    "",
    "Просто разрежьте кварцевый блок в пильном станке."
  ],
  "quest.1A000000000003DB.title": "Пластина кварца Нижнего мира",
  "quest.1A000000000003DC.quest_desc": [
    "Доступно с: HV.",
    "",
    "Даёт возможность открывать ваш терминал в определённом радиусе вокруг МЭ беспроводной точки доступа."
  ],
  "quest.1A000000000003DC.title": "Беспроводной терминал",
  "quest.1A000000000003DD.quest_desc": [
    "Доступно с: HV.",
    "",
    "Важное приспособление, которое отправляет в ваш беспроводной терминал информацию о предметах в вашей МЭ-сети."
  ],
  "quest.1A000000000003DD.title": "МЭ беспроводная точка доступа",
  "quest.1A000000000003E0.quest_desc": [
    "Доступно с: HV.",
    "",
    "Это нечто вроде дополнительной сумки. Вы можете класть и забирать оттуда предметы, чтобы сохранять ваш основной инвентарь свободным. Ячейку иногда нужно подзаряжать, чтобы она продолжала работать. Обратите внимание, что существуют ячейки на 2k, 8k, 32k байт."
  ],
  "quest.1A000000000003E0.title": "Переносная ячейка",
  "quest.1A000000000003E1.quest_desc": [
    "Доступно с: HV.",
    "",
    "Многоблоки, как правило, производят больше, чем 512 eu/t, так что им необходим как минимум EV динамо-люк. Как правило, но не всегда. Вы можете использовать его в любом многоблочном генераторе, производящем менее 512 eu/t.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__hatch_dynamo_hv.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003E1.title": "Динамо-люк (HV)",
  "quest.1A000000000003E2.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Вы можете быстро превращать обычное железо в кованое при помощи электродуговой печи, а затем переплавлять её в сталь в доменной печи, затрачивая совсем немного энергии и времени. Но это потом, а сейчас, на раннем этапе развития вам доступен лишь один способ получения кованого железа. Расплавьте железный слиток в печи и получите железные самородки, затем расплавьте их по отдельности и получите самородки кованого железа. Третий шаг - отправить девять самородков в печь сплавов вместе с шаблоном (слиток)."
  ],
  "quest.1A000000000003E2.title": "Самородок кованого железа",
  "quest.1A000000000003E3.quest_desc": [
    "Доступно с: без электричества.",
    "Где искать: Верхний мир, Y 16…64 (жила: Уголь); Верхний мир, Y -56…-32 (жила: Графит); Верхний мир, Y 16…144 (жила: Бурый уголь).",
    "",
    "Вам нужно собрать 40 штук в инвентаре.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_coal.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003E3.title": "Угольная пыль",
  "quest.1A000000000003E4.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Урожай культуры: выращивается на палочках для грядки и выводится скрещиванием",
    "",
    "Отправьте жемчуг Края в дробитель.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_ender_pearl.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003E4.title": "Дроблёный жемчуг Края",
  "quest.1A000000000003E5.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Сборщик: 1 × Дроблёный жемчуг Края, 4 × 1x Осмиевый провод, 4 × Логическая интегральная электросхема. 30 EU/т, 90 с.",
    "",
    "Дорогостоящий компонент некоторых механизмов. Для изготовления необходим осмий."
  ],
  "quest.1A000000000003E5.title": "Генератор поля (LV)",
  "quest.1A000000000003E6.quest_desc": [
    "Доступно с: MV.",
    "",
    "Может клонировать семена с сохранением параметров. Эффективность 60%% означает, что вероятность успешного завершения процесса составляет 60%%. Для работы необходима жидкая материя.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__organic_replicator_lv.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003E6.title": "Органический репликатор (LV)",
  "quest.1A000000000003E7.quest_desc": [
    "Доступно с: MV.",
    "",
    "С помощью этого механизма можно производить жидкую материю из UU-усилителя. Для работы необходимо 8 ампер. Каждый следующий уровень механизма ускоряет процесс производства в два раза, вдвое повышает потребление энергии, но также вдвое снижает необходимое количество ампер.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__massfab_lv.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003E7.title": "Производитель материи (LV)",
  "quest.1A000000000003E8.quest_desc": [
    "Доступно с: LV.",
    "",
    "Этот механизм можно использовать в качестве мусорной корзины, но с полезным свойством: изредка в результате переработки мусорного предмета можно получить утильсырьё. Оно является основным ресурсом для производства UU-усилителя. Другое его применение - создать коробку с утильсырьём, в которой может оказаться какая-нибудь интересная вещь. Существуют исключения, например, булыжник, песок, каменная пыль, стекло, стеклянная пыль и некоторые другие ресурсы - из них нельзя получить утильсырьё.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__recycler_lv.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003E8.title": "Утилизатор (LV)",
  "quest.1A000000000003E9.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Урожай культуры: выращивается на палочках для грядки и выводится скрещиванием",
    "",
    "Может быть получено путём переработки почти любых предметов в утилизаторе."
  ],
  "quest.1A000000000003E9.title": "Утильсырьё",
  "quest.1A000000000003EA.quest_desc": [
    "Доступно с: LV.",
    "",
    "Может производить UU-усилитель из утильсырья или из коробок с утильсырьём.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__amplifab_lv.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003EA.title": "Амплифабрикатор (LV)",
  "quest.1A000000000003EB.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Экстрактор жидкостей: 1 × UUA-ягода. 4 EU/т, 6,4 с.",
    "",
    "Может быть произведён из утильсырья."
  ],
  "quest.1A000000000003EB.title": "UU-усилитель",
  "quest.1A000000000003EC.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Экстрактор жидкостей: 1 × UUM-ягода. 4 EU/т, 6,4 с.",
    "",
    "Может быть сделана из UU-усилителя в производителе материи."
  ],
  "quest.1A000000000003EC.title": "Жидкая материя",
  "quest.1A000000000003EE.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Урожай культуры: выращивается на палочках для грядки и выводится скрещиванием",
    "",
    "Может работать (собирать урожай) в радиусе 11 на 11 (по 5 блоков с каждой стороны), и на три блока в высоту (на том же уровне, блоком выше и блоком ниже).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__crop_harvester.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003EE.title": "Сборщик урожая",
  "quest.1A000000000003EF.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Урожай культуры: выращивается на палочках для грядки и выводится скрещиванием",
    "",
    "Позволяет организовать автоматический полив и внесение удобрений в окружающие растения, чтобы повысить скорость роста. Область работы такая же, как и у сборщика урожая.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__crop_matron.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003EF.title": "Автосадовник",
  "quest.1A000000000003F0.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Отвердитель жидкостей: Шаблон (Шар), 144 мБ Расплавленное боросиликатное стекло. 24 EU/т, 2,2 с.",
    "",
    "Капсула, у которой можно менять объём."
  ],
  "quest.1A000000000003F0.title": "Мерная колба",
  "quest.1A000000000003F1.quest_desc": [
    "Доступно с: MV.",
    "",
    "Воспользуйтесь прокатным станом, чтобы сделать её из слитка",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__plate_electrical_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003F1.title": "Пластина электрической стали",
  "quest.1A000000000003F2.quest_desc": [
    "Доступно с: MV.",
    "",
    "Поместите два таких недалеко друг от друга, встаньте на один из них и зажмите Shift, глядя на второй - и вы станете свидетелем волшебства."
  ],
  "quest.1A000000000003F2.title": "Якорь путешествия",
  "quest.1A000000000003F3.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик: 1 × Бронзовая жидкостная труба, 1 × Незерский кварц, 144 мБ Расплавленное стекло. 30 EU/т, 5 с.",
    "",
    "Нечто вроде трубы со встроенным насосом."
  ],
  "quest.1A000000000003F3.title": "Жидкостная труба",
  "quest.1A000000000003F4.quest_desc": [
    "Доступно с: MV.",
    "",
    "Многоблок, способный выкачивать жидкости из пространства под коренной породой, если, конечно, там не пустота.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__oil_drill_1.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003F4.title": "Нефтекачалка",
  "quest.1A000000000003F5.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Может быть изготовлен из стальных стержней при помощи гаечного ключа.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__frame_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003F5.title": "Стальной каркас",
  "quest.1A000000000003F6.quest_desc": [
    "Доступно с: HV.",
    "",
    "То же, что и обычная, только с повышенным радиусом работы.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__oil_drill_2.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003F6.title": "Нефтекачалка II",
  "quest.1A000000000003F7.quest_desc": [
    "Доступно с: EV.",
    "",
    "То же, что и обычная, но с огромным радиусом работы.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__oil_drill_3.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003F7.title": "Нефтекачалка III",
  "quest.1A000000000003F8.quest_desc": [
    "Доступно с: HV.",
    "",
    "Вы можете использовать этот многоблок, чтобы расщеплять нефть на фракции с помощью пара или водорода.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__oil_cracker.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003F8.title": "Крекер",
  "quest.1A000000000003FB.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Просеиватель: 1 × Промытая измельчённая сапфировая руда. 16 EU/т, 40 с.",
    "",
    "Может быть получен в имплозионном компрессоре из низкоуровневых сапфиров, и даже из сапфировой пыли.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__gem_flawless_sapphire.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003FB.title": "Безупречный сапфир",
  "quest.1A000000000003FD.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Центрифуга: 1 × Липкая смола. 5 EU/т, 15 с.",
    "",
    "Чтобы получить его, просто отправьте латекс в центрифугу."
  ],
  "quest.1A000000000003FD.title": "Клей",
  "quest.1A000000000003FE.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик: 1 × 1x Золотой провод, 144 мБ Жидкая резина, схема 24. 8 EU/т, 5 с.",
    "",
    "Может быть изготовлен в сборочном станке из золотого провода и жидкой резины."
  ],
  "quest.1A000000000003FE.title": "Золотой кабель",
  "quest.1A000000000003FF.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Дробитель: 1 × Лепидолит (глубинный сланец). 2 EU/т, 20 с.",
    "Где искать: Верхний мир, Y 16…32 (жила: Каменная соль); Марс, Y -56…0 (жила: Графит); Верхний мир, Y -56…-32 (жила: Графит).",
    "",
    "А вот низкоуровневый способ - добыть литиевую пыль из лепидолитовой руды. Это сырой источник натрия и лития. Чтобы получить 2 литиевых пыли, вам нужно раздробить 9 блоков лепидолитовой руды и пропустить их через рудопромывочную машину. Это даст вам крошечную кучку литиевой пыли в качестве побочного продукта. Соль нужна для получения натрия через электролизёр. Также для получения литиевой пыли можно перерабатывать сподуменовую руду. В этом случае, чтобы получить литий как побочный продукт, его нужно измельчить, очистить, затем снова измельчить и отправить в центрифугу.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_lithium.png width:120 height:72 align:center}"
  ],
  "quest.1A000000000003FF.title": "Литиевая пыль",
  "quest.1A00000000000400.quest_desc": [
    "Доступно с: LuV.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_naquadah_alloy_4x.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000400.title": "4х Провод из сплава наквадаха",
  "quest.1A00000000000402.quest_desc": [
    "Доступно с: MV.",
    "",
    "Может преобразовывать напряжение из 128 в 512 eu/t или наоборот.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__transformer_mv.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000402.title": "Трансформатор среднего напряжения",
  "quest.1A00000000000403.quest_desc": [
    "Доступно с: EV.",
    "",
    "Может преобразовывать напряжение из 2048 в 8192 eu/t или наоборот.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__transformer_ev.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000403.title": "Экстремальный трансформатор",
  "quest.1A00000000000404.quest_desc": [
    "Доступно с: IV.",
    "",
    "Может преобразовывать напряжение из 2048 в 8192 eu/t или наоборот.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__transformer_iv.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000404.title": "Безумный трансформатор",
  "quest.1A00000000000405.quest_desc": [
    "Доступно с: LuV.",
    "",
    "Может преобразовывать напряжение из 32768 в 131072 eu/t или наоборот.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__transformer_luv.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000405.title": "Абсурдный трансформатор",
  "quest.1A00000000000406.quest_desc": [
    "Доступно с: ZPM.",
    "",
    "Может преобразовывать напряжение из 131072 в 524288 eu/t или наоборот.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__transformer_zpm.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000406.title": "Трансформатор напряжения ZPM",
  "quest.1A00000000000407.quest_desc": [
    "Доступно с: EV.",
    "Один из способов: Пильный станок: 1 × Пластина высокомощных микросхем, 90 мБ Вода. 48 EU/т, 60 с.",
    "",
    "Вы можете получить её, разрезав соответствующую кремниевую вафлю в пильном станке."
  ],
  "quest.1A00000000000407.title": "Высокомощная интегральная электросхема",
  "quest.1A00000000000408.quest_desc": [
    "Доступно с: UV.",
    "",
    "Может преобразовывать напряжение из 524288 в 2147483647 eu/t или наоборот.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__transformer_uv.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000408.title": "Ультимативный трансформатор",
  "quest.1A00000000000409.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Дробитель: 1 × Промытый измельчённый танталит. 2 EU/т, 20 с.",
    "Где искать: Край, Верхний мир, Y -32…-16 (жила: Гроссуляр); Марс, Y -56…0 (жила: Графит); Верхний мир, Y -56…-32 (жила: Графит).",
    "",
    "Ниобиевая пыль является побочным продуктом переработки пирохлора, пиролюзита и танталита.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_niobium.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000409.title": "Ниобиевая пыль",
  "quest.1A0000000000040A.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Аналог оловянного кабеля, но с повышенными потерями энергии. Также компонент ULV механизмов.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__cable_lead_1x.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000040A.title": "Свинцовый кабель",
  "quest.1A0000000000040B.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Аналог оловянного провода, но с повышенными потерями энергии.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_lead_1x.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000040B.title": "Свинцовый провод",
  "quest.1A0000000000040C.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Основа для всех ULV механизмов. Из него можно сделать самые дешёвые входные и выходные люки/шины для ваших многоблоков. Только имейте в виду, что и вместительность у них будет самая низкая.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__hull_ulv.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000040C.title": "Корпус механизма (ULV)",
  "quest.1A0000000000040D.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Может преобразовывать напряжение из 8 в 32 eu/t или наоборот. По умолчанию работает в режиме понижения. Для смены режима нажмите по нему ПКМ с киянкой в руке. Это работает и для всех остальных трансформаторов.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__transformer_ulv.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000040D.title": "Трансформатор сверхнизкого напряжения",
  "quest.1A0000000000040E.quest_desc": [
    "Доступно с: EV.",
    "Один из способов: Сборщик: 8 × Трансформатор (ULV), 4 × Трансформатор (LV), 2 × Трансформатор (MV), 1 × Трансформатор (HV), 1 × Монитор, 4 × Интегральный компьютер. 1920 EU/т, 2,5 с.",
    "",
    "Может преобразовывать напряжение из 8 в 2048 eu/t или наоборот."
  ],
  "quest.1A0000000000040E.title": "Экстремальный настраиваемый трансформатор",
  "quest.1A0000000000040F.quest_desc": [
    "Доступно с: IV.",
    "Один из способов: Сборщик: 1 × Трансформатор (EV), 1 × Настраиваемый трансформатор (EV), 2 × Мейнфрейм на базе интегральных процессоров. 1920 EU/т, 2,5 с.",
    "",
    "Может преобразовывать напряжение из 8 в 8192 eu/t или наоборот."
  ],
  "quest.1A0000000000040F.title": "Безумный настраиваемый трансформатор",
  "quest.1A00000000000410.quest_desc": [
    "Доступно с: LuV.",
    "Один из способов: Сборщик: 1 × Трансформатор (IV), 1 × Настраиваемый трансформатор (IV), 2 × Мейнфрейм на базе нанопроцессоров. 1920 EU/т, 2,5 с.",
    "",
    "Может преобразовывать напряжение из 8 в 32768 eu/t или наоборот."
  ],
  "quest.1A00000000000410.title": "Абсурдный настраиваемый трансформатор",
  "quest.1A00000000000411.quest_desc": [
    "Доступно с: ZPM.",
    "Один из способов: Сборщик: 1 × Трансформатор (LuV), 1 × Настраиваемый трансформатор (LuV), 2 × Мейнфрейм на базе квантовых процессоров. 1920 EU/т, 2,5 с.",
    "",
    "Может преобразовывать напряжение из 8 в 131072 eu/t или наоборот."
  ],
  "quest.1A00000000000411.title": "ZPM настраиваемый трансформатор",
  "quest.1A00000000000412.quest_desc": [
    "Доступно с: UV.",
    "Один из способов: Сборщик: 1 × Трансформатор (ZPM), 1 × Настраиваемый трансформатор (ZPM), 2 × Мейнфрейм на базе кристаллических процессоров. 1920 EU/т, 2,5 с.",
    "",
    "Может преобразовывать напряжение из 8 в 524288 eu/t или наоборот."
  ],
  "quest.1A00000000000412.title": "UV настраиваемый трансформатор",
  "quest.1A00000000000413.quest_desc": [
    "Доступно с: MAX.",
    "Один из способов: Сборщик: 1 × Трансформатор (UV), 1 × Настраиваемый трансформатор (UV), 2 × Биомейнфрейм. 1920 EU/т, 2,5 с.",
    "",
    "Может преобразовывать напряжение из 8 в 2147483647 eu/t или наоборот."
  ],
  "quest.1A00000000000413.title": "MAX настраиваемый трансформатор",
  "quest.1A00000000000414.quest_desc": [
    "Доступно с: HV.",
    "",
    "Может быть изготовлен из обычного титанового стержня.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__long_rod_titanium.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000414.title": "Длинный титановый стержень",
  "quest.1A00000000000415.quest_desc": [
    "Доступно с: HV.",
    "Один из способов: Сборщик: 8 × Алюминиевая лопасть турбины, 1 × Длинный титановый стержень. 400 EU/т, 16 с.",
    "",
    "Воспользуйтесь HV+ сборочным станком, чтобы изготовить турбинный ротор из восьми любых лопастей и длинного титанового стержня."
  ],
  "quest.1A00000000000415.title": "Турбинный ротор (обычного размера)",
  "quest.1A00000000000416.quest_desc": [
    "Доступно с: HV.",
    "",
    "Многоблочный генератор. Требует любого турбинного ротора и оптимального потока пара для работы с наивысшей эффективностью.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__large_steam_turbine.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000416.title": "Большая паровая турбина",
  "quest.1A00000000000417.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Может быть изготовлена в MV+ экструдере.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__pipe_large_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000417.title": "Большая стальная жидкостная труба",
  "quest.1A00000000000418.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Лазерный гравёр: 1 × Монокристаллическая кремниевая пластина, Рубиновая линза. 120 EU/т, 45 с.",
    "",
    "Может быть изготовлена в лазерном гравировщике из кремниевой пластины с помощью рубиновой линзы."
  ],
  "quest.1A00000000000418.title": "Интегральная логическая электросхема (кремниевая вафля)",
  "quest.1A00000000000419.quest_desc": [
    "Доступно с: HV.",
    "Один из способов: Протяжный стан: 1 × Наквадаховый стержень. 4 EU/т, 2,5 с.",
    "",
    "Поместите слиток в протяжный стан.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_naquadah_1x.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000419.title": "Наквадаховый провод",
  "quest.1A0000000000041A.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Печь сплавов: 1 × Магниевая пыль, 2 × Алюминиевая пыль. 16 EU/т, 7,5 с.",
    "",
    "Поместите пыли или слитки алюминия и магния в печь сплавов, чтобы получить магналиевые слитки."
  ],
  "quest.1A0000000000041A.title": "Магналиевый слиток",
  "quest.1A0000000000041B.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Дробитель: 1 × Измельчённая руда зелёного сапфира. 2 EU/т, 20 с.",
    "Где искать: Верхний мир, Y -48…0 (жила: Альмандин); Марс, Y -56…0 (жила: Графит); Верхний мир, Y -56…-32 (жила: Графит).",
    "",
    "Основные жилы (содержащие алюминий в больших количествах): Так как сейчас вы находитесь на уровне LV, вы сможете добыть алюминий только из алюминиевой руды, сапфировой пыли и пыли зелёного сапфира. Но есть и второстепенные жилы (с малой долей алюминия): Алюминий в качестве побочного продукта можно получить из следующих руд: сподумен, альмандин, бентонит, глауконит, изумрудная руда.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_aluminium.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000041B.title": "Алюминиевая пыль",
  "quest.1A0000000000041C.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Используйте экструдер или токарный станок, чтобы изготовить стержни.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__rod_magnalium.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000041C.title": "Магналиевый стержень",
  "quest.1A0000000000041D.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Электрическая доменная печь: 1 × Пыль синей стали. 120 EU/т, 70 с.",
    "",
    "Воспользуйтесь ЭДП, чтобы выплавить слиток."
  ],
  "quest.1A0000000000041D.title": "Слиток синей стали",
  "quest.1A0000000000041E.quest_desc": [
    "Доступно с: MV.",
    "",
    "Используйте MV+ экструдер или токарный станок, чтобы изготовить стержень из слитка.",
