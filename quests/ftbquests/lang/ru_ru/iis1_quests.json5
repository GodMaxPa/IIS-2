  "quest.1A0000000000030E.title": "Ракетный двигатель 1-го уровня",
  "quest.1A0000000000030F.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Позволяет вам не переломать ноги во время приземления.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__parachute.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000030F.title": "Парашют",
  "quest.1A00000000000310.quest_desc": [
    "Доступно с: LV.",
    "",
    "Плиты, из которых состоит стартовая площадка для ракеты. Всего таковых требуется девять.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__launch_pad.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000310.title": "Взлётная площадка",
  "quest.1A00000000000311.quest_desc": [
    "Доступно с: MV.",
    "",
    "Важный механизм, предназначенный для заправки топливного бака ракеты.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__fuel_loader.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000311.title": "Загрузчик топлива",
  "quest.1A00000000000312.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Компрессор: 1 × Слиток смешанного металла. 2 EU/т, 15 с.",
    "",
    "Для получения спрессуйте композитный слиток в компрессоре."
  ],
  "quest.1A00000000000312.title": "Композит",
  "quest.1A00000000000313.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Рецептов много - загляните в JEI и выберите понравившийся.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__mixed_metal_ingot.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000313.title": "Композитный слиток",
  "quest.1A00000000000314.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Наденьте перед полётом на Луну. Но её одной недостаточно, вам также придётся создать парашют, кислородное оборудование и баллон.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__oxygen_mask.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000314.title": "Кислородная маска",
  "quest.1A00000000000315.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Печь сплавов: 1 × Пластина улучшенного сплава, 3 × Стекло. 4 EU/т, 20 с.",
    "",
    "Его можно создать и на верстаке, но лучше воспользоваться печью сплавов."
  ],
  "quest.1A00000000000315.title": "Укреплённое стекло",
  "quest.1A00000000000316.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Отработанный стержень из ядерного реактора",
    "",
    "Компонент кислородной маски. Также является элементом радиационно-защитного костюма."
  ],
  "quest.1A00000000000316.title": "Шлем-акваланг",
  "quest.1A00000000000317.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Гибочный станок: 2 × Сжатое олово, схема 2. 8 EU/т, 10 с.",
    "",
    "Компонент кислородного концентратора."
  ],
  "quest.1A00000000000317.title": "Оловянная канистра",
  "quest.1A00000000000318.quest_desc": [
    "Доступно с: LV.",
    "",
    "Компонент кислородного концентратора.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__air_vent.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000318.title": "Вентиляционный клапан",
  "quest.1A00000000000319.quest_desc": [
    "Доступно с: MV.",
    "",
    "Компонент кислородного концентратора и нескольких механизмов из GC.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__air_fan.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000319.title": "Вентилятор",
  "quest.1A0000000000031A.quest_desc": [
    "Доступно с: MV.",
    "",
    "Кислородный концентратор + две электрических помпы (LV). Его можно носить.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__oxygen_gear.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000031A.title": "Кислородное оборудование",
  "quest.1A0000000000031B.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Экструдер: 1 × Армированное стекло, Форма для экструдера (Маленькая труба). 128 EU/т, 6 с.",
    "",
    "Компонент некоторых механизмов из GC."
  ],
  "quest.1A0000000000031B.title": "Кислородная труба",
  "quest.1A0000000000031C.quest_desc": [
    "Доступно с: MV.",
    "",
    "Собирает кислород из листвы в радиусе пяти блоков. Так что перед полётом на Луну вам нужно будет подготовить и взять с собой несколько важных вещей: блоки земли, мотыгу, съедобные растения (морковь, картофель и т.д.) и любые саженцы деревьев. Также возьмите как минимум стек костной муки, чтобы ускорять процесс роста. Лучше всего расположить деревья и кислородный сборщик по следующей схеме: восемь саженцев квадратом 3 на 3, а кислородный сборщик - в центре, на высоте 5 блоков на поверхностью.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__oxygen_collector.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000031C.title": "Кислородный сборщик",
  "quest.1A0000000000031D.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Имплозионный компрессор: 4 × Алюминиевая пластина, 2 × Динамит. 30 EU/т, 1 с.",
    "",
    "Поместите две алюминиевые пластины в имплозионный компрессор."
  ],
  "quest.1A0000000000031D.title": "Сжатый алюминий",
  "quest.1A0000000000031F.quest_desc": [
    "Доступно с: MV.",
    "",
    "Все эти механизмы требуют кислорода, который нужно закачивать в них напрямую или через кислородные трубы. Различие в том, что распределитель кислородных пузырей не требует закрытого пространства, но потребляет больше кислорода и имеет меньший радиус охвата, чем уплотнитель кислорода. Но в данный момент вам будет достаточно создать всего один распределитель.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__oxygen_distributor.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000031F.title": "Распределитель кислородных пузырей",
  "quest.1A00000000000320.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Компрессор: 1 × Углеткань. 2 EU/т, 15 с.",
    "",
    "Для получения спрессуйте углеткань в компрессоре."
  ],
  "quest.1A00000000000320.title": "Углепластик",
  "quest.1A00000000000321.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Отработанный стержень из ядерного реактора",
    "",
    "Воспользуйтесь сборочным станком любого уровня, чтобы получить углеткань из углеволокна.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__carbon_mesh.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000321.title": "Углеткань",
  "quest.1A00000000000322.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Имплозионный компрессор: 4 × Оловянная пластина, 2 × Динамит. 30 EU/т, 1 с.",
    "",
    "Поместите две оловянные пластины в имплозионный компрессор."
  ],
  "quest.1A00000000000322.title": "Сжатое олово",
  "quest.1A00000000000323.quest_desc": [
    "Доступно с: MV.",
    "",
    "Чтобы заполнить кислородный баллон, вы должны создать и использовать разливочную машину как минимум уровня MV (или лучше)."
  ],
  "quest.1A00000000000323.title": "Разливочная машина (MV+)",
  "quest.1A00000000000324.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Сборщик: 2 × Алмазная пластина, 4 × Покрытая печатная плата, 144 мБ Расплавленный паяльный сплав. 64 EU/т, 80 с.",
    "",
    "Две алмазных пластины, четыре покрытых печатных платы и расплавленный паяльный сплав."
  ],
  "quest.1A00000000000324.title": "Основная полупроводниковая пластина",
  "quest.1A00000000000325.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Компонент HV электрических помп.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__rotor_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000325.title": "Стальной ротор",
  "quest.1A00000000000326.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Поможет в изготовлении кислородной трубы (из Galacticraft).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__shape_extruder_pipe_small.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000326.title": "Форма для экструдера (Маленькая труба)",
  "quest.1A00000000000327.quest_desc": [
    "Доступно с: MV.",
    "",
    "Вы можете сжимать кислород, и носить его при себе в баллонах. Также вам понадобится кислородное оборудование и кислородная маска, чтобы выжить в космосе и на поверхности других планет.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__oxygen_tank_light.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000327.title": "Малый кислородный баллон",
  "quest.1A00000000000328.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Имплозионный компрессор: 4 × Железная пластина, 2 × Динамит. 30 EU/т, 1 с.",
    "",
    "Поместите две железные пластины в имплозионный компрессор."
  ],
  "quest.1A00000000000328.title": "Сжатое железо",
  "quest.1A00000000000329.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Из палок и нитей.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__canvas.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000329.title": "Холст",
  "quest.1A0000000000032A.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Сборщик: 1 × Двойная стальная пластина, 2 × Стальное кольцо. 64 EU/т, 10 с.",
    "",
    "Воспользуйтесь сборочным станком уровня MV+, чтобы изготовить канистру из двойной стальной пластины и двух стальных колец."
  ],
  "quest.1A0000000000032A.title": "Большая стальная жидкостная канистра",
  "quest.1A0000000000032B.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Компонент грузового загрузчика и грузового разгрузчика. Также может использоваться по прямому назначению.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__item_pipe_medium_brass.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000032B.title": "Латунная предметная труба",
  "quest.1A0000000000032C.quest_desc": [
    "Доступно с: MV.",
    "",
    "Компонент грузового загрузчика и грузового разгрузчика.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__chest_buffer_mv.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000032C.title": "Электросундук (MV)",
  "quest.1A0000000000032D.quest_desc": [
    "Доступно с: MV.",
    "",
    "Механизмы из GC, предназначенные для разгрузки или погрузки предметов в ракету. Только не забудьте построить вашу ракету с тремя сундуками, чтобы было куда загружать багаж.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__cargo_loader.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000032D.title": "Грузовой загрузчик/разгрузчик",
  "quest.1A0000000000032E.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Дробитель: 1 × Промытый измельчённый боксит. 2 EU/т, 20 с.",
    "Где искать: Луна, Верхний мир, Y 16…80 (жила: Боксит); Марс, Y -56…0 (жила: Графит); Верхний мир, Y -56…-32 (жила: Графит).",
    "",
    "Загляните в JEI, чтобы узнать способ получения рутиловой пыли из бокситов или ильменита.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_rutile.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000032E.title": "Рутиловая пыль",
  "quest.1A0000000000032F.quest_desc": [
    "Доступно с: HV.",
    "",
    "Замените люк в вашей электрической доменной печи, чтобы получить доступ к рецептам, требующим HV напряжения.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__hatch_energy_hv.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000032F.title": "Энергетический люк (HV)",
  "quest.1A00000000000330.quest_desc": [
    "Доступно с: HV.",
    "Один из способов: Химический реактор: 1 × Рутиловая пыль, 2 × Углеродная пыль, 4000 мБ Хлор. 480 EU/т, 25 с.",
    "",
    "Рутиловая пыль + углерод + хлор в химическом реакторе уровня HV."
  ],
  "quest.1A00000000000330.title": "Тетрахлорид титана",
  "quest.1A00000000000331.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Дробитель: 1 × Магнезит (глубинный сланец). 2 EU/т, 20 с.",
    "Где искать: Край, Верхний мир, Y -48…0 (жила: Бентонит); Марс, Y -56…0 (жила: Графит); Верхний мир, Y -56…-32 (жила: Графит).",
    "",
    "Найдите магнезит и получите из него магниевую пыль.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_magnesium.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000331.title": "Магниевая пыль",
  "quest.1A00000000000332.quest_desc": [
    "Доступно с: MV.",
    "",
    "Это катушка для доменной печи / пиролизной печи / мультиплавильни.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__coil_kanthal.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000332.title": "Канталовая катушка",
  "quest.1A00000000000333.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Сборщик: 2 × quartz fiber, 3 × fluix dust. 96 EU/т, 10 с.",
    "",
    "Основное приспособление для соединения механизмов AE2 друг с другом."
  ],
  "quest.1A00000000000333.title": "МЭ стеклянный кабель",
  "quest.1A00000000000334.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Протяжный стан: 4 × Стержень из истинного кварца. 96 EU/т, 10 с.",
    "",
    "Простейший кабель из AE2, способный передавать лишь АЕ2-энергию (без каналов). Может быть использован для разделения сети."
  ],
  "quest.1A00000000000334.title": "Кварцевое оптическое волокно",
  "quest.1A00000000000335.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Токарный станок: 1 × Кварцит. 16 EU/т, 1 с.",
    "",
    "Воспользуйтесь токарным станком, чтобы изготовить стержень из кварцита."
  ],
  "quest.1A00000000000335.title": "Кварцитовый стержень",
  "quest.1A00000000000336.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Электролизёр: 1 × Истинный кварц. 30 EU/т, 100 с.",
    "",
    "Используйте электролизёр."
  ],
  "quest.1A00000000000336.title": "Заряженный кристалл истинного кварца",
  "quest.1A00000000000337.quest_desc": [
    "Доступно с: MV.",
    "",
    "Лучше, чем обычный сундук, но только если вы знаете, как им пользоваться. Для работы должны соблюдаться два условия: к нему должно быть подведено питание (приёмщик энергии не требуется), и в нём должна быть МЭ ячейка хранения."
  ],
  "quest.1A00000000000337.title": "МЭ сундук",
  "quest.1A00000000000339.quest_desc": [
    "Доступно с: HV.",
    "Один из способов: Сборщик: 2 × Электродвигатель (HV), 6 × Лист силиконовой резины, 1 × 1x Золотой кабель, схема 5. 120 EU/т, 4 с.",
    "",
    "Является компонентом некоторых HV механизмов. Также может применяться по прямому назначению."
  ],
  "quest.1A00000000000339.title": "Конвейерный модуль (HV)",
  "quest.1A0000000000033A.quest_desc": [
    "Доступно с: HV.",
    "Один из способов: Сборщик: 2 × Электродвигатель (HV), 1 × Электропоршень (HV), 2 × Стержень из нержавеющей стали, 1 × Улучшенная электросхема, 3 × 1x Золотой кабель, схема 5. 120 EU/т, 4 с.",
    "",
    "Компонент механизмов уровня HV."
  ],
  "quest.1A0000000000033A.title": "Роборука (HV)",
  "quest.1A0000000000033B.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Печь: Изумрудная руда (глубинный сланец)",
    "Где искать: Край, Верхний мир, Y -56…-16 (жила: Бериллиевая руда).",
    "",
    "Есть небольшой шанс найти измельчённую изумрудную руду из вкрапления. Затем вы можете просеять её, чтобы получить изумруд.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/minecraft__emerald.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000033B.title": "Изумруд",
  "quest.1A0000000000033C.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Разборочный станок: 1 × Мультиметр. 16 EU/т, 120 с.",
    "",
    "...для просмотра некоторой информации."
  ],
  "quest.1A0000000000033C.title": "Монитор",
  "quest.1A0000000000033D.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Сборщик: 4 × fluix smart cable, схема 24. 96 EU/т, 10 с.",
    "",
    "Может передавать до 32-х каналов."
  ],
  "quest.1A0000000000033D.title": "МЭ плотный кабель",
  "quest.1A0000000000033E.quest_desc": [
    "Доступно с: HV.",
    "",
    "Лучше, чем предыдущие модели.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__assembler_hv.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000033E.title": "Сборочный станок (HV)",
  "quest.1A0000000000033F.quest_desc": [
    "Доступно с: HV.",
    "",
    "Лучше, чем предыдущие модели. Может изготавливать электросхемы вплоть до уровня IV.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__circuit_assembler_hv.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000033F.title": "Сборщик микросхем (HV)",
  "quest.1A00000000000340.quest_desc": [
    "Доступно с: LV.",
    "",
    "Основание для электросхем типа \"мейнфрейм\".",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__frame_aluminium.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000340.title": "Алюминиевый каркас",
  "quest.1A00000000000341.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Протяжный стан: 1 × Слиток отожжённой меди. 4 EU/т, 5 с.",
    "",
    "Используйте протяжный стан...",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_annealed_copper_1x.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000341.title": "Провод из отожжённой меди",
  "quest.1A00000000000342.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Отвердитель жидкостей: Шаблон (Пластина), 144 мБ Расплавленный галлий. 8 EU/т, 1,6 с.",
    "",
    "Создайте её в прокатном стане.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__plate_gallium.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000342.title": "Галлиевая пластина",
  "quest.1A00000000000343.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Сборщик: 4 × Платиновая проволока, 1 × Маленькая кучка галлиевой пыли, 288 мБ Расплавленный полиэтилен. 120 EU/т, 20 с.",
    "",
    "Компонент для создания электросхем."
  ],
  "quest.1A00000000000343.title": "SMD-диод",
  "quest.1A00000000000344.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Создайте её в прокатном стане.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_fine_platinum.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000344.title": "Платиновая проволока",
  "quest.1A00000000000345.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Отвердитель жидкостей: Шаблон (Слиток), 144 мБ Расплавленный кантал. 8 EU/т, 1,6 с.",
    "",
    "Чтобы охладить горячий канталовый слиток, используйте вакуумный морозильник."
  ],
  "quest.1A00000000000345.title": "Канталовый слиток",
  "quest.1A00000000000346.quest_desc": [
    "Доступно с: LV.",
    "",
    "Используйте прессы для высекателя, чтобы изготавливать в формовочном прессе отпечатанные контуры. Чтобы завершить этот квест, достаточно будет создать любой формовочный пресс уровня от LV до IV.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__forming_press_mv.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000346.title": "Формовочный пресс",
  "quest.1A00000000000347.quest_desc": [
    "Доступно с: HV.",
    "Один из способов: Электрическая доменная печь: 2 × Магниевая пыль, 1000 мБ Тетрахлорид титана. 480 EU/т, 40 с.",
    "",
    "Это побочный продукт производства титановых слиток. Что вам с ним делать? Поместите его в химический реактор HV+ с натрием, чтобы получить обратно часть ресурсов.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_magnesiumchloride.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000347.title": "Хлорид магния",
  "quest.1A00000000000348.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Лучше, чем обычный сундук."
  ],
  "quest.1A00000000000348.title": "Медный сундук",
  "quest.1A00000000000349.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Отличный прибор для отладки всего, что вас окружает. Это самый важный инструмент при работе с растениями, позволяющий замерять показатели роста и отбирать образцы с наилучшими параметрами для дальнейшего скрещивания. В отличие от анализатора агрокультур, сканер может показывать параметры растения в процессе его роста, и для этого ему не нужны семена. Таким образом, портативный сканер оказывает неоценимую помощь в проведении скрещивания и ускоряет вашу работу.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__multimeter.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000349.title": "Портативный сканер",
  "quest.1A0000000000034A.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Разборочный станок: 1 × Мультиметр. 16 EU/т, 120 с.",
    "",
    "MV батарея."
  ],
  "quest.1A0000000000034A.title": "Литиевая батарея",
  "quest.1A0000000000034B.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Экстрактор: 1 × Литиевая батарея. 2 EU/т, 15 с.",
    "",
    "Используется в качестве контейнера для MV батареи.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__battery_hull_mv.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000034B.title": "Корпус батареи",
  "quest.1A0000000000034C.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Урожай культуры: выращивается на палочках для грядки и выводится скрещиванием",
    "",
    "Токсичная быть может быть получена переработкой некоторых токсичных материалов в дробителе.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__grin_powder.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000034C.title": "Токсичная пыль",
  "quest.1A0000000000034E.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Урожай культуры: выращивается на палочках для грядки и выводится скрещиванием",
    "",
    "Используется для того, чтобы предотвратить появление сорняков.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__weed_ex.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000034E.title": "Средство от сорняков",
  "quest.1A0000000000034F.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Автоклав: 1 × Семя истинного кварца, 200 мБ Дистиллированная вода. 24 EU/т, 50 с.",
    "",
    "В некоторых рецептах дешевле использовать чистый кристалл истинного кварца, нежели обычный."
  ],
  "quest.1A0000000000034F.title": "Чистый кристалл истинного кварца",
  "quest.1A00000000000350.quest_desc": [
    "Доступно с: MV.",
    "",
    "Катушка уровня #3, которую можно использовать в постройке ЭДП.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__coil_nichrome.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000350.title": "Нихромовая катушка",
  "quest.1A00000000000351.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Отвердитель жидкостей: Шаблон (Слиток), 144 мБ Расплавленный нихром. 8 EU/т, 1,6 с.",
    "",
    "Используйте хромовый и никелевый слитки, чтобы создать новый сплав - нихром. В этом вам поможет ЭДП."
  ],
  "quest.1A00000000000351.title": "Нихромовый слиток",
  "quest.1A00000000000353.quest_desc": [
    "Доступно с: без электричества.",
    "Где искать: Край, Луна, Верхний мир, Y -32…16 (жила: Шеелит); Марс, Y -56…0 (жила: Графит); Верхний мир, Y -56…-32 (жила: Графит).",
    "",
    "Но найти её будет непросто, поэтому можно набрать лавы и отправить её в MV+ центрифугу, чтобы разделить на фракции, среди которых с небольшим шансом (2,5%% на каждые 100 л) может оказаться маленькая кучка вольфрамата.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_tungstate.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000353.title": "Вольфрамат",
  "quest.1A00000000000354.quest_desc": [
    "Доступно с: MV.",
    "",
    "Лучше, чем базовая.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__centrifuge_mv.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000354.title": "Центрифуга (MV)",
  "quest.1A00000000000355.quest_desc": [
    "Доступно с: EV.",
    "",
    "Если вы хотите получить его в экструдере, вам потребуется таковой уровня HV или выше.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__rod_tungsten_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000355.title": "Стержень из вольфрамовой стали",
  "quest.1A00000000000356.quest_desc": [
    "Доступно с: EV.",
    "Один из способов: Вакуумный морозильник: 1 × Горячий вольфрамовый слиток. 120 EU/т, 27,45 с.",
    "",
    "Воспользуйтесь ЭДП с нихромовыми кольцами."
  ],
  "quest.1A00000000000356.title": "Вольфрамовый слиток",
  "quest.1A00000000000357.quest_desc": [
    "Доступно с: EV.",
    "Один из способов: Химический реактор: 6 × Шеелит, 4000 мБ Соляная кислота. 1920 EU/т, 5 с.",
    "",
    "Используйте EV+ химический реактор, чтобы выделить вольфрамовую кислоту из вольфрама или шеелита.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_tungstig_acid.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000357.title": "Вольфрамовая кислота",
  "quest.1A00000000000359.quest_desc": [
    "Доступно с: EV.",
    "",
    "Может использоваться в качестве компонента катушки.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_tungsten_steel_2x.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000359.title": "2х Провод из вольфрамовой стали",
  "quest.1A0000000000035A.quest_desc": [
    "Доступно с: EV.",
    "",
    "Рецепт тот, же, что и для катушек предыдущих уровней, только в качестве основного материала используются слитки HSS-G.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__coil_hssg.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000035A.title": "Катушка из HSS-G",
  "quest.1A0000000000035B.quest_desc": [
    "Доступно с: EV.",
    "",
    "Может использоваться в качестве компонента катушки.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_hssg_2x.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000035B.title": "2х Провод из HSS-G",
  "quest.1A0000000000035C.quest_desc": [
    "Доступно с: EV.",
    "Один из способов: Сборщик: 1 × 1x Вольфрамовый провод, 1 × Вольфрамовая фольга, 72 мБ Расплавленная силиконовая резина, схема 24. 8 EU/т, 5 с.",
    "",
    "Фольга из полифениленсульфида + жидкая силиконовая резина (маленькая кучка, расплавленная в MV+ жидкостном экстракторе) + маленькая кучка поливинилхлорида. Чтобы изготовить кабель на 8 кВ из провода на 8 кВ, используйте сборочный станок."
  ],
  "quest.1A0000000000035C.title": "Вольфрамовый кабель",
  "quest.1A0000000000035D.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Дробитель: 1 × Молибденит (глубинный сланец). 2 EU/т, 20 с.",
    "Где искать: Край, Верхний мир, Y -32…0 (жила: Вульфенит); Марс, Y -56…0 (жила: Графит); Верхний мир, Y -56…-32 (жила: Графит).",
    "",
    "Крайне редкая жила. Есть другой способ получения молибдена - как побочный продукт переработки шеелита или вольфрамовой руды.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__dust_molybdenum.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000035D.title": "Молибденовая пыль",
  "quest.1A0000000000035E.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Сборщик: 16 × 1x Провод из отожжённой меди, схема 16. 8 EU/т, 25 с.",
    "",
    "Компонент электродвигателей уровня IV.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__wire_annealed_copper_16x.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000035E.title": "16х Провод из отожжённой меди",
  "quest.1A0000000000035F.quest_desc": [
    "Доступно с: EV.",
    "",
    "Может быть изготовлен из стержней из вольфрамовой стали.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__frame_tungsten_steel.png width:120 height:72 align:center}"
  ],
  "quest.1A0000000000035F.title": "Каркас из вольфрамовой стали",
  "quest.1A00000000000360.quest_desc": [
    "Доступно с: HV.",
    "",
    "Используйте титановые стержни для изготовления каркаса.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__frame_titanium.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000360.title": "Титановый каркас",
  "quest.1A00000000000361.quest_desc": [
    "Доступно с: EV.",
    "",
    "Контроллер замечательного многоблока, который позволяет вам отдыхать вместо того, чтобы копать руды. Но чтобы этот механизм мог брать на себя вашу работу по добыче полезных ископаемых, его нужно снабжать буровыми трубами и буровым раствором.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__ore_drill_1.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000361.title": "Большая буровая установка",
  "quest.1A00000000000362.quest_desc": [
    "Доступно с: IV.",
    "",
    "Контроллер замечательного многоблока, который позволяет вам отдыхать вместо того, чтобы копать руды. Но чтобы этот механизм мог брать на себя вашу работу по добыче полезных ископаемых, его нужно снабжать буровыми трубами и буровым раствором.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__ore_drill_2.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000362.title": "Большая буровая установка II",
  "quest.1A00000000000363.quest_desc": [
    "Доступно с: UV.",
    "Один из способов: Сборочная линия: 16 × Нейтрониевая пластина, 1 × Биомейнфрейм, 1 × Биомейнфрейм, 1 × Биомейнфрейм, 1 × Биомейнфрейм, 8 × Энергетический кластер, 2 × Генератор поля (UV), 64 × Биопроцессор, 64 × Биопроцессор, 16 × SMD-диод, 32 × 1x Сверхпроводящий провод, Энергетический кластер, 2880 мБ Расплавленный паяльный сплав, 16000 мБ Хладагент, 1152 мБ Расплавленная наквадрия. 300000 EU/т, 100 с.",
    "",
    "Требует очень много нейтрония... Может быть создана в сборочной линии с UV энергетическим люком. И кстати, не пытайтесь зарядить её полностью, так как на это уйдёт несколько тысяч лет =)"
  ],
  "quest.1A00000000000363.title": "Ультимативная батарея",
  "quest.1A00000000000364.quest_desc": [
    "Доступно с: UV.",
    "Один из способов: Сборочная линия: 1 × Нейтрониевый каркас, 6 × Нейтрониевая пластина, 1 × Грави-звезда, 4 × Излучатель (UV), 64 × Мейнфрейм на базе нанопроцессоров, 64 × Осмиевая проволока, 64 × Осмиевая проволока, 64 × Осмиевая проволока, 64 × Осмиевая проволока, 64 × Осмиевая проволока, 64 × Осмиевая проволока, 64 × Осмиевая проволока, 64 × Осмиевая проволока, 8 × 4x Кабель из ниобия-титана, Генератор поля (ZPM), 2304 мБ Расплавленный паяльный сплав. 100000 EU/т, 30 с.",
    "",
    "Может быть создан в сборочной линии с ZPM энергетическим люком."
  ],
  "quest.1A00000000000364.title": "Генератор поля (UV)",
  "quest.1A00000000000365.quest_desc": [
    "Доступно с: UV.",
    "Один из способов: Сборочная линия: 4 × Тританиевый каркас, 8 × Биосуперкомпьютер, 4 × Маленькая катушка, 24 × SMD-конденсатор, 64 × SMD-резистор, 32 × SMD-транзистор, 16 × SMD-диод, 16 × Чип произвольного выбора, 32 × 1x Сверхпроводящий провод, 64 × Тонкий лист силиконовой резины, Биосуперкомпьютер, 2880 мБ Расплавленный паяльный сплав, 10000 мБ Хладагент. 300000 EU/т, 100 с.",
    "",
    "Электросхема уровня MAX."
  ],
  "quest.1A00000000000365.title": "Биомейнфрейм",
  "quest.1A00000000000366.quest_desc": [
    "Доступно с: UV.",
    "Один из способов: Отвердитель жидкостей: Шаблон (Пластина), 144 мБ Расплавленный нейтроний. 8 EU/т, 1,6 с.",
    "",
    "Используйте прокатный стан, как и всегда. Либо жидкостный формовщик, если можете сравнить время производства.",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__plate_neutronium.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000366.title": "Нейтрониевая пластина",
  "quest.1A00000000000367.quest_desc": [
    "Доступно с: UV.",
    "Один из способов: Сборочная линия: 1 × Нейтрониевый каркас, 1 × Излучатель (ZPM), 2 × Излучатель (LuV), 4 × Излучатель (IV), 7 × Мейнфрейм на базе нанопроцессоров, 64 × Осмиридиевая фольга, 64 × Осмиридиевая фольга, 64 × Осмиридиевая фольга, 7 × 4x Кабель из ниобия-титана, Излучатель (ZPM), 576 мБ Расплавленный паяльный сплав. 100000 EU/т, 30 с.",
    "",
    "Может быть создан в сборочной линии с ZPM энергетическим люком."
  ],
  "quest.1A00000000000367.title": "Излучатель (UV)",
  "quest.1A00000000000368.quest_desc": [
    "Доступно с: UV.",
    "",
    "Из стержней при помощи гаечного ключа или сборочного станка (с запрограммированной микросхемой #4).",
    "",
    "Рецепт на верстаке:",
    "{image:iis:textures/quest_recipe/iis__frame_neutronium.png width:120 height:72 align:center}"
  ],
  "quest.1A00000000000368.title": "Нейтрониевый каркас",
  "quest.1A00000000000369.quest_desc": [
    "Доступно с: UV.",
    "Один из способов: Автоклав: 1 × Звезда Незера, 288 мБ Расплавленный нейтроний. 7680 EU/т, 24 с.",
    "",
    "Залейте 288 л (два слитка) расплавленного нейтрония в автоклав уровня IV+, и положите туда адскую звезду."
  ],
  "quest.1A00000000000369.title": "Грави-звезда",
  "quest.1A0000000000036A.quest_desc": [
    "Доступно с: UV.",
    "Один из способов: Отвердитель жидкостей: Шаблон (Слиток), 144 мБ Расплавленный нейтроний. 8 EU/т, 1,6 с.",
    "",
    "Отличный материал для изготовления мотыги... Ладно, это шутка."
  ],
  "quest.1A0000000000036A.title": "Нейтрониевый слиток",
  "quest.1A0000000000036B.quest_desc": [
    "Доступно с: UV.",
    "Один из способов: Токарный станок: 1 × Нейтрониевый слиток. 16 EU/т, 25000 с.",
    "",
    "В токарном станке или экструдере. Только пожалуйста, не используйте напильник =)",
    "",
    "Рецепт на верстаке:",
