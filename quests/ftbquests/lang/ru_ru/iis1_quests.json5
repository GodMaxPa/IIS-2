  "quest.1A000000000000E1.title": "Логическая интегральная электросхема",
  "quest.1A000000000000E2.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Печь сплавов: 9 × Оловянная пыль, 1 × Сурьмяная пыль. 16 EU/т, 25 с.",
    "",
    "Расплавьте 9 оловянных слитков и 1 слиток сурьмы в печи сплавов, чтобы получить 10 слитков паяльного сплава."
  ],
  "quest.1A000000000000E2.title": "Слиток паяльного сплава",
  "quest.1A000000000000E3.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик микросхем: 1 × Фенольная печатная плата, 3 × Логическая интегральная электросхема, 4 × Резистор, 8 × Золотая проволока, 72 мБ Расплавленный паяльный сплав. 16 EU/т, 20 с.",
    "",
    "Электросхема уровня MV, которую можно улучшить до уровня HV. Может быть создана в сборщике микросхем. Все подробности в JEI."
  ],
  "quest.1A000000000000E3.title": "Хорошая интегральная электросхема",
  "quest.1A000000000000E4.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Сборщик: 1 × Кремниевая пластина, 6 × Оловянная проволока, 144 мБ Расплавленный полиэтилен. 24 EU/т, 4 с.",
    "",
    "Компонент электросхем."
  ],
  "quest.1A000000000000E4.title": "Транзистор",
  "quest.1A000000000000E5.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Отвердитель жидкостей: Шаблон (Пластина), 144 мБ Расплавленный полиэтилен. 8 EU/т, 1,6 с.",
    "",
    "Один из самых востребованных компонентов для создания электросхем и многих химических процессов."
  ],
  "quest.1A000000000000E5.title": "Лист полиэтилена",
  "quest.1A000000000000E6.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Просеиватель: 1 × Промытая измельчённая руда зелёного сапфира. 16 EU/т, 40 с.",
    "Где искать: Верхний мир, Y -48…0 (жила: Альмандин).",
    "",
    "Для начала найдите жилу сапфировой руды. Затем получите изысканный зелёный сапфир, пропустив промытую измельчённую руду зелёного сапфира через просеиватель."
  ],
  "quest.1A000000000000E6.title": "Изысканный зелёный сапфир",
  "quest.1A000000000000E7.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Лазерный гравёр: 1 × Монокристаллическая кремниевая пластина, Линза из зелёного сапфира. 120 EU/т, 45 с.",
    "",
    "Ещё один тип кремниевой вафли."
  ],
  "quest.1A000000000000E7.title": "Чип произвольного выбора (кремниевая вафля)",
  "quest.1A000000000000E8.quest_desc": [
    "Доступно с: MV.",
    "Один из способов: Пильный станок: 1 × Чип произвольного выбора (Кремниевая вафля), 90 мБ Вода. 48 EU/т, 60 с.",
    "",
    "Чип RAM, часто используемый для создания электросхем."
  ],
  "quest.1A000000000000E8.title": "Чип произвольного выбора",
  "quest.1A000000000000EA.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Печь: Электрумовая пыль",
    "",
    "Сплав серебра и золота (используйте печь сплавов)."
  ],
  "quest.1A000000000000EA.title": "Электрумовый слиток",
  "quest.1A000000000000EB.quest_desc": [
    "Доступно с: без электричества.",
    "Один из способов: Печь: gold_block",
    "",
    "Найдите золотую руду в жиле магнетита и расплавьте её, чтобы получить слитки. Также можно встретить вкрапления золотой руды. Грязная золотая пыль тоже может быть переплавлена в золотой слиток."
  ],
  "quest.1A000000000000EB.title": "Золотой слиток",
  "quest.1A000000000000EC.quest_desc": [
    "Доступно с: LV.",
    "Один из способов: Разборочный станок: 1 × Мультиметр. 16 EU/т, 120 с.",
    "",
    "Электросхема уровня HV."
  ],
  "quest.1A000000000000EC.title": "Продвинутая электросхема",
  "quest.1A000000000000ED.quest_desc": [
    "Доступно с: без электричества.",
    "",
    "Используйте протяжный стан...",
    "",
