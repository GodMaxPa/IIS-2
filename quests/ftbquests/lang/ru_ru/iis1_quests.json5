  "chapter.1D00000000000020.title": "Б. плазм. генератор",
  "chapter.1D00000000000021.title": "Project Red",
  "chapter.1D00000000000022.title": "[Перечень наград]",
  "quest.1A00000000000000.quest_desc": [
    "Компонент некоторых механизмов уровня IV."
  ],
  "quest.1A00000000000000.title": "Электрическая помпа (IV)",
  "quest.1A00000000000001.quest_desc": [
    "Необходимо для IV-помпы."
  ],
  "quest.1A00000000000001.title": "Кольцо из бутадиен-стирольного каучука",
  "quest.1A00000000000002.quest_desc": [
    "Необходимо для помп уровня IV и выше."
  ],
  "quest.1A00000000000002.title": "Кольцо из силиконовой резины",
  "quest.1A00000000000003.quest_desc": [
    "Компонент IV-помпы."
  ],
  "quest.1A00000000000003.title": "Жидкостная труба из вольфрамовой стали",
  "quest.1A00000000000004.quest_desc": [
    "Компонент IV-помпы."
  ],
  "quest.1A00000000000004.title": "Ротор из вольфрамовой стали",
  "quest.1A00000000000005.quest_desc": [
    "Компонент IV-помпы."
  ],
  "quest.1A00000000000005.title": "Винт из вольфрамовой стали",
  "quest.1A00000000000006.quest_desc": [
    "Можно создать из слитков стали и вольфрама."
  ],
  "quest.1A00000000000006.title": "Слиток вольфрамовой стали",
  "quest.1A00000000000007.quest_desc": [
    "Используйте любой химический реактор, чтобы получить жидкий каучук из сырого каучука. Затем при помощи формовщика можно отлить из него пластины. Они могут служить компонентом для конвейерных модулей уровня IV+."
  ],
  "quest.1A00000000000007.title": "Пластина бутадиен-стирольного каучука",
  "quest.1A00000000000008.quest_desc": [
    "Получите расплавленную силиконовую резину, соединив серу и полидиметилсилоксан - и отлейте из неё пластины."
  ],
  "quest.1A00000000000008.title": "Пластина силиконовой резины",
  "quest.1A00000000000011.quest_desc": [
    "Высокотехнологичный сенсор."
  ],
  "quest.1A00000000000011.title": "Сенсор (LuV)",
  "quest.1A00000000000017.quest_desc": [
    "Те же компоненты, что и для остальных помп, только винт, ротор и труба из других материалов."
  ],
  "quest.1A00000000000017.title": "Электрическая помпа (EV)",
  "quest.1A00000000000018.quest_desc": [
    "Может быть создан из стержней из HSS-G при помощи гаечного ключа либо сборочного станка."
  ],
  "quest.1A00000000000018.title": "Каркас из HSS-G",
  "quest.1A00000000000019.quest_desc": [
    "Компонент некоторых HV механизмов."
  ],
  "quest.1A00000000000019.title": "Сенсор (HV)",
  "quest.1A0000000000001A.quest_desc": [
    "Это замечательный многоблок! Вам придётся использовать его для создания компонентов уровня LuV, таких как электродвигатели, электропоршни и т. д. А ещё его очень сложно построить, если вы делаете это впервые. Сложнее только постройка термоядерного реактора."
  ],
  "quest.1A0000000000001A.title": "Сборочная линия",
  "quest.1A0000000000001B.quest_desc": [
    "Компонент некоторых EV механизмов."
  ],
  "quest.1A0000000000001B.title": "Сенсор (EV)",
  "quest.1A0000000000001C.quest_desc": [
    "Пластины вольфрамовой стали, осмиевый стержень, око Края и электросхема уровня IV - не так уж и сложно."
  ],
  "quest.1A0000000000001C.title": "Сенсор (IV)",
  "quest.1A0000000000001D.quest_desc": [
    "Компонент HV механизмов."
  ],
  "quest.1A0000000000001D.title": "Излучатель (HV)",
  "quest.1A0000000000001E.quest_desc": [
    "Может быть создан из слитка при помощи токарного станка или экструдера."
  ],
  "quest.1A0000000000001E.title": "Платиновый стержень",
  "quest.1A0000000000001F.quest_desc": [
    "Чтобы получить титановые слитки, вам придётся построить электрическую доменную печь с канталовыми катушками и HV энергетическим люком (или лучше)."
  ],
  "quest.1A0000000000001F.title": "Титановый слиток",
  "quest.1A00000000000020.quest_desc": [
    "Выпадает со странников Края."
  ],
  "quest.1A00000000000020.title": "Жемчуг Края",
  "quest.1A00000000000021.quest_desc": [
    "Высота для поиска: 40-50 жила ПЛАТИНЫ (шелдонит, палладиевая руда, платиновая руда и иридиевая руда). Вы также можете заглянуть в NEI и поискать другие способы получения платины."
  ],
  "quest.1A00000000000021.title": "Платина",
  "quest.1A00000000000022.quest_desc": [
    "Может быть создан из осмиевого слитка при помощи токарного станка или экструдера."
  ],
  "quest.1A00000000000022.title": "Осмиевый стержень",
  "quest.1A00000000000023.quest_desc": [
    "Чтобы выплавить слиток из пыли, используйте ЭДП с нихромовыми (или лучше) катушками."
  ],
  "quest.1A00000000000023.title": "Осмиевый слиток",
  "quest.1A00000000000026.quest_desc": [
    "Создайте линзу из изысканного самоцвета при помощи токарного станка."
  ],
  "quest.1A00000000000026.title": "Линза из жёлтого граната",
  "quest.1A0000000000002A.quest_desc": [
    "Подготовьте девять синих самоцветов следующих видов: сапфир, опал, синий топаз."
  ],
  "quest.1A0000000000002A.title": "Девять синих самоцветов",
  "quest.1A0000000000002C.quest_desc": [
    "Дешёвая альтернатива алмазной линзе. Вы можете сделать её из стеклянной пластины. Смотрите рецепт в NEI."
  ],
  "quest.1A0000000000002C.title": "Стеклянная линза",
  "quest.1A0000000000002D.quest_desc": [
    "Поместите изысканный самоцвет в токарный станок."
  ],
  "quest.1A0000000000002D.title": "Алмазная линза",
  "quest.1A0000000000002F.quest_desc": [
    "Поместите изысканный самоцвет в токарный станок."
  ],
  "quest.1A0000000000002F.title": "Линза из зелёного сапфира",
  "quest.1A00000000000040.quest_desc": [
    "Высота для поиска: 40 - 80 жила КВАРЦА (Кварцит, барит, истинный кварц). Истинный кварц - это важный материал для многих механизмов из АЕ2."
  ],
  "quest.1A00000000000040.title": "Истинный кварц",
  "quest.1A00000000000042.quest_desc": [
    "Помимо скорости работы, основное отличие от дробителя предыдущего уровня - возможность получать побочные продукты."
  ],
  "quest.1A00000000000042.title": "Дробитель (HV)",
  "quest.1A00000000000046.quest_desc": [
    "Смесь жемчуга Края и огненного порошка."
  ],
  "quest.1A00000000000046.title": "Око Края",
  "quest.1A00000000000047.quest_desc": [
    "Это просто раздробленный стержень ифрита."
  ],
  "quest.1A00000000000047.title": "Огненный порошок",
  "quest.1A00000000000048.quest_desc": [
    "Катись в ад, ублюдок! Простите, я лишь хотел сказать, что вам нужно отправиться в Нижний мир, отыскать там ифрита и выбить из него стержни."
  ],
  "quest.1A00000000000048.title": "Стержень ифрита",
  "quest.1A0000000000004A.quest_desc": [
    "Компрессор, как ни странно, компрессует :)"
  ],
  "quest.1A0000000000004A.title": "Компрессор",
  "quest.1A0000000000004B.quest_desc": [
    "Используйте пильный станок, чтобы разрезать блок на пластины."
  ],
  "quest.1A0000000000004B.title": "Пластина ока Края",
  "quest.1A00000000000056.quest_desc": [
    "Разве это нормально - создавать одну пластину из двух слитков при помощи ручного молота? Конечно же нет! Выгодно ли тратить три слитка на создание двух пластин в паровом молоте? Уже лучше, но с прокатным станом вы сможете создавать пластины в пропорции 1 к 1-му. Одна пластина из одного слитка."
  ],
  "quest.1A00000000000056.title": "Прокатный стан (LV)",
  "quest.1A00000000000057.quest_desc": [
    "Найдите или создайте (в имплозионном компрессоре из пыли) девять жёлтых гранатов."
  ],
  "quest.1A00000000000057.title": "Жёлтый гранат (самоцвет)",
  "quest.1A00000000000058.quest_desc": [
    "Помогает просеивать промытую руду любых самоцветов, чтобы получать большие самоцветы с небольшим шансом. Кроме того, это более выгодный способ переработки руды."
  ],
  "quest.1A00000000000058.title": "Просеиватель (LV)",
  "quest.1A00000000000059.quest_desc": [
    "Вы можете получить его с помощью просеивателя из промытой измельчённой руды. Другой способ - сжатие более мелких самоцветов или даже пыли в имплозионном компрессоре."
  ],
  "quest.1A00000000000059.title": "Изысканный синий самоцвет",
  "quest.1A00000000000060.quest_desc": [
    "Используйте токарный станок, чтобы создать стержень из кварца Нижнего мира."
  ],
  "quest.1A00000000000060.title": "Стержень из кварца Нижнего мира",
  "quest.1A00000000000061.quest_desc": [
    "Используйте токарный станок, чтобы создать стержень из истинного кварца."
  ],
  "quest.1A00000000000061.title": "Стержень из истинного кварца",
  "quest.1A00000000000062.quest_desc": [
    "Вы можете получить его с помощью просеивателя из промытой измельчённой руды. Другой способ - сжатие более мелких самоцветов или даже пыли в имплозионном компрессоре."
  ],
  "quest.1A00000000000062.title": "Изысканный жёлтый гранат",
  "quest.1A00000000000066.quest_desc": [
    "Палка + красная пыль."
  ],
  "quest.1A00000000000066.title": "Красный факел",
  "quest.1A00000000000067.quest_desc": [
    "Цепочка квестов на красную пыль. Высота для поиска: 10 - 40 жила КРАСНОЙ ПЫЛИ (красная пыль, рубиновая руда и киноварь)."
  ],
  "quest.1A00000000000067.title": "Настоящая красная пыль",
  "quest.1A0000000000006A.quest_desc": [
    "Медь + красная пыль (в печи сплавов) дают на выходе слиток красного сплава. Затем сделайте из него пластину."
  ],
  "quest.1A0000000000006A.title": "Пластина красного сплава",
  "quest.1A00000000000072.quest_desc": [
    "С этим многоблоком можно производить сталь быстрее. Также вы сможете плавить прочие тугоплавкие металлы. Для первого запуска на уровне LV, используйте три LV энергетических люка - подключите к ним батарейный буфер как минимум с пятью LV батарейками, чтобы отдавать 5 ампер (посредством 8х оловянного кабеля). Либо же можете использовать только два LV энергетических люка с батарейным буфером с минимум двумя LV батарейками, напрямую подключённым к каждому люку. Имейте в виду, что на уровне LV высоки потери энергии, так что не прокладывайте слишком длинные кабели (во всех случаях)."
  ],
  "quest.1A00000000000072.title": "Электрическая доменная печь",
  "quest.1A00000000000073.quest_desc": [
    "Может демонтировать механизмы из Gregtech, соединять или разъединять трубы, задавать направление потока газа или пара."
  ],
  "quest.1A00000000000073.title": "Гаечный ключ (Gregtech)",
  "quest.1A00000000000074.quest_desc": [
    "Используйте прокатный стан."
  ],
  "quest.1A00000000000074.title": "Пластина вольфрамовой стали",
  "quest.1A00000000000075.quest_desc": [
    "Вы можете изготовить её из пластины при помощи молота. Но если у вас есть MV+ экструдер, используйте его для производства маленьких шестерёнок напрямую из слитков."
  ],
  "quest.1A00000000000075.title": "Маленькая шестерёнка из вольфрамовой стали",
  "quest.1A00000000000076.quest_desc": [
    "Тот же рецепт, что и для электропоршней предыдущих уровней, только основной материал - вольфрамовая сталь."
  ],
  "quest.1A00000000000076.title": "Электропоршень (IV)",
  "quest.1A00000000000077.quest_desc": [
    "Тот же рецепт, что и для роборук предыдущих уровней, но с использованием компонентов уровня IV."
  ],
  "quest.1A00000000000077.title": "Роборука (IV)",
  "quest.1A00000000000078.quest_desc": [
    "Каркас механизма из вольфрамовой стали."
  ],
  "quest.1A00000000000078.title": "Каркас механизма (IV)",
  "quest.1A00000000000079.quest_desc": [
    "Корпус для всех механизмов уровня IV."
  ],
  "quest.1A00000000000079.title": "Корпус механизма (IV)",
  "quest.1A0000000000007A.quest_desc": [
    "Часть СЛ (сборочной линии). Для создания необходимы: MV электродвигатель, стальной ротор, стальной каркас и железные прутья."
  ],
  "quest.1A0000000000007A.title": "Решётчатый корпус механизма",
  "quest.1A0000000000007B.quest_desc": [
    "Для создания нужно подготовить: 6 электросхем уровня EV, одну электросхему уровня IV, каркас из вольфрамовой стали и IV электродвигатель."
  ],
  "quest.1A0000000000007B.title": "Собирающий корпус механизма",
  "quest.1A0000000000007C.quest_desc": [
    "Для создания нужно подготовить: 4 стальные пластины, две IV роборуки, каркас из вольфрамовой стали, и кое-какие инструменты (молот и гаечный ключ)."
  ],
  "quest.1A0000000000007C.title": "Корпус сборочной линии",
  "quest.1A0000000000007D.quest_desc": [
    "Для выполнения рецептов сборочной линии вам понадобится как минимум энергетический люк уровня IV."
  ],
  "quest.1A0000000000007D.title": "Энергетический люк (IV)",
  "quest.1A0000000000007F.quest_desc": [
    "Двигатель для механизмов уровня MV."
  ],
  "quest.1A0000000000007F.title": "Электродвигатель (MV)",
  "quest.1A00000000000080.quest_desc": [
    "Компонент некоторых механизмов уровня IV."
  ],
  "quest.1A00000000000080.title": "Электродвигатель (IV)",
  "quest.1A00000000000081.quest_desc": [
    "Высота для поиска: 40 - 50 жила ПЛАТИНЫ (шелдонит, палладиевая руда, платиновая руда, иридиевая руда), 10 - 40 жила ТАЛЬКОХЛОРИТА (талькохлорит, тальк, глауконит, пентландит), 10 - 40 жила НИКЕЛЯ (гарниерит, никелевая руда, кобальтин, пентландит), 10 - 30 жила МЕДИ (халькопирит, железная руда, пирит, медная руда). Все эти жилы являются источниками осмия. Просто переработайте иридиевую руду, пентландит или халькопирит так, чтобы получить осмий в качестве побочного продукта."
  ],
  "quest.1A00000000000081.title": "Осмиевая пыль",
  "quest.1A00000000000083.quest_desc": [
    "Чтобы получить гелий из монацита, используйте жидкостный экстрактор уровня MV и выше."
  ],
  "quest.1A00000000000083.title": "Гелий",
  "quest.1A00000000000084.quest_desc": [
    "Энергетический люк уровня EV - может потреблять до 2048 eU/t."
  ],
  "quest.1A00000000000084.title": "Энергетический люк (EV)",
  "quest.1A00000000000085.quest_desc": [
    "Чтобы выплавить иридиевый слиток из пыли, используйте ЭДП с нихромовыми катушками (или лучше)."
  ],
  "quest.1A00000000000085.title": "Иридиевый слиток",
  "quest.1A00000000000086.quest_desc": [
    "Есть как минимум два способа их применения: 1) ПКМ по сейсмическому разведчику после того, как он завершит работу; 2) Использование в качестве хранилища информации по рецептам сборочной линии."
  ],
  "quest.1A00000000000086.title": "Флешка",
  "quest.1A00000000000087.quest_desc": [
    "Конечно, для сканирования можно использовать и LV сканер, но на вашем уровне индустриального развития разница в энергопотреблении будет не так значительна, зато с каждым новым уровнем сканера скорость его работы возрастает вдвое. Так или иначе, чтобы завершить квест, создайте сканер любого уровня от LV до IV."
  ],
  "quest.1A00000000000087.title": "Сканер",
  "quest.1A00000000000089.quest_desc": [
    "Компонент высокотехнологичных механизмов."
  ],
  "quest.1A00000000000089.title": "Излучатель (MV)",
  "quest.1A0000000000008A.quest_desc": [
    "Компонент высокотехнологичных механизмов."
  ],
  "quest.1A0000000000008A.title": "Сенсор (MV)",
  "quest.1A0000000000008C.quest_desc": [
    "Для создания необходима сборочная линия. Но перед этим нужно отсканировать мотор предыдущего уровня (IV) при помощи сканера, чтобы записать данные о нём на флешку, которая потом будет использоваться сборочной линией при создании LuV двигателя."
  ],
  "quest.1A0000000000008C.title": "Электродвигатель (LuV)",
  "quest.1A0000000000008D.quest_desc": [
    "Есть несколько способов его изготовления, воспользуйтесь NEI."
  ],
  "quest.1A0000000000008D.title": "Длинный намагниченный неодимовый стержень",
  "quest.1A0000000000008E.quest_desc": [
    "Компонент LuV электродвигателя."
  ],
  "quest.1A0000000000008E.title": "Длинный стержень из HSS-G",
  "quest.1A0000000000008F.quest_desc": [
    "Используйте протяжный стан..."
  ],
  "quest.1A0000000000008F.title": "Проволока из отожжённой меди",
  "quest.1A00000000000090.quest_desc": [
    "Используйте ту же изоляцию, что и для других кабелей уровня IV и выше."
  ],
  "quest.1A00000000000090.title": "Кабель из иттрия-бария-меди",
  "quest.1A00000000000092.quest_desc": [
    "Электросхема уровня LuV."
  ],
  "quest.1A00000000000092.title": "Мейнфрейм на базе нанопроцессоров",
  "quest.1A00000000000093.quest_desc": [
    "Используйте поляризатор уровня HV, чтобы намагнитить неодимовый стержень. Неодимовый слиток должен быть получен в ЭДП, так как его выплавка в обычной печи невозможна."
  ],
  "quest.1A00000000000093.title": "Намагниченный неодимовый стержень",
  "quest.1A00000000000094.quest_desc": [
    "Чтобы выплавить слиток HSS-G из пыли, используйте ЭДП с катушками из вольфрамовой стали."
  ],
  "quest.1A00000000000094.title": "Слиток HSS-G",
  "quest.1A00000000000095.quest_desc": [
    "Её можно получить из обычного медного слитка в ЭДП в присутствии кислорода, либо в электродуговой печи."
  ],
  "quest.1A00000000000095.title": "Отожжённая медь",
  "quest.1A00000000000096.quest_desc": [
    "Чтобы выплавить слиток ИБМ из пыли, используйте ЭДП с катушками из вольфрамовой стали."
  ],
  "quest.1A00000000000096.title": "Слиток иттрия-бария-меди",
  "quest.1A00000000000097.quest_desc": [
    "Для создания смеси, подготовьте пыль следующих металлов: иттрий (1), медь (3) и барий (2)."
  ],
  "quest.1A00000000000097.title": "Пыль иттрия-бария-меди",
  "quest.1A00000000000098.quest_desc": [
    "Высота для поиска: 40 - 80 жила КВАРЦА (кварцит, барит, истинный кварц). Вы можете получать её как побочный продукт переработки руд кварцита и истинного кварца."
  ],
  "quest.1A00000000000098.title": "Бариевая пыль",
  "quest.1A00000000000099.quest_desc": [
    "Вам нужно отцентрифугировать пыль редкоземельных элементов, которую можно получить как побочный продукт от переработки следующих руд: красная пыль, бастнезит, неодимовая руда, монацит. Высота для поиска: 20 - 40 жила МОНАЦИТА (бастнезит, монацит, неодимовая руда), 10 - 40 жила КРАСНОЙ ПЫЛИ (красная пыль, рубиновая руда, киноварь)."
  ],
  "quest.1A00000000000099.title": "Иттриевая пыль",
  "quest.1A0000000000009B.quest_desc": [
    "Получите стальные слитки из железных слитков с древесным углём или блоками древесного угля."
  ],
  "quest.1A0000000000009B.title": "Первая сталь.",
  "quest.1A0000000000009C.quest_desc": [
    "Вам необязательно создавать её прямо сейчас, но она понадобится в будущем. Просто разрежьте алмазный блок в пильном станке."
  ],
  "quest.1A0000000000009C.title": "Алмазная пластина",
  "quest.1A0000000000009E.quest_desc": [
    "Может быть создана из слитка HSS-G с помощью прокатного стана."
  ],
  "quest.1A0000000000009E.title": "Пластина HSS-G",
  "quest.1A0000000000009F.quest_desc": [
    "Слиток HSS-G -> стержень -> болт -> винт."
  ],
  "quest.1A0000000000009F.title": "Винт из HSS-G",
  "quest.1A000000000000A0.quest_desc": [
    "Слиток HSS-G -> пластина -> маленькая шестерёнка (с помощью молота)."
  ],
  "quest.1A000000000000A0.title": "Маленькая шестерёнка из HSS-G",
  "quest.1A000000000000A1.quest_desc": [
    "Изготавливается в EV+ сборочном станке из МФЭХ, EV сенсора и продвинутого теплообменника с добавлением расплавленного паяльного сплава."
  ],
  "quest.1A000000000000A1.title": "Заряжающий лазуротроновый кристалл",
  "quest.1A000000000000A2.quest_desc": [
    "Этот провод может выдержать любое напряжение, но он ограничен по силе тока, как и другие провода. Загляните в NEI, чтобы найти и применить один из восьми рецептов его создания."
  ],
  "quest.1A000000000000A2.title": "Сверхпроводящий провод",
  "quest.1A000000000000A3.quest_desc": [
    "Чтобы создать слиток оловянного сплава, вам нужно сплавить олово с железом в соотношении 1 к 1 в печи сплавов. Затем сделайте из слитка пластину с помощью прокатного стана."
  ],
  "quest.1A000000000000A3.title": "Оловянный сплав",
  "quest.1A000000000000A4.quest_desc": [
    "Высота для поиска: 10 - 40 жила ЖЕЛЕЗНОЙ РУДЫ (коричневый лимонит, жёлтый лимонит, руда полосчатого железа, малахит) или 50 - 120 жила МАГНЕТИТА (магнетит, железная руда, ванадий-магнетит) или 10 - 30 жила МЕДИ (халькопирит, железная руда, пирит, медная руда). Найдите и расплавьте магнетит/лимонит/полосчатое железо/железную руду, чтобы получить железный слиток. Имейте в виду, что киркой 1-го уровня (каменной или кремневой) вы сможете добыть только коричневый лимонит. Для добычи других руд потребуется кирка как минимум 2-го уровня. Ещё один способ получить железо - выкопать вкрапление железной руды."
  ],
  "quest.1A000000000000A4.title": "Железо",
  "quest.1A000000000000A5.quest_desc": [
    "Высота для поиска: 40 - 120 жила ОЛОВА (касситерит, оловянная руда). Расплавьте оловянную руду, чтобы получить оловянный слиток. Также вы можете расплавить грязную оловянную пыль, которую можно добыть из вкрапления оловянной руды."
  ],
  "quest.1A000000000000A5.title": "Олово",
  "quest.1A000000000000A6.quest_desc": [
    "Высота для поиска: 5 - 30 жила БЕРИЛЛИЯ (бериллиевая руда, изумрудная руда, ториевая руда). Используйте обычную печь, чтобы получить слиток, затем создайте пластину с помощью прокатного стана."
  ],
  "quest.1A000000000000A6.title": "Бериллий",
  "quest.1A000000000000A7.quest_desc": [
    "Создайте печь, чтобы плавить руды или готовить пищу. Внимание! Некоторые квесты содержат две награды: фиксированную и еще одну на выбор. Ту что на выбор, вы можете забрать в нижней части этого окна, щелкнув стрелку вправо."
  ],
  "quest.1A000000000000A7.title": "Первая печь",
  "quest.1A000000000000A8.quest_desc": [
    "Применяется в атомной энергетике."
  ],
  "quest.1A000000000000A8.title": "Отражатель нейтронов",
  "quest.1A000000000000A9.quest_desc": [
    "Применяется в атомной энергетике."
  ],
  "quest.1A000000000000A9.title": "Утолщённый отражатель нейтронов",
  "quest.1A000000000000AA.quest_desc": [
    "... с помощью молота или прокатного стана."
  ],
  "quest.1A000000000000AA.title": "Двойная бериллиевая пластина",
  "quest.1A000000000000AB.quest_desc": [
    "С её помощью можно расширить рабочую зону ядерного реактора."
  ],
  "quest.1A000000000000AB.title": "Реакторная камера",
  "quest.1A000000000000AC.quest_desc": [
    "Это сложно устроенный многоблок. Он может состоять из блока-контроллера и не более чем шести реакторных камер (с каждой из сторон реактора)."
  ],
  "quest.1A000000000000AC.title": "Ядерный реактор",
  "quest.1A000000000000AD.quest_desc": [
    "Роборука уровня EV."
  ],
  "quest.1A000000000000AD.title": "Роборука (EV)",
  "quest.1A000000000000AE.quest_desc": [
    "Высота для поиска: 20 - 30 жила УРАНА (уранинит, руда урана-238), 10 - 40 жила НАСТУРАНА (настуран, уранинит)."
  ],
  "quest.1A000000000000AE.title": "Урановый слиток",
  "quest.1A000000000000B0.quest_desc": [
    "Используйте печь сплавов, чтобы получить это топливо из шести урановых слитков и трёх самородков урана-235."
  ],
  "quest.1A000000000000B0.title": "Обогащённое урановое ядерное топливо",
  "quest.1A000000000000B1.quest_desc": [
    "Высота для поиска: 20 - 30. Вы можете получать уран-235 в качестве побочного продукта только из уранинита и руды урана-238."
  ],
  "quest.1A000000000000B1.title": "Самородок урана-235",
  "quest.1A000000000000B2.quest_desc": [
    "Для начала вам нужно создать железный или бронзовый наконечник кирки. Затем объедините его с палкой, чтобы сделать кирку второго уровня. Она может добывать большинство руд из Gregtech (но не все). Позже вы сможете создать кирку 3-го уровня из §9кобальта §fили §bалмазов§f."
  ],
  "quest.1A000000000000B2.title": "Кирка 2-го уровня",
  "quest.1A000000000000B3.quest_desc": [
    "Поместите ОУЯТ в пустой топливный стержень при помощи консервной машины."
  ],
  "quest.1A000000000000B3.title": "Топливный стержень (Уран)",
  "quest.1A000000000000B4.quest_desc": [
    "Вы можете создать его в экструдере из железного слитка с применением формы. Либо же используйте прокатный стан с запрограммированной микросхемой с конфигурацией 2."
  ],
  "quest.1A000000000000B4.title": "Топливный стержень (пустой)",
  "quest.1A000000000000B6.quest_desc": [
    "Поместите три ториевых пыли в пустой топливный стержень с помощью консервной машины."
  ],
  "quest.1A000000000000B6.title": "Топливный стержень (торий)",
  "quest.1A000000000000B7.quest_desc": [
    "Высота для поиска: 5 - 30. Её можно найти в жиле бериллиевой руды. Другой способ получения - как побочный продукт переработки угольной руды, монацитовой руды, уранинита, настурана (ищите в NEI)."
  ],
  "quest.1A000000000000B7.title": "Ториевая пыль",
  "quest.1A000000000000B8.quest_desc": [
    "Подготовьте как минимум три пыли, чтобы создать цикл между печью и химическим реактором для производства газа радона."
  ],
  "quest.1A000000000000B8.title": "Пыль плутония-239",
  "quest.1A000000000000B9.quest_desc": [
    "Один из двух материалов для синтеза америция."
  ],
  "quest.1A000000000000B9.title": "Лютециевая пыль",
  "quest.1A000000000000BA.quest_desc": [
    "Этот лист - важный компонент большинства низкоуровневых конвейерных модулей."
  ],
  "quest.1A000000000000BA.title": "Резиновый лист",
  "quest.1A000000000000BB.quest_desc": [
    "Используйте химический реактор любого уровня для производства радона из трёх слитков плутония-239."
  ],
  "quest.1A000000000000BB.title": "Радон",
  "quest.1A000000000000BC.quest_desc": [
    "Используйте химический реактор уровня HV или выше, чтобы получить индиевый концентрат из промытого измельчённого галенита и промытого измельчённого сфалерита в реакции с серной кислотой."
  ],
  "quest.1A000000000000BC.title": "Индиевый концентрат",
  "quest.1A000000000000BD.quest_desc": [
    "Высота для поиска галенита (Верхний мир): 30 - 60. Высота для поиска сфалерита (Нижний мир): 5 - 20. Высота для поиска фосфорной руды (Верхний мир): 40 - 60."
  ],
  "quest.1A000000000000BD.title": "Комплекс руд",
  "quest.1A000000000000BF.quest_desc": [
    "Получить его можно только как побочный продукт переработки кобальтина."
  ],
  "quest.1A000000000000BF.title": "Мышьяковый слиток",
  "quest.1A000000000000C0.quest_desc": [
    "Высота для поиска: 10 - 40 жила НИКЕЛЯ (гарниерит, кобальтин, пентландит, никелевая руда). Вы сможете создать кобальтовую кирку, которой можно добывать даже алмазы. Чтобы получить кобальтовый слиток из кобальтина, нужно поместить его в вашу примитивную доменную печь вместе с углём или древесным углём. Либо же можно отправить кобальтин сразу в обычную печь (но это неэффективно). Во втором случае вы получите один слиток с блока руды вместо двух в случае применения дробителя и примитивной доменной печи."
  ],
  "quest.1A000000000000C0.title": "Кобальтин",
  "quest.1A000000000000C1.quest_desc": [
    "Это око Края после промывки с радоном в химической ванне."
  ],
  "quest.1A000000000000C1.title": "Квантовое око",
  "quest.1A000000000000C2.quest_desc": [
    "Смешайте пыли индия, галлия и фосфора."
  ],
  "quest.1A000000000000C2.title": "Пыль фосфида индия-галлия",
  "quest.1A000000000000C3.quest_desc": [
    "Используйте ЕV+ химический реактор для получения крошечной кучки индиевой пыли из индиевого концентрата и алюминиевой пыли."
  ],
  "quest.1A000000000000C3.title": "Индиевая пыль",
  "quest.1A000000000000C4.quest_desc": [
    "Химический реактор уровня EV."
  ],
  "quest.1A000000000000C4.title": "Химический реактор (EV)",
  "quest.1A000000000000C5.quest_desc": [
    "Химическая ванна уровня HV."
  ],
  "quest.1A000000000000C5.title": "Химическая ванна (HV)",
  "quest.1A000000000000C6.quest_desc": [
    "Может применяться в качестве компонента некоторых HV механизмов."
  ],
  "quest.1A000000000000C6.title": "Электрическая помпа (HV)",
  "quest.1A000000000000C7.quest_desc": [
    "Базовый компонент для создания электросхем от EV до ZPM."
  ],
  "quest.1A000000000000C7.title": "Блок обработки QBit (Кремниевая вафля)",
  "quest.1A000000000000C8.quest_desc": [
    "Базовый компонент для создания электросхем уровней HV и выше."
  ],
  "quest.1A000000000000C8.title": "Нанокомпонентный ЦП (Кремниевая вафля)",
  "quest.1A000000000000C9.quest_desc": [
    "Часть многоблока \"Обрабатывающий массив\"."
  ],
  "quest.1A000000000000C9.title": "Прочный корпус из вольфрамовой стали",
  "quest.1A000000000000CA.quest_desc": [
    "Этот многоблок позволяет рациональнее использовать рабочее пространство. Кроме того, вы получаете в распоряжение всю мощь шестнадцати одновременно работающих механизмов Gregtech. Учитывайте, что его необходимо снабжать энергией, достаточной для питания всех используемых механизмов. К примеру, если вы поместите в него 16 LV электролизёров для разложения воды на газы, вам потребуется 480 EU/t и энергетический люк уровня HV или выше (30 EU/t * 16 = 480 EU/t)."
  ],
  "quest.1A000000000000CA.title": "Обрабатывающий массив",
  "quest.1A000000000000CB.quest_desc": [
    "Батарея под напряжение 8к eu/t"
  ],
  "quest.1A000000000000CB.title": "Лазуротроновая энергетическая сфера",
  "quest.1A000000000000CD.quest_desc": [
    "... из слитка при помощи прокатного стана."
  ],
  "quest.1A000000000000CD.title": "Европиевая пластина",
  "quest.1A000000000000CF.quest_desc": [
    "Может быть создана с помощью сборочной линии."
  ],
  "quest.1A000000000000CF.title": "Роборука (LuV)",
  "quest.1A000000000000D0.quest_desc": [
    "Вы можете получить его из дейтерия, который, в свою очередь, может быть получен из водорода."
  ],
  "quest.1A000000000000D0.title": "Тритий",
  "quest.1A000000000000D1.quest_desc": [
    "Вы можете получить его из водорода."
  ],
  "quest.1A000000000000D1.title": "Дейтерий",
  "quest.1A000000000000D3.quest_desc": [
    "Залейте воду в электролизёр, либо же найдите другой способ получения."
  ],
  "quest.1A000000000000D3.title": "Водород",
  "quest.1A000000000000D4.quest_desc": [
    "Для её получения необходим термоядерный реактор 1-го уровня."
  ],
  "quest.1A000000000000D4.title": "Гелиевая плазма",
  "quest.1A000000000000D5.quest_desc": [
    "Чтобы создать этот блок-контроллер, воспользуйтесь сборочной линией. Также вам нужно подготовить прочие интерфейсы (все люки должны быть как минимум уровня LuV). Необходимые предметы: катушка термоядерного реактора / четыре ZPM электросхемы (по одной на каждую входную шину сборочной линии) / пластина плутония-241 / пластина адской звезды / два генератора поля (IV) / 32 высокомощные интегральные электросхемы (кремниевые вафли) / 20 расплавленных слитков паяльного сплава (2880 л для входного люка). Также понадобится сборочная линия длиной как минимум в 11 блоков."
  ],
  "quest.1A000000000000D5.title": "Блок управления термоядерным реактором I",
  "quest.1A000000000000D6.quest_desc": [
    "Для её производства нужен термоядерный реактор 1-го уровня."
  ],
  "quest.1A000000000000D6.title": "Кислородная плазма",
  "quest.1A000000000000D7.quest_desc": [
    "Для её производства нужен термоядерный реактор 2-го уровня."
  ],
  "quest.1A000000000000D7.title": "Серная плазма",
  "quest.1A000000000000D8.quest_desc": [
    "Для её производства нужен термоядерный реактор 2-го уровня."
  ],
  "quest.1A000000000000D8.title": "Азотная плазма",
  "quest.1A000000000000D9.quest_desc": [
    "Высота для поиска: 50 - 60 жила СОЛИ (каменная соль, соль, лепидолит, сподумен)."
  ],
  "quest.1A000000000000D9.title": "Каменная соль",
  "quest.1A000000000000DA.quest_desc": [
    "Для её производства нужен термоядерный реактор 3-го уровня."
  ],
  "quest.1A000000000000DA.title": "Железная плазма",
  "quest.1A000000000000DC.quest_desc": [
    "Используйте электролизёр, чтобы получить калий из каменной соли."
  ],
  "quest.1A000000000000DC.title": "Калиевая пыль",
  "quest.1A000000000000DD.quest_desc": [
    "Для её производства нужен термоядерный реактор 3-го уровня."
  ],
  "quest.1A000000000000DD.title": "Никелевая плазма",
  "quest.1A000000000000DE.quest_desc": [
    "Лучше, чем обычная LV электросхема. Таким образом, вы можете использовать её для создания электросхем уровня MV и даже HV."
  ],
  "quest.1A000000000000DE.title": "Логическая интегральная электросхема",
  "quest.1A000000000000DF.quest_desc": [
    "Подложка для электронных микросхем."
  ],
  "quest.1A000000000000DF.title": "Монокристаллическая кремниевая пластина",
  "quest.1A000000000000E0.quest_desc": [
    "Просто киньте древесину в дробитель, затем поместите полученные опилки в сборочный станок вместе с шаблоном для пластин и клеем. Клей можно получить из латекса с помощью центрифуги."
  ],
  "quest.1A000000000000E0.title": "Фенольная печатная плата",
  "quest.1A000000000000E1.quest_desc": [
    "Лучше, чем обычная LV электросхема. Таким образом, вы можете использовать её для создания электросхем уровня MV и даже HV."
  ],
  "quest.1A000000000000E1.title": "Логическая интегральная электросхема",
  "quest.1A000000000000E2.quest_desc": [
    "Расплавьте 9 оловянных слитков и 1 слиток сурьмы в печи сплавов, чтобы получить 10 слитков паяльного сплава."
  ],
  "quest.1A000000000000E2.title": "Слиток паяльного сплава",
  "quest.1A000000000000E3.quest_desc": [
    "Электросхема уровня MV, которую можно улучшить до уровня HV. Может быть создана в сборщике микросхем. Все подробности в NEI."
  ],
  "quest.1A000000000000E3.title": "Хорошая интегральная электросхема",
  "quest.1A000000000000E4.quest_desc": [
    "Компонент электросхем."
  ],
  "quest.1A000000000000E4.title": "Транзистор",
  "quest.1A000000000000E5.quest_desc": [
    "Один из самых востребованных компонентов для создания электросхем и многих химических процессов."
  ],
  "quest.1A000000000000E5.title": "Лист полиэтилена",
  "quest.1A000000000000E6.quest_desc": [
    "Высота для поиска: 10 - 40. Для начала найдите жилу сапфировой руды. Затем получите изысканный зелёный сапфир, пропустив промытую измельчённую руду зелёного сапфира через просеиватель."
  ],
  "quest.1A000000000000E6.title": "Изысканный зелёный сапфир",
  "quest.1A000000000000E7.quest_desc": [
    "Ещё один тип кремниевой вафли."
  ],
  "quest.1A000000000000E7.title": "Чип произвольного выбора (кремниевая вафля)",
  "quest.1A000000000000E8.quest_desc": [
    "Чип RAM, часто используемый для создания электросхем."
  ],
  "quest.1A000000000000E8.title": "Чип произвольного выбора",
  "quest.1A000000000000E9.quest_desc": [
    "Высота для поиска: 30 - 60 жила ГАЛЕНИТА (галенит, серебряная руда, свинцовая руда). Вы можете найти серебряную руду в жиле галенита."
  ],
  "quest.1A000000000000E9.title": "Серебряный слиток",
  "quest.1A000000000000EA.quest_desc": [
    "Сплав серебра и золота (используйте печь сплавов)."
  ],
  "quest.1A000000000000EA.title": "Электрумовый слиток",
  "quest.1A000000000000EB.quest_desc": [
    "Высота для поиска: 60 - 80 жила ЗОЛОТА (магнетит, ванадий-магнетит, золотая руда). Найдите золотую руду в жиле магнетита и расплавьте её, чтобы получить слитки. Также можно встретить вкрапления золотой руды. Грязная золотая пыль тоже может быть переплавлена в золотой слиток."
  ],
  "quest.1A000000000000EB.title": "Золотой слиток",
  "quest.1A000000000000EC.quest_desc": [
    "Электросхема уровня HV."
  ],
  "quest.1A000000000000EC.title": "Продвинутая электросхема",
  "quest.1A000000000000ED.quest_desc": [
    "Используйте протяжный стан..."
  ],
  "quest.1A000000000000ED.title": "Электрумовая проволока",
  "quest.1A000000000000EE.quest_desc": [
    "Как и LV сборщик, может создавать электросхемы, только более мощные."
  ],
  "quest.1A000000000000EE.title": "Сборщик микросхем (MV)",
  "quest.1A000000000000EF.quest_desc": [
    "Роборука уровня MV."
  ],
  "quest.1A000000000000EF.title": "Роборука (MV)",
  "quest.1A000000000000F0.quest_desc": [
    "Чтобы получить стержень из слитка, используйте экструдер или токарный станок."
  ],
  "quest.1A000000000000F0.title": "Электрумовый стержень",
  "quest.1A000000000000F1.quest_desc": [
    "Используйте автоклав, чтобы получить кварц Нижнего мира из соответствующей пыли, либо же расплавьте блок его руды в печи, либо поместите блок в автомолот."
  ],
  "quest.1A000000000000F1.title": "Кварц Нижнего мира (самоцвет или пыль)",
  "quest.1A000000000000F2.quest_desc": [
    "Высота для поиска: 10 - 40 жила КРАСНОЙ ПЫЛИ (красная пыль, рубиновая руда, киноварь). Вы можете получить хромовую пыль из рубиновой пыли с помощью MV электролизёра. Рубиновая пыль может быть получена из красной пыли."
  ],
  "quest.1A000000000000F2.title": "Хромовая пыль",
  "quest.1A000000000000F3.quest_desc": [
    "Может разлагать многие сложные соединения на простые вещества."
  ],
  "quest.1A000000000000F3.title": "Электролизёр (MV)",
  "quest.1A000000000000F4.quest_desc": [
    "Поместите алюминиевую пыль в ЭДП (электрическую доменную печь) и подождите 85 секунд. Не забудьте обеспечить ЭДП достаточным количеством энергии (как минимум 204k энергии на слиток, без учёта потерь в проводах)."
  ],
  "quest.1A000000000000F4.title": "Алюминиевый слиток",
  "quest.1A000000000000F5.quest_desc": [
    "Лучше, чем просто электросхема. Может использоваться для создания механизмов уровня MV."
  ],
  "quest.1A000000000000F5.title": "Хорошая электросхема",
  "quest.1A000000000000F6.quest_desc": [
    "Высота для поиска: 20 - 30 жила МАРГАНЦА (гроссуляр, спессартин, пиролюзит, танталит). Найдите жилу с танталитом, пиролюзитом или спессартином. Марганец можно получить как побочный продукт переработки любой из этих руд."
  ],
  "quest.1A000000000000F6.title": "Марганцевая пыль",
  "quest.1A000000000000F7.quest_desc": [
    "Основной материал для механизмов уровня HV."
  ],
  "quest.1A000000000000F7.title": "Слиток нержавеющей стали",
  "quest.1A000000000000F8.quest_desc": [
    "Компонент паровых и газовых турбин уровня HV. Также применяется и в других механизмах того же уровня."
  ],
  "quest.1A000000000000F8.title": "Ротор из нержавеющей стали",
  "quest.1A000000000000F9.quest_desc": [
    "Двигатель для механизмов уровня HV."
  ],
  "quest.1A000000000000F9.title": "Электродвигатель (HV)",
  "quest.1A000000000000FA.quest_desc": [
    "Основание для механизмов уровня HV."
  ],
  "quest.1A000000000000FA.title": "Корпус механизма (HV)",
  "quest.1A000000000000FB.quest_desc": [
    "Поршень уровня HV."
  ],
  "quest.1A000000000000FB.title": "Электропоршень (HV)",
  "quest.1A000000000000FC.quest_desc": [
    "Контроллер для многоблока \"Чистая комната\". Эта комната предназначена для того, чтобы помещать в неё лазерные гравировщики, в которых будут производиться высокотехнологичные предметы. Минимальный размер - 3x3 с высотой в 4 блока."
  ],
  "quest.1A000000000000FC.title": "Контроллер чистой комнаты",
  "quest.1A000000000000FD.quest_desc": [
    "Серебро, золото и медь - всё, что нужно для её создания."
  ],
  "quest.1A000000000000FD.title": "Пыль чёрной бронзы",
  "quest.1A000000000000FE.quest_desc": [
    "Высота для поиска: 10 - 30 жила МЕДИ (халькопирит, железная руда, пирит, медная руда), либо 80 - 120 жила ТЕТРАЭДРИТА (тетраэдрит, медная руда, антимонит). Расплавьте медную руду для получения медного слитка. Также вы можете расплавить грязную медную пыль, которую можно получить, разбив вкрапление медной руды."
  ],
  "quest.1A000000000000FE.title": "Медь",
  "quest.1A000000000000FF.quest_desc": [
    "Чёрная бронза, никель и сталь - это всё. Используйте NEI."
  ],
  "quest.1A000000000000FF.title": "Пыль чёрной стали",
  "quest.1A00000000000100.quest_desc": [
    "Высота для поиска: 10 - 40 жила НИКЕЛЯ (гарниерит, никелевая руда, кобальтин, пентландит). Найдите и расплавьте никелевую руду (или пентландит, или гарниерит), чтобы получить никелевый слиток."
  ],
  "quest.1A00000000000100.title": "Никель",
  "quest.1A00000000000102.quest_desc": [
    "Можно создать его из стержней."
  ],
  "quest.1A00000000000102.title": "Каркас из чёрной стали",
  "quest.1A00000000000103.quest_desc": [
    "Высота для поиска: 5 - 20 жила АЛМАЗОВ (графит, алмазная руда, уголь). Вам нужно просеять промытую измельчённую алмазную руду, чтобы найти изысканный алмаз - он является отличным сырьём для создания алмазной линзы."
  ],
  "quest.1A00000000000103.title": "Изысканный алмаз",
  "quest.1A00000000000104.quest_desc": [
    "Этот станок избавляет от необходимости создавать алмазную линзу из изысканного алмаза. Достаточно сделать стеклянную пластину и изготовить из неё стеклянную линзу. Она применяется в тех же рецептах, что и алмазная."
  ],
  "quest.1A00000000000104.title": "Токарный станок (HV)",
  "quest.1A00000000000105.quest_desc": [
    "Внимание! Вы сможете изготовить её в лазерном гравировщике, только если он установлен в работающей чистой комнате. Результат напрямую зависит от эффективности чистой комнаты. Это значит, что после начала работы чистой комнаты вам нужно подождать, пока воздух в ней полностью отфильтруется."
  ],
  "quest.1A00000000000105.title": "Центральное процессорное устройство (кремниевая вафля)",
  "quest.1A00000000000106.quest_desc": [
    "Компонент электросхем."
  ],
  "quest.1A00000000000106.title": "Центральное процессорное устройство",
  "quest.1A00000000000107.quest_desc": [
    "Наилучшая и наиболее дешёвая электросхема для механизмов уровня LV."
  ],
  "quest.1A00000000000107.title": "Микропроцессор",
  "quest.1A00000000000108.quest_desc": [
    "Компонент электронных устройств."
  ],
  "quest.1A00000000000108.title": "Конденсатор",
  "quest.1A00000000000109.quest_desc": [
    "На её основе производятся электросхемы уровней от LV до IV. Чтобы создать её, используйте лист полиэтилена, медную фольгу и серную кислоту. Чтобы получить больше информации, воспользуйтесь NEI."
  ],
  "quest.1A00000000000109.title": "Пластиковая печатная плата",
  "quest.1A0000000000010A.quest_desc": [
    "Лучшая электросхема для механизмов уровня MV."
  ],
  "quest.1A0000000000010A.title": "Интегральный процессор",
  "quest.1A0000000000010B.quest_desc": [
    "Используйте протяжный стан дважды - чтобы получить провод из слитка, а затем проволоку из провода."
  ],
  "quest.1A0000000000010B.title": "Проволока из красного сплава",
  "quest.1A0000000000010C.quest_desc": [
    "Базовый электронный компонент."
  ],
  "quest.1A0000000000010C.title": "Маленькая катушка",
  "quest.1A0000000000010E.quest_desc": [
    "Высота для поиска не определена, потому что жил цинковой руды не существует. Но вам необходимо найти измельчённую цинковую руду - цинк является одним из материалов для создания фильтров для просеивателя. Также, измельчённая цинковая руда - единственный источник галлиевой пыли на вашем текущем уровне индустриального развития."
  ],
  "quest.1A0000000000010E.title": "Измельчённая цинковая руда",
  "quest.1A00000000000110.quest_desc": [
    "Электросхема уровня EV."
  ],
  "quest.1A00000000000110.title": "Интегральный компьютер",
  "quest.1A00000000000111.quest_desc": [
    "Вы можете получить его из обычного стального стержня, отправив последний в поляризатор."
  ],
  "quest.1A00000000000111.title": "Намагниченный стальной стержень",
  "quest.1A00000000000112.quest_desc": [
    "HV аккумуляторы, которые можно сделать, заполнив корпус аккумулятора натрием, кадмием или литием. Чтобы завершить этот квест, создайте любой из них."
  ],
  "quest.1A00000000000112.title": "Аккумулятор",
  "quest.1A00000000000113.quest_desc": [
    "Чтобы сделать её, используйте протяжный стан."
  ],
  "quest.1A00000000000113.title": "Оловянная проволока",
  "quest.1A00000000000114.quest_desc": [
    "Стандартные стенки для вакуумного морозильника."
  ],
  "quest.1A00000000000114.title": "Морозоустойчивый корпус механизма",
  "quest.1A00000000000115.quest_desc": [
    "Основная задача этого механизма - охлаждение горячих слитков, полученных в доменной печи."
  ],
  "quest.1A00000000000115.title": "Вакуумный морозильник",
  "quest.1A00000000000116.quest_desc": [
    "Используйте пластины нержавеющей стали."
  ],
  "quest.1A00000000000116.title": "Каркас механизма (HV)",
  "quest.1A00000000000117.quest_desc": [
    "... с помощью молота или прокатного стана."
  ],
  "quest.1A00000000000117.title": "Электрумовая фольга",
  "quest.1A00000000000118.quest_desc": [
    "Смесь алюминия, железа и хрома."
  ],
  "quest.1A00000000000118.title": "Канталовая пыль",
  "quest.1A00000000000119.quest_desc": [
    "Это материал для создания катушек следующего уровня, используемых в доменной печи / пиролизной печи / мультиплавильне. Пока что он ГОРЯЧИЙ! Не держите его у себя в инвентаре слишком долго, если только на вас не надет резиновый костюм. Чтобы охладить слиток, воспользуйтесь вакуумным морозильником."
  ],
  "quest.1A00000000000119.title": "Горячий канталовый слиток",
  "quest.1A0000000000011A.quest_desc": [
    "Этот бур берёт на себя ваши заботы. Он может добывать ресурсы (руды), но ему нужны буровые трубы - вам придется изготовить 54 штуки (остальные 10 вы получите в качестве награды). В общей сложности, 64-х буровых труб будет достаточно для извлечения всех руд до самой коренной породы. Правда, это зависит от высоты расположения бура - стака труб хватит в том случае, если он стоит на уровне моря или ниже. Заметьте, что можно снабжать бур напряжением меньше номинального (8 eu/t), и он всё равно будет работать, только медленнее. Так что создавайте бур, загружайте в него буровые трубы, ставьте где вам угодно, обеспечьте его энергией и наслаждайтесь. Кстати, он может автоматически выгружать добытую руду."
  ],
  "quest.1A0000000000011A.title": "Улучшенный автобур",
  "quest.1A0000000000011B.quest_desc": [
    "Чтобы сделать оловянную пластину, используйте молот или автомолот."
  ],
  "quest.1A0000000000011B.title": "Оловянная пластина",
  "quest.1A0000000000011C.quest_desc": [
    "Электросхема - основной компонент для создания любых электрических механизмов."
  ],
  "quest.1A0000000000011C.title": "Электросхема",
  "quest.1A0000000000011D.quest_desc": [
    "Важная часть паровой турбины. Чтобы создать его, подготовьте четыре оловянных пластины, оловянное кольцо и оловянный винт. Оловянные кольца изготавливаются из оловянных стержней при помощи молота. Оловянные винты - также из стержней, но с помощью пилы и напильника. Также для создания ротора нужны молот, напильник и отвёртка."
  ],
  "quest.1A0000000000011D.title": "Оловянный ротор",
  "quest.1A0000000000011E.quest_desc": [
    "Чтобы получить намагниченный железный стержень, используйте четыре красных пыли и железный стержень. Добрый совет: создайте LV поляризатор, чтобы намагничивать стержни, не тратя красную пыль. В этом нет строгой необходимости, однако же настоятельно рекомендуется приберечь красную пыль для других целей."
  ],
  "quest.1A0000000000011E.title": "Намагниченный железный стержень",
  "quest.1A0000000000011F.quest_desc": [
    "Воспользуйтесь напильником, чтобы сделать стержень из слитка. Позже вы сможете изготавливать их в токарном станке или экструдере."
  ],
  "quest.1A0000000000011F.title": "Железный стержень",
  "quest.1A00000000000120.quest_desc": [
    "Настало время создать электродвигатель (LV). Вы найдёте ему множество различных применений."
  ],
  "quest.1A00000000000120.title": "Электродвигатель (LV)",
  "quest.1A00000000000121.quest_desc": [
    "Изготовьте оловянный кабель. Это основной кабель для уровня LV."
  ],
  "quest.1A00000000000121.title": "1х Оловянный кабель",
  "quest.1A00000000000122.quest_desc": [
    "Может преобразовывать напряжение из 512 в 2048 eu/t или наоборот."
  ],
  "quest.1A00000000000122.title": "Трансформатор высокого напряжения",
  "quest.1A00000000000123.quest_desc": [
    "Создайте ковёр из чёрной шерсти. Другое направление использования шерсти - измельчение для получения нитей."
  ],
  "quest.1A00000000000123.title": "Чёрный ковёр",
  "quest.1A00000000000125.quest_desc": [
    "Чтобы создать любой LV механизм, вначале нужно изготовить LV каркас механизма."
  ],
  "quest.1A00000000000125.title": "Каркас механизма (LV)",
  "quest.1A00000000000126.quest_desc": [
    "Паровая турбина уже близко. Следующий шаг - LV корпус механизма. Изготовьте его."
  ],
  "quest.1A00000000000126.title": "Корпус механизма (LV)",
  "quest.1A00000000000127.quest_desc": [
    "Технологическая цепочка такова: Железный слиток (в печь) -> железные самородки (снова в печь) -> самородки кованого железа. Сплавьте их в слиток с помощью печи сплавов и специального шаблона. А далее слиток кованого железа может быть легко превращён в пластину."
  ],
  "quest.1A00000000000127.title": "Пластина кованого железа",
  "quest.1A00000000000128.quest_desc": [
    "Да! Настало время создать ваш первый генератор энергии!"
  ],
  "quest.1A00000000000128.title": "Базовая паровая турбина (LV)",
  "quest.1A00000000000129.quest_desc": [
    "Изготовьте напильник из двух железных или бронзовых пластин. Пластины можно сделать из слитков. Кстати, в отличие от прочих инструментов, у напильника нет иных применений, кроме как в рецептах для крафта."
  ],
  "quest.1A00000000000129.title": "Напильник (Gregtech)",
  "quest.1A0000000000012A.quest_desc": [
    "Воспользуйтесь печью сплавов, чтобы выплавить инваровый слиток из двух частей железа и одной части никеля. Вам нужно создать как минимум 56 слитков."
  ],
  "quest.1A0000000000012A.title": "Инваровый слиток",
  "quest.1A0000000000012B.quest_desc": [
    "Вы можете использовать этот механизм для более эффективного производства стержней. Теперь с каждых двух слитков любого металла вам будет возвращаться 1 пыль."
  ],
  "quest.1A0000000000012B.title": "Токарный станок (LV)",
  "quest.1A0000000000012C.quest_desc": [
    "Основной каркас, используемый при создании электрической доменной печи."
  ],
  "quest.1A0000000000012C.title": "Инваровый каркас",
  "quest.1A0000000000012D.quest_desc": [
    "Создайте шесть таковых, чтобы продолжить индустриализацию."
  ],
  "quest.1A0000000000012D.title": "Инваровая пластина",
  "quest.1A0000000000012E.quest_desc": [
    "Может толкать. Наверное."
  ],
  "quest.1A0000000000012E.title": "Электропоршень (LV)",
  "quest.1A0000000000012F.quest_desc": [
    "Этот корпус - основа для сооружения ЭДП (электрической доменной печи)."
  ],
  "quest.1A0000000000012F.title": "Теплоустойчивый корпус механизма",
  "quest.1A00000000000130.quest_desc": [
    "Компонент электропоршня."
  ],
  "quest.1A00000000000130.title": "Маленькая стальная шестерёнка",
  "quest.1A00000000000131.quest_desc": [
    "Вы, должно быть, уже знакомы со всеми компонентами помпы, кроме оловянного винта, а также бумажного либо резинового кольца."
  ],
  "quest.1A00000000000131.title": "Электрическая помпа (LV)",
  "quest.1A00000000000133.quest_desc": [
    "Оловянный слиток + напильник = оловянный стержень. Оловянный стержень + пила = два оловянных болта. Два оловянных болта + напильник = оловянный винт. Профит! Но на самом деле, профит - это когда вы создаёте 8 винтов из одного слитка. Чтобы достичь такого результата, воспользуйтесь NEI, дабы выявить наилучшую производственную цепочку."
  ],
  "quest.1A00000000000133.title": "Оловянный винт",
  "quest.1A00000000000134.quest_desc": [
    "Если вы решите сделать буфер с девятью слотами под батарейки, то нужно будет помещать туда не более восьми батареек и использовать 8x оловянный кабель во избежание возгорания. Но вы также можете сделать батарейный буфер с 4-мя или 16-ю слотами. Учитывайте, что каждая батарейка добавляет 1 ампер к выходному напряжению."
  ],
  "quest.1A00000000000134.title": "Низковольтовый батарейный буфер (4-16)",
  "quest.1A00000000000135.quest_desc": [
    "Эти блоки применяются в качестве источников тепла для доменных печей, чтобы плавить металлы и сплавы. Для одной доменной печи требуется изготовить 16 катушек. Также эти катушки можно использовать для сооружения пиролизной печи."
  ],
  "quest.1A00000000000135.title": "Константановая катушка",
  "quest.1A00000000000136.quest_desc": [
    "Вы можете сделать киянку из деревянных досок и палки. Основное назначение этого инструмента - включение и выключение механизмов и электрических многоблоков. Многоблоки выключены по умолчанию."
  ],
  "quest.1A00000000000136.title": "Киянка",
  "quest.1A00000000000137.quest_desc": [
    "Просто создайте его сразу после получения деревянных досок."
  ],
  "quest.1A00000000000137.title": "Верстак",
  "quest.1A00000000000139.quest_desc": [
    "Это один из инструментов, который поможет вам в обслуживании ваших многоблоков. Для выполнения квеста его нужно немного зарядить."
  ],
  "quest.1A00000000000139.title": "Паяльник",
  "quest.1A0000000000013A.quest_desc": [
    "Может разлагать многие сложные соединения на простые вещества."
  ],
  "quest.1A0000000000013A.title": "Электролизёр (LV)",
  "quest.1A0000000000013B.quest_desc": [
    "Большой комплекс заданий по изготовлению. Список заданий - ниже. Все созданные блоки будут использованы при сооружении доменной печи."
  ],
  "quest.1A0000000000013B.title": "Интерфейсы доменной печи",
  "quest.1A0000000000013C.quest_desc": [
    "Высота для поиска: 80 - 120 жила ТЕТРАЭДРИТА (тетраэдрит, медная руда, антимонит). Найдите антимонит или тетраэдрит, чтобы получить из них сурьму. Больше информации в NEI."
  ],
  "quest.1A0000000000013C.title": "Слиток сурьмы",
  "quest.1A0000000000013D.quest_desc": [
    "Воспользуйтесь консервной машиной, чтобы заполнить корпус батарейки литием."
  ],
  "quest.1A0000000000013D.title": "Литиевая батарейка",
  "quest.1A0000000000013E.quest_desc": [
    "Самая дешёвая батарейка - найти материалы для неё очень просто, но и энергоёмкость у неё наименьшая. Впрочем, это лучше, чем ничего."
  ],
  "quest.1A0000000000013E.title": "Натриевая батарейка",
  "quest.1A0000000000013F.quest_desc": [
    "Высота для поиска: 30 - 60 жила ГАЛЕНИТА (галенит, серебряная руда, свинцовая руда). Найдите свинцовую руду и выплавьте из неё свинцовые слитки. Но есть и другие способы получить свинец. Необязательно выкапывать жилы галенита в надежде найти там свинцовую руду. Вы можете просто расплавить грязную свинцовую пыль, чтобы получить слиток."
  ],
  "quest.1A0000000000013F.title": "Свинцовый слиток",
  "quest.1A00000000000140.quest_desc": [
    "Механизм, используемый для консервирования. В нём можно производить консервы, либо же заполнять батарейки натрием, кадмием или литием."
  ],
  "quest.1A00000000000140.title": "Консервная машина (LV)",
  "quest.1A00000000000141.quest_desc": [
    "Воспользуйтесь печью сплавов, чтобы получить пять слитков батарейного сплава из четырёх свинцовых и одного слитка сурьмы."
  ],
  "quest.1A00000000000141.title": "Слиток батарейного сплава",
  "quest.1A00000000000142.quest_desc": [
    "Корпус для LV батареек. Его можно изготовить из двух пластин батарейного сплава и оловянного кабеля."
  ],
  "quest.1A00000000000142.title": "Корпус батарейки",
  "quest.1A00000000000143.quest_desc": [
    "Не стоит крафтить это, если у вас нет прожорливого электроинструмента."
  ],
  "quest.1A00000000000143.title": "Аккумуляторный ранец - для чего?",
  "quest.1A00000000000147.quest_desc": [
    "Эту машину можно применять для более выгодного получения сплавов, например, бронзы. Более того, необязательно плавить именно пыль, можно использовать и слитки."
  ],
  "quest.1A00000000000147.title": "Паровая печь сплавов",
  "quest.1A00000000000148.quest_desc": [
    "Создайте блок стекла из песка, поместив последний в печь."
  ],
  "quest.1A00000000000148.title": "Стекло",
  "quest.1A00000000000149.quest_desc": [
    "Для изготовления кусачек можно использовать большинство металлов. На ранних этапах игры с помощью кусачек из пластин делаются провода, а из фольги - проволока. Также ими можно демонтировать кабели, установленные на вашей базе."
  ],
  "quest.1A00000000000149.title": "Кусачки (Gregtech)",
  "quest.1A0000000000014A.quest_desc": [
    "Рецепт тот же, что и для других труб, разница лишь в материале для пластин - нужен титан."
  ],
  "quest.1A0000000000014A.title": "Титановая жидкостная труба",
  "quest.1A0000000000014B.quest_desc": [
    "Тот же рецепт, что и для других винтов."
  ],
  "quest.1A0000000000014B.title": "Винт из нержавеющей стали",
  "quest.1A0000000000014C.quest_desc": [
    "Двигатель уровня EV."
  ],
  "quest.1A0000000000014C.title": "Электродвигатель (EV)",
  "quest.1A0000000000014D.quest_desc": [
    "Может использоваться в качестве компонента для ректификационной колонны."
  ],
  "quest.1A0000000000014D.title": "Большая жидкостная труба из нержавеющей стали",
  "quest.1A0000000000014E.quest_desc": [
    "Намного лучше, чем обычный одноблочный дистиллятор, но и намного дороже него. Главная её особенность в том, что она может разлагать одну жидкость на множество составляющих одновременно."
  ],
  "quest.1A0000000000014E.title": "Ректификационная колонна",
  "quest.1A0000000000014F.quest_desc": [
    "Часть многоблока \"Ректификационная колонна\"."
  ],
  "quest.1A0000000000014F.title": "Чистый корпус из нержавеющей стали",
  "quest.1A00000000000150.quest_desc": [
    "Поляризатор уровня HV - единственный способ получения намагниченных неодимовых стержней."
  ],
  "quest.1A00000000000150.title": "Поляризатор (HV)",
  "quest.1A00000000000151.quest_desc": [
    "Высота для поиска: 20-40 жила МОНАЦИТА (бастнезит, монацит, неодимовая руда). Необходимо найти бастнезит, монацит или неодимовую руду. Или вы можете выделить неодимовую пыль из редкоземельных элементов, которые являются побочным продуктом переработки руды красной пыли - воспользуйтесь NEI."
  ],
  "quest.1A00000000000151.title": "Неодимовая пыль",
  "quest.1A00000000000152.quest_desc": [
    "Используйте экструдер с формой под стержни."
  ],
  "quest.1A00000000000152.title": "Титановый стержень",
  "quest.1A00000000000153.quest_desc": [
    "Компонент механизмов уровня EV, и наилучший вид кабелей для передачи энергии EV напряжения. Только не забывайте об амперах!"
  ],
  "quest.1A00000000000153.title": "Алюминиевый кабель.",
  "quest.1A00000000000154.quest_desc": [
    "Для моторов уровня EV и выше подходит только отожжённая медь."
  ],
  "quest.1A00000000000154.title": "8x Провод из отожжённой меди",
  "quest.1A00000000000155.quest_desc": [
    "Компонент химического реактора уровня EV."
  ],
  "quest.1A00000000000155.title": "Большая пластиковая жидкостная труба",
  "quest.1A00000000000157.quest_desc": [
    "Поместите блок из ока Края в пильный станок, затем отправьте одну из пластин в HV+ токарный станок."
  ],
  "quest.1A00000000000157.title": "Линза из ока Края",
  "quest.1A00000000000158.quest_desc": [
    "Поместите блок из жемчуга Края в пильный станок, затем отправьте одну из пластин в HV+ токарный станок."
  ],
  "quest.1A00000000000158.title": "Линза из жемчуга Края",
  "quest.1A00000000000159.quest_desc": [
    "Используйте линзу из ока Края, чтобы создать NOR кремниевую вафлю в HV+ лазерном гравировщике."
  ],
  "quest.1A00000000000159.title": "NOR чип памяти (кремниевая вафля)",
  "quest.1A0000000000015A.quest_desc": [
    "Может выполнять большее количество рецептов, чем низкоуровневый гравировщик."
  ],
  "quest.1A0000000000015A.title": "Лазерный гравировщик (HV)",
  "quest.1A0000000000015B.quest_desc": [
    "Кремний + светящаяся пыль + азот. Вы уже должны были встречать все эти материалы, так что используйте ЭДП, чтобы получить новый предмет. Затем просто разрежьте монокристалл в пильном станке, чтобы получить кремниевые пластины."
  ],
  "quest.1A0000000000015B.title": "Монокристалл кремния легированный светопылью",
  "quest.1A0000000000015C.quest_desc": [
    "Используйте линзу из жемчуга Края, чтобы создать NAND кремниевую вафлю в HV+ лазерном гравировщике."
  ],
  "quest.1A0000000000015C.title": "NAND-чип памяти (кремниевая вафля)",
  "quest.1A0000000000015D.quest_desc": [
    "Закачайте воздух в центрифугу с помощью разливочной машины и капсул сжатого воздуха. Это - способ получения азота."
  ],
  "quest.1A0000000000015D.title": "Азот",
  "quest.1A0000000000015E.quest_desc": [
    "Вы можете встретить её в Нижнем мире - она выпадает из блоков-\"ламп\"."
  ],
  "quest.1A0000000000015E.title": "Светящаяся пыль",
  "quest.1A0000000000015F.quest_desc": [
    "Теперь у вас есть все механизмы для её получения. Способ таков: булыжник раздробить молотом -> гравий снова раздробить молотом -> песок в печь -> стекло в автомолот или дробитель -> стеклянную пыль в центрифугу -> диоксид крмения в электролизёр. На последнем шаге побочным продуктом будет кислород - не избавляйтесь от него, это полезный газ."
  ],
  "quest.1A0000000000015F.title": "Кремниевая пыль",
  "quest.1A00000000000160.quest_desc": [
    "... из NAND кремниевой вафли при помощи пильного станка."
  ],
  "quest.1A00000000000160.title": "NAND-чип памяти",
  "quest.1A00000000000161.quest_desc": [
    "Лучшая электросхема уровня HV."
  ],
  "quest.1A00000000000161.title": "Нанопроцессор",
  "quest.1A00000000000162.quest_desc": [
    "... из листа эпоксидной смолы + медной фольги + серной кислоты."
  ],
  "quest.1A00000000000162.title": "Эпоксидная печатная плата",
  "quest.1A00000000000163.quest_desc": [
    "... из нанокомпонентной кремниевой вафли при помощи пильного станка."
  ],
  "quest.1A00000000000163.title": "Нанокомпонентный центральный процессор",
  "quest.1A00000000000164.quest_desc": [
    "Компонент для создания электросхем."
  ],
  "quest.1A00000000000164.title": "SMD-резистор",
  "quest.1A00000000000165.quest_desc": [
    "Компонент для создания электросхем."
  ],
  "quest.1A00000000000165.title": "SMD-транзистор",
  "quest.1A00000000000166.quest_desc": [
    "Компонент для создания электросхем."
  ],
  "quest.1A00000000000166.title": "SMD-конденсатор",
  "quest.1A00000000000167.quest_desc": [
    "Углеродная пыль может быть превращена в углеволокно с помощью платины, палладия или лютеция."
  ],
  "quest.1A00000000000167.title": "Углеволокно",
  "quest.1A00000000000169.quest_desc": [
    "... молотом или в прокатном стане."
  ],
  "quest.1A00000000000169.title": "Медная фольга",
  "quest.1A0000000000016A.quest_desc": [
    "Рецепт для БХР: гидроксид натрия + эпихлоргидрин + ацетон + фенол."
  ],
  "quest.1A0000000000016A.title": "Лист эпоксидной смолы",
  "quest.1A0000000000016B.quest_desc": [
    "Может собирать электросхемы вплоть до уровня LuV."
  ],
  "quest.1A0000000000016B.title": "Сборщик микросхем (EV)",
  "quest.1A0000000000016C.quest_desc": [
    "Конвейер уровня EV."
  ],
  "quest.1A0000000000016C.title": "Конвейерный модуль (EV)",
  "quest.1A0000000000016D.quest_desc": [
    "Поршень уровня EV."
  ],
  "quest.1A0000000000016D.title": "Электропоршень (EV)",
  "quest.1A0000000000016E.quest_desc": [
    "Излучатель уровня EV."
  ],
  "quest.1A0000000000016E.title": "Излучатель (EV)",
  "quest.1A0000000000016F.quest_desc": [
    "Электросхема уровня IV."
  ],
  "quest.1A0000000000016F.title": "Мейнфрейм на базе интегральных процессоров",
  "quest.1A00000000000170.quest_desc": [
    "... из NOR кремниевой вафли при помощи пильного станка."
  ],
  "quest.1A00000000000170.title": "NOR-чип памяти",
  "quest.1A00000000000171.quest_desc": [
    "Электросхема уровня EV."
  ],
  "quest.1A00000000000171.title": "Сборка нанопроцессоров",
  "quest.1A00000000000172.quest_desc": [
    "Электросхема уровня IV."
  ],
  "quest.1A00000000000172.title": "Нанокомпьютер",
  "quest.1A00000000000173.quest_desc": [
    "Компонент нескольких механизмов."
  ],
  "quest.1A00000000000173.title": "Стальной корпус механизма",
  "quest.1A00000000000174.quest_desc": [
    "Вы можете взрывать что-нибудь внутри него без негативных последствий."
  ],
  "quest.1A00000000000174.title": "Имплозионный компрессор",
  "quest.1A00000000000175.quest_desc": [
    "Обсидиан - это затвердевшая лава. Его можно получить, вылив воду из ведра на лавовое озеро. Но чтобы добыть его, нужна кирка уровня 3, например, алмазная. Для чего он нужен? Если вы играете в Майнкрафт впервые, то вам следует знать, что это единственный материал, из которого можно построить портал в Нижний мир. Просто соорудите из обсидиана рамку шириной в 4 блока и высотой в 5 блоков. Затем воспользуйтесь спичками или огнивом, чтобы зажечь огонь внутри рамки, тем самым активируя портал."
  ],
  "quest.1A00000000000175.title": "Обсидиан",
  "quest.1A00000000000178.quest_desc": [
    "Гелеобразный толуол + серная кислота."
  ],
  "quest.1A00000000000178.title": "Динамит",
  "quest.1A0000000000017A.quest_desc": [
    "Широко известная кислота."
  ],
  "quest.1A0000000000017A.title": "Серная кислота",
  "quest.1A0000000000017B.quest_desc": [
    "Есть несколько способов его получения. Также может быть побочным продуктом работы ректификационной колонны."
  ],
  "quest.1A0000000000017B.title": "Метанол",
  "quest.1A0000000000017C.quest_desc": [
    "О, это замечательный механизм! Создать его непросто, но он должен у вас быть."
  ],
  "quest.1A0000000000017C.title": "Дистиллятор (LV)",
  "quest.1A0000000000017D.quest_desc": [
    "Его можно получить из дёгтя, но это не единственный способ."
  ],
  "quest.1A0000000000017D.title": "Толуол",
  "quest.1A0000000000017E.quest_desc": [
    "Требуется для изготовления стеклянных трубочек в печи сплавов."
  ],
  "quest.1A0000000000017E.title": "Шаблон (шар)",
  "quest.1A0000000000017F.quest_desc": [
    "В пиролизной печи либо из древесного угля."
  ],
  "quest.1A0000000000017F.title": "Дёготь",
  "quest.1A00000000000180.quest_desc": [
    "Смешайте в миксере серную и азотную кислоту."
  ],
  "quest.1A00000000000180.title": "Нитратная смесь",
  "quest.1A00000000000181.quest_desc": [
    "Глицерин + нитратная смесь (в химическом реакторе)."
  ],
  "quest.1A00000000000181.title": "Нитроглицерин",
  "quest.1A00000000000182.quest_desc": [
    "Отправьте семена в жидкостный экстрактор, чтобы сделать из них растительное масло."
  ],
  "quest.1A00000000000182.title": "Растительное масло",
  "quest.1A00000000000183.quest_desc": [
    "Из них можно делать растительное масло."
  ],
  "quest.1A00000000000183.title": "Семена пшеницы",
  "quest.1A00000000000184.quest_desc": [
    "С этим механизмом вы сможете выжимать жидкости из предметов либо растапливать их. Однако экстрактор уровня LV не столь полезен, как MV, так что если в низковольтовом варианте нет срочной необходимости, лучше сразу создать MV жидкостный экстрактор."
  ],
  "quest.1A00000000000184.title": "Жидкостный экстрактор (LV)",
  "quest.1A00000000000185.quest_desc": [
    "Воспользуйтесь химическим реактором, чтобы получить глицерин из гидроксида натрия, метанола и растительного масла."
  ],
  "quest.1A00000000000185.title": "Глицерин",
  "quest.1A00000000000187.quest_desc": [
    "Ура! Теперь вы сможете удвоить выход ресурсов из блоков руды. И вы сможете измельчать древесину на опилки... Зачем? Чтобы спрессовывать их и изготавливать ДСП."
  ],
  "quest.1A00000000000187.title": "Дробитель",
  "quest.1A00000000000188.quest_desc": [
    "Высота для поиска: 5 - 20 жила АЛМАЗОВ (графит, алмазная руда, уголь). Если три способа получения алмазов, два из применимы в том случае, если вы нашли жилу алмазов. Вы можете добыть блоки алмазной руды с помощью кобальтовой кирки, или же можете взорвать их пороховой бочкой или паровым котлом. Последний вариант несложен, но вряд ли вы будете его использовать в вашем прохождении. Также возможно найти алмаз, разбив вкрапление алмазной руды."
  ],
  "quest.1A00000000000188.title": "Алмазы",
  "quest.1A00000000000189.quest_desc": [
    "Печь, кирпичи и бронзовые пластины - всё, что нужно для изготовления угольного парового котла. Кстати, слово \"угольный\" в названии свидетельствует о том, что он может потреблять все виды угля (за исключением кубов сжатого угля)."
  ],
  "quest.1A00000000000189.title": "Угольный паровой котёл",
  "quest.1A0000000000018A.quest_desc": [
    "Хотите толкать? Купите (или создайте) поршень!"
  ],
  "quest.1A0000000000018A.title": "Поршень",
  "quest.1A0000000000018B.quest_desc": [
    "Убейте трёх криперов."
  ],
  "quest.1A0000000000018B.title": "Крипер",
  "quest.1A0000000000018C.quest_desc": [
    "Создайте огненный меч, чтобы поджаривать животных живьём. Его можно сделать из двух кремней и палки."
  ],
  "quest.1A0000000000018C.title": "Меч",
  "quest.1A0000000000018E.quest_desc": [
    "Её можно получить с пауков либо из шерсти."
  ],
  "quest.1A0000000000018E.title": "Нить",
  "quest.1A0000000000018F.quest_desc": [
    "Древесностружечная плита - основной компонент для изготовления покрытых печатных плат. Чтобы сделать такую плиту, отправьте опилки в компрессор."
  ],
  "quest.1A0000000000018F.title": "ДСП",
  "quest.1A00000000000190.quest_desc": [
    "Ещё несколько шагов, и вы сможете изготавливать базовые электросхемы."
  ],
  "quest.1A00000000000190.title": "Покрытая печатная плата",
  "quest.1A00000000000191.quest_desc": [
    "Найдите сахарный тростник и размножьте, чтоб получить его в большем количестве."
  ],
  "quest.1A00000000000191.title": "Сахарный тростник",
  "quest.1A00000000000192.quest_desc": [
    "У вас найдётся немного железных самородков? Вообще-то можно использовать и бронзу, но это будет дороговато. Так или иначе, настало время изготовить пилу. Две пластины, напильник и молот - и лезвие пилы готово. Затем просто прикрепите его к палке, и получите полностью готовый к работе инструмент. С помощью пилы можно делать доски из древесины, а из досок - палки (эффективнее, чем через сетку крафта). Но важнее то, что вы сможете распиливать блок камня на две плиты - они нужны для изготовления бумаги из целлюлозы."
  ],
  "quest.1A00000000000192.title": "Пила (Gregtech)",
  "quest.1A00000000000193.quest_desc": [
    "Сделайте бумагу из целлюлозы и каменных плит (последние не потребляются)."
  ],
  "quest.1A00000000000193.title": "Бумага",
  "quest.1A00000000000194.quest_desc": [
    "Разрежьте камень на плиты с помощью пилы."
  ],
  "quest.1A00000000000194.title": "Каменная плита",
  "quest.1A00000000000195.quest_desc": [
    "Воспользуйтесь ступкой, чтобы получить целлюлозу из сахарного тростника."
  ],
  "quest.1A00000000000195.title": "Целлюлоза",
  "quest.1A00000000000196.quest_desc": [
    "Изготовьте оболочку из закалённого железа из стальной пластины при помощи молота."
  ],
  "quest.1A00000000000196.title": "Оболочка из закалённого железа",
  "quest.1A00000000000197.quest_desc": [
    "Создайте молот из шести железных слитков и палки. Вы также можете использовать бронзу вместо железа. Основное применение молота - изготовление пластин из слитков (но с крайне низкой эффективностью - 2 к 1). Ещё одна функция молота - поиск руд вблизи от вас нажатием ПКМ по блоку камня."
  ],
  "quest.1A00000000000197.title": "Молот (Gregtech)",
  "quest.1A00000000000198.quest_desc": [
    "Отвёртка - один из полезнейших инструментов, без которого невозможно наладить рудоперерабатывающий комплекс или построить производственную линию. Отвёрткой можно задавать механизмам и покрытиям нужный режим работы (направление потока в помпах и объёмный расход в жидкостных регуляторах) - это делается нажатием ПКМ с отвёрткой в руке. Ещё одна функция - настройка вместимости внутреннего буфера под топливо у одноблочных генераторов."
  ],
  "quest.1A00000000000198.title": "Отвёртка (Gregtech)",
  "quest.1A00000000000199.quest_desc": [
    "Вакуумная трубка - ещё один компонент электросхемы."
  ],
  "quest.1A00000000000199.title": "Вакуумная трубка",
  "quest.1A0000000000019A.quest_desc": [
    "Разрежьте медную фольгу кусачками. Медную фольгу можно сделать из медной пластины при помощи молота."
  ],
  "quest.1A0000000000019A.title": "Медная проволока",
  "quest.1A0000000000019B.quest_desc": [
    "Основной компонент для вакуумных трубок."
  ],
  "quest.1A0000000000019B.title": "Стеклянная трубочка",
  "quest.1A0000000000019C.quest_desc": [
    "Ещё один компонент электросхем."
  ],
  "quest.1A0000000000019C.title": "Резистор",
  "quest.1A0000000000019D.quest_desc": [
    "Этот блок будет выдавать сигнал красного камня, если перед ним проедет вагонетка с сундуком с предметами."
  ],
  "quest.1A0000000000019D.title": "Детектор - инвентарь",
  "quest.1A0000000000019E.quest_desc": [
    "Просто отправьте обычный древесный уголь в дробитель."
  ],
  "quest.1A0000000000019E.title": "Пыль древесного угля",
  "quest.1A0000000000019F.quest_desc": [
    "Один слиток меди и четыре красных пыли, отправленных в печь сплавов, дадут вам слиток красного сплава."
  ],
  "quest.1A0000000000019F.title": "Красный сплав",
  "quest.1A000000000001A0.quest_desc": [
    "Используйте бумагу, чтобы сделать кабель из провода."
  ],
  "quest.1A000000000001A0.title": "1x Кабель из красного сплава",
  "quest.1A000000000001A2.quest_desc": [
    "Важный компонент монитора."
  ],
  "quest.1A000000000001A2.title": "Стеклянная панель",
  "quest.1A000000000001A3.quest_desc": [
    "Можно изготовить из шести железных стержней с помощью гаечного ключа."
  ],
  "quest.1A000000000001A3.title": "Железные прутья",
  "quest.1A000000000001A4.quest_desc": [
    "Палка + булыжник."
  ],
  "quest.1A000000000001A4.title": "Рычаг",
  "quest.1A000000000001A5.quest_desc": [
    "Сделайте ступку из камня и кремня."
  ],
  "quest.1A000000000001A5.title": "Ступка",
  "quest.1A000000000001A6.quest_desc": [
    "Разрежьте кусачками медную пластину."
  ],
  "quest.1A000000000001A6.title": "1x Медный провод",
  "quest.1A000000000001A7.quest_desc": [
    "Используйте бумагу и кожу для создания пустой книги."
  ],
  "quest.1A000000000001A7.title": "Книга",
  "quest.1A000000000001A8.quest_desc": [
    "С коров или лошадей."
  ],
  "quest.1A000000000001A8.title": "Кожа",
  "quest.1A000000000001AB.quest_desc": [
    "Не только оружие (плохое), но ещё и удобный способ делать бумажные кольца."
  ],
  "quest.1A000000000001AB.title": "Нож (Gregtech)",
  "quest.1A000000000001AC.quest_desc": [
    "Вам не нужно делать его прямо сейчас, но он понадобится в будущем. Для изготовления нужно сжать девять алмазов в компрессоре."
  ],
  "quest.1A000000000001AC.title": "Алмазный блок",
  "quest.1A000000000001AD.quest_desc": [
    "Используйте молот, напильник и четыре стальных пластины, чтобы изготовить пустой шаблон."
  ],
  "quest.1A000000000001AD.title": "Пустой шаблон",
  "quest.1A000000000001AE.quest_desc": [
    "Сделайте пластину красного сплава (молотом или в паровом молоте), чтобы вырезать из неё провод при помощи кусачек."
  ],
  "quest.1A000000000001AE.title": "Провод из красного сплава",
  "quest.1A000000000001AF.quest_desc": [
    "Её можно сделать из пустого шаблона при помощи кусачек. Так вы получите возможность изготавливать по 4 кольца из одной кучки резины или резинового бруска. Для этого требуется экструдер."
  ],
  "quest.1A000000000001AF.title": "Форма для экструдера (кольцо)",
  "quest.1A000000000001B0.quest_desc": [
    "Просто копайте где-нибудь."
  ],
  "quest.1A000000000001B0.title": "Добудьте булыжник.",
  "quest.1A000000000001B1.quest_desc": [
    "Найдите любое дерево и добудьте два блока древесины."
  ],
  "quest.1A000000000001B1.title": "Первый шаг",
  "quest.1A000000000001B2.quest_desc": [
    "Создайте кремневый топор."
  ],
  "quest.1A000000000001B2.title": "Топор",
  "quest.1A000000000001B3.quest_desc": [
    "Копайте гравий, чтобы добыть кремень - он может выпасть с небольшим шансом. Но если вы не хотите тратить время на это, то можете пойти одним из других путей: 1) Создать его из четырёх блоков гравия; 2) Если вам повезло найти овцу и получить с неё шерсть, то можете сделать полезный инструмент - сачок (для просеивания гравия)."
  ],
  "quest.1A000000000001B3.title": "Кремень",
  "quest.1A000000000001B4.quest_desc": [
    "Создайте вашу первую деревянную кирку. Есть много вариантов, из чего её можно изготовить: камень, кремень, железо, сталь, бронза, кобальт и т. д. Некоторые материалы прочнее других и могут добывать более твёрдые руды."
  ],
  "quest.1A000000000001B4.title": "Деревянная кирка",
  "quest.1A000000000001B5.quest_desc": [
    "Смесь латуни, алюминия и кобальта."
  ],
  "quest.1A000000000001B5.title": "Пыль кобальтовой латуни",
  "quest.1A000000000001B6.quest_desc": [
    "Пожарьте булыжник, чтоб получить..."
  ],
  "quest.1A000000000001B6.title": "Источник камня",
  "quest.1A000000000001B7.quest_desc": [
    "Пожарьте курицу."
  ],
  "quest.1A000000000001B7.title": "Готовьте как повар",
  "quest.1A000000000001B8.quest_desc": [
    "Найдите и накопайте немного песка."
  ],
  "quest.1A000000000001B8.title": "Песок",
  "quest.1A000000000001B9.quest_desc": [
    "Найдите гравий."
  ],
  "quest.1A000000000001B9.title": "Гравий",
  "quest.1A000000000001BA.quest_desc": [
    "Сделайте железную пластину из двух слитков при помощи молота."
  ],
  "quest.1A000000000001BA.title": "Железная пластина",
  "quest.1A000000000001BB.quest_desc": [
    "Сделайте ведро из трёх железных пластин с помощью молота."
  ],
  "quest.1A000000000001BB.title": "Ведро",
  "quest.1A000000000001BC.quest_desc": [
    "Сделайте котёл из семи железных пластин при помощи молота."
  ],
  "quest.1A000000000001BC.title": "Котёл",
  "quest.1A000000000001BD.quest_desc": [
    "Воспользуйтесь ступкой, чтобы сделать медную и оловянную пыль из соответствующих слитков. Затем создайте бронзовую пыль из трёх медных и одной оловянной."
  ],
  "quest.1A000000000001BD.title": "Бронзовая пыль",
  "quest.1A000000000001BE.quest_desc": [
    "Расплавьте бронзовую пыль, чтобы получить бронзовый слиток, затем с помощью молота сделайте бронзовые пластины."
  ],
  "quest.1A000000000001BE.title": "Бронзовая пластина",
  "quest.1A000000000001BF.quest_desc": [
    "Вам нужно найти глину - обычно она встречается под водой в реках или на океанских пляжах."
  ],
  "quest.1A000000000001BF.title": "Шарики глины",
  "quest.1A000000000001C0.quest_desc": [
    "Используйте печь, чтобы получить кирпич из глины."
  ],
  "quest.1A000000000001C0.title": "Кирпич",
  "quest.1A000000000001C1.quest_desc": [
    "Сделайте кирпичный блок из четырёх кирпичей."
  ],
  "quest.1A000000000001C1.title": "Блок кирпичей",
  "quest.1A000000000001C2.quest_desc": [
    "Объедините кирпичи и бронзовые пластины при помощи молота, чтобы изготовить бронзовый кирпичный корпус. Это основной компонент для некоторых паровых механизмов."
  ],
  "quest.1A000000000001C2.title": "Бронзовый кирпичный корпус",
  "quest.1A000000000001C3.quest_desc": [
    "Создайте блок-контроллер угольной ямы из двух самородков кованого железа, трёх кремней и бронзового кирпичного корпуса. Для получения самородков кованого железа необходимо расплавить железный слиток на самородки и затем вновь отправить их в печь."
  ],
  "quest.1A000000000001C3.title": "Угольная яма",
  "quest.1A000000000001C4.quest_desc": [
    "Используйте угольную яму, чтобы превращать древесину в древесный уголь. Для начала создайте как минимум девять кирпичных блоков и разместите их в виде квадрата 3 на 3. Затем поставьте брёвна (древесину) на них, от 1 до 5 блоков в высоту. Расположите контроллер угольной ямы сверху по центру. Все стороны, включая верхнюю, должны быть закрыты землёй."
  ],
  "quest.1A000000000001C4.title": "Древесный уголь",
  "quest.1A000000000001C6.quest_desc": [
    "Этот механизма может применяться для изготовления пластин по две штуки из трёх слитков - это эффективнее, чем использование обычного молота. Ещё одно применение - получение измельчённой руды из блоков руды или быстрое получение грязной пыли из измельчённой руды. Вы также сможете делать песок из... впрочем, лучше поищите рецепты сами."
  ],
  "quest.1A000000000001C6.title": "Паровой молот",
  "quest.1A000000000001C7.quest_desc": [
    "Наковальня действительно круто выглядит - а ради чего ещё её делать? (шутка)."
  ],
  "quest.1A000000000001C7.title": "Наковальня",
  "quest.1A000000000001C9.quest_desc": [
    "Доменная печь - единственный способ получения стали. Сталь - это круто. Почему? А вот это уже совсем другая история."
  ],
  "quest.1A000000000001C9.title": "Кирпичная домна",
  "quest.1A000000000001CA.quest_desc": [
    "Вам нужно изготовить 32 штуки."
  ],
  "quest.1A000000000001CA.title": "Огнеупорные кирпичи",
  "quest.1A000000000001CB.quest_desc": [
    "Вам нужно изготовить минимум §a32§f штуки, но учитывайте, что они делаются по два на операцию, так что процесс изготовления нужно повторить 16 раз. Также эти блоки можно использовать для постройки §6большого бронзового парового котла§f - понадобится минимум §a24§f таких блока."
  ],
  "quest.1A000000000001CB.title": "Кирпичи, обшитые бронзой",
  "quest.1A000000000001CD.quest_desc": [
    "Трубы можно использовать для транспортировки пара к другим паровым механизмам. Есть различные трубы с разной теплостойкостью и пропускной способностью. Также они находят применение в качестве компонентов паровых механизмов, и не только."
  ],
  "quest.1A000000000001CD.title": "Бронзовые жидкостные трубы",
  "quest.1A000000000001CE.quest_desc": [
    "Воспользуйтесь паровым компрессором, чтобы сделать железный блок из девяти железных слитков."
  ],
  "quest.1A000000000001CE.title": "Железный блок",
  "quest.1A000000000001CF.quest_desc": [
    "Найдите латекс."
  ],
  "quest.1A000000000001CF.title": "Латекс",
  "quest.1A000000000001D0.quest_desc": [
    "Есть ли у вас немного древесины? Если да, то вы можете смастерить краник из пяти досок. Он пригодится, чтобы позже делать факелы из латекса."
  ],
  "quest.1A000000000001D0.title": "Краник",
  "quest.1A000000000001D1.quest_desc": [
    "Ваш первый источник света. Его можно сделать из латекса и палки."
  ],
  "quest.1A000000000001D1.title": "Факел",
  "quest.1A000000000001D2.quest_desc": [
    "Компонент обшивки водонапорной башни."
  ],
  "quest.1A000000000001D2.title": "Сгусток слизи",
  "quest.1A000000000001D3.quest_desc": [
    "Сделайте как минимум один сундук и одну дверь. Соорудите любую... вообще любую коробку и поставьте дверь, чтобы защититься от ночных монстров."
  ],
  "quest.1A000000000001D3.title": "Дом, милый дом...",
  "quest.1A000000000001D4.quest_desc": [
    "Это чрезвычайно полезный блок, который можно использовать в качестве лестницы. Более того, если их поставить башенкой друг на друга, вы потом сможете легко разобрать вю конструкцию, просто сломав нижний блок."
  ],
  "quest.1A000000000001D4.title": "Леса",
  "quest.1A000000000001D5.quest_desc": [
    "Изготовьте кремневую лопату."
  ],
  "quest.1A000000000001D5.title": "Лопата",
  "quest.1A000000000001D6.quest_desc": [
    "Залейте воду в этот солнечный бойлер и разместите его под открытым небом (либо под прозрачными блоками, например, под стеклом)."
  ],
  "quest.1A000000000001D6.title": "Солнечный паровой котёл",
  "quest.1A000000000001D7.quest_desc": [
    "Используйте паровой молот, чтобы изготовить две серебряные пластины из трёх серебряных слитков."
  ],
  "quest.1A000000000001D7.title": "Серебряная пластина",
  "quest.1A000000000001D8.quest_desc": [
    "Высота для поиска: 30 - 60 жила ГАЛЕНИТА (галенит, серебряная руда, свинцовая руда). Серебряную руду можно отыскать в жиле галенита."
  ],
  "quest.1A000000000001D8.title": "Измельчённая серебряная руда",
  "quest.1A000000000001D9.quest_desc": [
    "Это способ изготовления двух проводов из одного слитка. Также это более выгодный способ получения проволоки."
  ],
  "quest.1A000000000001D9.title": "Протяжный стан (LV)",
  "quest.1A000000000001DA.quest_desc": [
    "Полезная крутилка, полезнее чем даже стиральная машина, хоть и выглядит так же."
  ],
  "quest.1A000000000001DA.title": "Центрифуга (LV)",
  "quest.1A000000000001DB.quest_desc": [
    "Так же, как и центрифуга, может применяться для выделения каучука из латекса, но ограничен в других возможностях."
  ],
  "quest.1A000000000001DB.title": "Экстрактор (LV)",
  "quest.1A000000000001DC.quest_desc": [
    "... может быть получен из латекса. Нужен для производства резины."
  ],
  "quest.1A000000000001DC.title": "Каучук",
  "quest.1A000000000001DD.quest_desc": [
    "Используется для приготовления различных химикатов."
  ],
  "quest.1A000000000001DD.title": "Химический реактор (LV)",
  "quest.1A000000000001DE.quest_desc": [
    "Высота для поиска (только в Нижнем мире): 5 - 20 жила СЕРЫ (сера, пирит, сфалерит). Жилы серы можно найти только в Нижнем мире, однако в Верхнем мире встречаются вкрапления серы. Также серу можно получить как побочный продукт переработки следующих руд: галенит, пирит, киноварь, пентландит, свинцовая руда и серебряная руда."
  ],
  "quest.1A000000000001DE.title": "Найдите серу",
  "quest.1A000000000001DF.quest_desc": [
    "Может быть изготовлен из четырёх стальных пластин при помощи молота и напильника. Затем просто придайте ему нужную форму молотом."
  ],
  "quest.1A000000000001DF.title": "Шаблон (Пластина)",
  "quest.1A000000000001E0.quest_desc": [
    "Позволяет отливать твёрдые предметы из жидких материалов, если возможно. Для работы нужен шаблон."
  ],
  "quest.1A000000000001E0.title": "Жидкостный формовщик (LV)",
  "quest.1A000000000001E1.quest_desc": [
    "Может передавать предметы в механизмы, трубы, сундуки, либо выгружать их оттуда. Также является компонентом в некоторых сложных рецептах. Нажмите Shift+ПКМ по установленному модулю, чтобы открыть его интерфейс."
  ],
  "quest.1A000000000001E1.title": "Конвейерный модуль (LV)",
  "quest.1A000000000001E2.quest_desc": [
    "Удовлетворяет вас. Как именно? Например, помогая с изготовлением сборочного станка."
  ],
  "quest.1A000000000001E2.title": "Роборука (LV)",
  "quest.1A000000000001E3.quest_desc": [
    "Может делать множество полезных вещей."
  ],
  "quest.1A000000000001E3.title": "Сборочный станок (LV)",
  "quest.1A000000000001E4.quest_desc": [
    "Материал для LV излучателя или для предметных труб. Это сплав цинка (1) и меди (3)."
  ],
  "quest.1A000000000001E4.title": "Латунный слиток",
  "quest.1A000000000001E5.quest_desc": [
    "Этот кабель может передавать напряжение 128 eu/t, являющееся основным на уровне MV. Чтобы изготовить его, расплавьте резину в жидкостном экстракторе и залейте в сборочный станок. Затем положите в него медный провод и запрограммированную микросхему с конфигурацией #24. Рецепт ищите в NEI."
  ],
  "quest.1A000000000001E5.title": "1х Медный кабель",
  "quest.1A000000000001E6.quest_desc": [
    "Уникальный компонент просеивателя."
  ],
  "quest.1A000000000001E6.title": "Предметный фильтр",
  "quest.1A000000000001E7.quest_desc": [
    "Теперь вы можете промывать измельчённую руду для получения побочной продукции. Есть четыре метода промывки с использованием разных запрограммированных микросхем. Конфигурация #1 - быстрая промывка без побочной продукции. #2 - быстрая промывка без продукции, но со сбором грязной воды в выходном слоте вашей рудопромывочной машины. #3 - медленная промывка с получением побочного продукта. #4 - то же, что и #3, но со сбором грязной воды."
  ],
  "quest.1A000000000001E7.title": "Рудопромывочная машина (LV)",
  "quest.1A000000000001E8.quest_desc": [
    "Высота для поиска (для рубиновой руды): 10 - 40. Когда вы найдёте рубиновую руду в жиле красной пыли, вам понадобится просеиватель для получения изысканного рубина (из промытой измельчённой рубиновой руды). Это отличный материал для изготовления рубиновой линзы в токарном станке. Вы также можете сделать красную линзу из других красных изысканных самоцветов, например, из яшмы или красного граната."
  ],
  "quest.1A000000000001E8.title": "Изысканный красный самоцвет",
  "quest.1A000000000001E9.quest_desc": [
    "Может преобразовывать ток MV напряжения в LV и обратно."
  ],
  "quest.1A000000000001E9.title": "Трансформатор низкого напряжения",
  "quest.1A000000000001EA.quest_desc": [
    "Достать её трудно. Для начала нужно воспользоваться котлом или рудопромывочной машиной, чтобы получить промытую измельчённую цинковую руду. Затем нужно отправить её в дробитель или автомолот, чтобы получить чистую цинковую пыль. Наконец, её необходимо поместить в центрифугу, которая выделит из неё галлий в качестве побочного продукта."
  ],
  "quest.1A000000000001EA.title": "Крошечная кучка галлиевой пыли",
  "quest.1A000000000001EB.quest_desc": [
    "Чтобы сделать диод, понадобятся следующие материалы: стеклянные панели, пыль древесного угля, оловянная проволока и крошечная кучка галлиевой пыли."
  ],
  "quest.1A000000000001EB.title": "Диод",
  "quest.1A000000000001EC.quest_desc": [
    "Высота для поиска: 40 - 80 жила КВАРЦА (кварцит, барит, истинный кварц). Если вы нашли кварцитовую пыль, то в автоклаве её можно превратить в кристалл кварцита. Кстати, среди кварцитовой руды можно отыскать истинный кварц - его тоже собирайте, он пригодится в дальнейшем развитии."
  ],
  "quest.1A000000000001EC.title": "Найдите кварцит (самоцвет или пыль).",
  "quest.1A000000000001ED.quest_desc": [
    "Этот механизм может кристаллизовать кварцитовую пыль в самоцвет."
  ],
  "quest.1A000000000001ED.title": "Автоклав (LV)",
  "quest.1A000000000001EE.quest_desc": [
    "Компонент высокотехнологичных механизмов."
  ],
  "quest.1A000000000001EE.title": "Излучатель (LV)",
  "quest.1A000000000001EF.quest_desc": [
    "Для изготовления электросхем более мощных и дешёвых, чем те, которые можно собрать в верстаке."
  ],
  "quest.1A000000000001EF.title": "Сборщик микросхем (LV)",
  "quest.1A000000000001F0.quest_desc": [
    "Важный компонент дробителя и разрушителя камня."
  ],
  "quest.1A000000000001F0.title": "Алмазный шлифовальный диск",
  "quest.1A000000000001F1.quest_desc": [
    "Лучше, чем натуральный алмаз, как минимум потому что его можно использовать во всех рецептах, где применяются и обычные алмазы - а вот в обратную сторону это не работает."
  ],
  "quest.1A000000000001F1.title": "Промышленный алмаз",
  "quest.1A000000000001F2.quest_desc": [
    "Куб сжатого угля - это уже почти готовый промышленный алмаз, но его ещё нужно спрессовать. Чтобы сделать этот куб, подготовьте 64 угольных пыли (пыль древесного угля не подойдёт) и восемь кремней. Затем изготовьте угольные шарики, спрессуйте их и положите в сборочный станок вместе с кирпичными блоками."
  ],
  "quest.1A000000000001F2.title": "Куб сжатого угля",
  "quest.1A000000000001F3.quest_desc": [
    "Для спрессовывания воспользуйтесь компрессором. Вам понадобится 8 шариков."
  ],
  "quest.1A000000000001F3.title": "Сжатый угольный шарик",
  "quest.1A000000000001F4.quest_desc": [
    "Это замечательная машина. Вы можете убедиться в этом, когда поместите капсулу с водой и лаву внутрь. Также требуется запрограммированная микросхема. Затем подключите его к электричеству и наслаждайтесь бесконечной генерацией булыжника. А ещё он может производить обсидиан из красной пыли."
  ],
  "quest.1A000000000001F4.title": "Разрушитель камня (LV)",
  "quest.1A000000000001F5.quest_desc": [
    "Основа для высокоуровневых электросхем."
  ],
  "quest.1A000000000001F5.title": "Монокристалл кремния",
  "quest.1A000000000001F6.quest_desc": [
    "... из кремня и угольной пыли. Вам понадобится 8 штук."
  ],
  "quest.1A000000000001F6.title": "Угольный шарик",
  "quest.1A000000000001F7.quest_desc": [
    "Это компонент некоторых механизмов."
  ],
  "quest.1A000000000001F7.title": "Стальная шестерня",
  "quest.1A000000000001F8.quest_desc": [
    "Трубы для одноблочных автобуров, буровых установок и нефтекачалок. Наиболее выгодный способ их изготовления - в экструдере из стальных жидкостных труб. Так что вы можете подождать, пока у вас появится экструдер уровня MV."
  ],
  "quest.1A000000000001F8.title": "Буровая труба",
  "quest.1A000000000001F9.quest_desc": [
    "Настало время поработать с бокситами. Дробитель (HV) позволяет получать галлиевую пыль в качестве побочного продукта. Воспользуйтесь NEI, чтобы получить больше информации."
  ],
  "quest.1A000000000001F9.title": "Термальная центрифуга (LV)",
  "quest.1A000000000001FA.quest_desc": [
    "Может быть изготовлен из обычного медного провода."
  ],
  "quest.1A000000000001FA.title": "4х Медный провод",
  "quest.1A000000000001FB.quest_desc": [
    "В этом механизме с помощью кислорода можно быстро превращать железо в кованое железо, медь в отожжённую медь, и т. д."
  ],
  "quest.1A000000000001FB.title": "Электродуговая печь (LV)",
  "quest.1A000000000001FC.quest_desc": [
    "Высота для поиска: 5 - 20 жила АЛМАЗОВ (графит, алмазная руда, уголь)."
  ],
  "quest.1A000000000001FC.title": "Графитовая пыль",
  "quest.1A000000000001FD.quest_desc": [
    "Возьмите изысканный рубин/красный гранат/яшму, чтобы изготовить из неё красную линзу в токарном станке."
  ],
  "quest.1A000000000001FD.title": "Красная линза",
  "quest.1A000000000001FE.quest_desc": [
    "... при помощи молота или прокатного стана."
  ],
  "quest.1A000000000001FE.title": "Тонкий лист силиконовой резины",
  "quest.1A000000000001FF.quest_desc": [
    "... при помощи молота или прокатного стана."
  ],
  "quest.1A000000000001FF.title": "Алюминиевая фольга.",
  "quest.1A00000000000201.quest_desc": [
    "Высота для поиска: 50 - 60. Основным источником хлора могут быть соляные руды (обычная либо каменная соль)."
  ],
  "quest.1A00000000000201.title": "Хлор",
  "quest.1A00000000000202.quest_desc": [
    "Хлор + метан (в химическом реакторе)"
  ],
  "quest.1A00000000000202.title": "Хлорметан",
  "quest.1A00000000000203.quest_desc": [
    "Самый простой и популярный вид газообразного топлива для газовых турбин. Есть много способов его производства, но лишь немногие из них являются выгодными."
  ],
  "quest.1A00000000000203.title": "Метан",
  "quest.1A00000000000204.quest_desc": [
    "Хлорметан + кремний (в химическом реакторе уровня MV или выше)."
  ],
  "quest.1A00000000000204.title": "Диметилдихлорсилан",
  "quest.1A00000000000205.quest_desc": [
    "Диметилдихлорсилан + вода (в химическом реакторе уровня MV или выше)."
  ],
  "quest.1A00000000000205.title": "Полидиметилсилоксан",
  "quest.1A00000000000206.quest_desc": [
    "Это побочный продукт получения хлорметана. Вы также можете производить её напрямую из этилена и хлора."
  ],
  "quest.1A00000000000206.title": "Соляная кислота",
  "quest.1A00000000000207.quest_desc": [
    "Соляная кислота + этилен + кислород (в химическом реакторе)."
  ],
  "quest.1A00000000000207.title": "Винилхлорид",
  "quest.1A00000000000208.quest_desc": [
    "Есть множество способов его получения в электролизёре, так что воспользуйтесь NEI, чтобы выбрать предпочтительный для вас. Проще всего добывать его из воды. Обратите внимание: чтобы этот квест засчитался как выполненный, вам нужно залить немного кислорода в одну из следующих ёмкостей: универсальная жидкостная капсула либо резервуар из истинного кварца. Жидкости и газы засчитываются в квест, только если они залиты в какую-либо из указанных ёмкостей."
  ],
  "quest.1A00000000000208.title": "Кислород",
  "quest.1A00000000000209.quest_desc": [
    "До пластика осталось всего пару шагов."
  ],
  "quest.1A00000000000209.title": "Этилен",
  "quest.1A0000000000020B.quest_desc": [
    "Хлор + метан (в химическом реакторе)."
  ],
  "quest.1A0000000000020B.title": "Хлороформ",
  "quest.1A0000000000020C.quest_desc": [
    "Водород + фтор (в химическом реакторе)."
  ],
  "quest.1A0000000000020C.title": "Плавиковая кислота",
  "quest.1A0000000000020D.quest_desc": [
    "Бастнезит, лепидолит, топазы, биотит - всё это может быть сырьём для производства фтора."
  ],
  "quest.1A0000000000020D.title": "Фтор",
  "quest.1A0000000000020E.quest_desc": [
    "Хлороформ + плавиковая кислота. Используйте химический реактор уровня HV."
  ],
  "quest.1A0000000000020E.title": "Тетрафторэтилен",
  "quest.1A0000000000020F.quest_desc": [
    "Химический реактор уровня HV."
  ],
  "quest.1A0000000000020F.title": "Химический реактор (HV)",
  "quest.1A00000000000210.quest_desc": [
    "Полимеризуйте кислородом, затем отлейте пластины."
  ],
  "quest.1A00000000000210.title": "Лист политетрафторэтилена",
  "quest.1A00000000000211.quest_desc": [
    "В сравнении с одноблочным химическим реактором, обладает некоторыми преимуществами и недостатками. С одной стороны, БХР намного дороже, но с другой, ему доступно большее количество рецептов, и он не потребляет больше энергии, если подавать ему более высокое напряжение. Таким образом, вы можете значительно ускорять химические процессы без негативных последствий."
  ],
  "quest.1A00000000000211.title": "Большой химический реактор",
  "quest.1A00000000000212.quest_desc": [
    "Важный компонент большого химического реактора. Также может использоваться по прямому назначению."
  ],
  "quest.1A00000000000212.title": "Большая ПТФЭ жидкостная труба",
  "quest.1A00000000000214.quest_desc": [
    "Дистиллируйте дёготь, чтобы получить бензол. Используйте дистиллятор уровня MV и выше."
  ],
  "quest.1A00000000000214.title": "Бензол",
  "quest.1A00000000000215.quest_desc": [
    "Это замечательный многоблок. С его помощью можно быстро перерабатывать древесину в древесный уголь. Более того, он может производить множество полезных побочных продуктов. Воспользуйтесь NEI, чтобы узнать, какая конфигурация микросхемы нужна для получения целевых побочных продуктов."
  ],
  "quest.1A00000000000215.title": "Пиролизная печь",
  "quest.1A00000000000217.quest_desc": [
    "Да, хлор + бензол (в химическом реакторе)."
  ],
  "quest.1A00000000000217.title": "1,2-дихлорбензол",
  "quest.1A00000000000219.quest_desc": [
    "Может быть получен из этилена в MV+ химическом реакторе."
  ],
  "quest.1A00000000000219.title": "Пропилен",
  "quest.1A0000000000021A.quest_desc": [
    "Рецепт для БХР: гидроксид натрия + пропилен + хлор + вода."
  ],
  "quest.1A0000000000021A.title": "Эпихлоргидрин",
  "quest.1A0000000000021B.quest_desc": [
    "Дистиллируйте дёготь, чтобы получить фенол. Используйте дистиллятор уровня MV и выше."
  ],
  "quest.1A0000000000021B.title": "Фенол",
  "quest.1A0000000000021C.quest_desc": [
    "... в пиролизной печи."
  ],
  "quest.1A0000000000021C.title": "Древесный уксус",
  "quest.1A0000000000021D.quest_desc": [
    "Получите в MV+ дистилляторе из древесного уксуса."
  ],
  "quest.1A0000000000021D.title": "Ацетон",
  "quest.1A00000000000221.quest_desc": [
    "Редко используемый компонент некоторых механизмов."
  ],
  "quest.1A00000000000221.title": "Сенсор (LV)",
  "quest.1A00000000000222.quest_desc": [
    "Подготовьте дистиллированную воду, мясной фарш, соль и сахар. Закиньте всё это в миксер, а затем вскипятите в нагревателе жидкостей."
  ],
  "quest.1A00000000000222.title": "Стерилизованный субстрат",
  "quest.1A00000000000223.quest_desc": [
    "Вы можете получить её из угля, древесного угля и множества других материалов."
  ],
  "quest.1A00000000000223.title": "Углеродная пыль",
  "quest.1A00000000000224.quest_desc": [
    "Из расплавленной эпоксидной смолы и углеволокна/стекловолокна."
  ],
  "quest.1A00000000000224.title": "Лист текстолита",
  "quest.1A00000000000225.quest_desc": [
    "Воспользуйтесь MV+ экструдером с формой для производства проводов, чтобы получить стекловолокно из бруска боросиликатного стекла."
  ],
  "quest.1A00000000000225.title": "Стекловолокно",
  "quest.1A00000000000226.quest_desc": [
    "Наподобие химического реактора, но с иными функциями."
  ],
  "quest.1A00000000000226.title": "Химическая ванна (LV)",
  "quest.1A00000000000227.quest_desc": [
    "Смешайте борную пыль со стеклянной пылью и выплавьте брусок."
  ],
  "quest.1A00000000000227.title": "Брусок боросиликатного стекла",
  "quest.1A00000000000228.quest_desc": [
    "Высота для поиска: 50 - 60 жила СОЛИ (каменная соль, соль, лепидолит, сподумен). Бор можно получить как побочный продукт переработки лепидолита."
  ],
  "quest.1A00000000000228.title": "Борная пыль.",
  "quest.1A00000000000229.quest_desc": [
    "Необходима для EV+ электросхем или батарей под напряжение 8 кВ."
  ],
  "quest.1A00000000000229.title": "Фиброармированная плата",
  "quest.1A0000000000022C.quest_desc": [
    "Может кипятить воду, однако вам необязательно этим заниматься. Чтобы завершить квест, создайте нагреватель любого уровня от LV до IV."
  ],
  "quest.1A0000000000022C.title": "Нагреватель жидкости",
  "quest.1A0000000000022D.quest_desc": [
    "Из сахарного тростника."
  ],
  "quest.1A0000000000022D.title": "Сахар",
  "quest.1A0000000000022E.quest_desc": [
    "Расплавьте кобальтовую латунь при помощи жидкостного экстрактора (MV), затем отлейте из неё шестерню в жидкостном формовщике с помощью соответствующей формы (наиболее дешёвый способ). Также можно сделать шестерню из пластин и стержней при помощи гаечного ключа, но этот способ немного дороже."
  ],
  "quest.1A0000000000022E.title": "Шестерня из кобальтовой латуни.",
  "quest.1A0000000000022F.quest_desc": [
    "Используйте любой химический реактор, чтобы создать стирол из этилена и бензола."
  ],
  "quest.1A0000000000022F.title": "Стирол",
  "quest.1A00000000000230.quest_desc": [
    "Чтобы получить бутилен-1 из этилена, воспользуйтесь MV+ химическим реактором с запрограммированной микросхемой #4."
  ],
  "quest.1A00000000000230.title": "Бутилен-1",
  "quest.1A00000000000231.quest_desc": [
    "Воспользуйтесь MV+ химическим реактором, чтобы получить бутадиен из бутилена-1."
  ],
  "quest.1A00000000000231.title": "Бутадиен",
  "quest.1A00000000000232.quest_desc": [
    "Его можно получить в HV+ химическом реакторе из стирола и бутадиена в присутствии кислорода. Последний можно заменить воздухом, но это невыгодно."
  ],
  "quest.1A00000000000232.title": "Сырой бутадиен-стирольный каучук",
  "quest.1A00000000000233.quest_desc": [
    "Соедините утолщённые отражатели нейтронов и укреплённую иридиевую пластину, чтобы получить иридиевый отражатель нейтронов."
  ],
  "quest.1A00000000000233.title": "Иридиевый отражатель нейтронов.",
  "quest.1A00000000000234.quest_desc": [
    "Воспользуйтесь имплозионным компрессором, чтобы получить укреплённую иридиевую пластину из слитка иридиевого сплава."
  ],
  "quest.1A00000000000234.title": "Укреплённая иридиевая пластина",
  "quest.1A00000000000235.quest_desc": [
    "Есть три типа синих линз для изготовления PIC кремниевой вафли: из синего топаза, сапфировая и опаловая. Воспользуйтесь HV+ лазерным гравировщиком и кремниевой пластиной, легированной светопылью."
  ],
  "quest.1A00000000000235.title": "PIC кремниевая вафля",
  "quest.1A00000000000236.quest_desc": [
    "Синтезируйте расплавленный европий в термоядерном реакторе из водорода и расплавленного неодима."
  ],
  "quest.1A00000000000236.title": "Европиевый слиток",
  "quest.1A00000000000237.quest_desc": [
    "PIC кремниевая вафля + пыль фосфида индия-галлия + расплавленный красный сплав. Поместите всё это в EV+ химический реактор."
  ],
  "quest.1A00000000000237.title": "Высокомощная интегральная электросхема (кремниевая вафля)",
  "quest.1A00000000000238.quest_desc": [
    "Для изготовления этого блока вам понадобится 16 сверхпроводящих проводов."
  ],
  "quest.1A00000000000238.title": "Сверхпроводящая катушка",
  "quest.1A00000000000239.quest_desc": [
    "Применяется для подачи до 32к eu/t энергии в многоблоки."
  ],
  "quest.1A00000000000239.title": "Энергетический люк (LuV)",
  "quest.1A0000000000023A.quest_desc": [
    "Корпус для всех механизмов уровня LuV."
  ],
  "quest.1A0000000000023A.title": "Корпус механизма (LuV)",
  "quest.1A0000000000023B.quest_desc": [
    "Дроблёное око Края + MV электросхема + 2х осмиевый провод (в сборочном станке уровня MV+)."
  ],
  "quest.1A0000000000023B.title": "Генератор поля (MV)",
  "quest.1A0000000000023C.quest_desc": [
    "Подготовьте одну пластину плутония-241."
  ],
  "quest.1A0000000000023C.title": "Пластина плутония-241",
  "quest.1A0000000000023D.quest_desc": [
    "Высокотехнологичный компонент сложных механизмов."
  ],
  "quest.1A0000000000023D.title": "Генератор поля (IV)",
  "quest.1A0000000000023E.quest_desc": [
    "Один из основных элементов термоядерного реактора."
  ],
  "quest.1A0000000000023E.title": "Катушка термоядерного реактора",
  "quest.1A0000000000023F.quest_desc": [
    "Электросхема уровня ZPM."
  ],
  "quest.1A0000000000023F.title": "Мейнфрейм на базе квантовых процессоров",
  "quest.1A00000000000241.quest_desc": [
    "Думаете, это бесполезный хлам? Как бы не так..."
  ],
  "quest.1A00000000000241.title": "Каменная пыль",
  "quest.1A00000000000243.quest_desc": [
    "На первый взгляд - простой механизм. Но на деле он может производить множество полезных вещей: бетон, индустриальную биомассу, буровой раствор и многое другое."
  ],
  "quest.1A00000000000243.title": "Миксер (LV)",
  "quest.1A00000000000247.quest_desc": [
    "Используйте восемь хромовых пластин."
  ],
  "quest.1A00000000000247.title": "Каркас механизма (LuV)",
  "quest.1A00000000000248.quest_desc": [
    "Используйте изоляцию для кабелей под напряжение 8k+ eu/t."
  ],
  "quest.1A00000000000248.title": "Кабель из галлида ванадия",
  "quest.1A00000000000249.quest_desc": [
    "Расплавьте три слитка ванадия и один слиток галлия, чтобы получить новый сплав."
  ],
  "quest.1A00000000000249.title": "Слиток галлида ванадия",
  "quest.1A0000000000024C.quest_desc": [
    "Может плавить больше тугоплавких материалов, чем низковольтовый экстрактор. К примеру, теперь вы сможете плавить стеклянные блоки и панели, чтобы затем изготавливать оловянные электронные лампы."
  ],
  "quest.1A0000000000024C.title": "Жидкостный экстрактор (MV)",
  "quest.1A0000000000024E.quest_desc": [
    "Соберите девять звёзд. Используйте 27 черепов скелета-иссушителя и 36 блоков песка душ, чтобы построить и призвать девять Иссушителей. Будьте очень осторожны, это непростой босс."
  ],
  "quest.1A0000000000024E.title": "Адская звезда",
  "quest.1A0000000000024F.quest_desc": [
    "Воспользуйтесь пильным станком. Кстати, не забудьте, что для блока управления термоядерным реактором вам понадобится два генератора поля (IV), а для них тоже нужны адские звёзды."
  ],
  "quest.1A0000000000024F.title": "Пластина адской звезды",
  "quest.1A00000000000250.quest_desc": [
    "Электросхема уровня LuV."
  ],
  "quest.1A00000000000250.title": "Квантовый компьютер",
  "quest.1A00000000000251.quest_desc": [
    "Воспользуйтесь химической ванной HV+, чтобы промыть адскую звезду с радоном."
  ],
  "quest.1A00000000000251.title": "Квантовая звезда",
  "quest.1A00000000000252.quest_desc": [
    "Полезный механизм для сборки некоторых сложных компонентов и деталей."
  ],
  "quest.1A00000000000252.title": "Сборочный станок (IV)",
  "quest.1A00000000000253.quest_desc": [
    "Приготовьте несколько литров кофе (в реальном мире), ибо сейчас вам придётся убить тысячи скелетов-иссушителей, чтобы добыть из них минимум 27 черепов."
  ],
  "quest.1A00000000000253.title": "Череп скелета-иссушителя",
  "quest.1A00000000000256.quest_desc": [
    "Может собирать множество различных вещей."
  ],
  "quest.1A00000000000256.title": "Сборочный станок (MV)",
  "quest.1A00000000000257.quest_desc": [
    "Центрифуга уровня HV."
  ],
  "quest.1A00000000000257.title": "Центрифуга (HV)",
  "quest.1A00000000000258.quest_desc": [
    "Электросхема уровня IV."
  ],
  "quest.1A00000000000258.title": "Сборка квантовых процессоров",
  "quest.1A00000000000259.quest_desc": [
    "Основное отличие от конвейерных модулей предыдущих уровней - необходимость использовать листы силиконовой резины либо бутадиен-стирольного каучука."
  ],
  "quest.1A00000000000259.title": "Конвейерный модуль (IV)",
  "quest.1A0000000000025D.quest_desc": [
    "Воспользуйтесь центрифугой уровня HV+, чтобы получить плутоний-241 из плутония-239. Затем расплавьте крошечную кучку пыли в обычной печи, чтобы получить самородок."
  ],
  "quest.1A0000000000025D.title": "Самородок плутония-241",
  "quest.1A0000000000025E.quest_desc": [
    "Высота для поиска: 10 - 40 жила КРАСНОЙ ПЫЛИ (красная пыль, рубиновая руда, киноварь). Хромовую пыль можно получить из рубиновой пыли с помощью электролизёра (MV). Также рубиновая пыль может быть получена из красной пыли. Как и в случае с алюминием, хромовый слиток нужно выплавлять из пыли в доменной печи."
  ],
  "quest.1A0000000000025E.title": "Хромовый слиток",
  "quest.1A0000000000025F.quest_desc": [
    "Электросхема уровня EV."
  ],
  "quest.1A0000000000025F.title": "Квантовый процессор",
  "quest.1A00000000000260.quest_desc": [
    "Излучатель уровня IV."
  ],
  "quest.1A00000000000260.title": "Излучатель (IV)",
  "quest.1A00000000000265.quest_desc": [
    "Компонент некоторых HV механизмов."
  ],
  "quest.1A00000000000265.title": "Генератор поля (HV)",
  "quest.1A00000000000268.quest_desc": [
    "Рецепт тот же, что и для катушек предыдущих уровней, только теперь основным материалом служит вольфрамовая сталь."
  ],
  "quest.1A00000000000268.title": "Катушка из вольфрамовой стали",
  "quest.1A00000000000269.quest_desc": [
    "Высота для поиска: 20 - 50 жила МАГНЕТИТА (магнетит, железная руда, ванадий-магнетит) либо жила ЗОЛОТА (магнетит, ванадий-магнетит, золотая руда). Воспользуйтесь центрифугой, чтобы разделить ванадий-магнетит на отдельные фракции."
  ],
  "quest.1A00000000000269.title": "Ванадиевая пыль",
  "quest.1A0000000000026A.quest_desc": [
    "... из QBit кремниевой вафли при помощи пильного станка."
  ],
  "quest.1A0000000000026A.title": "Блок обработки QBit",
  "quest.1A0000000000026B.quest_desc": [
    "Этот сборщик микросхем позволяет изготавливать электросхемы вплоть до уровня ZPM включительно."
  ],
  "quest.1A0000000000026B.title": "Сборщик микросхем (IV)",
  "quest.1A0000000000026E.quest_desc": [
    "Главный компонент некоторых энергетических устройств."
  ],
  "quest.1A0000000000026E.title": "Сильная интегральная электросхема",
  "quest.1A0000000000026F.quest_desc": [
    "Используйте стержни из ляпис-лазури/лазурита/содалита вместе с энергетическим кристаллом и EV электросхемами, чтобы создать лазуротроновый кристалл. А ещё его можно изготовить из изысканного сапфира (см. NEI)."
  ],
  "quest.1A0000000000026F.title": "Лазуротроновый кристалл",
  "quest.1A00000000000273.quest_desc": [
    "Найдите его в Нижнем мире."
  ],
  "quest.1A00000000000273.title": "Песок душ",
  "quest.1A00000000000274.quest_desc": [
    "Отличный механизм, способный хранить целые океаны энергии. Для завершения квеста создайте буфер с четырьмя либо девятью либо шестнадцатью слотами под батарейки."
  ],
  "quest.1A00000000000274.title": "Батарейный буфер (LuV) [4-16 слотов]",
  "quest.1A00000000000275.quest_desc": [
    "Батарея под напряжение 32к eu/t."
  ],
  "quest.1A00000000000275.title": "Кластер лазуротроновых энергетических сфер",
  "quest.1A00000000000276.quest_desc": [
    "Сконфигурируйте пустой шаблон в верстаке с помощью молота."
  ],
  "quest.1A00000000000276.title": "Шаблон (Бутылка)",
  "quest.1A00000000000277.quest_desc": [
    "Используйте шаблон для создания бутылок, чтобы сделать пузырёк из стеклянной пыли в печи сплавов. Стеклянную пыль можно получить, просто разбив стекло в автомолоте."
  ],
  "quest.1A00000000000277.title": "Пузырёк",
  "quest.1A0000000000027D.quest_desc": [
    "Используйте ЭДП с катушками из HSS-G."
  ],
  "quest.1A0000000000027D.title": "Наквадаховый слиток",
  "quest.1A0000000000027E.quest_desc": [
    "Высота для поиска (только на Марсе): 10 - 20 уникальная марсианская жила (наквадаховая руда, европиевая руда)."
  ],
  "quest.1A0000000000027E.title": "Наквадаховая пыль",
  "quest.1A0000000000027F.quest_desc": [
    "Создайте ракету на верстаке NASA. Вы можете поместить три сундука (в верстак) в качестве хранилища для ресурсов и предметов. Также вам нужно создать и построить взлётную площадку в виде квадрата 3 на 3. И наконец, изготовьте парашют для безопасного падения."
  ],
  "quest.1A0000000000027F.title": "Ракета 1-го уровня (используйте три сундука)",
  "quest.1A00000000000281.quest_desc": [
    "Может быть изготовлен из вольфрамового стержня."
  ],
  "quest.1A00000000000281.title": "Вольфрамовый болт",
  "quest.1A00000000000283.quest_desc": [
    "Радон + расплавленный галлий в термоядерном реакторе --> дюраний."
  ],
  "quest.1A00000000000283.title": "Дюраниевая пластина",
  "quest.1A00000000000286.quest_desc": [
    "Сделайте пластину из слитка метеоритного железа в прокатном стане."
  ],
  "quest.1A00000000000286.title": "Пластина метеоритного железа",
  "quest.1A00000000000287.quest_desc": [
    "Высота для поиска (только на Луне): 20 - 50. Там вы найдёте уникальную лунную жилу (сапфировая руда, метеоритное железо, платиновая руда, иридиевая руда)."
  ],
  "quest.1A00000000000287.title": "Слиток метеоритного железа",
  "quest.1A00000000000288.quest_desc": [
    "Высота для поиска: 40 - 50 жила ПЛАТИНЫ (шелдонит, палладиевая руда, платиновая руда, иридиевая руда). Но знайте, что вероятность найти эту жилу КРАЙНЕ МАЛА! Если вам так и не удалось её отыскать, то есть другой способ добыть иридий, и этот способ называется \"осадок платиновой группы\" или \"ОПГ\". Всю информацию о нём можно получить в наборе квестов №6 - \"Полиэтилен и ОПГ\"."
  ],
  "quest.1A00000000000288.title": "Иридиевая пыль",
  "quest.1A00000000000289.quest_desc": [
    "Воспользуйтесь имплозионным компрессором, чтобы создать сверхпрочное покрытие из сверхпрочного слитка."
  ],
  "quest.1A00000000000289.title": "Сверхпрочное покрытие (1-й уровень)",
  "quest.1A0000000000028A.quest_desc": [
    "Основную полупроводниковую пластину можно изготовить в сборочном станке из алмазных пластин и покрытых печатных плат с добавлением расплавленного паяльного сплава. Остальные компоненты изготовить проще. Оловянную канистру можно создать из сжатого олова в прокатном стане или экструдере."
  ],
  "quest.1A0000000000028A.title": "Кислородный концентратор",
  "quest.1A0000000000028B.quest_desc": [
    "Используйте двойные провода, полученные из наквадаховых слитков. Сделайте катушку из восьми двойных проводов с помощью гаечного ключа. Всего необходимо изготовить 16 катушек."
  ],
  "quest.1A0000000000028B.title": "Наквадаховая катушка",
  "quest.1A0000000000028C.quest_desc": [
    "Возьмите 53 капсулы со сжиженным воздухом и поместите их в центрифугу. Среди прочего, вы получите капсулу с аргоном."
  ],
  "quest.1A0000000000028C.title": "Аргон",
  "quest.1A00000000000290.quest_desc": [
    "Основной компонент всех одноблочных механизмов уровня ZPM."
  ],
  "quest.1A00000000000290.title": "Корпус механизма (ZPM)",
  "quest.1A00000000000291.quest_desc": [
    "Для создания используйте иридиевые пластины."
  ],
  "quest.1A00000000000291.title": "Каркас механизма (ZPM)",
  "quest.1A00000000000292.quest_desc": [
    "Вы можете сделать его, заизолировав наквадаховый провод так же, как и изолируются остальные провода этого напряжения."
  ],
  "quest.1A00000000000292.title": "Наквадаховый кабель",
  "quest.1A00000000000293.quest_desc": [
    "Необходим для термоядерного реактора II."
  ],
  "quest.1A00000000000293.title": "Энергетический люк (ZPM)",
  "quest.1A00000000000296.quest_desc": [
    "Может быть создан в сборочной линии."
  ],
  "quest.1A00000000000296.title": "Генератор поля (LuV)",
  "quest.1A0000000000029B.quest_desc": [
    "Поместите титановый и ниобиевый слитки в ЭДП, чтобы получить новый сплав. Затем на протяжном стане сделайте из него проволоку."
  ],
  "quest.1A0000000000029B.title": "Ниобий-титановая проволока",
  "quest.1A0000000000029D.quest_desc": [
    "Для создания электросхем вплоть до уровня UV."
  ],
  "quest.1A0000000000029D.title": "Сборщик микросхем (LuV)",
  "quest.1A0000000000029F.quest_desc": [
    "Подготовьте изумрудную линзу, чтобы получить возможность создавать кристаллические блоки обработки. Линзу можно изготовить из изысканного изумруда, либо из изумрудной пластины, которая, в свою очередь, получается разрезанием изумрудного блока, состоящего из девяти сжатых изумрудов."
  ],
  "quest.1A0000000000029F.title": "Изумрудная линза",
  "quest.1A000000000002A0.quest_desc": [
    "Поможет вам в изготовлении кристаллического блока обработки."
  ],
  "quest.1A000000000002A0.title": "Лазерный гравировщик (LuV)",
  "quest.1A000000000002A2.quest_desc": [
    "Может быть изготовлен в сборочной линии."
  ],
  "quest.1A000000000002A2.title": "Излучатель (LuV)",
  "quest.1A000000000002A3.quest_desc": [
    "Может быть изготовлен в сборочной линии."
  ],
  "quest.1A000000000002A3.title": "Электропоршень (LuV)",
  "quest.1A000000000002A4.quest_desc": [
    "Может быть изготовлен в сборочной линии."
  ],
  "quest.1A000000000002A4.title": "Конвейерный модуль (LuV)",
  "quest.1A000000000002A5.quest_desc": [
    "Вам нужно раздробить пять слитков вольфрамовой стали, чтобы получить пять пылей вольфрамовой стали. Затем смешайте их с двумя молибденовыми пылями, ванадиевой и хромовой пылью. Так вы получите новую пыль, из которой можно выплавить слиток нового сплава - HSS-G."
  ],
  "quest.1A000000000002A5.title": "Пыль HSS-G",
  "quest.1A000000000002A6.quest_desc": [
    "Один из двух материалов для изготовления сплава ниобия-титана."
  ],
  "quest.1A000000000002A6.title": "Ниобиевый слиток",
  "quest.1A000000000002A7.quest_desc": [
    "Это смесь шести пылей HSS-G, а также пыли кобальта, кремния и марганца."
  ],
  "quest.1A000000000002A7.title": "Пыль HSS-E",
  "quest.1A000000000002A8.quest_desc": [
    "Поместите пыль HSS-E в ЭДП с катушками из HSS-G или лучше."
  ],
  "quest.1A000000000002A8.title": "Слиток HSS-E",
  "quest.1A000000000002A9.quest_desc": [
    "Может быть создан в сборочной линии с LuV энергетическим люком."
  ],
  "quest.1A000000000002A9.title": "Конвейерный модуль (ZPM)",
  "quest.1A000000000002AA.quest_desc": [
    "Может быть создан в сборочной линии с LuV энергетическим люком."
  ],
  "quest.1A000000000002AA.title": "Электродвигатель (ZPM)",
  "quest.1A000000000002AB.quest_desc": [
    "Может быть создан в сборочной линии с LuV энергетическим люком."
  ],
  "quest.1A000000000002AB.title": "Электропоршень (ZPM)",
  "quest.1A000000000002AC.quest_desc": [
    "Может быть создана в сборочной линии с LuV энергетическим люком."
  ],
  "quest.1A000000000002AC.title": "Роборука (ZPM)",
  "quest.1A000000000002AD.quest_desc": [
    "Может быть создан из стержней из HSS-E."
  ],
  "quest.1A000000000002AD.title": "Каркас из HSS-E",
  "quest.1A000000000002AE.quest_desc": [
    "Может быть создана в сборочной линии с LuV энергетическим люком."
  ],
  "quest.1A000000000002AE.title": "Излучатель (ZPM)",
  "quest.1A000000000002AF.quest_desc": [
    "Механизм уровня ZPM, предназначенный для изготовления электросхем."
  ],
  "quest.1A000000000002AF.title": "Сборщик микросхем (ZPM)",
  "quest.1A000000000002B1.quest_desc": [
    "Для лучших кремниевых пластин."
  ],
  "quest.1A000000000002B1.title": "Монокристалл кремния легированный наквадахом",
  "quest.1A000000000002B2.quest_desc": [
    "Отличный материал для изготовления различных кремниевых вафель."
  ],
  "quest.1A000000000002B2.title": "Кремниевая пластина легированная наквадахом",
  "quest.1A000000000002B3.quest_desc": [
    "Пильный станок уровня HV."
  ],
  "quest.1A000000000002B3.title": "Пильный станок (HV)",
  "quest.1A000000000002B4.quest_desc": [
    "Основной компонент пильного станка."
  ],
  "quest.1A000000000002B4.title": "Алмазный диск",
  "quest.1A000000000002C2.quest_desc": [
    "Надеемся, что этот механизм не нуждается в описании. Просто экспериментируйте, помещая туда различные вещества, или откройте NEI, если вы не в настроении проводить опыты."
  ],
  "quest.1A000000000002C2.title": "Химический реактор (MV)",
  "quest.1A000000000002C3.quest_desc": [
    "Компонент газовых и паровых турбин уровня MV, и ещё нескольких механизмов того же уровня."
  ],
  "quest.1A000000000002C3.title": "Бронзовый ротор",
  "quest.1A000000000002C4.quest_desc": [
    "То же, что и LV дистиллятор, только работает быстрее, и способен проводить процессы, требующие более высокого напряжения."
  ],
  "quest.1A000000000002C4.title": "Дистиллятор (MV)",
  "quest.1A000000000002C8.quest_desc": [
    "Возьмите её в руку и кликните ПКМ по земле. Рекомендуется наличие воды не далее чем в четырёх блоках от грядки."
  ],
  "quest.1A000000000002C8.title": "Деревянная/каменная/кремневая мотыга",
  "quest.1A000000000002C9.quest_desc": [
    "Теперь у вас есть всё необходимое, чтобы успешно скрещивать растения, получать новые агрокультуры и быстро разбивать новые грядки."
  ],
  "quest.1A000000000002C9.title": "Скрещивание - уровень 2",
  "quest.1A000000000002CA.quest_desc": [
    ""
  ],
  "quest.1A000000000002CA.title": "Нефть",
  "quest.1A000000000002CB.quest_desc": [
    "Используйте дистиллятор уровня MV или выше, чтобы получить сернистую нафту из нефти."
  ],
  "quest.1A000000000002CB.title": "Сернистая нафта",
  "quest.1A000000000002CC.quest_desc": [
    "Может быть получена в химическом реакторе из сернистой нафты и водорода."
  ],
  "quest.1A000000000002CC.title": "Нафта",
  "quest.1A000000000002CD.quest_desc": [
    "Может быть получен в пиролизной печи."
  ],
  "quest.1A000000000002CD.title": "Смешанный газ",
  "quest.1A000000000002CE.quest_desc": [
    "Может быть получен в химическом реакторе из серной пыли и кислорода с помощью запрограммированной микросхемы с конфигурацией #3. Также есть способ получения из диоксида серы."
  ],
  "quest.1A000000000002CE.title": "Триоксид серы",
  "quest.1A000000000002CF.quest_desc": [
    "Промытый измельчённый пентландит + азотная кислота в химическом реакторе..."
  ],
  "quest.1A000000000002CF.title": "Раствор никелевого купороса",
  "quest.1A000000000002D0.quest_desc": [
    "Промытый измельчённый халькопирит + азотная кислота в химическом реакторе..."
  ],
  "quest.1A000000000002D0.title": "Раствор медного купороса",
  "quest.1A000000000002D1.quest_desc": [
    "Доступное на ранних этапах химическое соединение, которое можно использовать для приготовления азотной кислоты. На данный момент вам доступен только один способ получения этой жидкости - при помощи дистиллятора. Позже вы сможете производить её из водорода и азота в HV+ химическом реакторе."
  ],
  "quest.1A000000000002D1.title": "Аммиак",
  "quest.1A000000000002D2.quest_desc": [
    "Этот механизм может вливать и выливать жидкости из капсул."
  ],
  "quest.1A000000000002D2.title": "Разливочная машина (LV)",
  "quest.1A000000000002D3.quest_desc": [
    "Воспользуйтесь прокатным станом с запрограммированной микросхемой #12, чтобы изготовить капсулу из оловянных или стальных пластин."
  ],
  "quest.1A000000000002D3.title": "Пустая капсула",
  "quest.1A000000000002D4.quest_desc": [
    "Аммиак + кислород (в химическом реакторе)."
  ],
  "quest.1A000000000002D4.title": "Монооксид азота",
  "quest.1A000000000002D5.quest_desc": [
    "... из монооксида азота и кислорода. Это основой компонент для производства азотной кислоты."
  ],
  "quest.1A000000000002D5.title": "Диоксид азота",
  "quest.1A000000000002D6.quest_desc": [
    "Эта кислота сложна в производстве, но необходима для некоторых специфических рецептов."
  ],
  "quest.1A000000000002D6.title": "Азотная кислота",
  "quest.1A000000000002D7.quest_desc": [
    ""
  ],
  "quest.1A000000000002D7.title": "Промытый измельчённый пентландит",
  "quest.1A000000000002D8.quest_desc": [
    ""
  ],
  "quest.1A000000000002D8.title": "Промытый измельчённый халькопирит",
  "quest.1A000000000002D9.quest_desc": [
    "Этот порошок ценнее, чем кажется. И он является одним из способов получения редких ресурсов."
  ],
  "quest.1A000000000002D9.title": "Осадок платиновой группы",
  "quest.1A000000000002DA.quest_desc": [
    "С его помощью можно изготавливать по два стержня из одного слитка. И это ещё не всё - с этим механизмом вам откроется множество полезных рецептов."
  ],
  "quest.1A000000000002DA.title": "Экструдер (MV)",
  "quest.1A000000000002DB.quest_desc": [
    "Найдите любое море или большое озеро. Там могут появиться спруты. Коснитесь их своим мечом или топором (нажатием ЛКМ). После этого некоторые из них оставят вам подарок =)"
  ],
  "quest.1A000000000002DB.title": "Чернильный мешок",
  "quest.1A000000000002DC.quest_desc": [
    "Высокотехнологичный механизм для лазерной гравировки кремниевых вафель или чипов для мощных электросхем."
  ],
  "quest.1A000000000002DC.title": "Лазерный гравировщик (MV)",
  "quest.1A000000000002DD.quest_desc": [
    "Достаточно мощный, чтобы разрезать кремниевые вафли для электросхем."
  ],
  "quest.1A000000000002DD.title": "Пильный станок (MV)",
  "quest.1A000000000002DE.quest_desc": [
    "Каркас для MV механизмов."
  ],
  "quest.1A000000000002DE.title": "Каркас механизма (MV)",
  "quest.1A000000000002DF.quest_desc": [
    "Работает так же, как и базовая паровая турбина, но производит 128 eu/t. Вам нужно будет использовать медные провода или кабели для передачи электроэнергии. НЕ ПОДКЛЮЧАЙТЕ эту турбину к LV механизмам - это приведёт к взрыву."
  ],
  "quest.1A000000000002DF.title": "Улучшенная паровая турбина (MV)",
  "quest.1A000000000002E0.quest_desc": [
    "Лучше, чем бронзовая."
  ],
  "quest.1A000000000002E0.title": "Стальная жидкостная труба",
  "quest.1A000000000002E1.quest_desc": [
    "Основной корпус для всех MV механизмов."
  ],
  "quest.1A000000000002E1.title": "Корпус механизма (MV)",
  "quest.1A000000000002E2.quest_desc": [
    "Настало время создать поляризатор, если вы не сделали этого раньше. Этот механизм позволяет намагничивать железные стержни, используемые для производства LV электродвигателей, избавляя от необходимости намагничивать их вручную с помощью красной пыли. А вот стальные стержни уже нельзя намагнитить никаким иным способом, кроме как поляризатором."
  ],
  "quest.1A000000000002E2.title": "Поляризатор (LV)",
  "quest.1A000000000002E3.quest_desc": [
    "Компонент некоторых механизмов уровня MV. И кстати, его можно размещать на механизмах или предметных трубах с целью транспортировки предметов."
  ],
  "quest.1A000000000002E3.title": "Конвейерный модуль (MV)",
  "quest.1A000000000002E4.quest_desc": [
    "Электропоршень уровня MV."
  ],
  "quest.1A000000000002E4.title": "Электропоршень (MV)",
  "quest.1A000000000002E5.quest_desc": [
    "Перекачивает жидкости быстрее, чем LV вариант. Также является компонентом некоторых механизмов уровня MV."
  ],
  "quest.1A000000000002E5.title": "Электрическая помпа (MV)",
  "quest.1A000000000002E6.quest_desc": [
    "Кольцо, вырезанное из резинового листа."
  ],
  "quest.1A000000000002E6.title": "Резиновое кольцо",
  "quest.1A000000000002EC.quest_desc": [
    "Что это, и для чего оно нужно? Ответ следующий: это одна из первых стадий производства топлива. Из отходов можно получить полезные в сфере энергетики жидкости и газы, которые являются горючим для газовых турбин и дизельных двигателей. Отходы можно производить в дробителях, отправляя туда практически любые продукты растительного происхождения. Также из отходов можно делать блоки земли для ферм из Forestry, просто помещая их в дробитель."
  ],
  "quest.1A000000000002EC.title": "Отходы",
  "quest.1A000000000002EE.quest_desc": [
    "Чтобы сделать этот инструмент, просто объедините кремень и стальной самородок. Дешёвое приспособление для разжигания огня, если у вас есть сталь."
  ],
  "quest.1A000000000002EE.title": "Огниво",
  "quest.1A000000000002EF.quest_desc": [
    "Часть корпуса машины ULV"
  ],
  "quest.1A000000000002EF.title": "Каркас механизма (ULV)",
  "quest.1A000000000002F0.quest_desc": [
    "Может применяться в качестве компонента некоторых механизмов."
  ],
  "quest.1A000000000002F0.title": "4х Константановый провод",
  "quest.1A000000000002F1.quest_desc": [
    "Может принимать 128 eu/t (и два ампера). Для доменной печи удобнее использовать его, нежели два или три LV энергетических люка."
  ],
  "quest.1A000000000002F1.title": "Энергетический люк (MV)",
  "quest.1A000000000002F2.quest_desc": [
    "Задача этого многоблока - производить пар в колоссальных количествах, если, конечно, вы будете его хорошенько \"кормить\". Кстати, настоятельно рекомендуется создать для него отдельный источник воды, чтобы не допустить нехватки воды, т.к. это может привести к взрыву. Имейте в виду, что он может использовать дистиллированную воду. Причём, если у бойлера есть два входных люка, в одном из которых обычная вода, а в другом дистиллированная, то котёл вначале будет потреблять дистиллированную воду."
  ],
  "quest.1A000000000002F2.title": "Большой бронзовый паровой котёл",
  "quest.1A000000000002F3.quest_desc": [
    "Компонент ББПК (большого бронзового парового котла)."
  ],
  "quest.1A000000000002F3.title": "Бронзовая топка",
  "quest.1A000000000002F5.quest_desc": [
    "Высота для поиска: 10 - 40 жила НИКЕЛЯ (гарниерит, никелевая руда, кобальтин, пентландит). Ваша цель - кобальтин. Но есть и иной, простой путь: отправьте измельчённую медную руду в рудопромывочную машину, и в качестве побочного продукта получите крошечную кучку кобальтовой пыли."
  ],
  "quest.1A000000000002F5.title": "Кобальтовый слиток",
  "quest.1A000000000002F6.quest_desc": [
    "Вы можете сделать её в миксере из отходов."
  ],
  "quest.1A000000000002F6.title": "Индустриальная биомасса",
  "quest.1A000000000002F7.quest_desc": [
    "Воспользуйтесь LV ферментёром, чтобы преобразовать индустриальную биомассу в ферментированную биомассу."
  ],
  "quest.1A000000000002F7.title": "Ферментированная биомасса",
  "quest.1A000000000002F8.quest_desc": [
    "Просто отправьте отходы в варочную машину."
  ],
  "quest.1A000000000002F8.title": "Биомасса",
  "quest.1A000000000002F9.quest_desc": [
    "Есть несколько способов его получения в дистилляторе."
  ],
  "quest.1A000000000002F9.title": "Этанол",
  "quest.1A000000000002FA.quest_desc": [
    "Может перерабатывать отходы в обычную жидкую биомассу (с помощью воды)."
  ],
  "quest.1A000000000002FA.title": "Варочная машина (LV)",
  "quest.1A000000000002FB.quest_desc": [
    "Может вырабатывать энергию из почти всех видов жидкого топлива."
  ],
  "quest.1A000000000002FB.title": "Базовый дизельный генератор (LV)",
  "quest.1A000000000002FC.quest_desc": [
    "Может вырабатывать энергию из любого газообразного топлива."
  ],
  "quest.1A000000000002FC.title": "Базовая газовая турбина (LV)",
  "quest.1A000000000002FD.quest_desc": [
    "Приготовься к полёту, космонавт!"
  ],
  "quest.1A000000000002FD.title": "Верстак NASA",
  "quest.1A000000000002FE.quest_desc": [
    "Её можно изготовить в сборочном станке уровня HV+ из алмазных пластин, эпоксидных печатных плат и расплавленного паяльного сплава."
  ],
  "quest.1A000000000002FE.title": "Продвинутая полупроводниковая пластина",
  "quest.1A000000000002FF.quest_desc": [
    "Получить платиновый провод легче, чем изготовить из него платиновый кабель."
  ],
  "quest.1A000000000002FF.title": "4х Платиновый кабель",
  "quest.1A00000000000300.quest_desc": [
    "Необходима для некоторых рецептов. Также её можно применять в упаковщике для того, чтобы собирать полноразмерную пыль из маленьких или крошечных кучек пыли. Для этого нужно настроить схему на конфигурацию \"пыль\" в верстаке при помощи отвёртки."
  ],
  "quest.1A00000000000300.title": "Схема",
  "quest.1A00000000000301.quest_desc": [
    "Залейте в миксер тетраоксид диазота и 1,1-диметилгидразин."
  ],
  "quest.1A00000000000301.title": "Ракетное топливо",
  "quest.1A00000000000304.quest_desc": [
    "Вода + хлор + ртуть."
  ],
  "quest.1A00000000000304.title": "Хлорноватистая кислота",
  "quest.1A00000000000305.quest_desc": [
    "Её можно получить в центрифуге из красной пыли или киновари."
  ],
  "quest.1A00000000000305.title": "Ртуть",
  "quest.1A00000000000306.quest_desc": [
    "Сверхпрочное покрытие + сжатая сталь."
  ],
  "quest.1A00000000000306.title": "Ракетный стабилизатор",
  "quest.1A00000000000307.quest_desc": [
    "Редкий материал, применяемый при постройке ракеты."
  ],
  "quest.1A00000000000307.title": "Сверхпрочный слиток Т1",
  "quest.1A00000000000308.quest_desc": [
    "Может быть создана из двух титановых пластин."
  ],
  "quest.1A00000000000308.title": "Двойная титановая пластина",
  "quest.1A00000000000309.quest_desc": [
    "Поместите две бронзовых пластины в имплозионный компрессор."
  ],
  "quest.1A00000000000309.title": "Сжатая бронза",
  "quest.1A0000000000030A.quest_desc": [
    "Поместите две стальных пластины в имплозионный компрессор."
  ],
  "quest.1A0000000000030A.title": "Сжатая сталь",
  "quest.1A0000000000030B.quest_desc": [
    "Компонент сверхпрочного слитка Т1."
  ],
  "quest.1A0000000000030B.title": "Двойной лист политетрафторэтилена",
  "quest.1A0000000000030C.quest_desc": [
    "Может быть создан из стержня из нержавеющей стали."
  ],
  "quest.1A0000000000030C.title": "Болт из нержавеющей стали",
  "quest.1A0000000000030D.quest_desc": [
    "Деталь ракеты."
  ],
  "quest.1A0000000000030D.title": "Головной обтекатель",
  "quest.1A0000000000030E.quest_desc": [
    "Двигатель для ракеты 1-го уровня."
  ],
  "quest.1A0000000000030E.title": "Ракетный двигатель 1-го уровня",
  "quest.1A0000000000030F.quest_desc": [
    "Позволяет вам не переломать ноги во время приземления."
  ],
  "quest.1A0000000000030F.title": "Парашют",
  "quest.1A00000000000310.quest_desc": [
    "Плиты, из которых состоит стартовая площадка для ракеты. Всего таковых требуется девять."
  ],
  "quest.1A00000000000310.title": "Взлётная площадка",
  "quest.1A00000000000311.quest_desc": [
    "Важный механизм, предназначенный для заправки топливного бака ракеты."
  ],
  "quest.1A00000000000311.title": "Загрузчик топлива",
  "quest.1A00000000000312.quest_desc": [
    "Для получения спрессуйте композитный слиток в компрессоре."
  ],
  "quest.1A00000000000312.title": "Композит",
  "quest.1A00000000000313.quest_desc": [
    "Рецептов много - загляните в NEI и выберите понравившийся."
  ],
  "quest.1A00000000000313.title": "Композитный слиток",
  "quest.1A00000000000314.quest_desc": [
    "Наденьте перед полётом на Луну. Но её одной недостаточно, вам также придётся создать парашют, кислородное оборудование и баллон."
  ],
  "quest.1A00000000000314.title": "Кислородная маска",
  "quest.1A00000000000315.quest_desc": [
    "Его можно создать и на верстаке, но лучше воспользоваться печью сплавов."
  ],
  "quest.1A00000000000315.title": "Укреплённое стекло",
  "quest.1A00000000000316.quest_desc": [
    "Компонент кислородной маски. Также является элементом радиационно-защитного костюма."
  ],
  "quest.1A00000000000316.title": "Шлем-акваланг",
  "quest.1A00000000000317.quest_desc": [
    "Компонент кислородного концентратора."
  ],
  "quest.1A00000000000317.title": "Оловянная канистра",
  "quest.1A00000000000318.quest_desc": [
    "Компонент кислородного концентратора."
  ],
  "quest.1A00000000000318.title": "Вентиляционный клапан",
  "quest.1A00000000000319.quest_desc": [
    "Компонент кислородного концентратора и нескольких механизмов из GC."
  ],
  "quest.1A00000000000319.title": "Вентилятор",
  "quest.1A0000000000031A.quest_desc": [
    "Кислородный концентратор + две электрических помпы (LV). Его можно носить."
  ],
  "quest.1A0000000000031A.title": "Кислородное оборудование",
  "quest.1A0000000000031B.quest_desc": [
    "Компонент некоторых механизмов из GC."
  ],
  "quest.1A0000000000031B.title": "Кислородная труба",
  "quest.1A0000000000031D.quest_desc": [
    "Поместите две алюминиевые пластины в имплозионный компрессор."
  ],
  "quest.1A0000000000031D.title": "Сжатый алюминий",
  "quest.1A00000000000320.quest_desc": [
    "Для получения спрессуйте углеткань в компрессоре."
  ],
  "quest.1A00000000000320.title": "Углепластик",
  "quest.1A00000000000321.quest_desc": [
    "Воспользуйтесь сборочным станком любого уровня, чтобы получить углеткань из углеволокна."
  ],
  "quest.1A00000000000321.title": "Углеткань",
  "quest.1A00000000000322.quest_desc": [
    "Поместите две оловянные пластины в имплозионный компрессор."
  ],
  "quest.1A00000000000322.title": "Сжатое олово",
  "quest.1A00000000000323.quest_desc": [
    "Чтобы заполнить кислородный баллон, вы должны создать и использовать разливочную машину как минимум уровня MV (или лучше)."
  ],
  "quest.1A00000000000323.title": "Разливочная машина (MV+)",
  "quest.1A00000000000324.quest_desc": [
    "Две алмазных пластины, четыре покрытых печатных платы и расплавленный паяльный сплав."
  ],
  "quest.1A00000000000324.title": "Основная полупроводниковая пластина",
  "quest.1A00000000000325.quest_desc": [
    "Компонент HV электрических помп."
  ],
  "quest.1A00000000000325.title": "Стальной ротор",
  "quest.1A00000000000326.quest_desc": [
    "Поможет в изготовлении кислородной трубы (из Galacticraft)."
  ],
  "quest.1A00000000000326.title": "Форма для экструдера (Маленькая труба)",
  "quest.1A00000000000327.quest_desc": [
    "Вы можете сжимать кислород, и носить его при себе в баллонах. Также вам понадобится кислородное оборудование и кислородная маска, чтобы выжить в космосе и на поверхности других планет."
  ],
  "quest.1A00000000000327.title": "Малый кислородный баллон",
  "quest.1A00000000000328.quest_desc": [
    "Поместите две железные пластины в имплозионный компрессор."
  ],
  "quest.1A00000000000328.title": "Сжатое железо",
  "quest.1A00000000000329.quest_desc": [
    "Из палок и нитей."
  ],
  "quest.1A00000000000329.title": "Холст",
  "quest.1A0000000000032A.quest_desc": [
    "Воспользуйтесь сборочным станком уровня MV+, чтобы изготовить канистру из двойной стальной пластины и двух стальных колец."
  ],
  "quest.1A0000000000032A.title": "Большая стальная жидкостная канистра",
  "quest.1A0000000000032C.quest_desc": [
    "Компонент грузового загрузчика и грузового разгрузчика."
  ],
  "quest.1A0000000000032C.title": "Электросундук (MV)",
  "quest.1A0000000000032E.quest_desc": [
    "Высота для поиска: 50 - 90 жила БОКСИТОВ (бокситы, алюминиевая руда, ильменит). Загляните в NEI, чтобы узнать способ получения рутиловой пыли из бокситов или ильменита."
  ],
  "quest.1A0000000000032E.title": "Рутиловая пыль",
  "quest.1A0000000000032F.quest_desc": [
    "Замените люк в вашей электрической доменной печи, чтобы получить доступ к рецептам, требующим HV напряжения."
  ],
  "quest.1A0000000000032F.title": "Энергетический люк (HV)",
  "quest.1A00000000000330.quest_desc": [
    "Рутиловая пыль + углерод + хлор в химическом реакторе уровня HV."
  ],
  "quest.1A00000000000330.title": "Тетрахлорид титана",
  "quest.1A00000000000331.quest_desc": [
    "Высота для поиска: 10 - 40 жила ОЛИВИНА (бентонит, магнезит, глауконит, оливиновая руда). Найдите магнезит и получите из него магниевую пыль."
  ],
  "quest.1A00000000000331.title": "Магниевая пыль",
  "quest.1A00000000000332.quest_desc": [
    "Это катушка для доменной печи / пиролизной печи / мультиплавильни."
  ],
  "quest.1A00000000000332.title": "Канталовая катушка",
  "quest.1A00000000000339.quest_desc": [
    "Является компонентом некоторых HV механизмов. Также может применяться по прямому назначению."
  ],
  "quest.1A00000000000339.title": "Конвейерный модуль (HV)",
  "quest.1A0000000000033A.quest_desc": [
    "Компонент механизмов уровня HV."
  ],
  "quest.1A0000000000033A.title": "Роборука (HV)",
  "quest.1A0000000000033B.quest_desc": [
    "Высота для поиска: 5 - 30 жила БЕРИЛЛИЯ (изумрудная руда, бериллиевая руда, ториевая руда). Есть небольшой шанс найти измельчённую изумрудную руду из вкрапления. Затем вы можете просеять её, чтобы получить изумруд."
  ],
  "quest.1A0000000000033B.title": "Изумруд",
  "quest.1A0000000000033C.quest_desc": [
    "...для просмотра некоторой информации."
  ],
  "quest.1A0000000000033C.title": "Монитор",
  "quest.1A0000000000033E.quest_desc": [
    "Лучше, чем предыдущие модели."
  ],
  "quest.1A0000000000033E.title": "Сборочный станок (HV)",
  "quest.1A0000000000033F.quest_desc": [
    "Лучше, чем предыдущие модели. Может изготавливать электросхемы вплоть до уровня IV."
  ],
  "quest.1A0000000000033F.title": "Сборщик микросхем (HV)",
  "quest.1A00000000000340.quest_desc": [
    "Основание для электросхем типа \"мейнфрейм\"."
  ],
  "quest.1A00000000000340.title": "Алюминиевый каркас",
  "quest.1A00000000000341.quest_desc": [
    "Используйте протяжный стан..."
  ],
  "quest.1A00000000000341.title": "Провод из отожжённой меди",
  "quest.1A00000000000342.quest_desc": [
    "Создайте её в прокатном стане."
  ],
  "quest.1A00000000000342.title": "Галлиевая пластина",
  "quest.1A00000000000343.quest_desc": [
    "Компонент для создания электросхем."
  ],
  "quest.1A00000000000343.title": "SMD-диод",
  "quest.1A00000000000344.quest_desc": [
    "Создайте её в прокатном стане."
  ],
  "quest.1A00000000000344.title": "Платиновая проволока",
  "quest.1A00000000000345.quest_desc": [
    "Чтобы охладить горячий канталовый слиток, используйте вакуумный морозильник."
  ],
  "quest.1A00000000000345.title": "Канталовый слиток",
  "quest.1A00000000000346.quest_desc": [
    "Используйте прессы для высекателя, чтобы изготавливать в формовочном прессе отпечатанные контуры. Чтобы завершить этот квест, достаточно будет создать любой формовочный пресс уровня от LV до IV."
  ],
  "quest.1A00000000000346.title": "Формовочный пресс",
  "quest.1A00000000000347.quest_desc": [
    "Это побочный продукт производства титановых слиток. Что вам с ним делать? Поместите его в химический реактор HV+ с натрием, чтобы получить обратно часть ресурсов."
  ],
  "quest.1A00000000000347.title": "Хлорид магния",
  "quest.1A0000000000034A.quest_desc": [
    "MV батарея."
  ],
  "quest.1A0000000000034A.title": "Литиевая батарея",
  "quest.1A0000000000034B.quest_desc": [
    "Используется в качестве контейнера для MV батареи."
  ],
  "quest.1A0000000000034B.title": "Корпус батареи",
  "quest.1A00000000000350.quest_desc": [
    "Катушка уровня #3, которую можно использовать в постройке ЭДП."
  ],
  "quest.1A00000000000350.title": "Нихромовая катушка",
  "quest.1A00000000000351.quest_desc": [
    "Используйте хромовый и никелевый слитки, чтобы создать новый сплав - нихром. В этом вам поможет ЭДП."
  ],
  "quest.1A00000000000351.title": "Нихромовый слиток",
  "quest.1A00000000000353.quest_desc": [
    "Высота для поиска: 20 - 50 жила ВОЛЬФРАМАТА (шеелит, вольфрамат, литиевая руда). Но найти её будет непросто, поэтому можно набрать лавы и отправить её в MV+ центрифугу, чтобы разделить на фракции, среди которых с небольшим шансом (2,5%% на каждые 100 л) может оказаться маленькая кучка вольфрамата."
  ],
  "quest.1A00000000000353.title": "Вольфрамат",
  "quest.1A00000000000354.quest_desc": [
    "Лучше, чем базовая."
  ],
  "quest.1A00000000000354.title": "Центрифуга (MV)",
  "quest.1A00000000000355.quest_desc": [
    "Если вы хотите получить его в экструдере, вам потребуется таковой уровня HV или выше."
  ],
  "quest.1A00000000000355.title": "Стержень из вольфрамовой стали",
  "quest.1A00000000000356.quest_desc": [
    "Воспользуйтесь ЭДП с нихромовыми кольцами."
  ],
  "quest.1A00000000000356.title": "Вольфрамовый слиток",
  "quest.1A00000000000357.quest_desc": [
    "Используйте EV+ химический реактор, чтобы выделить вольфрамовую кислоту из вольфрама или шеелита."
  ],
  "quest.1A00000000000357.title": "Вольфрамовая кислота",
  "quest.1A00000000000359.quest_desc": [
    "Может использоваться в качестве компонента катушки."
  ],
  "quest.1A00000000000359.title": "2х Провод из вольфрамовой стали",
  "quest.1A0000000000035A.quest_desc": [
    "Рецепт тот, же, что и для катушек предыдущих уровней, только в качестве основного материала используются слитки HSS-G."
  ],
  "quest.1A0000000000035A.title": "Катушка из HSS-G",
  "quest.1A0000000000035B.quest_desc": [
    "Может использоваться в качестве компонента катушки."
  ],
  "quest.1A0000000000035B.title": "2х Провод из HSS-G",
  "quest.1A0000000000035C.quest_desc": [
    "Фольга из полифениленсульфида + жидкая силиконовая резина (маленькая кучка, расплавленная в MV+ жидкостном экстракторе) + маленькая кучка поливинилхлорида. Чтобы изготовить кабель на 8 кВ из провода на 8 кВ, используйте сборочный станок."
  ],
  "quest.1A0000000000035C.title": "Вольфрамовый кабель",
  "quest.1A0000000000035D.quest_desc": [
    "Высота для поиска: 20 - 50 жила МОЛИБДЕНА (вульфенит, молибденит, молибденовая руда, повеллит). Крайне редкая жила. Есть другой способ получения молибдена - как побочный продукт переработки шеелита или вольфрамовой руды."
  ],
  "quest.1A0000000000035D.title": "Молибденовая пыль",
  "quest.1A0000000000035E.quest_desc": [
    "Компонент электродвигателей уровня IV."
  ],
  "quest.1A0000000000035E.title": "16х Провод из отожжённой меди",
  "quest.1A0000000000035F.quest_desc": [
    "Может быть изготовлен из стержней из вольфрамовой стали."
  ],
  "quest.1A0000000000035F.title": "Каркас из вольфрамовой стали",
  "quest.1A00000000000360.quest_desc": [
    "Используйте титановые стержни для изготовления каркаса."
  ],
  "quest.1A00000000000360.title": "Титановый каркас",
  "quest.1A00000000000361.quest_desc": [
    "Контроллер замечательного многоблока, который позволяет вам отдыхать вместо того, чтобы копать руды. Но чтобы этот механизм мог брать на себя вашу работу по добыче полезных ископаемых, его нужно снабжать буровыми трубами и буровым раствором."
  ],
  "quest.1A00000000000361.title": "Большая буровая установка",
  "quest.1A00000000000362.quest_desc": [
    "Контроллер замечательного многоблока, который позволяет вам отдыхать вместо того, чтобы копать руды. Но чтобы этот механизм мог брать на себя вашу работу по добыче полезных ископаемых, его нужно снабжать буровыми трубами и буровым раствором."
  ],
  "quest.1A00000000000362.title": "Большая буровая установка II",
  "quest.1A0000000000036C.quest_desc": [
    "С его помощью можно создать грави-звезду."
  ],
  "quest.1A0000000000036C.title": "Автоклав (IV)",
  "quest.1A0000000000036D.quest_desc": [
    "Поместите пыль наквадрии в ЭДП с наилучшими катушками (из сплава наквадаха)."
  ],
  "quest.1A0000000000036D.title": "Слиток наквадрии",
  "quest.1A00000000000370.quest_desc": [
    "Если у вас есть наквадах, то из него можно сделать наквадрию. Способов несколько, вам нужно выбрать понравившийся."
  ],
  "quest.1A00000000000370.title": "Пыль наквадрии",
  "quest.1A00000000000375.quest_desc": [
    "Может быть создана в сборочной линии. Требует IV+ энергетического люка."
  ],
  "quest.1A00000000000375.title": "Квантовая кираса",
  "quest.1A00000000000378.quest_desc": [
    "Может быть изготовлен в сборочной линии. Требует IV+ энергетического люка."
  ],
  "quest.1A00000000000378.title": "Квантовый шлем",
  "quest.1A00000000000379.quest_desc": [
    "Одна из четырёх частей высокотехнологичной брони."
  ],
  "quest.1A00000000000379.title": "Нано-шлем",
  "quest.1A0000000000037A.quest_desc": [
    "Могут быть изготовлены в сборочной линии. Требуют IV+ энергетического люка."
  ],
  "quest.1A0000000000037A.title": "Квантовые поножи",
  "quest.1A0000000000037B.quest_desc": [
    "Одна из четырёх частей высокотехнологичной брони."
  ],
  "quest.1A0000000000037B.title": "Нано-поножи",
  "quest.1A0000000000037C.quest_desc": [
    "Могут быть изготовлены в сборочной линии. Требуют IV+ энергетического люка."
  ],
  "quest.1A0000000000037C.title": "Квантовые ботинки",
  "quest.1A0000000000037D.quest_desc": [
    "Одна из четырёх частей высокотехнологичной брони."
  ],
  "quest.1A0000000000037D.title": "Нано-ботинки",
  "quest.1A00000000000380.quest_desc": [
    "Вам предстоит воспользоваться сборочным станком уровня HV+. Поместите в него обычный теплообменник, LV электросхемы, пластины ляпис-лазури, меди и олова (для подробностей см. NEI)."
  ],
  "quest.1A00000000000380.title": "Продвинутый теплообменник",
  "quest.1A00000000000381.quest_desc": [
    "Компонент охлаждающего ядра. Также может быть использована в ядерном реакторе."
  ],
  "quest.1A00000000000381.title": "Теплоёмкая реакторная пластина",
  "quest.1A00000000000382.quest_desc": [
    "Компонент охлаждающего ядра. Также может быть использован в ядерном реакторе."
  ],
  "quest.1A00000000000382.title": "Охлаждающий стержень 60к",
  "quest.1A00000000000383.quest_desc": [
    "Компонент теплоёмкой реакторной пластины. Может быть изготовлена в HV+ формовочном прессе из свинцовой пластины и композита."
  ],
  "quest.1A00000000000383.title": "Реакторная обшивка",
  "quest.1A00000000000384.quest_desc": [
    "... из девяти слитков (или пластин)."
  ],
  "quest.1A00000000000384.title": "Плотная медная пластина",
  "quest.1A00000000000385.quest_desc": [
    "Компонент охлаждающего ядра. Также может быть использован в ядерном реакторе."
  ],
  "quest.1A00000000000385.title": "Охлаждающий стержень 30к",
  "quest.1A00000000000386.quest_desc": [
    "Капсула хладагента, совмещённая с оловянными пластинами в верстаке."
  ],
  "quest.1A00000000000386.title": "Охлаждающий стержень 10к",
  "quest.1A00000000000387.quest_desc": [
    "Лучше, чем базовая модель."
  ],
  "quest.1A00000000000387.title": "Формовочный пресс (HV)",
  "quest.1A0000000000038F.quest_desc": [
    "Смесь рубиновой и красной пыли."
  ],
  "quest.1A0000000000038F.title": "Энергопыль",
  "quest.1A00000000000390.quest_desc": [
    "Используйте HV+ автоклав, чтобы кристаллизовать энергопыль."
  ],
  "quest.1A00000000000390.title": "Энергетический кристалл",
  "quest.1A00000000000391.quest_desc": [
    "Отличается от модели предыдущего уровня большим количеством доступных рецептов."
  ],
  "quest.1A00000000000391.title": "Автоклав (HV)",
  "quest.1A00000000000392.quest_desc": [
    "Отлично подходит для того, чтобы посещать уборную ночью, не включая свет."
  ],
  "quest.1A00000000000392.title": "Прибор ночного видения",
  "quest.1A00000000000393.quest_desc": [
    "Одна из четырёх частей высокотехнологичной брони."
  ],
  "quest.1A00000000000393.title": "Нано-кираса",
  "quest.1A00000000000395.quest_desc": [
    "Как MV батарея, только хуже."
  ],
  "quest.1A00000000000395.title": "Продвинутый аккумулятор",
  "quest.1A00000000000397.quest_desc": [
    "Воспользуйтесь миксером, чтобы смешать каменную и глиняную пыль. Вместо последней также можно использовать оксид кальция. Таким образом вы получите сырой цемент. Залейте его в жидкостный формовщик с шаблоном (блок), чтобы получить блоки светлого бетона."
  ],
  "quest.1A00000000000397.title": "Светлый бетон",
  "quest.1A00000000000399.quest_desc": [
    "Если вы поместите его себе в инвентарь, он будет подзаряжать электроинструменты, которые вы держите в руках, а также нано-кирасу, если она будет лежать на панели быстрого доступа."
  ],
  "quest.1A00000000000399.title": "Заряжающий энергетический кристалл",
  "quest.1A0000000000039A.quest_desc": [
    "Изготавливается в MV+ сборочном станке из теплообменника и золотых пластин."
  ],
  "quest.1A0000000000039A.title": "Компонентный теплообменник",
  "quest.1A0000000000039B.quest_desc": [
    "Используйте MV+ сборочный станок с запрограммированной микросхемой #1, чтобы изготовить теплообменник из LV электросхемы, а также медных и оловянных пластин."
  ],
  "quest.1A0000000000039B.title": "Теплообменник",
  "quest.1A0000000000039C.quest_desc": [
    "Может заряжать электроинструменты уровня LV и MV, которые вы держите в руках (на панели быстрого доступа)."
  ],
  "quest.1A0000000000039C.title": "Продвинутый заряжающий аккумулятор",
  "quest.1A0000000000039D.quest_desc": [
    "Аналог LV батарейки, но в разы хуже. Вам нужно залить две расплавленные красные пыли в корпус батарейки при помощи разливочной машины."
  ],
  "quest.1A0000000000039D.title": "Незаряженный аккумулятор",
  "quest.1A0000000000039E.quest_desc": [
    "Может заряжать электроинструменты уровня LV , которые вы держите в руках (на панели быстрого доступа)."
  ],
  "quest.1A0000000000039E.title": "Заряжающий аккумулятор",
  "quest.1A0000000000039F.quest_desc": [
    "Если носить этот ранец вместо нательной брони, он будет подзаряжать инструменты, которые вы держите в руках, и даже нано-броню, если вы поместите её на панель быстрого доступа."
  ],
  "quest.1A0000000000039F.title": "Энергетический ранец",
  "quest.1A000000000003A2.quest_desc": [
    "Карлсон. Если не знаете, кто это - гуглите =)"
  ],
  "quest.1A000000000003A2.title": "Электрический реактивный ранец",
  "quest.1A000000000003A4.quest_desc": [
    "Как обычный теплоотвод, только с алмазом, и сделанный в HV+ сборочном станке."
  ],
  "quest.1A000000000003A4.title": "Улучшенный теплоотвод",
  "quest.1A000000000003A7.quest_desc": [
    "Воспользуйтесь MV+ сборочным станком, чтобы изготовить теплоотвод из LV электродвигателя, железных прутьев и алюминиевой фольги."
  ],
  "quest.1A000000000003A7.title": "Теплоотвод",
  "quest.1A000000000003A8.quest_desc": [
    "Наиболее дорогие компоненты: заряжающий лазуротроновый кристалл, излучатель (EV), IV электросхема и изысканный самоцвет. Рецепт ищите в NEI."
  ],
  "quest.1A000000000003A8.title": "Шахтёрский лазер",
  "quest.1A000000000003A9.quest_desc": [
    "Зарядите её и кликните ПКМ для активации. В активном состоянии у неё больше урон."
  ],
  "quest.1A000000000003A9.title": "Нано-сабля",
  "quest.1A000000000003AA.quest_desc": [
    "Промышленный алмаз + иридиевые пластины + композит."
  ],
  "quest.1A000000000003AA.title": "Слиток иридиевого сплава",
  "quest.1A000000000003AB.quest_desc": [
    "Бесполезно, если сравнивать с обычным GT батарейным буфером на 9 слотов."
  ],
  "quest.1A000000000003AB.title": "Энергохранилище",
  "quest.1A000000000003AC.quest_desc": [
    "Высота для поиска: 20 - 40 жила МОНАЦИТА (бастнезит, монацит, неодимовая руда)."
  ],
  "quest.1A000000000003AC.title": "Монацит",
  "quest.1A000000000003AE.quest_desc": [
    "Подготовьте стержень из лазурита, содалита или ляпис-лазури. Для изготовления воспользуйтесь токарным станком."
  ],
  "quest.1A000000000003AE.title": "Один из синих стержней",
  "quest.1A000000000003B0.quest_desc": [
    "Изготовьте линзу из синего топаза, сапфира или опала."
  ],
  "quest.1A000000000003B0.title": "Любая синяя линза",
  "quest.1A000000000003B6.quest_desc": [
    "Деталь дизельного двигателя (многоблока)."
  ],
  "quest.1A000000000003B6.title": "Стабильный титановый корпус",
  "quest.1A000000000003B7.quest_desc": [
    "Деталь дизельного двигателя (многоблока)."
  ],
  "quest.1A000000000003B7.title": "Воздухозаборник двигателя",
  "quest.1A000000000003B8.quest_desc": [
    "Деталь дизельного двигателя (многоблока)."
  ],
  "quest.1A000000000003B8.title": "Титановый ротор",
  "quest.1A000000000003B9.quest_desc": [
    "Деталь дизельного двигателя (многоблока)."
  ],
  "quest.1A000000000003B9.title": "Титановый корпус коробки передач",
  "quest.1A000000000003BA.quest_desc": [
    "Деталь дизельного двигателя (многоблока)."
  ],
  "quest.1A000000000003BA.title": "Титановая шестерня",
  "quest.1A000000000003BB.quest_desc": [
    "Большой двигатель, способный производить энергию, работая на жидком топливе. Требует смазку. При помощи кислорода можно повысить мощность двигателя, в этом случае он будет производить 6144 eu/t (необходим IV динамо-люк)."
  ],
  "quest.1A000000000003BB.title": "Дизельный двигатель",
  "quest.1A000000000003BD.quest_desc": [
    "Используется в качестве блока, вырабатывающего энергию в составе многоблочного генератора. Может выдавать до 8192 eu/t без взрыва."
  ],
  "quest.1A000000000003BD.title": "Динамо-люк (IV)",
  "quest.1A000000000003BE.quest_desc": [
    "Многоблоки, как правило, производят больше, чем 512 eu/t, так что им необходим как минимум EV динамо-люк."
  ],
  "quest.1A000000000003BE.title": "Динамо-люк (EV)",
  "quest.1A000000000003BF.quest_desc": [
    "Простейший способ получения - дистилляция креозота."
  ],
  "quest.1A000000000003BF.title": "Смазка",
  "quest.1A000000000003C0.quest_desc": [
    "Ранний способ получения - из опилок в жидкостном экстракторе. Информацию о других способах ищите в NEI, как и всегда."
  ],
  "quest.1A000000000003C0.title": "Креозот",
  "quest.1A000000000003C1.quest_desc": [
    "Может потреблять большинство видов газообразного топлива, чтобы производить энергию."
  ],
  "quest.1A000000000003C1.title": "Большая газовая турбина",
  "quest.1A000000000003C2.quest_desc": [
    "Компонент большого турбинного ротора."
  ],
  "quest.1A000000000003C2.title": "Длинный стержень из вольфрамовой стали",
  "quest.1A000000000003C4.quest_desc": [
    "Лучше чем модель предыдущего уровня, так как может работать с напряжением 2048 eu/t."
  ],
  "quest.1A000000000003C4.title": "Сборочный станок (EV)",
  "quest.1A000000000003C5.quest_desc": [
    "Компонент большой газовой турбины."
  ],
  "quest.1A000000000003C5.title": "Шестерня из нержавеющей стали",
  "quest.1A000000000003C6.quest_desc": [
    "Может быть изготовлен в протяжном стане из золотого слитка."
  ],
  "quest.1A000000000003C6.title": "Золотой провод",
  "quest.1A000000000003C7.quest_desc": [
    "Смесь пылей золота и меди."
  ],
  "quest.1A000000000003C7.title": "Розовое золото",
  "quest.1A000000000003C8.quest_desc": [
    "Сложная смесь пылей чёрных и цветных металлов."
  ],
  "quest.1A000000000003C8.title": "Пыль синей стали",
  "quest.1A000000000003C9.quest_desc": [
    "Компонент турбинного корпуса. Используйте гаечный ключ или сборочный станок, чтобы изготовить каркас из стержней из синей стали."
  ],
  "quest.1A000000000003C9.title": "Каркас из синей стали",
  "quest.1A000000000003CA.quest_desc": [
    "Компонент турбины."
  ],
  "quest.1A000000000003CA.title": "Турбинный корпус",
  "quest.1A000000000003CB.quest_desc": [
    "Компонент большой турбины."
  ],
  "quest.1A000000000003CB.title": "Турбинный корпус из нержавеющей стали",
  "quest.1A000000000003CC.quest_desc": [
    "Сплав магния и алюминия. Может быть получен в печи сплавов."
  ],
  "quest.1A000000000003CC.title": "Магналиевая пластина",
  "quest.1A000000000003CE.quest_desc": [
    "Основа для всех механизмов уровня EV."
  ],
  "quest.1A000000000003CE.title": "Корпус механизма (EV)",
  "quest.1A000000000003CF.quest_desc": [
    "Воспользуйтесь пильным станком (как минимум уровня MV)."
  ],
  "quest.1A000000000003CF.title": "Кремниевая пластина, легированная светопылью",
  "quest.1A000000000003D0.quest_desc": [
    "Вы можете изготовить его из пустого шаблона."
  ],
  "quest.1A000000000003D0.title": "Шаблон (Оболочка)",
  "quest.1A000000000003D1.quest_desc": [
    "Сплав меди и никеля. Может быть получен в печи сплавов. Вам нужно подготовить два полных стака медных и никелевых слитков (или пыли), по одному на каждый слиток константана."
  ],
  "quest.1A000000000003D1.title": "Константан",
  "quest.1A000000000003D2.quest_desc": [
    "Используйте протяжный стан, чтобы изготавливать провода с наибольшей эффективностью."
  ],
  "quest.1A000000000003D2.title": "2х Константановый провод",
  "quest.1A000000000003D3.quest_desc": [
    "Могут быть сделаны из шести блоков стекла."
  ],
  "quest.1A000000000003D3.title": "Стеклянная панель (для окон)",
  "quest.1A000000000003D8.quest_desc": [
    "Просто разрежьте блок истинного кварца в пильном станке."
  ],
  "quest.1A000000000003D8.title": "Пластина истинного кварца",
  "quest.1A000000000003DA.quest_desc": [
    "Можно получить его, сжав 4 кристалла кварца."
  ],
  "quest.1A000000000003DA.title": "Кварцевый блок",
  "quest.1A000000000003DB.quest_desc": [
    "Просто разрежьте кварцевый блок в пильном станке."
  ],
  "quest.1A000000000003DB.title": "Пластина кварца Нижнего мира",
  "quest.1A000000000003E1.quest_desc": [
    "Многоблоки, как правило, производят больше, чем 512 eu/t, так что им необходим как минимум EV динамо-люк. Как правило, но не всегда. Вы можете использовать его в любом многоблочном генераторе, производящем менее 512 eu/t."
  ],
  "quest.1A000000000003E1.title": "Динамо-люк (HV)",
  "quest.1A000000000003E2.quest_desc": [
    "Вы можете быстро превращать обычное железо в кованое при помощи электродуговой печи, а затем переплавлять её в сталь в доменной печи, затрачивая совсем немного энергии и времени. Но это потом, а сейчас, на раннем этапе развития вам доступен лишь один способ получения кованого железа. Расплавьте железный слиток в печи и получите железные самородки, затем расплавьте их по отдельности и получите самородки кованого железа. Третий шаг - отправить девять самородков в печь сплавов вместе с шаблоном (слиток)."
  ],
  "quest.1A000000000003E2.title": "Самородок кованого железа",
  "quest.1A000000000003E3.quest_desc": [
    "Высота для поиска: 50 - 80 жила УГЛЯ (уголь, бурый уголь). Вам нужно собрать 40 штук в инвентаре."
  ],
  "quest.1A000000000003E3.title": "Угольная пыль",
  "quest.1A000000000003E4.quest_desc": [
    "Отправьте жемчуг Края в дробитель."
  ],
  "quest.1A000000000003E4.title": "Дроблёный жемчуг Края",
  "quest.1A000000000003E5.quest_desc": [
    "Дорогостоящий компонент некоторых механизмов. Для изготовления необходим осмий."
  ],
  "quest.1A000000000003E5.title": "Генератор поля (LV)",
  "quest.1A000000000003EB.quest_desc": [
    "Может быть произведён из утильсырья."
  ],
  "quest.1A000000000003EB.title": "UU-усилитель",
  "quest.1A000000000003F4.quest_desc": [
    "Многоблок, способный выкачивать жидкости из пространства под коренной породой, если, конечно, там не пустота."
  ],
  "quest.1A000000000003F4.title": "Нефтекачалка",
  "quest.1A000000000003F5.quest_desc": [
    "Может быть изготовлен из стальных стержней при помощи гаечного ключа."
  ],
  "quest.1A000000000003F5.title": "Стальной каркас",
  "quest.1A000000000003F6.quest_desc": [
    "То же, что и обычная, только с повышенным радиусом работы."
  ],
  "quest.1A000000000003F6.title": "Нефтекачалка II",
  "quest.1A000000000003F7.quest_desc": [
    "То же, что и обычная, но с огромным радиусом работы."
  ],
  "quest.1A000000000003F7.title": "Нефтекачалка III",
  "quest.1A000000000003F8.quest_desc": [
    "Вы можете использовать этот многоблок, чтобы расщеплять нефть на фракции с помощью пара или водорода."
  ],
  "quest.1A000000000003F8.title": "Крекер",
  "quest.1A000000000003FB.quest_desc": [
    "Может быть получен в имплозионном компрессоре из низкоуровневых сапфиров, и даже из сапфировой пыли."
  ],
  "quest.1A000000000003FB.title": "Безупречный сапфир",
  "quest.1A000000000003FD.quest_desc": [
    "Чтобы получить его, просто отправьте латекс в центрифугу."
  ],
  "quest.1A000000000003FD.title": "Клей",
  "quest.1A000000000003FE.quest_desc": [
    "Может быть изготовлен в сборочном станке из золотого провода и жидкой резины."
  ],
  "quest.1A000000000003FE.title": "Золотой кабель",
  "quest.1A000000000003FF.quest_desc": [
    "Высота для поиска: 20 - 50 жила ВОЛЬФРАМАТА (шеелит, вольфрамат, литиевая руда). А вот низкоуровневый способ - добыть литиевую пыль из лепидолитовой руды. Высота для поиска: 50 - 60 жила СОЛИ (каменная соль, соль, лепидолит, сподумен). Это сырой источник натрия и лития. Чтобы получить 2 литиевых пыли, вам нужно раздробить 9 блоков лепидолитовой руды и пропустить их через рудопромывочную машину. Это даст вам крошечную кучку литиевой пыли в качестве побочного продукта. Соль нужна для получения натрия через электролизёр. Также для получения литиевой пыли можно перерабатывать сподуменовую руду. В этом случае, чтобы получить литий как побочный продукт, его нужно измельчить, очистить, затем снова измельчить и отправить в центрифугу."
  ],
  "quest.1A000000000003FF.title": "Литиевая пыль",
  "quest.1A00000000000402.quest_desc": [
    "Может преобразовывать напряжение из 128 в 512 eu/t или наоборот."
  ],
  "quest.1A00000000000402.title": "Трансформатор среднего напряжения",
  "quest.1A00000000000403.quest_desc": [
    "Может преобразовывать напряжение из 2048 в 8192 eu/t или наоборот."
  ],
  "quest.1A00000000000403.title": "Экстремальный трансформатор",
  "quest.1A00000000000404.quest_desc": [
    "Может преобразовывать напряжение из 2048 в 8192 eu/t или наоборот."
  ],
  "quest.1A00000000000404.title": "Безумный трансформатор",
  "quest.1A00000000000405.quest_desc": [
    "Может преобразовывать напряжение из 32768 в 131072 eu/t или наоборот."
  ],
  "quest.1A00000000000405.title": "Абсурдный трансформатор",
  "quest.1A00000000000409.quest_desc": [
    "Высота для поиска: 40 - 60 жила АПАТИТА (апатит, фосфат, пирохлор) либо 20 - 30 жила МАРГАНЦА (гроссуляр, спессартин, пиролюзит, танталит). Ниобиевая пыль является побочным продуктом переработки пирохлора, пиролюзита и танталита."
  ],
  "quest.1A00000000000409.title": "Ниобиевая пыль",
  "quest.1A0000000000040A.quest_desc": [
    "Аналог оловянного кабеля, но с повышенными потерями энергии. Также компонент ULV механизмов."
  ],
  "quest.1A0000000000040A.title": "Свинцовый кабель",
  "quest.1A0000000000040B.quest_desc": [
    "Аналог оловянного провода, но с повышенными потерями энергии."
  ],
  "quest.1A0000000000040B.title": "Свинцовый провод",
  "quest.1A0000000000040C.quest_desc": [
    "Основа для всех ULV механизмов. Из него можно сделать самые дешёвые входные и выходные люки/шины для ваших многоблоков. Только имейте в виду, что и вместительность у них будет самая низкая."
  ],
  "quest.1A0000000000040C.title": "Корпус механизма (ULV)",
  "quest.1A0000000000040D.quest_desc": [
    "Может преобразовывать напряжение из 8 в 32 eu/t или наоборот. По умолчанию работает в режиме понижения. Для смены режима нажмите по нему ПКМ с киянкой в руке. Это работает и для всех остальных трансформаторов."
  ],
  "quest.1A0000000000040D.title": "Трансформатор сверхнизкого напряжения",
  "quest.1A0000000000040E.quest_desc": [
    "Может преобразовывать напряжение из 8 в 2048 eu/t или наоборот."
  ],
  "quest.1A0000000000040E.title": "Экстремальный настраиваемый трансформатор",
  "quest.1A0000000000040F.quest_desc": [
    "Может преобразовывать напряжение из 8 в 8192 eu/t или наоборот."
  ],
  "quest.1A0000000000040F.title": "Безумный настраиваемый трансформатор",
  "quest.1A00000000000410.quest_desc": [
    "Может преобразовывать напряжение из 8 в 32768 eu/t или наоборот."
  ],
  "quest.1A00000000000410.title": "Абсурдный настраиваемый трансформатор",
  "quest.1A00000000000411.quest_desc": [
    "Может преобразовывать напряжение из 8 в 131072 eu/t или наоборот."
  ],
  "quest.1A00000000000411.title": "ZPM настраиваемый трансформатор",
  "quest.1A00000000000414.quest_desc": [
    "Может быть изготовлен из обычного титанового стержня."
  ],
  "quest.1A00000000000414.title": "Длинный титановый стержень",
  "quest.1A00000000000416.quest_desc": [
    "Многоблочный генератор. Требует любого турбинного ротора и оптимального потока пара для работы с наивысшей эффективностью."
  ],
  "quest.1A00000000000416.title": "Большая паровая турбина",
  "quest.1A00000000000417.quest_desc": [
    "Может быть изготовлена в MV+ экструдере."
  ],
  "quest.1A00000000000417.title": "Большая стальная жидкостная труба",
  "quest.1A00000000000418.quest_desc": [
    "Может быть изготовлена в лазерном гравировщике из кремниевой пластины с помощью рубиновой линзы."
  ],
  "quest.1A00000000000418.title": "Интегральная логическая электросхема (кремниевая вафля)",
  "quest.1A00000000000419.quest_desc": [
    "Поместите слиток в протяжный стан."
  ],
  "quest.1A00000000000419.title": "Наквадаховый провод",
  "quest.1A0000000000041A.quest_desc": [
    "Поместите пыли или слитки алюминия и магния в печь сплавов, чтобы получить магналиевые слитки."
  ],
  "quest.1A0000000000041A.title": "Магналиевый слиток",
  "quest.1A0000000000041B.quest_desc": [
    "Основные жилы (содержащие алюминий в больших количествах): высота для поиска 50 - 90 жила БОКСИТОВ (бокситы, алюминиевая руда, ильменит), 10 - 40 жила САПФИРОВ (альмандин, пироп, сапфировая руда, руда зелёного сапфира). Так как сейчас вы находитесь на уровне LV, вы сможете добыть алюминий только из алюминиевой руды, сапфировой пыли и пыли зелёного сапфира. Но есть и второстепенные жилы (с малой долей алюминия): высота для поиска 50 - 60 жила СОЛИ (соль, каменная соль, лепидолит, сподумен), 5 - 30 жила БЕРИЛЛИЯ (бериллиевая руда, изумрудная руда, ториевая руда), 10 - 40 жила ОЛИВИНА (бентонит, магнезит, оливин, глауконит). Алюминий в качестве побочного продукта можно получить из следующих руд: сподумен, альмандин, бентонит, глауконит, изумрудная руда."
  ],
  "quest.1A0000000000041B.title": "Алюминиевая пыль",
  "quest.1A0000000000041C.quest_desc": [
    "Используйте экструдер или токарный станок, чтобы изготовить стержни."
  ],
  "quest.1A0000000000041C.title": "Магналиевый стержень",
  "quest.1A0000000000041D.quest_desc": [
    "Воспользуйтесь ЭДП, чтобы выплавить слиток."
  ],
  "quest.1A0000000000041D.title": "Слиток синей стали",
  "quest.1A0000000000041E.quest_desc": [
    "Используйте MV+ экструдер или токарный станок, чтобы изготовить стержень из слитка."
  ],
  "quest.1A0000000000041E.title": "Стержень из синей стали",
  "quest.1A0000000000041F.quest_desc": [
    "Может быть создан из обычных стержней при помощи молота."
  ],
  "quest.1A0000000000041F.title": "Длинный магналиевый стержень",
  "quest.1A00000000000421.quest_desc": [
    "Работает на перегретом паре."
  ],
  "quest.1A00000000000421.title": "Большая паровая турбина высокого давления",
  "quest.1A00000000000422.quest_desc": [
    "Может применяться как в качестве компонента некоторых механизмов, так и по прямому назначению."
  ],
  "quest.1A00000000000422.title": "Большая титановая жидкостная труба",
  "quest.1A00000000000423.quest_desc": [
    "Компонент большой паровой турбины высокого давления."
  ],
  "quest.1A00000000000423.title": "Титановый турбинный корпус",
  "quest.1A00000000000424.quest_desc": [
    "Многоблок, способный производить перегретый пар, используя лаву или горячий хладагент. Его хорошо использовать в связке с большой паровой турбиной высокого давления."
  ],
  "quest.1A00000000000424.title": "Большой теплообменник",
  "quest.1A00000000000425.quest_desc": [
    "Компонент большого теплообменника."
  ],
  "quest.1A00000000000425.title": "Блок титановых обсадных труб",
  "quest.1A00000000000427.quest_desc": [
    "Позволяет изготавливать трубы огромного размера."
  ],
  "quest.1A00000000000427.title": "Форма для экструдера (Огромная труба)",
  "quest.1A00000000000428.quest_desc": [
    "Воспользуйтесь протяжным станом, а затем объедините четыре провода в четырёхкратный."
  ],
  "quest.1A00000000000428.title": "4х Канталовый провод",
  "quest.1A0000000000042A.quest_desc": [
    "Может применяться как в качестве компонента некоторых механизмов, так и по прямому назначению."
  ],
  "quest.1A0000000000042A.title": "Огромная жидкостная труба из вольфрамовой стали",
  "quest.1A0000000000042B.quest_desc": [
    "Лучше, чем предыдущий (работает быстрее)."
  ],
  "quest.1A0000000000042B.title": "Экструдер (HV)",
  "quest.1A0000000000042C.quest_desc": [
    "Может применяться как в качестве компонента некоторых механизмов, так и по прямому назначению."
  ],
  "quest.1A0000000000042C.title": "Огромная жидкостная труба из нержавеющей стали",
  "quest.1A0000000000042D.quest_desc": [
    "Лучше и быстрее, чем предыдущая версия."
  ],
  "quest.1A0000000000042D.title": "Протяжный стан (MV)",
  "quest.1A00000000000438.quest_desc": [
    "Может быть сделан из пустого шаблона с помощью молота."
  ],
  "quest.1A00000000000438.title": "Шаблон (Блок)",
  "quest.1A00000000000439.quest_desc": [
    "Может быть изготовлена в сборочном станке из оловянных оболочек и стеклянной панели. Этот сосуд отлично подойдёт для завершения §dжидкостных квестов§f. Чтобы это сделать, вам нужно налить в неё жидкость, кликнув ПКМ с §3§f§bуниверсальной жидкостной капсулой§f в руке по механизму, содержащему жидкость. Так жидкость извлечётся из механизма в вашу капсулу."
  ],
  "quest.1A00000000000439.title": "Универсальная жидкостная капсула",
  "quest.1A0000000000043B.quest_desc": [
    "Может быть изготовлена из оловянной пластины при помощи молота."
  ],
  "quest.1A0000000000043B.title": "Оловянная оболочка",
  "quest.1A0000000000043C.quest_desc": [
    "Воспользуйтесь токарным станком, чтобы изготовить инваровый стержень из инварового слитка."
  ],
  "quest.1A0000000000043C.title": "Инваровый стержень",
  "quest.1A0000000000043D.quest_desc": [
    "Значительно крепче, чем каменная кирка."
  ],
  "quest.1A0000000000043D.title": "Кирка (кремневая)",
  "quest.1A00000000000440.quest_desc": [
    "Простейшая лопата. Для изготовления нужна лишь древесина."
  ],
  "quest.1A00000000000440.title": "Деревянная лопата",
  "quest.1A00000000000441.quest_desc": [
    "Значительно крепче, чем деревянная лопата."
  ],
  "quest.1A00000000000441.title": "Каменная лопата",
  "quest.1A00000000000442.quest_desc": [
    "Значительно крепче, чем деревянная кирка."
  ],
  "quest.1A00000000000442.title": "Каменная кирка",
  "quest.1A00000000000444.quest_desc": [
    "Лучше, чем обычный паровой котёл, но требует больше угля для нагрева."
  ],
  "quest.1A00000000000444.title": "Угольный паровой котёл высокого давления",
  "quest.1A00000000000445.quest_desc": [
    "Отличный сплав олова и меди. Это основной материал для паровых механизмов."
  ],
  "quest.1A00000000000445.title": "Бронзовый слиток",
  "quest.1A00000000000446.quest_desc": [
    "Распилите любые деревянные доски пилой."
  ],
  "quest.1A00000000000446.title": "Деревянная плита",
  "quest.1A00000000000447.quest_desc": [
    "Может быть использована в качестве компонента рельсовых путей. Вы можете изготовить её вручную на верстаке, но рекомендуется делать это в химической ванне."
  ],
  "quest.1A00000000000447.title": "Деревянная шпала",
  "quest.1A00000000000448.quest_desc": [
    "Применяется в качестве компонента рельсовых путей."
  ],
  "quest.1A00000000000448.title": "Деревянное полотно.",
  "quest.1A00000000000449.quest_desc": [
    "Компонент деревянных путей."
  ],
  "quest.1A00000000000449.title": "Деревянный рельс",
  "quest.1A0000000000044A.quest_desc": [
    "Компонент обычного пути."
  ],
  "quest.1A0000000000044A.title": "Стандартный рельс",
  "quest.1A0000000000044B.quest_desc": [
    "Самый дешёвый, но и самый низкоскоростной рельсовый путь"
  ],
  "quest.1A0000000000044B.title": "Деревянный путь",
  "quest.1A0000000000044C.quest_desc": [
    "Обычный рельсовый путь"
  ],
  "quest.1A0000000000044C.title": "Путь",
  "quest.1A0000000000044E.quest_desc": [
    "Вы можете использовать его в качестве тягового подвижного состава для вашего поезда. Только не забудьте заправить его углём и водой."
  ],
  "quest.1A0000000000044E.title": "Паровой локомотив",
  "quest.1A0000000000044F.quest_desc": [
    "Отличное средство для перемещения по рельсовым путям. Либо же вы можете применить её для автоматической транспортировки ресурсов, например, от буровой установки до базы. Только в этом случае вам придётся использовать один из двух видов локомотивов, чтобы приводить поезд в движение."
  ],
  "quest.1A0000000000044F.title": "Вагонетка",
  "quest.1A00000000000450.quest_desc": [
    "Компонент для колёс вагонетки."
  ],
  "quest.1A00000000000450.title": "Железное кольцо",
  "quest.1A00000000000451.quest_desc": [
    "Часть ББПК (большого бронзового парового котла)."
  ],
  "quest.1A00000000000451.title": "Блок бронзовых обсадных труб",
  "quest.1A00000000000452.quest_desc": [
    "Компонент ББПК (большого бронзового парового котла)."
  ],
  "quest.1A00000000000452.title": "Бронзовый каркас",
  "quest.1A00000000000453.quest_desc": [
    "Просто палочка из бронзы. Может быть использована в качестве компонента для некоторых механизмов."
  ],
  "quest.1A00000000000453.title": "Бронзовый стержень.",
  "quest.1A00000000000454.quest_desc": [
    "HV хранилище энергии."
  ],
  "quest.1A00000000000454.title": "МФЭ",
  "quest.1A00000000000455.quest_desc": [
    "Вы можете поместить МФЭ в вагонетку, чтобы получить передвижное энергохранилище. МФЭ можно в любой момент достать обратно, положив вагонетку с МФЭ в сетку крафта."
  ],
  "quest.1A00000000000455.title": "Вагонетка с МФЭ",
  "quest.1A00000000000456.quest_desc": [
    "Компонент некоторых предметов и механизмов."
  ],
  "quest.1A00000000000456.title": "Стальной корпус коробки передач",
  "quest.1A00000000000457.quest_desc": [
    "Компонент проходческого щита."
  ],
  "quest.1A00000000000457.title": "Укладчик путей",
  "quest.1A00000000000458.quest_desc": [
    "Компонент некоторых предметов и механизмов из Railcraft."
  ],
  "quest.1A00000000000458.title": "Приёмная схема",
  "quest.1A00000000000459.quest_desc": [
    "Подготовьте красители."
  ],
  "quest.1A00000000000459.title": "Красный, жёлтый и лаймовый красители",
  "quest.1A0000000000045A.quest_desc": [
    "Может указывать на точку спауна. Также может служить компонентом для изготовления других предметов."
  ],
  "quest.1A0000000000045A.title": "Компас",
  "quest.1A0000000000045C.quest_desc": [
    "Может устанавливаться в качестве покрытия на GT механизмы, чтобы управлять их состоянием по красному сигналу."
  ],
  "quest.1A0000000000045C.title": "Контроллер механизмов",
  "quest.1A0000000000045D.quest_desc": [
    "Замечательная машина, позволяющая прокладывать широкие тоннели (3 на 3 блока) внутри гор или под землёй. Для работы ей необходимы пути, гравий и уголь; она может забирать их из прицепленной к ней вагонетки с сундуком. Но учитывайте, что эта машина боится лавы, и остановится, если перед ней окажется источник или поток лавы."
  ],
  "quest.1A0000000000045D.title": "Проходческий щит",
  "quest.1A0000000000045E.quest_desc": [
    "Ему необходима вагонетка с МФЭ (или с другим энергохранилищем) в качестве источника тока."
  ],
  "quest.1A0000000000045E.title": "Электровоз",
  "quest.1A00000000000462.quest_desc": [
    "Компонент некоторых предметов и механизмов из Railcraft."
  ],
  "quest.1A00000000000462.title": "Контрольная схема",
  "quest.1A00000000000463.quest_desc": [
    "Устройство, связывающее друг с другом контроллер и приёмник."
  ],
  "quest.1A00000000000463.title": "Настройщик сигнала",
  "quest.1A00000000000465.quest_desc": [
    "Может принимать беспроводной красный сигнал от контроллера сигнала, который был привязан к нему при помощи настройщика сигнала."
  ],
  "quest.1A00000000000465.title": "Приёмник сигнала",
  "quest.1A00000000000466.quest_desc": [
    "Излучает беспроводной красный сигнал, который затем может быть принят приёмником сигнала, который был привязан к данному блоку при помощи настройщика сигнала."
  ],
  "quest.1A00000000000466.title": "Контроллер сигнала",
  "quest.1A0000000000046D.quest_desc": [
    "Создайте портал в Нижний мир - теперь вы можете это сделать."
  ],
  "quest.1A0000000000046D.title": "Портал Нижнего мира",
  "quest.1A0000000000046F.quest_desc": [
    "Просто ведро, внутри которого плещется лава."
  ],
  "quest.1A0000000000046F.title": "Ведро лавы",
  "quest.1A00000000000470.quest_desc": [
    "Пустая оболочка под аккумулятор, которую можно заполнить натрием, литием либо кадмием. А если вам нужен одноразовый аккумулятор, то в качестве электролита используйте ртуть либо серную кислоту."
  ],
  "quest.1A00000000000470.title": "Корпус аккумулятора",
  "quest.1A00000000000474.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A00000000000474.title": "[об] Паровой дробитель",
  "quest.1A00000000000475.quest_desc": [
    "Монтировка - может быть изготовлена из любых металлических стержней и любого синего красителя + молот и напильник. Её используют, чтобы снимать покрытия, например, пластины, установленные на стенки механизмов или труб."
  ],
  "quest.1A00000000000475.title": "Монтировка",
  "quest.1A00000000000478.quest_desc": [
    "Простая табличка, на которой можно что-нибудь написать."
  ],
  "quest.1A00000000000478.title": "Табличка",
  "quest.1A00000000000482.quest_desc": [
    "Часть радиационно-защитного костюма."
  ],
  "quest.1A00000000000482.title": "Защитная куртка",
  "quest.1A00000000000483.quest_desc": [
    "Часть радиационно-защитного костюма."
  ],
  "quest.1A00000000000483.title": "Защитные поножи",
  "quest.1A00000000000484.quest_desc": [
    "Часть радиационно-защитного костюма."
  ],
  "quest.1A00000000000484.title": "Резиновые ботинки",
  "quest.1A00000000000485.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A00000000000485.title": "[об] Угольный паровой котёл",
  "quest.1A00000000000487.quest_desc": [
    "Используйте напильник или токарный станок, чтобы изготовить стержень из латунного слитка."
  ],
  "quest.1A00000000000487.title": "Латунный стержень",
  "quest.1A00000000000488.quest_desc": [
    "Этот автобур берёт на себя ваши заботы. Он может добывать ресурсы (руды), но ему нужны буровые трубы - вам придется изготовить 54 штуки (остальные 10 вы получите в качестве награды). В общей сложности, 64-х буровых труб будет достаточно для извлечения всех руд до самой коренной породы. Правда, это зависит от высоты расположения бура - стака труб хватит в том случае, если он стоит на уровне моря или ниже. Заметьте, что можно снабжать бур напряжением меньше номинального (8 eu/t), и он всё равно будет работать, только медленнее. Так что создавайте бур, загружайте в него буровые трубы, ставьте где вам угодно, обеспечьте его энергией и наслаждайтесь. Кстати, он может автоматически выгружать добытую руду. Зона работы - 17 блоков (8 блоков в каждую сторону)."
  ],
  "quest.1A00000000000488.title": "Автобур (LV)",
  "quest.1A00000000000489.quest_desc": [
    "Это подарок - солнечная панель. Вы можете разместить её в как покрытие поверх любого механизма, батарейного буфера, и даже корпуса механизма. В последнем случае она будет использоваться как \"генератор на солнечной энергии\" - просто поверните его выход в нужном направлении."
  ],
  "quest.1A00000000000489.title": "Солнечная панель",
  "quest.1A0000000000048A.quest_desc": [
    "Вы можете объединить восемь простых солнечных панелей, чтобы сделать одну 8V солнечную панель."
  ],
  "quest.1A0000000000048A.title": "Солнечная панель (8V)",
  "quest.1A0000000000048B.quest_desc": [
    "Используется для того, чтобы держать заданную область чанков постоянно загруженной в память, позволяя игровым процессам протекать в этих чанках вне зависимости от того, присутствует там игрок или нет. Красный сигнал деактивирует загрузчик. Важно всегда проверять область охвата загрузчика, используя опцию \"Показать лазеры\", ибо некоторые механизмы, будучи загруженными некорректно, могут работать не так, как предусматривалось."
  ],
  "quest.1A0000000000048B.title": "Загрузчик чанков",
  "quest.1A0000000000048C.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A0000000000048C.title": "[об] Дробитель высокого давления",
  "quest.1A0000000000048D.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
  "quest.1A0000000000048D.title": "[об] Дробитель (LV)",
  "quest.1A0000000000048E.quest_desc": [
    "Один из многих одноблочных механизмов."
  ],
