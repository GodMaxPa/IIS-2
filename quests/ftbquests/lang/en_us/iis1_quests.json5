    "The main part of all UV machines"
  ],
  "quest.1A000000000002C1.title": "UV Machine Hull",
  "quest.1A000000000002C2.quest_desc": [
    "I hope this machine don't need a description. Just push inside different stuff for experiment or use NEI if you don't like adventures."
  ],
  "quest.1A000000000002C2.title": "Advanced Chemical Reactor",
  "quest.1A000000000002C3.quest_desc": [
    "The part of MV steam and gas turbines. Also may be used for other MV tier machines"
  ],
  "quest.1A000000000002C3.title": "Bronze Rotor",
  "quest.1A000000000002C4.quest_desc": [
    "Like a basic, but works faster and can process recipes with more voltage."
  ],
  "quest.1A000000000002C4.title": "Advanced Distillery",
  "quest.1A000000000002C8.quest_desc": [
    "Take it to hand and right-click on dirt. it is recommended to have a water near in 4 blocks."
  ],
  "quest.1A000000000002C8.title": "Wooden/Stone/Flint Hoe",
  "quest.1A000000000002C9.quest_desc": [
    "Now you have all required stuff to successfully crossbreed plants to get any one plant type and quickly set new plant fields."
  ],
  "quest.1A000000000002C9.title": "Cross breeding LvL 2",
  "quest.1A000000000002CA.quest_desc": [
    ""
  ],
  "quest.1A000000000002CA.title": "Oil",
  "quest.1A000000000002CB.quest_desc": [
    "Use MV (or better) Distillery to get sulfuric naphtha from oil."
  ],
  "quest.1A000000000002CB.title": "Sulfuric Naphtha",
  "quest.1A000000000002CC.quest_desc": [
    "You may get it by chemical reactor from hydrogen and sulfuric naphtha."
  ],
  "quest.1A000000000002CC.title": "Naphtha",
  "quest.1A000000000002CD.quest_desc": [
    "It may be produced by Pyrolyse Oven."
  ],
  "quest.1A000000000002CD.title": "Wood Gas",
  "quest.1A000000000002CE.quest_desc": [
    "May be created from sulfur dust and oxygen with help of programmed circuit (with configuration == 3) by chemical reactor. Also you may get it from sulfur dioxide."
  ],
  "quest.1A000000000002CE.title": "Sulfur Trioxide",
  "quest.1A000000000002CF.quest_desc": [
    "Purified Pentlandite Ore + Nitric Acid by chemical reactor..."
  ],
  "quest.1A000000000002CF.title": "Nickel Sulfate Water Solution",
  "quest.1A000000000002D0.quest_desc": [
    "Purified Chalcopyrite Ore + Nitric Acid by chemical reactor..."
  ],
  "quest.1A000000000002D0.title": "Blue Vitriol Water Solution",
  "quest.1A000000000002D1.quest_desc": [
    "Early tier chemical stuff that may be used to craft the nitric acid. Currently, you have only one way to get this liquid - by using the distillery machine. Later you may create it from hydrogen and nitrogen by HV+ chemical reactor."
  ],
  "quest.1A000000000002D1.title": "Ammonia",
  "quest.1A000000000002D2.quest_desc": [
    "This machine may put in and out fluids of cells."
  ],
  "quest.1A000000000002D2.title": "Basic Fluid Canner",
  "quest.1A000000000002D3.quest_desc": [
    "Use bending machine with programmed circuit #12 to make the cell from tin or steel plates"
  ],
  "quest.1A000000000002D3.title": "Empty Cell",
  "quest.1A000000000002D4.quest_desc": [
    "Ammonia + oxygen (to chemical reactor)"
  ],
  "quest.1A000000000002D4.title": "Nitric Oxide",
  "quest.1A000000000002D5.quest_desc": [
    "...From nitric oxide with oxygen. This is the main component for crafting the nitric acid."
  ],
  "quest.1A000000000002D5.title": "Nitrogen Dioxide",
  "quest.1A000000000002D6.quest_desc": [
