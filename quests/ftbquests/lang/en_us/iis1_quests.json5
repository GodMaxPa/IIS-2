    "May be created from gold ingot by wiremill"
  ],
  "quest.1A000000000003C6.title": "Gold Wire",
  "quest.1A000000000003C7.quest_desc": [
    "A mix of gold and copper dusts"
  ],
  "quest.1A000000000003C7.title": "Rose Gold",
  "quest.1A000000000003C8.quest_desc": [
    "A complex mix of ferrous and non-ferrous metall dusts."
  ],
  "quest.1A000000000003C8.title": "Blue Steel Dust",
  "quest.1A000000000003C9.quest_desc": [
    "A part of Turbine Casing. Use wrench or assembling machine to craft this from blue steel rods."
  ],
  "quest.1A000000000003C9.title": "Blue Steel Frame Box",
