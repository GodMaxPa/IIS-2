  "quest.1A00000000000395.title": "Advanced RE-Batter",
  "quest.1A00000000000397.quest_desc": [
    "Use mixer to blend stone dust and clay dust. Or use quicklime dust instead of clay dust. By this action you will get wet concrete. Than you should use fluid solidifier with mold (block) to get light concrete block."
  ],
  "quest.1A00000000000397.title": "Light Concrete",
  "quest.1A00000000000399.quest_desc": [
    "If you place it to your inventory - it will charging your electric tools in your hands, including nano armor, if you place it to hot keys slots."
  ],
  "quest.1A00000000000399.title": "Charging Energy Crystal",
  "quest.1A0000000000039A.quest_desc": [
