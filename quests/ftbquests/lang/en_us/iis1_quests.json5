  "quest.1A0000000000035C.quest_desc": [
    "Polyphenylene Suflide Foil + molten silicone rubber (small pile by fluid extractor MV tier or better) + small pile of Polyvinyl Chloride Pulp. Use assembling machine for crafting any 8192 eu/t cable from 8192 eu/t wire."
  ],
  "quest.1A0000000000035C.title": "Tungsten Cable",
  "quest.1A0000000000035D.quest_desc": [
    "Height to search: 20 - 50 MOLYBDENUM vein (Wulfenite, Molybdenite, Molybdenum, Powellite). Very rare vein of ore. Other way to get it - as subproduct of scheelite or tungsten ore."
  ],
  "quest.1A0000000000035D.title": "Molybdenum Dust",
  "quest.1A0000000000035E.quest_desc": [
