  "quest.1A00000000000341.title": "Annealed Copper Wire",
  "quest.1A00000000000342.quest_desc": [
    "Create it by bending machine."
  ],
  "quest.1A00000000000342.title": "Gallium Plate",
  "quest.1A00000000000343.quest_desc": [
    "The stuff to craft a circuit."
  ],
  "quest.1A00000000000343.title": "SMD Diode",
  "quest.1A00000000000344.quest_desc": [
    "Use wiremill..."
  ],
  "quest.1A00000000000344.title": "Fine Platinum Wire",
