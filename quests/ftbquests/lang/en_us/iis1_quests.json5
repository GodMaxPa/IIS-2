  "quest.1A00000000000351.title": "Nichrome Ingot",
  "quest.1A00000000000353.quest_desc": [
    "Height to search: 20 - 50 TUNGSTATE vein (Scheelite, Tungstate, Lithium). But it wil be hard to find. So you may use centrifuge MV+ tier to separate lava to get few type of resources including the small pile of tangstate dust with a tiny chance (only 2.5%% per every 100 mb)."
  ],
  "quest.1A00000000000353.title": "Tungstate Dust",
  "quest.1A00000000000354.quest_desc": [
    "Better than basic."
  ],
  "quest.1A00000000000354.title": "Advanced Centrifuge",
