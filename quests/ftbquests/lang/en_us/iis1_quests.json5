    "A part of some ZPM machines."
  ],
  "quest.1A000000000002BD.title": "Field Generator (ZPM)",
  "quest.1A000000000002BF.quest_desc": [
    "May be used to insert up to 524k eu/t to multiblocks"
  ],
  "quest.1A000000000002BF.title": "UV Energy Hatch",
  "quest.1A000000000002C0.quest_desc": [
    "It is a main part of all UV machines."
  ],
  "quest.1A000000000002C0.title": "UV Machine Casing",
