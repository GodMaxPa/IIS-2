  ],
  "quest.1A0000000000039A.title": "Component Heat Exchanger",
  "quest.1A0000000000039B.quest_desc": [
    "Use MV+ Assembling machine with programmed circuit (config #1) to make from LV tier circuit, copper plate and tin plate the Heat Exchanger."
  ],
  "quest.1A0000000000039B.title": "Heat Exchanger",
  "quest.1A0000000000039C.quest_desc": [
    "It may charge your LV and MV electric tools in your hands (on hot keys slots)"
  ],
  "quest.1A0000000000039C.title": "Advanced Charging battery",
  "quest.1A0000000000039D.quest_desc": [
    "Like LV battery. But in times more worse. You have to pour the molten redston of 2 dusts to the fluid canner to fill the LV battery hull."
  ],
  "quest.1A0000000000039D.title": "RE-Battery",
  "quest.1A0000000000039E.quest_desc": [
    "It may charge your LV electric tools in your hands (on hot keys slots)"
  ],
  "quest.1A0000000000039E.title": "Charging RE Batter",
  "quest.1A0000000000039F.quest_desc": [
    "If you wear this backpack instead of you body armor - it will charging your electric tools in your hands, including nano armor, if you place it to hot keys slots."
  ],
  "quest.1A0000000000039F.title": "Energypack",
  "quest.1A000000000003A2.quest_desc": [
    "Karlsson. If you don't know hwo is he - use google =)"
  ],
  "quest.1A000000000003A2.title": "Electric Jetpack",
  "quest.1A000000000003A4.quest_desc": [
    "It is like previous tier but with diamond and by HV+ tier assembling machine."
  ],
  "quest.1A000000000003A4.title": "Advanced Heat Vent",
  "quest.1A000000000003A5.quest_desc": [
    "You may use common water (deprecated) or distil water (recommended) in mixer with lapis dust to prepare this fluid. This may be used for liquid nuclear reactor."
  ],
  "quest.1A000000000003A5.title": "IC2 Coolant",
  "quest.1A000000000003A7.quest_desc": [
