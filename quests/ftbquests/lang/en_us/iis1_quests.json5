  "quest.1A0000000000067C.title": "Bronze Hull",
  "quest.1A0000000000067D.quest_desc": [
    "A part of Primitive Pump Filter"
  ],
  "quest.1A0000000000067D.title": "Primitive Fluid Filter",
  "quest.1A0000000000067E.quest_desc": [
    "To complete this quest you have to craft to hatches: one for input and one for output. Them are required to work of primitive pump. Them tier should be LV or ULV."
  ],
  "quest.1A0000000000067E.title": "Communications for liquids",
  "quest.1A0000000000067F.quest_desc": [
    "A part of some machines or stuffs."
  ],
