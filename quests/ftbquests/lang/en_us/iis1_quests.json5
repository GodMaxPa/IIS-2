  ],
  "quest.1A00000000000326.title": "Extruder Shape (small pipe)",
  "quest.1A00000000000327.quest_desc": [
    "You may compress the oxygen to ut and wear. Also required the oxygen gear and oxygen mask to stay alive in the space and on surface of other planets or moon."
  ],
  "quest.1A00000000000327.title": "Light Oxygen Tank",
  "quest.1A00000000000328.quest_desc": [
    "Put two iron plates to implosion compressor to get the 1 compressed iron."
