  ],
  "quest.1A00000000000308.title": "Double Titanium Plate",
  "quest.1A00000000000309.quest_desc": [
    "Put 2 bronze plates to implosion compressor."
  ],
  "quest.1A00000000000309.title": "Compressed Bronze",
  "quest.1A0000000000030A.quest_desc": [
