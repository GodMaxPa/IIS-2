  "quest.1A0000000000032C.title": "Medium Voltage Chest Buffer",
  "quest.1A0000000000032E.quest_desc": [
    "Height for search: 50-90 BAUXITE vein (Bauxite, Aluminium, Ilmenite). Look at NEI to find a way to get it from Bauxite or Ilmenite ores."
  ],
  "quest.1A0000000000032E.title": "Rutile Dust",
