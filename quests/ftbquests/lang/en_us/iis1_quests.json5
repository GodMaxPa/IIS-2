  "chapter.1D00000000001000.title": "Weapons and vehicles",
  "quest.1A00000000000000.quest_desc": [
    "A part of some IV tier machines."
  ],
  "quest.1A00000000000000.title": "Electric Pump (IV)",
  "quest.1A00000000000001.quest_desc": [
    "Required for the IV tier pump."
  ],
  "quest.1A00000000000001.title": "Stirene-Butadiene Rubber Ring",
  "quest.1A00000000000002.quest_desc": [
    "Required for the IV or higher tier pump."
  ],
  "quest.1A00000000000002.title": "Silicone Rubber Ring",
  "quest.1A00000000000003.quest_desc": [
    "A part of the IV tier pump."
  ],
  "quest.1A00000000000003.title": "Tungstensteel Fluid Pipe",
  "quest.1A00000000000004.quest_desc": [
    "A part of the IV tier pump."
  ],
  "quest.1A00000000000004.title": "Tungstensteel Rotor",
  "quest.1A00000000000005.quest_desc": [
    "A part of the IV tier pump."
  ],
  "quest.1A00000000000005.title": "Tungstensteel Screw",
  "quest.1A00000000000006.quest_desc": [
    "You may produce this out of steel and tungsten ingots."
  ],
  "quest.1A00000000000006.title": "Tungstensteel Ingot",
  "quest.1A00000000000007.quest_desc": [
    "Use any chemical reactor to make rubber from raw pulp. Then you may cast it into plates. Plates may be used as parts for IV+ tier conveyors."
  ],
  "quest.1A00000000000007.title": "Styrene-Butadiene Rubber Sheet",
  "quest.1A00000000000008.quest_desc": [
    "Use sulfur with polydimethylsiloxane to get molten silicon rubber - then you may cast it into sheets."
  ],
  "quest.1A00000000000008.title": "Silicone Rubber Sheet",
  "quest.1A0000000000000E.quest_desc": [
    "A pipe with a huge liquid transfer rate."
  ],
  "quest.1A0000000000000E.title": "Small High Pressure Fluid Pipe",
  "quest.1A00000000000010.quest_desc": [
    "Can be created from molten chrome and molten lutecium in a tier 2 fusion reactor."
  ],
  "quest.1A00000000000010.title": "Americium Ingot",
  "quest.1A00000000000011.quest_desc": [
    "High-tech sensor"
  ],
  "quest.1A00000000000011.title": "Sensor (LuV)",
  "quest.1A00000000000012.quest_desc": [
    "Can be created from molten titanium and molten duranium in a tier 2 fusion reactor."
  ],
  "quest.1A00000000000012.title": "Tritanium Plate",
  "quest.1A00000000000013.quest_desc": [
    "To assemble it, you'll need an assembly line with a ZPM (or better) energy hatch. You'll also need to prepare at least 32 fusion coil blocks and nearly 4 times more fusion machine casings."
  ],
  "quest.1A00000000000013.title": "Fusion Control Computer Mark II",
  "quest.1A00000000000015.quest_desc": [
    "Can be created from the ingot."
  ],
  "quest.1A00000000000015.title": "Naquadah Alloy Plate",
  "quest.1A00000000000016.quest_desc": [
    "Use an EBF with naquadah coil blocks and with a LuV energy hatch to smelt next things: naquadah ingot + osmiridium ingot + argon gas, in order to get two naquadah alloy ingots."
  ],
  "quest.1A00000000000016.title": "Naquadah Alloy Ingot",
  "quest.1A00000000000017.quest_desc": [
    "Screw, rotor and pipe are different, other parts are the same as those for other pumps."
  ],
  "quest.1A00000000000017.title": "Electric Pump (EV)",
  "quest.1A00000000000018.quest_desc": [
    "Can be created from HSS-G rods with a wrench or using an assembling machine."
  ],
  "quest.1A00000000000018.title": "HSS-G Frame box",
  "quest.1A00000000000019.quest_desc": [
    "A part of some HV machines."
  ],
  "quest.1A00000000000019.title": "Sensor (HV)",
  "quest.1A0000000000001A.quest_desc": [
    "This is a great multiblock! You will have to use it to craft LuV tier components such as motors, pistons etc. Also it is very hard to build it for the first time. The only thing harder to build is the fusion reactor."
  ],
  "quest.1A0000000000001A.title": "Assembly Line",
  "quest.1A0000000000001B.quest_desc": [
    "A part of some EV machines."
  ],
  "quest.1A0000000000001B.title": "Sensor (EV)",
  "quest.1A0000000000001C.quest_desc": [
    "Tungstensteel plates, an osmium rod, an ender eye and an IV circuit - not so hard."
  ],
  "quest.1A0000000000001C.title": "Sensor (IV)",
  "quest.1A0000000000001D.quest_desc": [
    "A part of HV tier machines."
  ],
  "quest.1A0000000000001D.title": "Emitter (HV)",
  "quest.1A0000000000001E.quest_desc": [
    "Can be created from the ingot using a Lathe or an Extruder."
  ],
  "quest.1A0000000000001E.title": "Platinum Rod",
  "quest.1A0000000000001F.quest_desc": [
    "You have to prepare and build a blast furnace with kanthal coil blocks and with a HV energy hatch (or better) in order to smelt titanium ingots."
  ],
  "quest.1A0000000000001F.title": "Titanium Ingot",
  "quest.1A00000000000020.quest_desc": [
    "The drop of endermans."
  ],
  "quest.1A00000000000020.title": "Ender Pearl",
  "quest.1A00000000000021.quest_desc": [
    "Height to search: 40 - 50 PLATINUM vein (Sheldonite, Palladium, Platinum and Iridium). Or you may look it up in NEI and find another way to obtain platinum."
  ],
  "quest.1A00000000000021.title": "Platinum",
  "quest.1A00000000000022.quest_desc": [
    "Can be created from an osmium ingot using a Lathe or an Extruder."
  ],
  "quest.1A00000000000022.title": "Osmium Rod",
  "quest.1A00000000000023.quest_desc": [
    "Use an EBF with nichrome coil blocks (or better) to smelt the dust into the ingot."
  ],
  "quest.1A00000000000023.title": "Osmium Ingot",
  "quest.1A00000000000024.quest_desc": [
    "A form for crafting Engineering Processors."
  ],
  "quest.1A00000000000024.title": "Inscriber Engineering Press",
  "quest.1A00000000000025.quest_desc": [
    "You may create it from 9 steel ingots."
  ],
  "quest.1A00000000000025.title": "Dense Steel Plate",
  "quest.1A00000000000026.quest_desc": [
    "Use a Lathe to produce the lens from the exquisite gem."
  ],
  "quest.1A00000000000026.title": "Yellow Garnet Lens",
  "quest.1A00000000000027.quest_desc": [
    "A form for crafting a Calculation Processor."
  ],
  "quest.1A00000000000027.title": "Inscriber Calculation Press",
  "quest.1A00000000000028.quest_desc": [
    "Use a compressor to create one of these: Sapphire, Opal or Blue Topaz Block."
  ],
  "quest.1A00000000000028.title": "Blue (compressed) Block",
  "quest.1A0000000000002A.quest_desc": [
    "Prepare 9 blue gems such as: Sapphire, Blue Topaz or Opal."
  ],
  "quest.1A0000000000002A.title": "Nine Blue Gems",
  "quest.1A0000000000002B.quest_desc": [
    "A form for crafting a Printed Silicon."
  ],
  "quest.1A0000000000002B.title": "Inscriber Silicon Press",
  "quest.1A0000000000002C.quest_desc": [
    "A cheap alternative for a Diamond Lens. You can make it from a glass pane. Look it up in NEI."
  ],
  "quest.1A0000000000002C.title": "Glass Lens",
  "quest.1A0000000000002D.quest_desc": [
    "Put an Exquisite Gem into a Lathe."
  ],
  "quest.1A0000000000002D.title": "Diamond Lens",
  "quest.1A0000000000002E.quest_desc": [
    "A form for crafting a Logic Processor."
  ],
  "quest.1A0000000000002E.title": "Inscriber Logic Press",
  "quest.1A0000000000002F.quest_desc": [
    "Put an Exquisite Gem into a Lathe."
  ],
  "quest.1A0000000000002F.title": "Green Sapphire Lens",
  "quest.1A00000000000030.quest_desc": [
    "The storage weight shows how much data (items) you can store on it. 1k - the smallest one."
  ],
  "quest.1A00000000000030.title": "1k ME Storage Component",
  "quest.1A00000000000031.quest_desc": [
    "Use an assembling machine (of any tier)."
  ],
  "quest.1A00000000000031.title": "Logic Processor",
  "quest.1A00000000000032.quest_desc": [
    "Use a macerator."
  ],
  "quest.1A00000000000032.title": "Fluix Dust",
  "quest.1A00000000000033.quest_desc": [
    "It is a box with an interface to connect it to a ME chest or to a ME Drive."
  ],
  "quest.1A00000000000033.title": "ME Storage Housing",
  "quest.1A00000000000034.quest_desc": [
    "It is like a flash card - it can store your items. Also it is ready to be plugged into a ME chest / ME Drive."
  ],
  "quest.1A00000000000034.title": "1k ME Storage Cell",
  "quest.1A00000000000035.quest_desc": [
    "A multistorage for ME storage cells. But it doesn't have its own interface, so you have to create an ME terminal first."
  ],
  "quest.1A00000000000035.title": "ME Drive",
  "quest.1A00000000000036.quest_desc": [
    "The \"window\" through which you can see what items do you have in this network."
  ],
  "quest.1A00000000000036.title": "ME Terminal",
  "quest.1A00000000000037.quest_desc": [
    "Certus or nether quartz rods + pure fluix crystal + logic processor."
  ],
  "quest.1A00000000000037.title": "Cores",
  "quest.1A00000000000038.quest_desc": [
    "An AE2 display. It can show the number of items for selected item in your ME network. Also it can be just a component for crafting."
  ],
  "quest.1A00000000000038.title": "Illuminated Panel",
  "quest.1A00000000000039.quest_desc": [
    "The heart of your network. It can provide 32 channels to each side of it. Also you may extend it by adding several more blocks. Limit is 7 blocks in each direction."
  ],
  "quest.1A00000000000039.title": "ME Controller",
  "quest.1A0000000000003A.quest_desc": [
    "Use an assembling machine (of any tier)."
  ],
  "quest.1A0000000000003A.title": "Engineering Processor",
  "quest.1A0000000000003B.quest_desc": [
    "It shows you what recipes have already been added to an autocraft config."
  ],
  "quest.1A0000000000003B.title": "ME Pattern Terminal",
  "quest.1A0000000000003C.quest_desc": [
    "You may setup a pattern of any recipe to configure autocraft. Even if it doesn't use crafting table and has to be processed by any machine of gregtech."
  ],
  "quest.1A0000000000003C.title": "Blank Pattern",
  "quest.1A0000000000003D.quest_desc": [
    "It will show you what patterns are already used, and where, but with low accuracy."
  ],
  "quest.1A0000000000003D.title": "ME Interface Terminal",
  "quest.1A0000000000003E.quest_desc": [
    "It is the same as the block version, but it doesn't take additional space and it can be placed as a cover on ME cables."
  ],
  "quest.1A0000000000003E.title": "ME Interface (cover)",
  "quest.1A0000000000003F.quest_desc": [
    "Glowstone + fluid extractor --> molten glowstone + Mold Plate + Solidifier --> Glowstone Plate."
  ],
  "quest.1A0000000000003F.title": "Glowstone Plate",
  "quest.1A00000000000040.quest_desc": [
    "Height to search: 40 - 80 QUARTZ vein (Quartzite, Barite, Certus Quartz). Certus Quartz is important stuff for most machines of AE2."
  ],
  "quest.1A00000000000040.title": "Certus Quartz",
  "quest.1A00000000000041.quest_desc": [
    "Combine it with any storage component to get the crafting storage. Then connect it to your ME network. Without this block(s) you can't order items to autocraft them."
  ],
  "quest.1A00000000000041.title": "Crafting Unit",
  "quest.1A00000000000042.quest_desc": [
    "The main difference from previous tier, in addition to the higher speed, is the ability to get by-products."
  ],
  "quest.1A00000000000042.title": "Universal Macerator",
  "quest.1A00000000000043.quest_desc": [
    "Can store AE2 energy inside of it. Usually used as a small buffer between gregtech energy and AE2 energy systems. This energy cell cannot take energy directly from GT cables, so you'll have to use an energy acceptor."
  ],
  "quest.1A00000000000043.title": "Energy Cell",
  "quest.1A00000000000044.quest_desc": [
    "The only way to transform Gregtech energy into AE2 energy. Can consume any voltage."
  ],
  "quest.1A00000000000044.title": "Energy Acceptor",
  "quest.1A00000000000045.quest_desc": [
    "Use a Compressor."
  ],
  "quest.1A00000000000045.title": "Fluix Block",
  "quest.1A00000000000046.quest_desc": [
    "A mix of an Ender Pearl and Blaze Powder."
  ],
  "quest.1A00000000000046.title": "Eye of Ender",
  "quest.1A00000000000047.quest_desc": [
    "This is just a crushed blaze rod."
  ],
  "quest.1A00000000000047.title": "Blaze Powder",
  "quest.1A00000000000048.quest_desc": [
    "Go to hell, bastard! Sorry, I mean, you just have to go to the Nether in order to find a blaze and obtain blaze rods."
  ],
  "quest.1A00000000000048.title": "Blaze Rod",
  "quest.1A00000000000049.quest_desc": [
    "Use a Compressor to produce this block from 9 items."
  ],
  "quest.1A00000000000049.title": "Block of Endereye",
  "quest.1A0000000000004A.quest_desc": [
    "Compressor can... yeah, compress! :)"
  ],
  "quest.1A0000000000004A.title": "Compressor",
  "quest.1A0000000000004B.quest_desc": [
    "Use a cutting machine to split the block into plates."
  ],
  "quest.1A0000000000004B.title": "Endereye Plate",
  "quest.1A0000000000004C.quest_desc": [
    "4 * pure fluix crystal + 4 * endereye plate + ender pearl."
  ],
  "quest.1A0000000000004C.title": "Fluix Pearl",
  "quest.1A0000000000004D.quest_desc": [
    "You can craft it from a common fluix crystal by crushing it with a hammer. Then put Fluix dust into a chemical reactor with sand to get fluix seeds. The last step is autoclave."
  ],
  "quest.1A0000000000004D.title": "Pure Fluix Crystal",
  "quest.1A0000000000004E.quest_desc": [
    "This is a multiblock that allows you to connect two parts of a ME network that are placed far away from each other (even on different planets), but only if you have enough channels and the ME controller is in one place. BUT... first you have to get a Quantum Entangled Singularity."
  ],
  "quest.1A0000000000004E.title": "ME Quantum Link Chamber",
  "quest.1A0000000000004F.quest_desc": [
    "A part of a Quantum ring multiblock."
  ],
  "quest.1A0000000000004F.title": "ME Quantum Ring",
  "quest.1A00000000000050.quest_desc": [
    "Can be crafted from 4 * 1K ME storage component."
  ],
  "quest.1A00000000000050.title": "4k ME Storage Component",
  "quest.1A00000000000051.quest_desc": [
    "Can be crafted from 4k ME storage components."
  ],
  "quest.1A00000000000051.title": "16k ME Storage Component",
  "quest.1A00000000000052.quest_desc": [
    "Can be crafted from 16k ME storage components."
  ],
  "quest.1A00000000000052.title": "64k ME Storage Component",
  "quest.1A00000000000053.quest_desc": [
    "Use a matter condenser - put the 64k ME storage component in its top slot, then provide them with 256k of any trash items or liquids - it will produce the Singularity for you."
  ],
  "quest.1A00000000000053.title": "Singularity",
  "quest.1A00000000000054.quest_desc": [
    "A non-electric machine that can be used as a simple unlimited waste box."
  ],
  "quest.1A00000000000054.title": "Matter Condenser",
  "quest.1A00000000000055.quest_desc": [
    "To make a pair of it, prepare any explosives. Then, drop the singularity and 1 enderpearl (not endereye) dust near (not on top) the explosives block, and make the bang."
  ],
  "quest.1A00000000000055.title": "Quantum Entangled Singularity",
  "quest.1A00000000000056.quest_desc": [
    "Is it okay to create 1 plate from 2 ingots with a hand-held hammer? Of course not! Is it more profitable to use 3 ingots to create 2 plates via steam forge hammer? Not bad, but with this bending machine you will craft one-to-one, ingot-to-plate."
  ],
  "quest.1A00000000000056.title": "Basic Bending Machine",
  "quest.1A00000000000057.quest_desc": [
    "Find or craft (with an implosion compressor from dust) 9 yellow garnet gems."
  ],
  "quest.1A00000000000057.title": "Yellow Garnet (gem)",
  "quest.1A00000000000058.quest_desc": [
    "It can help you to sift purified ore of any gems to obtain great gems with a small chance, and moreover, it will give you a more profitable result."
  ],
  "quest.1A00000000000058.title": "Basic Sifting Machine",
  "quest.1A00000000000059.quest_desc": [
    "You can produce it with a sifting machine from purified crushed ore. Another way is to use an implosion compressor to get the output from low level gems or even gem dust."
  ],
  "quest.1A00000000000059.title": "Exquisite Blue Gem",
  "quest.1A0000000000005B.quest_desc": [
    "Use an Inscriber Calculation Press with a certus quartz plate or with a Pure certus quartz crystal (latter one is cheaper)."
  ],
  "quest.1A0000000000005B.title": "Printed Calculation Circuit",
  "quest.1A0000000000005C.quest_desc": [
    "Use an assembling machine (of any tier)."
  ],
  "quest.1A0000000000005C.title": "Calculation Processor",
  "quest.1A0000000000005D.quest_desc": [
    "Use an Inscriber Silicon Press with a Silicone Plate."
  ],
  "quest.1A0000000000005D.title": "Printed Silicon",
  "quest.1A0000000000005E.quest_desc": [
    "Use an Inscriber Logic Press with a Gold Plate."
  ],
  "quest.1A0000000000005E.title": "Printed Logic Circuit",
  "quest.1A0000000000005F.quest_desc": [
    "Use an Inscriber Engineering Press with a Diamond Plate."
  ],
  "quest.1A0000000000005F.title": "Engineering Circuit",
  "quest.1A00000000000060.quest_desc": [
    "Use a lathe to create the rod from nether quartz."
  ],
  "quest.1A00000000000060.title": "Nether Quartz Rod",
  "quest.1A00000000000061.quest_desc": [
    "Use lathe to create the rod from certus quartz"
  ],
  "quest.1A00000000000061.title": "Certus Quartz Rod",
  "quest.1A00000000000062.quest_desc": [
    "You may produce it with a sifting machine from purified crushed ore. Another way is to use an implosion compressor to get the output from low level gems."
  ],
  "quest.1A00000000000062.title": "Exquisite Yellow Garnet",
  "quest.1A00000000000063.quest_desc": [
    "This block is some kind of a connector between an ME network and outside world. You can input any items into this block, and if it is connected to a ME chest or drive with storage components with enough free space, the items will be stored in there..."
  ],
  "quest.1A00000000000063.title": "ME Interface",
  "quest.1A00000000000065.quest_desc": [
    "Charged certus quartz crystal + redstone + nether quartz in a mixer with water will give you Fluix Crystal."
  ],
  "quest.1A00000000000065.title": "Fluix Crystal",
  "quest.1A00000000000066.quest_desc": [
    "Stick + redstone"
  ],
  "quest.1A00000000000066.title": "Redstone Torch",
  "quest.1A00000000000067.quest_desc": [
    "Redstone quests chain. Height for search: 10-40 REDSTONE vein (Redstone, Ruby and Cinnabar)."
  ],
  "quest.1A00000000000067.title": "Real Redstone",
  "quest.1A00000000000068.quest_desc": [
    "Calc. processor + redstone torch. You may place this item onto a glass cable and configure it to emit redstone signal depending on the number of certain items. It can help you to automatically start/stop some production processes."
  ],
  "quest.1A00000000000068.title": "ME Level Emitter",
  "quest.1A00000000000069.quest_desc": [
    "It is an empty card that may be used as a part of other cards."
  ],
  "quest.1A00000000000069.title": "Basic Card",
  "quest.1A0000000000006A.quest_desc": [
    "Copper + redstone (using an alloy smelter) to get a red alloy ingot. Then create a plate from it."
  ],
  "quest.1A0000000000006A.title": "Red Alloy Plate",
  "quest.1A0000000000006B.quest_desc": [
    "Can be used to add more filter options for a storage/import/export bus."
  ],
  "quest.1A0000000000006B.title": "Capacity Card",
  "quest.1A0000000000006C.quest_desc": [
    "Advanced Card version"
  ],
  "quest.1A0000000000006C.title": "Advanced Card",
  "quest.1A0000000000006D.quest_desc": [
    "Increases work rate rate of import/export buses."
  ],
  "quest.1A0000000000006D.title": "Acceleration Card",
  "quest.1A0000000000006E.quest_desc": [
    "This card is almost useless by itself but is necessary as a part of some other items."
  ],
  "quest.1A0000000000006E.title": "Fuzzy Card",
  "quest.1A00000000000070.quest_desc": [
    "It exports selected item(s) to a selected chest/machine."
  ],
  "quest.1A00000000000070.title": "ME Export Bus",
  "quest.1A00000000000071.quest_desc": [
    "It is a very helpful tool that allows you to control and configure most of the items and blocks of your ME network."
  ],
  "quest.1A00000000000071.title": "Yeta Wrench",
  "quest.1A00000000000072.quest_desc": [
    "With this multiblock machine you will be able to produce steel faster. Also you may smelt there other refractory metals. For the first run on LV tier use 3 LV energy hatches and connect to them a battery buffer with at least 5 small LV batteries to send 5 amperes (via 8x Tin cable). Or you may use only 2 LV energy hatches with a battery buffer with at less 2 small LV batteries closely connected to each hatch. Note that energy losses at LV tier are high, so don't use long wire connections (in any cases)."
  ],
  "quest.1A00000000000072.title": "Electric blast furnace",
  "quest.1A00000000000073.quest_desc": [
    "It can dismantle gregtech machines, connect or disconnect pipes, set the direction of a gas or steam flow."
  ],
  "quest.1A00000000000073.title": "Wrench (gregtech)",
  "quest.1A00000000000074.quest_desc": [
    "Use a metal bender."
  ],
  "quest.1A00000000000074.title": "Tungstensteel Plate",
  "quest.1A00000000000075.quest_desc": [
    "You may craft it from the plate using a hammer. But if you have MV (or better) extruder, you can use it to make small gears directly from the ingot."
  ],
  "quest.1A00000000000075.title": "Small Tungstensteel Gear",
  "quest.1A00000000000076.quest_desc": [
    "The recipe is the same as for previous tier piston, but the basic material is tungstensteel."
  ],
  "quest.1A00000000000076.title": "Electric Piston (IV)",
  "quest.1A00000000000077.quest_desc": [
    "The recipe is the same as for previous tier robot arm, but it uses IV tier components."
  ],
  "quest.1A00000000000077.title": "Robot Arm (IV)",
  "quest.1A00000000000078.quest_desc": [
    "Tungstensteel casing."
  ],
  "quest.1A00000000000078.title": "IV Machine Casing",
  "quest.1A00000000000079.quest_desc": [
    "A machine hull for all IV tier machines."
  ],
  "quest.1A00000000000079.title": "IV Machine Hull",
  "quest.1A0000000000007A.quest_desc": [
    "A part of an AL (assembly line). Requires the following items to craft: an MV motor, a steel rotor, a steel frame box and iron bars."
  ],
  "quest.1A0000000000007A.title": "Grate Machine Casing",
  "quest.1A0000000000007B.quest_desc": [
    "For crafting you need to prepare: 6 EV tier circuits, an IV circuit, a tungstensteel frame box and an electric motor (IV)."
  ],
  "quest.1A0000000000007B.title": "Assembler Machine Casing",
  "quest.1A0000000000007C.quest_desc": [
    "For crafting you need to prepare: 4 steel plates, 2 IV robot arms, a tungstensteel frame box and some tools (a hammer and a wrench)."
  ],
  "quest.1A0000000000007C.title": "Assembling Line Casing",
  "quest.1A0000000000007D.quest_desc": [
    "You have to use at least an IV energy hatch for assembly line recipes."
  ],
  "quest.1A0000000000007D.title": "IV Energy Hatch",
  "quest.1A0000000000007E.quest_desc": [
    "Place it near the AL (assembly line) controller block to store data sticks for recipes."
  ],
  "quest.1A0000000000007E.title": "Data Access Hatch",
  "quest.1A0000000000007F.quest_desc": [
    "A motor for MV tier machines."
  ],
  "quest.1A0000000000007F.title": "Electric Motor (MV)",
  "quest.1A00000000000080.quest_desc": [
    "A part of some IV tier machines."
  ],
  "quest.1A00000000000080.title": "Electric Motor (IV)",
  "quest.1A00000000000081.quest_desc": [
    "Height to search: 40 - 50 PLATINUM vein (Sheldonite, Palladium, Platinum, Iridium), 10 - 40 SOAPSTONE vein (Soapstone, Talc, Glauconite, Pentlandite), 10 - 40 NICKEL vein (Garnierite, Nickel, Cobaltite, Pentlandite), 10 - 30 COPPER vein (Chalcopyrite, Iron, Pyrite, Copper). All these veins can be a source of osmium. Just process Iridium, Pentlandite or Chalcopyrite ores to get an osmium as by-product."
  ],
  "quest.1A00000000000081.title": "Osmium Dust",
  "quest.1A00000000000082.quest_desc": [
    "Use an EBF with an EV energy hatch to get osmiridium alloy. It consists of osmium, iridium and helium (as a catalyst)."
  ],
  "quest.1A00000000000082.title": "Osmiridium Ingot",
  "quest.1A00000000000083.quest_desc": [
    "Use a fluid extractor MV+ tier to get helium from monazite."
  ],
  "quest.1A00000000000083.title": "Helium Gas",
  "quest.1A00000000000084.quest_desc": [
    "An EV tier energy hatch - it can consume up to 2048 eu/t."
  ],
  "quest.1A00000000000084.title": "EV Energy Hatch",
  "quest.1A00000000000085.quest_desc": [
    "Use an EBF with Nichrome coils (or better) to smelt Iridium dust into the ingot."
  ],
  "quest.1A00000000000085.title": "Iridium Ingot",
  "quest.1A00000000000086.quest_desc": [
    "There are at least two ways to use it: RMB click on a seismic prospector, after it finished its work; and the second way is: using as an info storage item for an assembly line recipe."
  ],
  "quest.1A00000000000086.title": "Data Stick",
  "quest.1A00000000000087.quest_desc": [
    "Sure, for scanning you also may use the LV scanner, but the difference in energy is not that great for your current industrial level, yet it will work 2 times faster than an LV tier scanner. Anyway, to complete this quest, you have to craft any scanner with a tier between LV and IV."
  ],
  "quest.1A00000000000087.title": "Scanner",
  "quest.1A00000000000088.quest_desc": [
    "Don't craft it without special necessity. You may, of course, but for what? Btw, for this quest any tier machine will do."
  ],
  "quest.1A00000000000088.title": "Printer",
  "quest.1A00000000000089.quest_desc": [
    "A part of high tech machines."
  ],
  "quest.1A00000000000089.title": "Emitter (MV)",
  "quest.1A0000000000008A.quest_desc": [
    "A part of high tech machines."
  ],
  "quest.1A0000000000008A.title": "Sensor (MV)",
  "quest.1A0000000000008B.quest_desc": [
    "A part of an Ore Drilling Plant III."
  ],
  "quest.1A0000000000008B.title": "Osmiridium Frame Box",
  "quest.1A0000000000008C.quest_desc": [
    "Requires an assembly line which will be used to craft the LuV motor. But before that, you have to scan the previous tier motor (IV) with a scanner to write the info to a data stick which then will be used by an assembly line to assemble the LuV motor."
  ],
  "quest.1A0000000000008C.title": "Electric Motor (LuV)",
  "quest.1A0000000000008D.quest_desc": [
    "There few ways to craft it, use NEI."
  ],
  "quest.1A0000000000008D.title": "Long Magnetic Neodymium Rod",
  "quest.1A0000000000008E.quest_desc": [
    "A part of LuV motors."
  ],
  "quest.1A0000000000008E.title": "Long HSS-G rod",
  "quest.1A0000000000008F.quest_desc": [
    "Use a wiremill..."
  ],
  "quest.1A0000000000008F.title": "Fine Annealed Copper Wire",
  "quest.1A00000000000090.quest_desc": [
    "Use the same wire isolation as for other IV+ tier cables."
  ],
  "quest.1A00000000000090.title": "Yttrium Barium Cuprate Cable",
  "quest.1A00000000000091.quest_desc": [
    "The controller of a wonderful multiblock that allows you to rest instead of digging ores. This machine can do your digging work for you, but you need to feed it with mining pipes and ore drilling fluid."
  ],
  "quest.1A00000000000091.title": "Ore Drilling Plant III",
  "quest.1A00000000000092.quest_desc": [
    "An LuV Tier Circuit."
  ],
  "quest.1A00000000000092.title": "Nanoprocessor Mainframe",
  "quest.1A00000000000093.quest_desc": [
    "Use an HV tier polarizer on a neodymium rod. A Neodymium ingot can be obtained using an EBF because using a regular furnace won't work."
  ],
  "quest.1A00000000000093.title": "Magnetic Neodymium Rod",
  "quest.1A00000000000094.quest_desc": [
    "Use an EBF with Tungstensteel Coil Blocks to smelt HSS-G dust into the Ingot."
  ],
  "quest.1A00000000000094.title": "HSS-G Ingot",
  "quest.1A00000000000095.quest_desc": [
    "You can make it from a regular copper ingot with oxygen using an EBF or an Arc furnace."
  ],
  "quest.1A00000000000095.title": "Annealed Copper",
  "quest.1A00000000000096.quest_desc": [
    "Use an EBF with tungstensteel coil blocks or better to get the ingot from YBC dust."
  ],
  "quest.1A00000000000096.title": "Yttrium Barium Cuprate Ingot",
  "quest.1A00000000000097.quest_desc": [
    "Prepare next dusts to make the dust of YCB metal mix: Yttrium (1), Copper (3) and Barium (2)."
  ],
  "quest.1A00000000000097.title": "Yttrium Barium Cuprate Dust",
  "quest.1A00000000000098.quest_desc": [
    "Height to search: 40 - 80 QUARTZ vein (Quartzite, Barite and Certus Quartz). You may find it in a certus quartz ore vein. Also you may get it as by-product of quartzite and certus quartz ores."
  ],
  "quest.1A00000000000098.title": "Barium Dust",
  "quest.1A00000000000099.quest_desc": [
    "You have to centrifuge Rare Earth, that you may get as by-product from the following ores: redstone, bastnasite, neodymium, monazite. Height to search: 20-40 MONAZITE vein (Bastnasite, Monazite, Neodymium), 10-40 REDSTONE vein (Redstone, Ruby, Cinnabar)."
  ],
  "quest.1A00000000000099.title": "Yttrium Dust",
  "quest.1A0000000000009B.quest_desc": [
    "Use an iron ingot and charcoal or charcoal blocks to get steel ingots."
  ],
  "quest.1A0000000000009B.title": "First Steel",
  "quest.1A0000000000009C.quest_desc": [
    "You don't have to craft it immediately. But it will be required in the future. Just slice a diamond block by a cutting machine."
  ],
  "quest.1A0000000000009C.title": "Diamond Plate",
  "quest.1A0000000000009E.quest_desc": [
    "Can be created from an HSS-G ingot with a bending machine."
  ],
  "quest.1A0000000000009E.title": "HSS-G Plate",
  "quest.1A0000000000009F.quest_desc": [
    "HSS-G ingot >> rod >> bolt >> screw."
  ],
  "quest.1A0000000000009F.title": "HSS-G Screw",
  "quest.1A000000000000A0.quest_desc": [
    "HSS-G ingot >> plate >> small gear (using a hammer)."
  ],
  "quest.1A000000000000A0.title": "Small HSS-G Gear",
  "quest.1A000000000000A1.quest_desc": [
    "You may get it from the previous charging item using an advanced heat exchanger and a lapotron crystal."
  ],
  "quest.1A000000000000A1.title": "Charging Lapotron Crystal",
  "quest.1A000000000000A2.quest_desc": [
    "This cable may use any voltage, but it is limited in maximum amperes like other cables. Use NEI to find and apply one of the eight recipes."
  ],
  "quest.1A000000000000A2.title": "Superconductor Wire",
  "quest.1A000000000000A3.quest_desc": [
    "To make a tin alloy ingot you have to smelt iron and tin 1-to-1 in an alloy smelter. Then use a bender to make the plate."
  ],
  "quest.1A000000000000A3.title": "Tin Alloy",
  "quest.1A000000000000A4.quest_desc": [
    "Height for search: 10-40 IRON ORE vein (Brown Limonite, Yellow Limonite, Banded Iron, Malachite) or 50-120 MAGNETITE vein (Magnetite, Iron, VanadiumMagnetite) or 10 - 30 COPPER vein (Chalcopyrite, Iron, Pyrite, Copper). Find and smelt Iron/Magnetite/Limonite/Banded Iron ores to get an iron ingot. Note that with level 1 pickaxe (stone or flint one) you can only dig Brown Limonite ore. Other ores require at least second level pickaxe to dig them out. Another way to find iron ore is to dig it out of a small ore block."
  ],
  "quest.1A000000000000A4.title": "Iron",
  "quest.1A000000000000A5.quest_desc": [
    "Height for search: 40-120 TIN vein (Cassiterite, Tin). Melt tin ore to get a tin ingot. Also you may smelt an \"Impure Pile of Tin Dust\", which you can find by breaking small tin ore blocks."
  ],
  "quest.1A000000000000A5.title": "Tin",
  "quest.1A000000000000A6.quest_desc": [
    "Height to search: 5 - 30 BERYLLIUM vein (Beryllium, Emerald, Thorium). Use a regular furnace to get ingot. Then use a bender to get a plate."
  ],
  "quest.1A000000000000A6.title": "Beryllium",
  "quest.1A000000000000A7.quest_desc": [
    "Craft a furnace to smelt ores or cook food. Note! some quests contain two rewards: fixed and one more is variation. Variation you may choose in the bottom of this window by click arrow right."
  ],
  "quest.1A000000000000A7.title": "First Furnace",
  "quest.1A000000000000A8.quest_desc": [
    "It may be used in nuclear power."
  ],
  "quest.1A000000000000A8.title": "Neutron Reflector",
  "quest.1A000000000000A9.quest_desc": [
    "It may be used in nuclear power."
  ],
  "quest.1A000000000000A9.title": "Thick Neutron Reflector",
  "quest.1A000000000000AA.quest_desc": [
    "With a hammer or a bender."
  ],
  "quest.1A000000000000AA.title": "Double Beryllium Plate",
  "quest.1A000000000000AB.quest_desc": [
    "It may extend inner working area of a nuclear reactor."
  ],
  "quest.1A000000000000AB.title": "Reactor Chamber",
  "quest.1A000000000000AC.quest_desc": [
    "This is a complex multiblock. It may consist of a controller block and up to 6 reactor chambers (on each side of the reactor)."
  ],
  "quest.1A000000000000AC.title": "Nuclear Reactor",
  "quest.1A000000000000AD.quest_desc": [
    "An EV tier Robot Arm."
  ],
  "quest.1A000000000000AD.title": "Robot Arm (EV)",
  "quest.1A000000000000AE.quest_desc": [
    "Height to search: 20 - 30 URANIUM vein (Uraninite, Uranium), 10 - 40 PITCHBLENDE vein (Pitchblende, Uraninite)."
  ],
  "quest.1A000000000000AE.title": "Uranium 238 Ingot",
  "quest.1A000000000000B0.quest_desc": [
    "Use an alloy smelter to get this from 6 uranium-238 ingots and 3 uranium-235 nuggets."
  ],
  "quest.1A000000000000B0.title": "Enriched Uranium Nuclear Fuel",
  "quest.1A000000000000B1.quest_desc": [
    "Height to search: 20 - 30. You may get uranium-235 as by-product only from uraninite and uranium ores."
  ],
  "quest.1A000000000000B1.title": "Uranium 235 Nugget",
  "quest.1A000000000000B2.quest_desc": [
    "For starters, you have to craft an Iron or Bronze pickaxe head. Then use a wooden stick to make a second level pickaxe. It can dig most of gregtech ores (but not all). Later you can craft a level 3 pickaxe from §9cobalt §for §bdiamonds§f."
  ],
  "quest.1A000000000000B2.title": "2 Level Pickaxe",
  "quest.1A000000000000B3.quest_desc": [
    "Put EUNF into an empty fuel rod with a canning machine."
  ],
  "quest.1A000000000000B3.title": "Fuel Rod (Uranium)",
  "quest.1A000000000000B4.quest_desc": [
    "You can craft this from an iron ingot in an extruder using a mold shape. Or just use a bending machine with a programmed circuit with the second configuration."
  ],
  "quest.1A000000000000B4.title": "Fuel Rod",
  "quest.1A000000000000B6.quest_desc": [
    "Put 3 thorium dusts to an empty fuel rod using a canning machine."
  ],
  "quest.1A000000000000B6.title": "Fuel Rod (Thorium)",
  "quest.1A000000000000B7.quest_desc": [
    "Height to search: 5 - 30. You can find it in a beryllium ore vein. Another way to get it - as by-product of coal, monazite, uraninite, uranium or pitchblende ores (look it up in NEI)."
  ],
  "quest.1A000000000000B7.title": "Thorium Dust",
  "quest.1A000000000000B8.quest_desc": [
    "Prepare at least 3 dusts to create a cycle between a furnace and a chemical reactor in order to produce Radon (gas)."
  ],
  "quest.1A000000000000B8.title": "Plutonium 239 Dust",
  "quest.1A000000000000B9.quest_desc": [
    "One of the two materials to fuse americium."
  ],
  "quest.1A000000000000B9.title": "Lutetium Dust",
  "quest.1A000000000000BA.quest_desc": [
    "This shit is an important part of most low tier conveyors."
  ],
  "quest.1A000000000000BA.title": "Rubber Sheet",
  "quest.1A000000000000BB.quest_desc": [
    "Use any tier chemical reactor to produce Radon from 3 plutonium-239 ingots."
  ],
  "quest.1A000000000000BB.title": "Radon",
  "quest.1A000000000000BC.quest_desc": [
    "Use HV+ tier chemical reactor to make an indium concentrate fluid from purified galena and sphalerite ores with sulfuric acid."
  ],
  "quest.1A000000000000BC.title": "Indium Concentrate",
  "quest.1A000000000000BD.quest_desc": [
    "Height to search galena ore (overworld): 30 - 60. Height to search sphalerite ore (nether): 5 - 20. Height to search phosphorus ore (overworld): 40 - 60."
  ],
  "quest.1A000000000000BD.title": "Ores Set",
  "quest.1A000000000000BF.quest_desc": [
    "You may get this only as by-product of cobaltite ore."
  ],
  "quest.1A000000000000BF.title": "Arsenic Ingot",
  "quest.1A000000000000C0.quest_desc": [
    "Height to search: 10-40 NICKEL vein (Garnierite, Nickel, Cobaltite, Pentlandite). You can create a cobalt pickaxe that can dig even diamond blocks. To make a cobalt ingot from cobaltite dust you have to put it into your primitive blast furnace with coal or charcoal. Or you can directly put cobaltite ore into a regular furnace (but with lower efficiency). In the second case you will get 1 ingot per ore block instead of 2 ingots per block ore when using a macerator and a primitive blast furnace."
  ],
  "quest.1A000000000000C0.title": "Cobaltite Dust",
  "quest.1A000000000000C1.quest_desc": [
    "The Ender Eye after washing it in a chemical bath with radon."
  ],
  "quest.1A000000000000C1.title": "Quantum Eye",
  "quest.1A000000000000C2.quest_desc": [
    "Mix the indium, gallium and phosphorus dusts."
  ],
  "quest.1A000000000000C2.title": "Indium Galium Phosphide Dust",
  "quest.1A000000000000C3.quest_desc": [
    "Use an EV+ chemical reactor to get a tiny pile of indium dust from indium concentrate and aluminium dust."
  ],
  "quest.1A000000000000C3.title": "Indium Dust",
  "quest.1A000000000000C4.quest_desc": [
    "An EV tier chemical reactor."
  ],
  "quest.1A000000000000C4.title": "Advanced Chemical Reactor III",
  "quest.1A000000000000C5.quest_desc": [
    "An HV tier Chemical Bath."
  ],
  "quest.1A000000000000C5.title": "Advanced Chemical Bath II",
  "quest.1A000000000000C6.quest_desc": [
    "Can be used as a part of some HV machines."
  ],
  "quest.1A000000000000C6.title": "Electric Pump (HV)",
  "quest.1A000000000000C7.quest_desc": [
    "A basic component to craft circuits from EV to ZPM tier."
  ],
  "quest.1A000000000000C7.title": "QBit Wafer",
  "quest.1A000000000000C8.quest_desc": [
    "A basic component to craft HV+ tier Circuits."
  ],
  "quest.1A000000000000C8.title": "NanoCPU Wafer",
  "quest.1A000000000000C9.quest_desc": [
    "A part of a Processing Array multiblock."
  ],
  "quest.1A000000000000C9.title": "Robust Tungstensteel Machine Casing",
  "quest.1A000000000000CA.quest_desc": [
    "This multiblock provides you with the convenient utilization of space and allows you to gain the working power of any sixteen GT machines operating simultaneously. Note that you have to feed it with power sufficient for all of the machines used. For example, if you put inside 16 LV electrolyzers to get gas products from water, you'll need 480 eu/t and an HV (or better) energy hatch (30 eu/t * 16 = 480 eu/t)."
  ],
  "quest.1A000000000000CA.title": "Processing Array",
  "quest.1A000000000000CB.quest_desc": [
    "The 8 k eu\\t battery"
  ],
  "quest.1A000000000000CB.title": "Lapotronic Energy Orb",
  "quest.1A000000000000CC.quest_desc": [
    "A part of an Advanced Processing Array multiblock."
  ],
  "quest.1A000000000000CC.title": "Robust HSS-G Machine Casing",
  "quest.1A000000000000CD.quest_desc": [
    "... from the ingot using a metal bender."
  ],
  "quest.1A000000000000CD.title": "Europium Plate",
  "quest.1A000000000000CE.quest_desc": [
    "This multiblock provides you with the convenient utilization of space and allows you to gain the working power of any 64 GT machines operating simultaneously. Note that you have to feed it with power sufficient for all of the machines used. For example, if you put inside 64 LV electrolyzers to get gas products from water, you'll need 1920 eu/t and an EV (or better) energy hatch (30 eu/t * 64 =1920 eu/t)."
  ],
  "quest.1A000000000000CE.title": "Advanced Processing Array",
  "quest.1A000000000000CF.quest_desc": [
    "Can be created using an AL."
  ],
  "quest.1A000000000000CF.title": "Robot Arm (LuV)",
  "quest.1A000000000000D0.quest_desc": [
    "You can get it from deuterium that in turn can be produced from hydrogen."
  ],
  "quest.1A000000000000D0.title": "Tritium",
  "quest.1A000000000000D1.quest_desc": [
    "You can get it from hydrogen."
  ],
  "quest.1A000000000000D1.title": "Deuterium",
  "quest.1A000000000000D3.quest_desc": [
    "Pour water into an electrolyzer, or find any other way to get it."
  ],
  "quest.1A000000000000D3.title": "Hydrogen Gas",
  "quest.1A000000000000D4.quest_desc": [
    "To produce it, you have to use a Fusion reactor tier 1."
  ],
  "quest.1A000000000000D4.title": "Helium Plasma",
  "quest.1A000000000000D5.quest_desc": [
    "Use an Assembly Line to craft this controller block. You also have to prepare other interfaces (all hatches must be at least of LuV tier). Required items: Fusion Coil block / 4 ZPM circuits (one per assembly line input bus) / Plutonium 241 plate / Nether star Plate / 2 Field Generator IV / 32 HPIC Wafers / 32 Superconductor wires / 20 molten ingots of soldering alloy (2880 L for input hatch) Also, an assembly line with a length of at least 11 blocks is required."
  ],
  "quest.1A000000000000D5.title": "Fusion Controll Computer Mark I",
  "quest.1A000000000000D6.quest_desc": [
    "To produce it, you have to use a Fusion reactor tier 1."
  ],
  "quest.1A000000000000D6.title": "Oxygen Plasma",
  "quest.1A000000000000D7.quest_desc": [
    "To produce it, you have to use a Fusion reactor tier 2."
  ],
  "quest.1A000000000000D7.title": "Sulfur Plasma",
  "quest.1A000000000000D8.quest_desc": [
    "To produce it, you have to use a Fusion reactor tier 2."
  ],
  "quest.1A000000000000D8.title": "Nitrogen Plasma",
  "quest.1A000000000000D9.quest_desc": [
    "Height for search: 50-60 SALTS vein (Rock Salt, Salt, Lepidolite, Spodumene)."
  ],
  "quest.1A000000000000D9.title": "Rock Salt",
  "quest.1A000000000000DA.quest_desc": [
    "To produce it, you have to use a Fusion reactor tier 3."
  ],
  "quest.1A000000000000DA.title": "Iron Plasma",
  "quest.1A000000000000DB.quest_desc": [
    "To assemble it you'll need an assembly line with a UV (or better) energy hatch. You'll also need to prepare at least 32 fusion coil blocks and nearly 4 times more fusion machine casings MK2."
  ],
  "quest.1A000000000000DB.title": "Fusion Control Computer Mark III",
  "quest.1A000000000000DC.quest_desc": [
    "Use an electrolyzer to get potassium from rock salt."
  ],
  "quest.1A000000000000DC.title": "Potassium Dust",
  "quest.1A000000000000DD.quest_desc": [
    "To produce it, you have to use a Fusion reactor tier 3."
  ],
  "quest.1A000000000000DD.title": "Nickel Plasma",
  "quest.1A000000000000DE.quest_desc": [
    "A component used for crafting LV, MV and HV tiers electronic circuits. You can obtain it by dicing an engraved wafer that can be produced using a precision laser with a ruby lens."
  ],
  "quest.1A000000000000DE.title": "Integrated Logic Circuit",
  "quest.1A000000000000DF.quest_desc": [
    "The substrate for electronic circuits."
  ],
  "quest.1A000000000000DF.title": "Wafer",
  "quest.1A000000000000E0.quest_desc": [
    "Just drop wood logs into a macerator to get wood pulp. Place it to an assembly machine with mold plate and glue. To get glue, use a centrifuge and sticky resin. Another way is not so profitable because of higher consumption of glue - use a cell with glue and 8 wood pulps to make a Phenolic Circuit Board on a crafting table."
  ],
  "quest.1A000000000000E0.title": "Phenolic Circuit Board",
  "quest.1A000000000000E1.quest_desc": [
    "A component used for crafting LV, MV and HV tiers electronic circuits. You can obtain it by dicing an engraved wafer that can be produced using a precision laser with a ruby lens."
  ],
  "quest.1A000000000000E1.title": "Integrated Logic Circuit",
  "quest.1A000000000000E2.quest_desc": [
    "Smelt 9 tin and 1 antimony ingots in an alloy smelter to get 10 soldering alloy ingots."
  ],
  "quest.1A000000000000E2.title": "Soldering Alloy Ingot",
  "quest.1A000000000000E3.quest_desc": [
    "An MV tier circuit that can be upgraded into a HV tier circuit. Can be created by a Circuit Assembly Machine. Use NEI for more details."
  ],
  "quest.1A000000000000E3.title": "Good Integrated Circuit",
  "quest.1A000000000000E4.quest_desc": [
    "A part of circuits."
  ],
  "quest.1A000000000000E4.title": "Transistor",
  "quest.1A000000000000E5.quest_desc": [
    "One of the most required items for many chemical processes and circuit crafting."
  ],
  "quest.1A000000000000E5.title": "Polyethylene Sheet",
  "quest.1A000000000000E6.quest_desc": [
    "Height to search: 10-40. For starters, find a sapphire ore vein. Then use a Sifting machine to get an exquisite green sapphire from crushed green sapphire ore."
  ],
  "quest.1A000000000000E6.title": "Exquisite Green Sapphire",
  "quest.1A000000000000E7.quest_desc": [
    "Another type of wafer."
  ],
  "quest.1A000000000000E7.title": "RAM chip (wafer)",
  "quest.1A000000000000E8.quest_desc": [
    "A RAM chip often used for crafting circuits."
  ],
  "quest.1A000000000000E8.title": "Random Access Memory Chip",
  "quest.1A000000000000E9.quest_desc": [
    "Height to search: 30-60 GALENA vein (Galena, Silver, Lead). You may find silver ore in a vein of galena ore."
  ],
  "quest.1A000000000000E9.title": "Silver Ingot",
  "quest.1A000000000000EA.quest_desc": [
    "An alloy of silver and gold (use an alloy smelter)."
  ],
  "quest.1A000000000000EA.title": "Electrum Ingot",
  "quest.1A000000000000EB.quest_desc": [
    "Height to search: 60-80 GOLD vein (Magnetite, Vanadium Magnetite, Gold). Find gold inside a vein of magnetite ore and smelt it to get an ingot. Also you may meet it in small gold ore blocks. So, \"impure pile of Gold dust\" can be smelted into a gold ingot as well."
  ],
  "quest.1A000000000000EB.title": "Gold Ingot",
  "quest.1A000000000000EC.quest_desc": [
    "An HV tier Circuit."
  ],
  "quest.1A000000000000EC.title": "Advanced Circuit",
  "quest.1A000000000000ED.quest_desc": [
    "Use a wiremill..."
  ],
  "quest.1A000000000000ED.title": "Fine Electrum Wire",
  "quest.1A000000000000EE.quest_desc": [
    "Can produce circuits like the basic tier machine, but more powerful ones."
  ],
  "quest.1A000000000000EE.title": "Advanced Circuit Assembling",
  "quest.1A000000000000EF.quest_desc": [
    "An MV tier robot arm."
  ],
  "quest.1A000000000000EF.title": "Robot Arm (MV)",
  "quest.1A000000000000F0.quest_desc": [
    "Use an extruder or a lathe to get it from an ingot."
  ],
  "quest.1A000000000000F0.title": "Electrum Rod",
  "quest.1A000000000000F1.quest_desc": [
    "Use an autoclave to get nether quartz from nether dust or just smelt nether quartz ore (block) using a furnace or put nether quartz ore (block) into a forge hammer."
  ],
  "quest.1A000000000000F1.title": "Nether Quartz (gem or dust)",
  "quest.1A000000000000F2.quest_desc": [
    "Height to search: 10-40 REDSTONE vein (Redstone, Ruby, Cinnabar). You may get it from ruby dust via an advanced electrolyzer. Also ruby dust can be produced from redstone dust."
  ],
  "quest.1A000000000000F2.title": "Chrome Dust",
  "quest.1A000000000000F3.quest_desc": [
    "It can disintegrate most chemical compounds to simple substances."
  ],
  "quest.1A000000000000F3.title": "Advanced Electrolyzer",
  "quest.1A000000000000F4.quest_desc": [
    "Put aluminium dust into an EBF (Electric blast furnace) and wait for 85 seconds. Don't forget to feed EBF with sufficient energy during the process (at least 204k of energy per one aluminium ingot excluding energy loss on transmission by wires)."
  ],
  "quest.1A000000000000F4.title": "Aluminium Ingot",
  "quest.1A000000000000F5.quest_desc": [
    "Better than a simple electronic circuit. Can be used to craft MV tier machines."
  ],
  "quest.1A000000000000F5.title": "Good Electronic Circuit",
  "quest.1A000000000000F6.quest_desc": [
    "Height to search: 20-30 MANGANESE vein (Grossular, Spessartine, Pyrolusite, Tantalite). Find a vein with tantalite, pyrolusite or spessartine ore. You may get manganese from all of them as by-product."
  ],
  "quest.1A000000000000F6.title": "Manganese Dust",
  "quest.1A000000000000F7.quest_desc": [
    "The main material for HV tier machines."
  ],
  "quest.1A000000000000F7.title": "Stainless Steel Ingot",
  "quest.1A000000000000F8.quest_desc": [
    "A part of HV steam and gas turbines. Also can be used for other HV tier machines."
  ],
  "quest.1A000000000000F8.title": "Stainless Steel Rotor",
  "quest.1A000000000000F9.quest_desc": [
    "A motor for HV tier machines."
  ],
  "quest.1A000000000000F9.title": "Electric Motor (HV)",
  "quest.1A000000000000FA.quest_desc": [
    "A base for any HV tier machines."
  ],
  "quest.1A000000000000FA.title": "HV Machine Hull",
  "quest.1A000000000000FB.quest_desc": [
    "An HV tier piston."
  ],
  "quest.1A000000000000FB.title": "Electric Piston (HV)",
  "quest.1A000000000000FC.quest_desc": [
    "A controller for a cleanroom multiblock. This is a room designed for placing there precision laser engravers in order to produce high tech items. Min size is 3 by 3 and height is 4."
  ],
  "quest.1A000000000000FC.title": "Cleanroom Controller",
  "quest.1A000000000000FD.quest_desc": [
    "Silver, Gold and Copper - that is all you need to craft it."
  ],
  "quest.1A000000000000FD.title": "Black Bronze Dust",
  "quest.1A000000000000FE.quest_desc": [
    "Height for search: 10-30 COPPER vein (Chalcopyrite, Iron, Pyrite, Copper) or 80-120 TETRAHEDRITE vein (Tetrahedrite, Copper, Stibnite). Melt copper ore to get a copper ingot. Also you may smelt an \"Impure Pile of Copper Dust\", which you can find by breaking small copper ore blocks."
  ],
  "quest.1A000000000000FE.title": "Copper",
  "quest.1A000000000000FF.quest_desc": [
    "Black Bronze, Nickel and Steel - that is all. Use NEI."
  ],
  "quest.1A000000000000FF.title": "Black Steel Dust",
  "quest.1A00000000000100.quest_desc": [
    "Height for search: 10-40 NICKEL vein (Garnierite, Nickel, Cobaltite, Pentlandite). Find and smelt nickel ore (or Pentlandite or Garnierite) to get a nickel ingot."
  ],
  "quest.1A00000000000100.title": "Nickel",
  "quest.1A00000000000102.quest_desc": [
    "You may craft it from rods."
  ],
  "quest.1A00000000000102.title": "Black Steel Frame Box",
  "quest.1A00000000000103.quest_desc": [
    "Height for search: 5-20 DIAMOND vein (Graphite, Diamond, Coal). You have to sift purified diamond ore to find an exquisite diamond - it would be a nice raw stuff to create the diamond lens."
  ],
  "quest.1A00000000000103.title": "Exquisite Diamond",
  "quest.1A00000000000104.quest_desc": [
    "With this lathe it will become possible to avoid the need to produce a diamond lens from an Exquisite Diamond. Just craft a glass pane in order to make a glass lens from it. It may be used in the same recipes as the diamond one."
  ],
  "quest.1A00000000000104.title": "Advanced Lathe II",
  "quest.1A00000000000105.quest_desc": [
    "Warning! You may get it via laser engraver only if it will be placed inside a working cleanroom. The result is directly related to the efficiency of the cleanroom. As such, after the cleanroom started working, you should wait until it completely filters the air inside of it."
  ],
  "quest.1A00000000000105.title": "Central Processing Unit (Wafer)",
  "quest.1A00000000000106.quest_desc": [
    "A component of circuits."
  ],
  "quest.1A00000000000106.title": "Central Processing Unit",
  "quest.1A00000000000107.quest_desc": [
    "The best and most cheap circuit for LV tier machines."
  ],
  "quest.1A00000000000107.title": "Microprocessor",
  "quest.1A00000000000108.quest_desc": [
    "A component of electronic devices."
  ],
  "quest.1A00000000000108.title": "Capacitor",
  "quest.1A00000000000109.quest_desc": [
    "It will help you to craft circuits from LV to IV. To craft this use a polyethylene sheet, copper foil and sulfuric acid. Use NEI for more info."
  ],
  "quest.1A00000000000109.title": "Plastic Circuit Board",
  "quest.1A0000000000010A.quest_desc": [
    "Best circuit for MV tier machines."
  ],
  "quest.1A0000000000010A.title": "Integrated Processor",
  "quest.1A0000000000010B.quest_desc": [
    "Use a wiremill twice - to get wire from an ingot and to get fine wire from wire."
  ],
  "quest.1A0000000000010B.title": "Fine Red Alloy Wire",
  "quest.1A0000000000010C.quest_desc": [
    "A basic electronic component."
  ],
  "quest.1A0000000000010C.title": "Small Coil",
  "quest.1A0000000000010E.quest_desc": [
    "Height for search is not defined, because there are no existing veins of zinc ore. Find a Crushed Zinc Ore. It is one of the materials used to craft a filter for sifting machine. Also it is the only source of gallium dust at your current industrial level."
  ],
  "quest.1A0000000000010E.title": "Crushed Zinc Ore",
  "quest.1A00000000000110.quest_desc": [
    "An EV tier circuit."
  ],
  "quest.1A00000000000110.title": "Workstation",
  "quest.1A00000000000111.quest_desc": [
    "The only way to obtain it from a regular steel rod is using an Electromagnetic Polarizer."
  ],
  "quest.1A00000000000111.title": "Magnetic Steel Rod",
  "quest.1A00000000000112.quest_desc": [
    "HV batteries that you may create by using a large battery hull. Can contain sodium, cadmium or lithium. To complete this quest, you have to craft any one of them."
  ],
  "quest.1A00000000000112.title": "Large Battery",
  "quest.1A00000000000113.quest_desc": [
    "Use a wiremill to make it."
  ],
  "quest.1A00000000000113.title": "Fine Tin Wire",
  "quest.1A00000000000114.quest_desc": [
    "Regular walls for a vacuum freezer."
  ],
  "quest.1A00000000000114.title": "Frost Proof Machine Casing",
  "quest.1A00000000000115.quest_desc": [
    "Primary purpose of this machine is cooling hot ingots that you may get from a blast furnace."
  ],
  "quest.1A00000000000115.title": "Vacuum Freezer",
  "quest.1A00000000000116.quest_desc": [
    "Use stainless steel plates."
  ],
  "quest.1A00000000000116.title": "HV Machine Casing",
  "quest.1A00000000000117.quest_desc": [
    "...with a hammer or a metal bender."
  ],
  "quest.1A00000000000117.title": "Electrum Foil",
  "quest.1A00000000000118.quest_desc": [
    "A mix of Aluminium + Iron + Chrome."
  ],
  "quest.1A00000000000118.title": "Kanthal Dust",
  "quest.1A00000000000119.quest_desc": [
    "It is a material for crafting next tier coil blocks for a Blast Furnace / pyrolyse oven / multi smelter. Now it is HOT! Don't keep it in your inventory for a long time, at least not without a rubber suit. To cool it, you have to use a vacuum freezer."
  ],
  "quest.1A00000000000119.title": "Hot Kanthal Ingot",
  "quest.1A0000000000011A.quest_desc": [
    "This miner can do your job for you. It can dig up resources (ores), but it requires mining pipes - you have to craft 54 of them (other 10 you will receive as a reward). In total, 64 mining pipes will be enough to dig up all the ores above bedrock. But the quality of work depends on the height where you place your miner, it may affect its ability to dig up all ores above bedrock. For example, it can dig up all ores below the sea level with one stack (64 items) of mining pipes inside it. Note, that you may provide your miner with lesser (than 8 eu/t) energy and it will be ok (but it may work slower). So, when you craft a miner and mining pipes, you may place your miner anywhere. Then just put mining pipes inside it, provide it with energy and enjoy. Btw, it can auto output mined ores."
  ],
  "quest.1A0000000000011A.title": "Advanced Miner",
  "quest.1A0000000000011B.quest_desc": [
    "Use a hammer / forge hammer to make a tin plate."
  ],
  "quest.1A0000000000011B.title": "Tin Plate",
  "quest.1A0000000000011C.quest_desc": [
    "An Electronic Circuit is the main item to craft any electronic machines."
  ],
  "quest.1A0000000000011C.title": "Electronic Circuit",
  "quest.1A0000000000011D.quest_desc": [
    "An important part of a steam turbine. To craft it you have to prepare 4 tin plates, a tin ring and a tin screw. Tin rings are crafted from tin rods with a hammer. Tin screws - also from tin rods, but using a saw and a file. The following tools are required for rotor crafting: a hammer, a file and a screwdriver."
  ],
  "quest.1A0000000000011D.title": "Tin Rotor",
  "quest.1A0000000000011E.quest_desc": [
    "Use 4 redstone dusts and an iron rod to craft a Magnetic Iron Rod. Good advice for you: craft the§6§6§0§1§2§3§b Basic Polarize§f§br§f to polarize rods without consuming redstone. It is not required, but is strongly recommended to save redstone to apply it for other goals."
  ],
  "quest.1A0000000000011E.title": "Magnetic Iron Rod",
  "quest.1A0000000000011F.quest_desc": [
    "Use a file on an ingot to make the rod. Later you will be able to make it using a lathe or an extruder."
  ],
  "quest.1A0000000000011F.title": "Iron Rod",
  "quest.1A00000000000120.quest_desc": [
    "It is time to craft an Electric motor (LV). You will find a lot of items where it can be used."
  ],
  "quest.1A00000000000120.title": "Electric Motor (LV)",
  "quest.1A00000000000121.quest_desc": [
    "Craft a Tin Cable. It is a basic cable for LV tier."
  ],
  "quest.1A00000000000121.title": "1x Tin Cable",
  "quest.1A00000000000122.quest_desc": [
    "Can convert voltage between 512 and 2048 eu/t both ways."
  ],
  "quest.1A00000000000122.title": "High Voltage Transformer",
  "quest.1A00000000000123.quest_desc": [
    "Craft the carpet from black wool. One more usage for wool is shredding it in order to get strings."
  ],
  "quest.1A00000000000123.title": "Black Carpet",
  "quest.1A00000000000125.quest_desc": [
    "To craft any LV machine you first have to craft an LV Machine Casing."
  ],
  "quest.1A00000000000125.title": "LV Machine Casing",
  "quest.1A00000000000126.quest_desc": [
    "The Steam Turbine is close. Next step is the LV machine hull - craft it now."
  ],
  "quest.1A00000000000126.title": "LV machine Hull",
  "quest.1A00000000000127.quest_desc": [
    "The tech chain is as follows: Iron ingot (to a furnace)-> iron nuggets (also to a furnace) -> wrought Iron nuggets, smelt them with use of a specific mold into a wrought iron ingot with an alloy smelter. And a wrought Iron ingot can be easily transformed into a wrought iron plate."
  ],
  "quest.1A00000000000127.title": "Wrought Iron Plate",
  "quest.1A00000000000128.quest_desc": [
    "Yes! It is time to craft your first energy generator!"
  ],
  "quest.1A00000000000128.title": "Basic Steam Turbine",
  "quest.1A00000000000129.quest_desc": [
    "Craft a file from 2 iron or bronze plates. Plates can produced from ingots. Btw, unlike other tools, a file has no other uses. It can be used only as a part of crafting recipes."
  ],
  "quest.1A00000000000129.title": "File (gregtech)",
  "quest.1A0000000000012A.quest_desc": [
    "Use your allow smelter to smelt an Invar Ingot from 2 parts of iron and 1 part of nickel. You have to craft at least §b56§r ingots."
  ],
  "quest.1A0000000000012A.title": "Invar Ingot",
  "quest.1A0000000000012B.quest_desc": [
    "You can use this to make rods more efficiently. Now it will return you 1 dust from 2 ingots of any metal."
  ],
  "quest.1A0000000000012B.title": "Basic Lathe",
  "quest.1A0000000000012C.quest_desc": [
    "Main Frame material for an electric blast furnace."
  ],
  "quest.1A0000000000012C.title": "Invar Frame Box",
  "quest.1A0000000000012D.quest_desc": [
    "Craft 6 items to continue your industrialization."
  ],
  "quest.1A0000000000012D.title": "Invar plate",
  "quest.1A0000000000012E.quest_desc": [
    "It can push. Maybe."
  ],
  "quest.1A0000000000012E.title": "Electric piston (LV)",
  "quest.1A0000000000012F.quest_desc": [
    "This casing is the base for an EBF (electric blast furnace)."
  ],
  "quest.1A0000000000012F.title": "Heat proof machine casing",
  "quest.1A00000000000130.quest_desc": [
    "A part of a piston. You can easily craft it with a hammer from the plate, but this is not a profitable way."
  ],
  "quest.1A00000000000130.title": "Small steel gear",
  "quest.1A00000000000131.quest_desc": [
    "You should be already familiar with all parts of a pump. except a few new ones: tin screw and paper or rubber ring. A pump is not only a part of other machines, it is also a useful tool to transport fluids in and out of machines. Click RMB + Shift on a placed pump to open GUI."
  ],
  "quest.1A00000000000131.title": "Electric Pump (LV)",
  "quest.1A00000000000133.quest_desc": [
    "Tin ingot + file = tin rod / tin rod + saw = 2*Tin bolt / 2*Tin bolt + file = tin screw. Profit! In fact, profit can be earned if you craft 8 screws from 1 tin ingot. So, use NEI to find the best crafts chain to achieve this result."
  ],
  "quest.1A00000000000133.title": "Tin Screw",
  "quest.1A00000000000134.quest_desc": [
    "If you choose to make a buffer with 9 slots for batteries, it is important to place there only 8 batteries or less and use 8x tin cable to prevent fire. But you may also craft a battery buffer with 4 or 16 slots. Note that each battery inside it adds 1 ampere."
  ],
  "quest.1A00000000000134.title": "Low Voltage Battery Buffer (4-16)",
  "quest.1A00000000000135.quest_desc": [
    "These blocks are designed to be a source of heat for blast furnaces in order to smelt metals and alloys. You need to craft 16 coils for one blast furnace. Also these coils can be used to build a pyrolyse oven."
  ],
  "quest.1A00000000000135.title": "Cupronickel Coil Block",
  "quest.1A00000000000136.quest_desc": [
    "Soft Mallet - you can craft it from wood planks and sticks. The most important usage of this tool is turning on/off machines, including electrical multiblocks. Multiblocks are turned off by default."
  ],
  "quest.1A00000000000136.title": "Soft Mallet",
  "quest.1A00000000000137.quest_desc": [
    "Just craft it after making wooden planks."
  ],
  "quest.1A00000000000137.title": "Crafting Table",
  "quest.1A00000000000138.quest_desc": [
    "This block is required for most of gregtech multiblock machines. For starters, prepare following tools: a screwdriver, a wrench, a wire cutter, a hammer, a crowbar, a file, a saw and a soft mallet. Then place them in a crafting table around an LV machine hull."
  ],
  "quest.1A00000000000138.title": "Maintenance Hatch",
  "quest.1A00000000000139.quest_desc": [
    "This is one of the tools that can help you in maintenance of your multiblocks. To complete a quest you have to charge it a bit."
  ],
  "quest.1A00000000000139.title": "Soldering Iron",
  "quest.1A0000000000013A.quest_desc": [
    "It can disintegrate most chemical compounds to simple substances."
  ],
  "quest.1A0000000000013A.title": "Basic Electrolyzer",
  "quest.1A0000000000013B.quest_desc": [
    "A large crafting multitask. The task list is below. All crafted blocks will be used to build a Blast Furnace."
  ],
  "quest.1A0000000000013B.title": "Interfaces of Blast Furnace",
  "quest.1A0000000000013C.quest_desc": [
    "Height for search: 80-120 TETRAHEDRITE vein (Tetrahedrite, Copper, Stibnite). Find Stibnite or Tetrahedrite ores to get antimony from them. Use NEI to get more info."
  ],
  "quest.1A0000000000013C.title": "Antimony Ingot",
  "quest.1A0000000000013D.quest_desc": [
    "Use a Canning machine to fill the battery hull with lithium."
  ],
  "quest.1A0000000000013D.title": "Small Lithium Battery",
  "quest.1A0000000000013E.quest_desc": [
    "The cheapest battery because it is easy to find materials to craft it. But it has the worst energy capacity. Anyway, it is better than nothing."
  ],
  "quest.1A0000000000013E.title": "Small Sodium Battery",
  "quest.1A0000000000013F.quest_desc": [
    "Height for search: 30-60 GALENA vein (Galena, Silver, Lead). Find lead ore and smelt it to get lead ingots. But there is more than one way to get Lead. It is not necessary to dig up galena ore with the hope of finding lead ore there. You may just smelt an \"Impure Pile Of Lead dust\" to get a lead ingot."
  ],
  "quest.1A0000000000013F.title": "Lead Ingot",
  "quest.1A00000000000140.quest_desc": [
    "A machine used for canning. You can use it to produce canned food or to fill up batteries with sodium, cadmium or lithium."
  ],
  "quest.1A00000000000140.title": "Basic Canning Machine",
  "quest.1A00000000000141.quest_desc": [
    "Use an Alloy Smelter to get 5 battery alloy ingots from 4 lead and 1 antimony ingots."
  ],
  "quest.1A00000000000141.title": "Battery Alloy Ingot",
  "quest.1A00000000000142.quest_desc": [
    "This is the casing for LV batteries. You can craft it from 2 battery alloy plates and a tin cable."
  ],
  "quest.1A00000000000142.title": "Small Battery Hull",
  "quest.1A00000000000143.quest_desc": [
    "Don't craft this unless you have a voracious power tool."
  ],
  "quest.1A00000000000143.title": "Batpack - for what?",
  "quest.1A00000000000145.quest_desc": [
    "Put glass with quartzite dust into an alloy smelter."
  ],
  "quest.1A00000000000145.title": "Fused Quartz",
  "quest.1A00000000000147.quest_desc": [
    "This machine can be used to get alloys such as bronze more profitably. Moreover, you don't need to use dusts only, you can create bronze from tin and copper ingots."
  ],
  "quest.1A00000000000147.title": "Steam Alloy Smelter",
  "quest.1A00000000000148.quest_desc": [
    "Create a glass block from sand by putting it into a furnace."
  ],
  "quest.1A00000000000148.title": "Glass",
  "quest.1A00000000000149.quest_desc": [
    "You may use most of metals to craft a wire cutter. Early in the game it may be used to craft wires from plates or fine wire from foil. Also it can help you to dismantle wires placed at your base."
  ],
  "quest.1A00000000000149.title": "Wire Cutter (gregtech)",
  "quest.1A0000000000014A.quest_desc": [
    "Recipe is the same as for other pipes, but the difference is the material of the plates - use titanium."
  ],
  "quest.1A0000000000014A.title": "Titanium Fluid Pipe",
  "quest.1A0000000000014B.quest_desc": [
    "Same recipe as for other screws."
  ],
  "quest.1A0000000000014B.title": "Stainless Steel Screw",
  "quest.1A0000000000014C.quest_desc": [
    "An EV tier Motor."
  ],
  "quest.1A0000000000014C.title": "Electric Motor (EV)",
  "quest.1A0000000000014D.quest_desc": [
    "Can be used as a part of a distillation tower."
  ],
  "quest.1A0000000000014D.title": "Large Stainless Steel fluid Pipe",
  "quest.1A0000000000014E.quest_desc": [
    "Many times better, but much more expensive than the regular single block distillery. The main feature is that it can distill one fluid to obtain multiple different liquids at same time."
  ],
  "quest.1A0000000000014E.title": "Distillation Tower",
  "quest.1A0000000000014F.quest_desc": [
    "A part of a distillery multiblock."
  ],
  "quest.1A0000000000014F.title": "Clean Stainlessteel Casing",
  "quest.1A00000000000150.quest_desc": [
    "An HV tier polarizer (or better) is the only way to get magnetic neodymium rods."
  ],
  "quest.1A00000000000150.title": "Advanced Polarizer II",
  "quest.1A00000000000151.quest_desc": [
    "Height to search: 20-40 MONAZITE vein (Bastnasite, Monazite, Neodymium). You have to look for Bastnasite, Monazite or Neodymium ores. Or you may get neodymium dust from Rare Earth which is subproduct of redstone ore processing - use NEI."
  ],
  "quest.1A00000000000151.title": "Neodymium Dust",
  "quest.1A00000000000152.quest_desc": [
    "Use an extruder and a rod shape."
  ],
  "quest.1A00000000000152.title": "Titanium Rod",
  "quest.1A00000000000153.quest_desc": [
    "A part of EV tier machines, and the best type of cable to transfer EV tier energy. But don't forget about amperes!"
  ],
  "quest.1A00000000000153.title": "Aluminium Cable",
  "quest.1A00000000000154.quest_desc": [
    "For EV+ tier motors you have to use annealed copper only."
  ],
  "quest.1A00000000000154.title": "8x Annealed Copper Wire",
  "quest.1A00000000000155.quest_desc": [
    "A part of an EV tier chemical reactor."
  ],
  "quest.1A00000000000155.title": "Large Plastic Fluid Pipe",
  "quest.1A00000000000157.quest_desc": [
    "Place the block into a cutting saw, and then send one of the plates into an HV+ tier lathe."
  ],
  "quest.1A00000000000157.title": "Endereye Lens",
  "quest.1A00000000000158.quest_desc": [
    "Place the block into a cutting saw, and then send one of the plates into an HV+ tier lathe."
  ],
  "quest.1A00000000000158.title": "Enderpearl Lens",
  "quest.1A00000000000159.quest_desc": [
    "Use an endereye lens to create a NOR wafer using an HV+ tier precision laser engraver."
  ],
  "quest.1A00000000000159.title": "NOR Memory Chip (Wafer)",
  "quest.1A0000000000015A.quest_desc": [
    "Can process more recipes compared to the basic one."
  ],
  "quest.1A0000000000015A.title": "Advanced Precision Laser II",
  "quest.1A0000000000015B.quest_desc": [
    "Silicon + glowstone + nitrogen. You should have already met all that stuff, so use an EBF to get another kind of it. Then just cut the monocrystalline with a cutting machine to get wafers."
  ],
  "quest.1A0000000000015B.title": "Glowstone doped MSB",
  "quest.1A0000000000015C.quest_desc": [
    "Use an enderpearl lens to create the NAND wafer using a precision laser engraver of HV+ tier."
  ],
  "quest.1A0000000000015C.title": "NAND Memory Chip (Wafer)",
  "quest.1A0000000000015D.quest_desc": [
    "Pump the air into a centrifuge by a fluid canner machine from a compressed air cell. This is the way to get nitrogen gas."
  ],
  "quest.1A0000000000015D.title": "Nitrogen Gas",
  "quest.1A0000000000015E.quest_desc": [
    "You can meet it in the Nether - it drops out of \"lamp\" blocks."
  ],
  "quest.1A0000000000015E.title": "Glowstone",
  "quest.1A0000000000015F.quest_desc": [
    "Now you've got to have all the machines to create it. The way is: cobblestone into a hammer -> gravel into a hammer again -> sand into a furnace -> glass into a forge hammer (or a macerator) -> glass dust into a centrifuge -> silicon dioxide into an electrolyzer. On the last step you obtain oxygen as a sub-product, don't get rid of it, it is a useful gas."
  ],
  "quest.1A0000000000015F.title": "Silicon Dust",
  "quest.1A00000000000160.quest_desc": [
    "...from a NAND wafer using a cutting saw."
  ],
  "quest.1A00000000000160.title": "NAND Memory Chip",
  "quest.1A00000000000161.quest_desc": [
    "The best HV tier circuit."
  ],
  "quest.1A00000000000161.title": "Nanoprocessor",
  "quest.1A00000000000162.quest_desc": [
    "... from an epoxy resin sheet + copper foil + sulfuric acid."
  ],
  "quest.1A00000000000162.title": "Epoxy Circuit Board",
  "quest.1A00000000000163.quest_desc": [
    "...from a NanoCPU wafer with a cutting saw."
  ],
  "quest.1A00000000000163.title": "Nanocomponent CPU",
  "quest.1A00000000000164.quest_desc": [
    "The stuff to craft a circuit."
  ],
  "quest.1A00000000000164.title": "SMD Resistor",
  "quest.1A00000000000165.quest_desc": [
    "The stuff to craft a circuit."
  ],
  "quest.1A00000000000165.title": "SMD Transistor",
  "quest.1A00000000000166.quest_desc": [
    "The stuff to craft a circuit."
  ],
  "quest.1A00000000000166.title": "SMD Capacitor",
  "quest.1A00000000000167.quest_desc": [
    "Carbon dust can be converted into raw carbon fiber using platinum, palladium or lutetium."
  ],
  "quest.1A00000000000167.title": "Raw Carbon Fiber",
  "quest.1A00000000000168.quest_desc": [
    "It may help you to clone elemental matter. Also it is required for some rare recipes."
  ],
  "quest.1A00000000000168.title": "Data Orb",
  "quest.1A00000000000169.quest_desc": [
    "...with a hammer or a metal bender."
  ],
  "quest.1A00000000000169.title": "Copper Foil",
  "quest.1A0000000000016A.quest_desc": [
    "LCR recipe: sodium hydroxide + epichlorohydrin + acetone + phenol."
  ],
  "quest.1A0000000000016A.title": "Epoxy Resin Sheet",
  "quest.1A0000000000016B.quest_desc": [
    "It may craft circuits up to LuV tier."
  ],
  "quest.1A0000000000016B.title": "Advanced Circuit Assembling III",
  "quest.1A0000000000016C.quest_desc": [
    "An EV tier Conveyor."
  ],
  "quest.1A0000000000016C.title": "Conveyor Module (EV)",
  "quest.1A0000000000016D.quest_desc": [
    "An EV tier piston."
  ],
  "quest.1A0000000000016D.title": "Electric Piston (EV)",
  "quest.1A0000000000016E.quest_desc": [
    "An EV tier Emitter."
  ],
  "quest.1A0000000000016E.title": "Emitter (EV)",
  "quest.1A0000000000016F.quest_desc": [
    "An IV tier Circuit."
  ],
  "quest.1A0000000000016F.title": "Mainframe",
  "quest.1A00000000000170.quest_desc": [
    "...from NOR wafer using a cutting saw."
  ],
  "quest.1A00000000000170.title": "NOR Memory Chip",
  "quest.1A00000000000171.quest_desc": [
    "An EV tier Circuit."
  ],
  "quest.1A00000000000171.title": "Nanoprocessor Assembly",
  "quest.1A00000000000172.quest_desc": [
    "An IV tier Circuit."
  ],
  "quest.1A00000000000172.title": "Elite Nanocomputer",
  "quest.1A00000000000173.quest_desc": [
    "A part of certain machines."
  ],
  "quest.1A00000000000173.title": "Solid Steel Machine Casing",
  "quest.1A00000000000174.quest_desc": [
    "You can blow up stuff inside of it without negative effects."
  ],
  "quest.1A00000000000174.title": "Implosion Compressor",
  "quest.1A00000000000175.quest_desc": [
    "Obsidian is solidified lava. You may create it by pouring water from a bucket into a lava lake. But to dig it you must have pickaxe tier 3, like with diamonds. What is it for? If you play Minecraft for the first time, you should know that this is the only way to build a portal to the Nether. Just build an obsidian frame of 4 blocks width and 5 blocks height. Then use matches or a flint and a steel nugget to lit the fire inside the frame in order to open the portal."
  ],
  "quest.1A00000000000175.title": "Obsidian",
  "quest.1A00000000000176.quest_desc": [
    "Better than regular TNT, but requires nitric acid as a component. Use an HV+ chemical reactor to produce it from gelled toluene and nitration mixture."
  ],
  "quest.1A00000000000176.title": "Industrial TNT",
  "quest.1A00000000000177.quest_desc": [
    "You may put it into an implosion compressor with other things to make new stuff."
  ],
  "quest.1A00000000000177.title": "Dynamite",
  "quest.1A00000000000178.quest_desc": [
    "Gelled Toluene + sulfuric acid."
  ],
  "quest.1A00000000000178.title": "TNT",
  "quest.1A00000000000179.quest_desc": [
    "Use a mold (ball) with a solidifier."
  ],
  "quest.1A00000000000179.title": "Gelled Toluene",
  "quest.1A0000000000017A.quest_desc": [
    "A well known acid."
  ],
  "quest.1A0000000000017A.title": "Sulfuric Acid",
  "quest.1A0000000000017B.quest_desc": [
    "There are several ways to obtain it. Also it may be a by-product for distillery tower."
  ],
  "quest.1A0000000000017B.title": "Methanol",
  "quest.1A0000000000017C.quest_desc": [
    "Ohhh! It's a nice machine. It is hard to craft but you ought to have it."
  ],
  "quest.1A0000000000017C.title": "Basic Distillery",
  "quest.1A0000000000017D.quest_desc": [
    "You may obtain this from wood tar, but it is not the only way."
  ],
  "quest.1A0000000000017D.title": "Toluene",
  "quest.1A0000000000017E.quest_desc": [
    "Required for producing Glass Tubes in an Alloy Smelter."
  ],
  "quest.1A0000000000017E.title": "Mold (Ball)",
  "quest.1A0000000000017F.quest_desc": [
    "From a pyrolyse oven or charcoal."
  ],
  "quest.1A0000000000017F.title": "Wood Tar",
  "quest.1A00000000000180.quest_desc": [
    "Sulfuric Acid + Nitric Acid by a mixer."
  ],
  "quest.1A00000000000180.title": "Nitration Mixture",
  "quest.1A00000000000181.quest_desc": [
    "Glycerol + nitration mixture (by a chemical reactor)."
  ],
  "quest.1A00000000000181.title": "Glyceryl Trinitrate",
  "quest.1A00000000000182.quest_desc": [
    "Put seeds into a fluid extractor to produce seed oil."
  ],
  "quest.1A00000000000182.title": "Seed Oil",
  "quest.1A00000000000183.quest_desc": [
    "You can make seed oil from this."
  ],
  "quest.1A00000000000183.title": "Seeds",
  "quest.1A00000000000184.quest_desc": [
    "With this machine you will get ability to squeeze or smelt items to obtain fluids from them. But LV tier is §cnot as useful as MV§f. So if you don't have a strong need to craft it, you may make directly the §aMV tier Fluid Extractor§f."
  ],
  "quest.1A00000000000184.title": "Basic Fluid Extractor",
  "quest.1A00000000000185.quest_desc": [
    "Use a chemical reactor to make glycerol from sodium hydroxide + seed oil + methanol."
  ],
  "quest.1A00000000000185.title": "Glycerol",
  "quest.1A00000000000186.quest_desc": [
    "Sodium + water (by a chemical reactor)."
  ],
  "quest.1A00000000000186.title": "Sodium Hydroxide Dust",
  "quest.1A00000000000187.quest_desc": [
    "Hurray!!! Now you can get double resources from ore blocks. And you can create wood pulp from wood.. Why? - to compress it to get wood planks."
  ],
  "quest.1A00000000000187.title": "Macerator",
  "quest.1A00000000000188.quest_desc": [
    "Height for search: 5-20 DIAMOND vein (Graphite, Diamond, Coal). There are three ways to obtain diamonds: first two matter for you in case if you have found a vein of diamonds. You may dig diamond blocks using a cobalt pickaxe or you may blow it up with a powder barrel or a boiler. The last option is simple but it's unlikely that you will use it in a real game. You may also find a diamond just by breaking small diamond ore."
  ],
  "quest.1A00000000000188.title": "Diamonds",
  "quest.1A00000000000189.quest_desc": [
    "Furnace, bricks and bronze plates - these are all you have to use in order to craft a small coal boiler. Btw, it has the word \"coal\" in its name because it can consume all types of coal (except compressed coal blocks)."
  ],
  "quest.1A00000000000189.title": "Small Coal Boiler",
  "quest.1A0000000000018A.quest_desc": [
    "You wanna push? Buy (or craft) the piston!"
  ],
  "quest.1A0000000000018A.title": "Piston",
  "quest.1A0000000000018B.quest_desc": [
    "Kill 3 Creepers"
  ],
  "quest.1A0000000000018B.title": "Creeper",
  "quest.1A0000000000018C.quest_desc": [
    "Create a fire sword to cook animals alive. It can be crafted from 2 flints and a stick."
  ],
  "quest.1A0000000000018C.title": "Sword",
  "quest.1A0000000000018E.quest_desc": [
    "You may get it from spiders or wool."
  ],
  "quest.1A0000000000018E.title": "String",
  "quest.1A0000000000018F.quest_desc": [
    "Wood plank is the base material to craft a circuit board. To make it you should put wood pulp into a compressor."
  ],
  "quest.1A0000000000018F.title": "Wood Plank (compressed)",
  "quest.1A00000000000190.quest_desc": [
    "A few more steps, and you will be able to ctaft basic circuits."
  ],
  "quest.1A00000000000190.title": "Coated Circuit Board",
  "quest.1A00000000000191.quest_desc": [
    "Find Sugar Canes. Breed them to get more........"
  ],
  "quest.1A00000000000191.title": "Sugar Canes",
  "quest.1A00000000000192.quest_desc": [
    "Do you have some iron ingots? Actually, you may use bronze, but that would be a bit expensive. Anyway, it is time to craft a saw. Two plates, a file and a hammer to craft the saw blade, then just add a stick to it in order to get a tool fully ready for use. A saw will help you to obtain planks from wood blocks as well as sticks from planks with increased efficiency. But more importantly, you may create two plates of stone from a stone block. They are required to make paper from chad (and chad from sugar canes)."
  ],
  "quest.1A00000000000192.title": "Saw (gregtech)",
  "quest.1A00000000000193.quest_desc": [
    "Craft paper from sugar canes via chad and stone slabs. Slabs will not be consumed."
  ],
  "quest.1A00000000000193.title": "Paper",
  "quest.1A00000000000194.quest_desc": [
    "Use a saw to cut stone into stone slabs."
  ],
  "quest.1A00000000000194.title": "Stone Slab",
  "quest.1A00000000000195.quest_desc": [
    "Use a mortar to obtain Chad from Sugar Canes."
  ],
  "quest.1A00000000000195.title": "Chad",
  "quest.1A00000000000196.quest_desc": [
    "Craft the reinforced iron item casing from a steel plate and a hammer."
  ],
  "quest.1A00000000000196.title": "Refined Iron Item Casing",
  "quest.1A00000000000197.quest_desc": [
    "Create a hammer with 6 iron ingots and a stick. Or you may use bronze ingots instead of iron ingots. The main application of a hammer is making plates from ingots (but with a horribly low efficiency - 2-to-1). An additional ability is to find ores around you by clicking RMB on a stone block while you hold the hammer in your hand."
  ],
  "quest.1A00000000000197.title": "Hammer (gregtech)",
  "quest.1A00000000000198.quest_desc": [
    "Screwdriver is one of useful tools that you will require to setup your base in order to configure automatic resource processing and build production lines. You may choose a certain rule for machines (setting output mode) and covers (adjusting other settings such as flow directions for pumps or flow speed for fluid regulators) by clicking RMB on them while you hold a screwdriver. And one more ability - you may set max fuel capacity of the internal buffer of single block generators lower than it is by default."
  ],
  "quest.1A00000000000198.title": "Screwdriver (gregtech)",
  "quest.1A00000000000199.quest_desc": [
    "A Vacuum tube is another item to craft circuit."
  ],
  "quest.1A00000000000199.title": "Vacuum tube",
  "quest.1A0000000000019A.quest_desc": [
    "Use a cutter on copper foil. Copper foil can be obtained from copper plate using a hammer."
  ],
  "quest.1A0000000000019A.title": "Fine copper wire",
  "quest.1A0000000000019B.quest_desc": [
    "The main item for vacuum tubes."
  ],
  "quest.1A0000000000019B.title": "Glass Tube",
  "quest.1A0000000000019C.quest_desc": [
    "Another stuff used as a component of circuits."
  ],
  "quest.1A0000000000019C.title": "Resistor",
  "quest.1A0000000000019D.quest_desc": [
    "This block will output a redstone signal if there is a Chest Cart that contains the specified items in front of it."
  ],
  "quest.1A0000000000019D.title": "Detector - Item",
  "quest.1A0000000000019E.quest_desc": [
    "Just put usual charcoal into a macerator."
  ],
  "quest.1A0000000000019E.title": "Charcoal Dust",
  "quest.1A0000000000019F.quest_desc": [
    "One copper and 4 redstone dust may be used to get a red alloy ingot - use an alloy smelter."
  ],
  "quest.1A0000000000019F.title": "Red alloy",
  "quest.1A000000000001A0.quest_desc": [
    "Use paper to make the cable from wire."
  ],
  "quest.1A000000000001A0.title": "Red Alloy Cable",
  "quest.1A000000000001A2.quest_desc": [
    "An important part of a Computer Monitor."
  ],
  "quest.1A000000000001A2.title": "Glass Pane",
  "quest.1A000000000001A3.quest_desc": [
    "6 iron rods may be used to craft iron bars with a wrench."
  ],
  "quest.1A000000000001A3.title": "Iron Bars",
  "quest.1A000000000001A4.quest_desc": [
    "Stick + cobblestone."
  ],
  "quest.1A000000000001A4.title": "Lever",
  "quest.1A000000000001A5.quest_desc": [
    "Craft a mortar from stone and flint."
  ],
  "quest.1A000000000001A5.title": "Mortar",
  "quest.1A000000000001A6.quest_desc": [
    "Use a wire cutter on a copper plate."
  ],
  "quest.1A000000000001A6.title": "1x Copper Wire",
  "quest.1A000000000001A7.quest_desc": [
    "Use Paper and Leather to craft an Empty Book."
  ],
  "quest.1A000000000001A7.title": "Book",
  "quest.1A000000000001A8.quest_desc": [
    "From cows or horses."
  ],
  "quest.1A000000000001A8.title": "Leather",
  "quest.1A000000000001AB.quest_desc": [
    "Not only a (bad) weapon, but also a handy way to craft paper or rubber rings."
  ],
  "quest.1A000000000001AB.title": "Knife (gregtech)",
  "quest.1A000000000001AC.quest_desc": [
    "You don't have to craft it immediately. But it will be required in future. To craft it, you have to compress 9 diamonds with a compressor."
  ],
  "quest.1A000000000001AC.title": "Diamond Block",
  "quest.1A000000000001AD.quest_desc": [
    "Use a hammer, a file and 4 steel plates to craft this shape."
  ],
  "quest.1A000000000001AD.title": "Empty Shape Plate",
  "quest.1A000000000001AE.quest_desc": [
    "Make the red alloy plate (with a hammer or a forge hammer) to create the wire from it by a wire cutter."
  ],
  "quest.1A000000000001AE.title": "Red Alloy Wire",
  "quest.1A000000000001AF.quest_desc": [
    "You may create it from an empty mold using a wire cutter. It may give you the ability to create 4 rings per 1 rubber pulp (or bar). An extruder machine is required (LV or higher)."
  ],
  "quest.1A000000000001AF.title": "Extruder Shape (Ring)",
  "quest.1A000000000001B0.quest_desc": [
    "Just dig anywhere."
  ],
  "quest.1A000000000001B0.title": "Get cobblestone",
  "quest.1A000000000001B1.quest_desc": [
    "Find any tree and get two blocks of wood."
  ],
  "quest.1A000000000001B1.title": "First step",
  "quest.1A000000000001B2.quest_desc": [
    "Create the Flint Axe."
  ],
  "quest.1A000000000001B2.title": "Axe",
  "quest.1A000000000001B3.quest_desc": [
    "Dig gravel to find a flint. It may drop out with a small chance. But if you do not want to spend your time, you can use a few other ways: 1) craft it from 4 gravel blocks. 2) If you are lucky enough to find a sheep and obtain wool - you may craft a useful tool - scoop (to sift gravel)."
  ],
  "quest.1A000000000001B3.title": "Flint",
  "quest.1A000000000001B4.quest_desc": [
    "Craft your first wooden pickaxe. There are many options of what to craft pickaxe from: stone, flint, iron, steel, bronze, cobalt and etc. Some materials used to make a pickaxe are harder than other and can dig out more solid resource blocks."
  ],
  "quest.1A000000000001B4.title": "Pickaxe (wooden)",
  "quest.1A000000000001B5.quest_desc": [
    "A mix of brass, aluminium and cobalt dusts."
  ],
  "quest.1A000000000001B5.title": "Cobalt Brass Dust",
  "quest.1A000000000001B6.quest_desc": [
    "Fry cobblestone to get..."
  ],
  "quest.1A000000000001B6.title": "Stone source",
  "quest.1A000000000001B7.quest_desc": [
    "Fry a chicken."
  ],
  "quest.1A000000000001B7.title": "Cook as cook",
  "quest.1A000000000001B8.quest_desc": [
    "Find and dig out some sand."
  ],
  "quest.1A000000000001B8.title": "Sand",
  "quest.1A000000000001B9.quest_desc": [
    "Find gravel."
  ],
  "quest.1A000000000001B9.title": "Gravel",
  "quest.1A000000000001BA.quest_desc": [
    "Craft an Iron Plate with a hammer and two iron ingots."
  ],
  "quest.1A000000000001BA.title": "Iron Plate",
  "quest.1A000000000001BB.quest_desc": [
    "Craft a bucket with a hammer and 3 iron plates."
  ],
  "quest.1A000000000001BB.title": "Bucket",
  "quest.1A000000000001BC.quest_desc": [
    "Craft a cauldron - use 7 iron plates and a hammer."
  ],
  "quest.1A000000000001BC.title": "Cauldron",
  "quest.1A000000000001BD.quest_desc": [
    "Use a Mortar to get Copper and Tin dusts from tin and copper ingots. Then craft bronze dust from 3 copper dusts and 1 tin dust."
  ],
  "quest.1A000000000001BD.title": "Bronze Dust",
  "quest.1A000000000001BE.quest_desc": [
    "Smelt bronze dust to get a bronze ingot. Then use a hammer to get bronze plates."
  ],
  "quest.1A000000000001BE.title": "Bronze Plate",
  "quest.1A000000000001BF.quest_desc": [
    "You have to find clay - usually you may find it in a river or an ocean beach underwater."
  ],
  "quest.1A000000000001BF.title": "Clay (balls)",
  "quest.1A000000000001C0.quest_desc": [
    "Use a Furnace to get a brick from clay."
  ],
  "quest.1A000000000001C0.title": "Brick",
  "quest.1A000000000001C1.quest_desc": [
    "Use 4 bricks to create a bricks block."
  ],
  "quest.1A000000000001C1.title": "Bricks block",
  "quest.1A000000000001C2.quest_desc": [
    "Use bricks blocks and bronze plates with a hammer to get bricked bronze hull. It is the base part of most steam machines."
  ],
  "quest.1A000000000001C2.title": "Bricked Bronze Hull",
  "quest.1A000000000001C3.quest_desc": [
    "Craft the Charcoal Pile Igniter from 2 wrought iron nuggets, 3 flints and a bricked bronze hull. To get wrought iron nuggets, you have to smelt an iron ingot to iron nuggets, then smelt them again."
  ],
  "quest.1A000000000001C3.title": "Charcoal Pile Igniter",
  "quest.1A000000000001C4.quest_desc": [
    "Use a charcoal pile igniter to transform wood into charcoal. For starters, craft at least 9 brick blocks and put them in the shape of a square 3 by 3. Then put logs (wood) onto it, from 1 to 5 blocks height. Position the charcoal pile igniter on top in the center. All sides including top have to be covered by dirt."
  ],
  "quest.1A000000000001C4.title": "Charcoal",
  "quest.1A000000000001C6.quest_desc": [
    "This machine can be used to get 2 plates from 3 ingots - this is more efficient than using a regular hammer. Another way to use a forge hammer - to obtain crushed ore from ore blocks or make impure dust from crushed ore very quickly. Also you will be able to make sand from... well, it would be better if you searched recipes by yourself."
  ],
  "quest.1A000000000001C6.title": "Forge Hammer",
  "quest.1A000000000001C7.quest_desc": [
    "Anvil looks really cool. This is the main reason to craft it =) (it is a joke)."
  ],
  "quest.1A000000000001C7.title": "Anvil",
  "quest.1A000000000001C9.quest_desc": [
    "Blast furnace is the only way to obtain steel. Steel is cool. Why? - It is another story...)"
  ],
  "quest.1A000000000001C9.title": "Bricked BF",
  "quest.1A000000000001CA.quest_desc": [
    "You have to craft 32 of them."
  ],
  "quest.1A000000000001CA.title": "Firebricks",
  "quest.1A000000000001CB.quest_desc": [
    "You have to craft §a32§f of them, but you should know that they are crafted in two items per one crafting operation, so you need to do it only 16 times. Also, these blocks may be used to build a §6Large Bronze Boiler§f - it requires at least §a24§f blocks."
  ],
  "quest.1A000000000001CB.title": "Bronze Plated Bricks",
  "quest.1A000000000001CD.quest_desc": [
    "Pipes can be used to supply steam to other steam machines. There are many different pipes with different heat resistance and different transfer rate. Also they can be used as parts of (but not limited to) steam machines."
  ],
  "quest.1A000000000001CD.title": "Bronze Fluid Pipes",
  "quest.1A000000000001CE.quest_desc": [
    "Use a steam compressor to make the block of iron from 9 iron ingots."
  ],
  "quest.1A000000000001CE.title": "Block of Iron",
  "quest.1A000000000001CF.quest_desc": [
    "Find Sticky Resin."
  ],
  "quest.1A000000000001CF.title": "Sticky Resin",
  "quest.1A000000000001D0.quest_desc": [
    "Do you have some wood? If yes - you can craft a treetap out of 5 wooden planks. It is a useful thing to make torches from sticky resin."
  ],
  "quest.1A000000000001D0.title": "Treetap",
  "quest.1A000000000001D1.quest_desc": [
    "Your first light. You can craft it out of sticky resin and stick."
  ],
  "quest.1A000000000001D1.title": "Torch",
  "quest.1A000000000001D2.quest_desc": [
    "It may be used as a part of a Water Tank in the recipe."
  ],
  "quest.1A000000000001D2.title": "Slimeball",
  "quest.1A000000000001D3.quest_desc": [
    "Craft at least one chest and one door. Build any... basically any box, but with a door to protect yourself from night monsters."
  ],
  "quest.1A000000000001D3.title": "Home, sweet home...",
  "quest.1A000000000001D4.quest_desc": [
    "This is a very useful block that can be used as a ladder. Moreover, if they are placed on each other like a tower, you can easily bring them all down just by breaking the bottom block."
  ],
  "quest.1A000000000001D4.title": "Scaffold",
  "quest.1A000000000001D5.quest_desc": [
    "Craft a flint shovel."
  ],
  "quest.1A000000000001D5.title": "Shovel",
  "quest.1A000000000001D6.quest_desc": [
    "Pour water into this solar boiler and place it beneath the clear sky (transparent blocks such as glass are allowed)."
  ],
  "quest.1A000000000001D6.title": "Simple Solar Boiler",
  "quest.1A000000000001D7.quest_desc": [
    "Use a forge hammer to craft 2 silver plates from 3 silver ingots."
  ],
  "quest.1A000000000001D7.title": "Silver Plate",
  "quest.1A000000000001D8.quest_desc": [
    "Height to search: 30-60 GALENA vein (Galena, Silver, Lead). You may find silver ore in a vein of galena ore."
  ],
  "quest.1A000000000001D8.title": "Crushed Silver Ore",
  "quest.1A000000000001D9.quest_desc": [
    "This is a way to produce 2 wires from 1 ingot. Also it is a more profitable way to get fine wires."
  ],
  "quest.1A000000000001D9.title": "Basic Wiremill",
  "quest.1A000000000001DA.quest_desc": [
    "A useful spinner, better than washing machine, despite the fact that it looks the same."
  ],
  "quest.1A000000000001DA.title": "Basic Centrifuge",
  "quest.1A000000000001DB.quest_desc": [
    "Also (as a centrifuge) can be used to extract raw resin from sticky resin, but has less functionality in other avenues."
  ],
  "quest.1A000000000001DB.title": "Basic Extractor",
  "quest.1A000000000001DC.quest_desc": [
    "...can be obtained from sticky resin. Needed to create rubber."
  ],
  "quest.1A000000000001DC.title": "Raw Rubber Pulp",
  "quest.1A000000000001DD.quest_desc": [
    "Can be used to produce some chemicals."
  ],
  "quest.1A000000000001DD.title": "Basic Chemical Reactor",
  "quest.1A000000000001DE.quest_desc": [
    "Height for search (only in nether): 5 - 20 SULFUR vein (Sulfur, Pyrite, Sphalerite). Sulfur ore veins can be only found in the Nether. But in the Overworld you may find small sulfur ore blocks and get sulfur dust as by-product from the following ores: Galena, Pyrite, Cinnabar, Pentlandite, Lead and Silver."
  ],
  "quest.1A000000000001DE.title": "Find the sulfur",
  "quest.1A000000000001DF.quest_desc": [
    "Can be crafted using 4 steel plates, a hammer and a file. Then just modify it by a hammer to get the desired result."
  ],
  "quest.1A000000000001DF.title": "Mold (Plate)",
  "quest.1A000000000001E0.quest_desc": [
    "Can turn liquids into solid state if possible. Needs a mold to work."
  ],
  "quest.1A000000000001E0.title": "Basic Fluid Solidifier",
  "quest.1A000000000001E1.quest_desc": [
    "Can transport items from and to machines, pipes, chests. Also may be used as a component in crafting complex things. Click RMB + Shift on a conveyor placed as cover to open GUI."
  ],
  "quest.1A000000000001E1.title": "Conveyor module (LV)",
  "quest.1A000000000001E2.quest_desc": [
    "It can give you satisfaction. For example, it may help you to craft an assembly machine."
  ],
  "quest.1A000000000001E2.title": "Robot Arm (LV)",
  "quest.1A000000000001E3.quest_desc": [
    "Can do a lot of useful different things."
  ],
  "quest.1A000000000001E3.title": "Basic Assembling Machine",
  "quest.1A000000000001E4.quest_desc": [
    "A material for an LV emitter or for item pipes. It is an alloy of zinc(1) and copper(3)."
  ],
  "quest.1A000000000001E4.title": "Brass Ingot",
  "quest.1A000000000001E5.quest_desc": [
    "This cable can use voltage of 128 eu/t. And this is the base for MV tier. To craft it you have to smelt rubber with a fluid extractor and pour it into an assembler. Then add there copper wire and a programmed circuit with configuration 24. Use NEI to find the recipe."
  ],
  "quest.1A000000000001E5.title": "1x Copper Cable",
  "quest.1A000000000001E6.quest_desc": [
    "The unique part of the sifting machine"
  ],
  "quest.1A000000000001E6.title": "Item Filter",
  "quest.1A000000000001E7.quest_desc": [
    "Now you can wash crushed ore to get by-products. There are 4 ways how to wash by using different programmed circuits. With config \"1\" - a fast wash without by-products. \"2\" - also fast washing without by-products, but you will get dirty water in the output hatch of your washing plant. \"3\" - slow, but you will get by-products. \"4\" - also as \"3\", but with dirty water in the output."
  ],
  "quest.1A000000000001E7.title": "Basic Ore Washing Plant",
  "quest.1A000000000001E8.quest_desc": [
    "Height to search (for Ruby ore): 10-40. After finding ruby ore inside a redstone vein, you need to use a sifter to find an Exquisite Ruby (from purified ruby ore). It is nice stuff to create a ruby lens using a lathe. Also you may create a red lens from other red exquisite gems such as Jasper or Red Garnet. It will also work fine."
  ],
  "quest.1A000000000001E8.title": "Exquisite Red Gem",
  "quest.1A000000000001E9.quest_desc": [
    "It can convert MV to LV voltage and vice versa (LV to MV)."
  ],
  "quest.1A000000000001E9.title": "Low Voltage Transformer",
  "quest.1A000000000001EA.quest_desc": [
    "The way to get it is hard. For starters, you have to use a cauldron or an ore washing plant to get purified zinc ore, then put it into a macerator or a forge hammer to obtain purified zinc dust. And in the end drop it into a centrifuge to get gallium as by-product."
  ],
  "quest.1A000000000001EA.title": "Tiny Pile of Gallium Dust",
  "quest.1A000000000001EB.quest_desc": [
    "To craft a diode you need following materials: a Glass pane, charcoal dust, fine tin wire and a tiny pile of gallium dust."
  ],
  "quest.1A000000000001EB.title": "Diode",
  "quest.1A000000000001EC.quest_desc": [
    "Height to search: 40 - 80 QUARTZ vein (Quartzite, Barite, Certus Quartz). If you found quartzite dust, you may use an Autoclave to convert quartzite dust into quartzite. Btw, amidst quartzite ore you may find certus quartz ore - collect it too, for future development."
  ],
  "quest.1A000000000001EC.title": "Find Quartzite (gem or dust)",
  "quest.1A000000000001ED.quest_desc": [
    "The machine which can help you to obtain quartzite out of quartzite dust."
  ],
  "quest.1A000000000001ED.title": "Basic Autoclave",
  "quest.1A000000000001EE.quest_desc": [
    "A part of high tech machines."
  ],
  "quest.1A000000000001EE.title": "Emitter (LV)",
  "quest.1A000000000001EF.quest_desc": [
    "To craft electronic circuits more powerful and cheap than those you can make on a crafting table."
  ],
  "quest.1A000000000001EF.title": "Basic Circuit Assembling Machine",
  "quest.1A000000000001F0.quest_desc": [
    "An important part of a macerator and a rock breaker."
  ],
  "quest.1A000000000001F0.title": "Diamond Grinding Head",
  "quest.1A000000000001F1.quest_desc": [
    "Better than a regular diamond. At least because it can be used for any recipes instead of natural diamond, but not vice versa."
  ],
  "quest.1A000000000001F1.title": "Industrial Diamond",
  "quest.1A000000000001F2.quest_desc": [
    "Coal chunk is almost an industrial diamond, just compress it. To get the coal chunk you have to prepare 64 items of coal (not charcoal) dust and 8 flints. Then compress coal balls and put them into an assembler with a bricks block."
  ],
  "quest.1A000000000001F2.title": "Coal Chunk",
  "quest.1A000000000001F3.quest_desc": [
    "Use a compressor to compress. You need 8 items of it."
  ],
  "quest.1A000000000001F3.title": "Compressed Coal Ball",
  "quest.1A000000000001F4.quest_desc": [
    "This is a wonderful machine. You can check it, when place water cell and lava into. Also programmed circiut is required. Then connect it to electricity and enjoy of infinite generation of cobblestone. Also it may produce obsidian from redstone dust, yeah."
  ],
  "quest.1A000000000001F4.title": "Basic Rock Breaker",
  "quest.1A000000000001F5.quest_desc": [
    "The base for high level electronic circuit"
  ],
  "quest.1A000000000001F5.title": "Monocrystalline Silicon Boule",
  "quest.1A000000000001F6.quest_desc": [
    "...from flint and coal dust. You need 8 items of it."
  ],
  "quest.1A000000000001F6.title": "Coal Ball",
  "quest.1A000000000001F7.quest_desc": [
    "This is a part of some machines."
  ],
  "quest.1A000000000001F7.title": "Steel Gear",
  "quest.1A000000000001F8.quest_desc": [
    "Pipes for single block miners, ore drilling plants, and oil drilling rigs. The most profiable way to craft it - by tiny steel fluid pipes via wiremill. So you may to wait until you have got the MV tier extruder."
  ],
  "quest.1A000000000001F8.title": "Mining Pipe",
  "quest.1A000000000001F9.quest_desc": [
    "It is time to work with bauxite. Universal macerator allow you to get gallium dust as sub product. Use NEI for more info."
  ],
  "quest.1A000000000001F9.title": "Basic Thermal Centrifuge",
  "quest.1A000000000001FA.quest_desc": [
    "May be created from common copper wire."
  ],
  "quest.1A000000000001FA.title": "4x Copper Wire",
  "quest.1A000000000001FB.quest_desc": [
    "By this machine with help of oxygen you may quickly convert iron to wrought iron, copper to annealed copper and etc."
  ],
  "quest.1A000000000001FB.title": "Basic Arc Furnace",
  "quest.1A000000000001FC.quest_desc": [
    "Height for search: 5-20 DIAMOND vein (Graphite, Diamond, Coal)."
  ],
  "quest.1A000000000001FC.title": "Graphite Dust",
  "quest.1A000000000001FD.quest_desc": [
    "Use an Exquisite Ruby/Red Garnet/Jasper to make a red lens from it by Lathe."
  ],
  "quest.1A000000000001FD.title": "Red Lens",
  "quest.1A000000000001FE.quest_desc": [
    "...by hammer or metal bender."
  ],
  "quest.1A000000000001FE.title": "Thin Silicone Rubber Sheet",
  "quest.1A000000000001FF.quest_desc": [
    "...by hammer or metal bender."
  ],
  "quest.1A000000000001FF.title": "Aluminium Foil",
  "quest.1A00000000000200.quest_desc": [
    "...by hammer or metal bender."
  ],
  "quest.1A00000000000200.title": "Thin Polyvinyl Chloride Sheet",
  "quest.1A00000000000201.quest_desc": [
    "Height to search: 50 - 60. the main source of chlorine may be salt ores (common or rock salt)"
  ],
  "quest.1A00000000000201.title": "Chlorine",
  "quest.1A00000000000202.quest_desc": [
    "Chlorine + Methane (by chemical reactor)"
  ],
  "quest.1A00000000000202.title": "Chloromethane",
  "quest.1A00000000000203.quest_desc": [
    "The most popular and easy way to produce gas fuel for gas turbines. There are many ways to produce it, but only few of them may be profitable."
  ],
  "quest.1A00000000000203.title": "Methane Gas",
  "quest.1A00000000000204.quest_desc": [
    "Chloromethane + silicon (by chemical reactor MV tier or better)"
  ],
  "quest.1A00000000000204.title": "Dimethyldichlorosilane",
  "quest.1A00000000000205.quest_desc": [
    "Dimethyldichlorosilane + water (by chemical reactor MV tier or better)"
  ],
  "quest.1A00000000000205.title": "Polydimethylsiloxane",
  "quest.1A00000000000206.quest_desc": [
    "It is sub product of creating the chloromethane. Or you may directly do it from ethylene and chlorine."
  ],
  "quest.1A00000000000206.title": "Hydrochloric Acid",
  "quest.1A00000000000207.quest_desc": [
    "Hydrochloric acid + ethylene + oxygen (by chemical reactor)"
  ],
  "quest.1A00000000000207.title": "Vinyl Chloride",
  "quest.1A00000000000208.quest_desc": [
    "There so much ways to get it via electrolyzer, so use NEI to find your favorite. The simplest is to get it from water. Note, that to mark this quest as completed, you have to put a bit of oxygen to one of: Universal cell or Certus quartz tank. Only these two items may help you to detect your fluids or gases for this and other liquid quests."
  ],
  "quest.1A00000000000208.title": "Oxygen Gas",
  "quest.1A00000000000209.quest_desc": [
    "Almost the plastic, it just few steps left."
  ],
  "quest.1A00000000000209.title": "Ethylene",
  "quest.1A0000000000020A.quest_desc": [
    "Vinyl chloride + oxygen to get polyvinyl chloride - then just solidify it to be plate with help of plate mold."
  ],
  "quest.1A0000000000020A.title": "Polyvinyl Chloride Sheet",
  "quest.1A0000000000020B.quest_desc": [
    "Chlorine + Methane (by chemical reactor)"
  ],
  "quest.1A0000000000020B.title": "Chloroform",
  "quest.1A0000000000020C.quest_desc": [
    "Hydrogen + fluorine (by chemical reactor)"
  ],
  "quest.1A0000000000020C.title": "Hydrofluoric Acid",
  "quest.1A0000000000020D.quest_desc": [
    "Bastnasite, Lepidolite, Topaz, Biotite - all these resources may be used to produce fluorine."
  ],
  "quest.1A0000000000020D.title": "Fluorine",
  "quest.1A0000000000020E.quest_desc": [
    "Chloroform + Hydrofluoric. Use HV tier chemical reactor."
  ],
  "quest.1A0000000000020E.title": "Tetrafluoroethylene",
  "quest.1A0000000000020F.quest_desc": [
    "HV tier chemical reactor"
  ],
  "quest.1A0000000000020F.title": "Advanced Chemical Reactor II",
  "quest.1A00000000000210.quest_desc": [
    "Use oxygen to polymerize - then you may solidify it to sheets."
  ],
  "quest.1A00000000000210.title": "Polytetrafluoroethylene Sheet",
  "quest.1A00000000000211.quest_desc": [
    "It have both advantages and lacks in comparison with common single block chemical reactor. It is much more expensive, but it can do more recipes and don't consume more energy if you connect higher voltage. So you may greatly grow processes speed without any negative effects."
  ],
  "quest.1A00000000000211.title": "Large Chemical Reactor",
  "quest.1A00000000000212.quest_desc": [
    "An important part of Large Chemical Reactor. Also may be used standalone."
  ],
  "quest.1A00000000000212.title": "Large PTFE Fluid Pipe",
  "quest.1A00000000000213.quest_desc": [
    "Sodium + Sulfur (by chemical reactor)"
  ],
  "quest.1A00000000000213.title": "Sodium Sulfide Dust",
  "quest.1A00000000000214.quest_desc": [
    "Distil wood tar to get benzene. Use distillery MV+ tier."
  ],
  "quest.1A00000000000214.title": "Benzene",
  "quest.1A00000000000215.quest_desc": [
    "It is a wonderful multiblock. With it help you may fast convert wood to charcoal. But moreover it may give you alot of useful sub products. Use NEI to find what circuit config you want to use, to get target sub products."
  ],
  "quest.1A00000000000215.title": "Pyrolyse Oven",
  "quest.1A00000000000217.quest_desc": [
    "Yeah, benzene + chlorine (by chemical reactor)"
  ],
  "quest.1A00000000000217.title": "Dichlorobenzene",
  "quest.1A00000000000219.quest_desc": [
    "It may be converted from ethylene by MV+ chemical reactor"
  ],
  "quest.1A00000000000219.title": "Propene",
  "quest.1A0000000000021A.quest_desc": [
    "LCR recipe: sodium hydroxide + propene + chlorine + water."
  ],
  "quest.1A0000000000021A.title": "Epichlorohydrin",
  "quest.1A0000000000021B.quest_desc": [
    "Distil wood tar to get phenol. Use distillery MV+ tier."
  ],
  "quest.1A0000000000021B.title": "Phenol",
  "quest.1A0000000000021C.quest_desc": [
    "...by pyrolyse oven"
  ],
  "quest.1A0000000000021C.title": "Wood Vinegar",
  "quest.1A0000000000021D.quest_desc": [
    "Use MV+ distillery for wood vinegar"
  ],
  "quest.1A0000000000021D.title": "Acetone",
  "quest.1A0000000000021E.quest_desc": [
    "One of the best stuff to craft the high-end circuits."
  ],
  "quest.1A0000000000021E.title": "Wetware Lifesupport c.b.",
  "quest.1A0000000000021F.quest_desc": [
    "The part of WLCB"
  ],
  "quest.1A0000000000021F.title": "Petri Dish",
  "quest.1A00000000000220.quest_desc": [
    "Required for IV+ circuits."
  ],
  "quest.1A00000000000220.title": "Multilayer Fiber-Reinforced c.b",
  "quest.1A00000000000221.quest_desc": [
    "Rare to use detail of some machines."
  ],
  "quest.1A00000000000221.title": "Sensor (LV)",
  "quest.1A00000000000222.quest_desc": [
    "Prepare distilled water, mince meat, salt and sugar. Than drop these to the mixer, then boil by fluid heater."
  ],
  "quest.1A00000000000222.title": "Sterilized Growth Medium",
  "quest.1A00000000000223.quest_desc": [
    "You may get it from coal, charcoal dust or from a lot of other materials."
  ],
  "quest.1A00000000000223.title": "Carbon Dust",
  "quest.1A00000000000224.quest_desc": [
    "From molten epoxy resin and raw carbon fiber or from glass fiber."
  ],
  "quest.1A00000000000224.title": "Fiber-Reinforced Epoxy Resin",
  "quest.1A00000000000225.quest_desc": [
    "Use MV+ extruder with wire shape to get the glass fiber from borosilicate glass bar."
  ],
  "quest.1A00000000000225.title": "Glass Fiber",
  "quest.1A00000000000226.quest_desc": [
    "Like chemical reactor, but with other features."
  ],
  "quest.1A00000000000226.title": "Basic Chemical Bath",
  "quest.1A00000000000227.quest_desc": [
    "Mix the boron and glass dusts and smelt the result to get this."
  ],
  "quest.1A00000000000227.title": "Borosilicate Glass Bar",
  "quest.1A00000000000228.quest_desc": [
    "Height to search: 50-60 SALT vein (Rock Salt, Salt, Lepidolite, Spodumene).You may get a Boron as sub product of lepidolite ore."
  ],
  "quest.1A00000000000228.title": "Boron Dust",
  "quest.1A00000000000229.quest_desc": [
    "Required for EV+ circuits or batteries with voltage 8+ k.v."
  ],
  "quest.1A00000000000229.title": "Fiber-Reinforced circuit board",
  "quest.1A0000000000022A.quest_desc": [
    "Use blank mold and NEI."
  ],
  "quest.1A0000000000022A.title": "Mold (Cylinder)",
  "quest.1A0000000000022B.quest_desc": [
    "Drop any raw meat to macerator"
  ],
  "quest.1A0000000000022B.title": "Mince Meat",
  "quest.1A0000000000022C.quest_desc": [
    "It can boil water. But it dosn't mean that you have to do this. You may create LV - IV machine to complete this quest."
  ],
  "quest.1A0000000000022C.title": "Fluid Heater",
  "quest.1A0000000000022D.quest_desc": [
    "from sugar canes"
  ],
  "quest.1A0000000000022D.title": "Sugar",
  "quest.1A0000000000022E.quest_desc": [
    "Use a fluid MV extractor to melt cobalt brass alloy. Then you have to solidify it in a fluid solidifier with gear mold (cheapes way). A second way is to make this gear from cobalt brass plates and rods by wrench, but it is a bit more expensive."
  ],
  "quest.1A0000000000022E.title": "Cobalt Brass Gear",
  "quest.1A0000000000022F.quest_desc": [
    "Use any chemical reactor to make the styrene from ethylene and benzene."
  ],
  "quest.1A0000000000022F.title": "Styrene",
  "quest.1A00000000000230.quest_desc": [
    "Use MV+ chemical reactor to make it from ethylene by programmed circuit configured as #4"
  ],
  "quest.1A00000000000230.title": "Butene",
  "quest.1A00000000000231.quest_desc": [
    "Use MV+ chemical reactor to make the butadiene from butene."
  ],
  "quest.1A00000000000231.title": "Butadiene",
  "quest.1A00000000000232.quest_desc": [
    "Use HV+ chemical reactor to make this from styrene and butadiene with help of oxygen. Also you may use the air instead of oxygen, but it is less profitable."
  ],
  "quest.1A00000000000232.title": "Raw Styrene-Butadiene Rubber",
  "quest.1A00000000000233.quest_desc": [
    "Use thick neutron reflector + iridium reinforced plate to craft the iridium neutron reflector."
  ],
  "quest.1A00000000000233.title": "Iridium Neutron Reflector",
  "quest.1A00000000000234.quest_desc": [
    "Use the implosion compressor to make Iridium Reinforced Plate from Iridium Alloy Ingot"
  ],
  "quest.1A00000000000234.title": "Iridium Reinforced Plate",
  "quest.1A00000000000235.quest_desc": [
    "There 3 available blue lens to craft the PIC Wafer: Blue topaz, blue sapphire and opal. Than use precision laser HV+ tier with blue lens and glowstone doped wafer."
  ],
  "quest.1A00000000000235.title": "PIC Wafer",
  "quest.1A00000000000236.quest_desc": [
    "Use molten neodymium and hydrogen to synthesise the molten europium by fusion reactor."
  ],
  "quest.1A00000000000236.title": "Europium Ingot",
  "quest.1A00000000000237.quest_desc": [
    "PIC wafer + IGP dust + molten red alloy. Put all these to EV+ chemical reactor."
  ],
  "quest.1A00000000000237.title": "HPIC Wafer",
  "quest.1A00000000000238.quest_desc": [
    "Use 16 superconductor wires to craft this block."
  ],
  "quest.1A00000000000238.title": "Supreconducting Coil Block",
  "quest.1A00000000000239.quest_desc": [
    "May be used to insert up to 32k eu/t. to multiblocks"
  ],
  "quest.1A00000000000239.title": "LuV Energy Hatch",
  "quest.1A0000000000023A.quest_desc": [
    "Machine Hull for all LuV tier machines."
  ],
  "quest.1A0000000000023A.title": "LuV Machine Hull",
  "quest.1A0000000000023B.quest_desc": [
    "Endereye dust + MV circuit + 2x osmium wire (by assembling machine MV+ tier)"
  ],
  "quest.1A0000000000023B.title": "Field Generator (MV)",
  "quest.1A0000000000023C.quest_desc": [
    "Prepare one plate of plutonium 241."
  ],
  "quest.1A0000000000023C.title": "Plutonium 241 Plate",
  "quest.1A0000000000023D.quest_desc": [
    "High tech component used as a part for crafting complex machines."
  ],
  "quest.1A0000000000023D.title": "Field Generator IV",
  "quest.1A0000000000023E.quest_desc": [
    "One of the main parts of Fusion Reactor."
  ],
  "quest.1A0000000000023E.title": "Fusion Coil Block",
  "quest.1A0000000000023F.quest_desc": [
    "ZPM tier circuit."
  ],
  "quest.1A0000000000023F.title": "Quantumprocessor Mainframe",
  "quest.1A00000000000241.quest_desc": [
    "Do you think that this is completely useless stuff? Not quite..."
  ],
  "quest.1A00000000000241.title": "Stone Dust",
  "quest.1A00000000000242.quest_desc": [
    "Can be used for crafting the most of conduit types."
  ],
  "quest.1A00000000000242.title": "Conduit Binder",
  "quest.1A00000000000243.quest_desc": [
    "This machine looks simple. But in fact it may do a lot of useful things. For example: concrete, industrial biomass, drilling fluid and some other things."
  ],
  "quest.1A00000000000243.title": "Basic Mixer",
  "quest.1A00000000000245.quest_desc": [
    "Use EBF to get a Pulsating Iron Ingot from Pulsating Iron Dust."
  ],
  "quest.1A00000000000245.title": "Pulsating Iron",
  "quest.1A00000000000246.quest_desc": [
    "By itself it is useless. But you may use this to craft the item conduit."
  ],
  "quest.1A00000000000246.title": "Electrum Item Pipe",
  "quest.1A00000000000247.quest_desc": [
    "Use 8 chrome plates."
  ],
  "quest.1A00000000000247.title": "LuV Machine Casing",
  "quest.1A00000000000248.quest_desc": [
    "Use an isolation for 8k+ eu/t wires type."
  ],
  "quest.1A00000000000248.title": "Vanadium Gallium Cable",
  "quest.1A00000000000249.quest_desc": [
    "Use 3 vanadium ingots and 1 gallium ingot to smelt them to get a new alloy."
  ],
  "quest.1A00000000000249.title": "Vanadium-Gallium Ingot",
  "quest.1A0000000000024B.quest_desc": [
    "Prepare diamond dust, and put it to autoclave. Also pour to autoclave the molten pulsating iron."
  ],
  "quest.1A0000000000024B.title": "Pulsating Crystal",
  "quest.1A0000000000024C.quest_desc": [
    "Can molten more materials with more high heat proof than basic machine. For example now you may get molten glass from glass (block or panel), which you may use to craft the tin electron tube."
  ],
  "quest.1A0000000000024C.title": "Advanced Fluid Extractor",
  "quest.1A0000000000024E.quest_desc": [
    "Collect the 9 stars. Use 27 heads and 36 blocks of soul sand to build (to summon) and kill 9 withers. Be very careful, because this is hard boss."
  ],
  "quest.1A0000000000024E.title": "Nether Star",
  "quest.1A0000000000024F.quest_desc": [
    "Use the cutting saw. BTW, don't forget that for fusion controller block you have to prepare two field generators IV tier, that also use the nether stars."
  ],
  "quest.1A0000000000024F.title": "Nether Star Plate",
  "quest.1A00000000000250.quest_desc": [
    "LuV tier circuit"
  ],
  "quest.1A00000000000250.title": "Master Quantumprocessor",
  "quest.1A00000000000251.quest_desc": [
    "Use chemical bath HV+ to wash the star in radon."
  ],
  "quest.1A00000000000251.title": "Quantum Star",
  "quest.1A00000000000252.quest_desc": [
    "Useful machine, that used to assembling some complex components and details."
  ],
  "quest.1A00000000000252.title": "Advanced Assembling Machine IV",
  "quest.1A00000000000253.quest_desc": [
    "Prepare a few liters of coffee (in real), because now you have to kill a thouthands of wither skeletons to collect at least the 27 of them heads."
  ],
  "quest.1A00000000000253.title": "Wither Skeleton Skull",
  "quest.1A00000000000254.quest_desc": [
    "Use assembling machine MV+ to make the Double-Layer Capacitor from 2 basic capacitors, pulsating crystal and 2 molten glowstone dusts. It is the light upgrade for powered spawner, that greatly up the working speed, but it consume a little more energy."
  ],
  "quest.1A00000000000254.title": "Double-Layer Capacitor",
  "quest.1A00000000000255.quest_desc": [
    "Small battery hull + 4 gold ingots + 2 molten redstone dusts. Put all this to assembling machine to craft the basic capacitor. This is the basic component for IO machine upgrades."
  ],
  "quest.1A00000000000255.title": "Basic Capacitor",
  "quest.1A00000000000256.quest_desc": [
    "Can do a lot of useful different things."
  ],
  "quest.1A00000000000256.title": "Advanced Assembling Machine",
  "quest.1A00000000000257.quest_desc": [
    "HV tier centrifuge."
  ],
  "quest.1A00000000000257.title": "Turbo Centrifuge",
  "quest.1A00000000000258.quest_desc": [
    "IV tier circuit."
  ],
  "quest.1A00000000000258.title": "Quantumprocessor Assembly",
  "quest.1A00000000000259.quest_desc": [
    "The main difference between previous tier conveyor modules and IV tier (and higher) is in requirement to use the silicon rubber sheet or styrene-butadiene rubber sheet."
  ],
  "quest.1A00000000000259.title": "Conveyor Module (IV)",
  "quest.1A0000000000025A.quest_desc": [
    "You may build the punishment cell to close there the wither. Because this blocks are fully explosion resist against attacks of wither."
  ],
  "quest.1A0000000000025A.title": "Reinforced Obsidian",
  "quest.1A0000000000025B.quest_desc": [
    "Use the dark steel to craft the dark steel frame box."
  ],
  "quest.1A0000000000025B.title": "Dark Steel Frame Box",
  "quest.1A0000000000025C.quest_desc": [
    "For a first, you have to craft the powered spawner - it will be empty. Than, with help of anvil, you should join to it the broken spawner which should be the \"Skeleton\" type."
  ],
  "quest.1A0000000000025C.title": "Powered Spawner (Skeleton)",
  "quest.1A0000000000025D.quest_desc": [
    "Use centrifuge HV+ tier to get the plutonium 241 from plutonium 239. Than smelt the tiny pile to get the nugget by common furance."
  ],
  "quest.1A0000000000025D.title": "Plutonium 241 nugget",
  "quest.1A0000000000025E.quest_desc": [
    "Height to search: 10-40 REDSTONE vein (Redstone, Ruby, Cinnabar). You may get Chrome Dust from ruby dust via advanced electrolyzer. Also ruby dust can be produced from redstone dust. As well as for aluminium you should use blast furnace to get Chrome Ingot from Chrome Dust."
  ],
  "quest.1A0000000000025E.title": "Chrome Ingot",
  "quest.1A0000000000025F.quest_desc": [
    "EV tier Circuit"
  ],
  "quest.1A0000000000025F.title": "Quantumprocessor",
  "quest.1A00000000000260.quest_desc": [
    "Emitter IV tier."
  ],
  "quest.1A00000000000260.title": "Emitter (IV)",
  "quest.1A00000000000261.quest_desc": [
    "An important part of powered spawner."
  ],
  "quest.1A00000000000261.title": "Vibrant Crystal",
  "quest.1A00000000000262.quest_desc": [
    "Dark steel frame box + dark steel plates, with help of wrench and hammer."
  ],
  "quest.1A00000000000262.title": "Machine Chassis",
  "quest.1A00000000000263.quest_desc": [
    "This machine can change the type of broken spawners. To work it require any broken spawner, soul vial with any catched mob and the player should have at least 15 level. Also it require the energy to work (use gregtech cables to connect)"
  ],
  "quest.1A00000000000263.title": "Soul Binder",
  "quest.1A00000000000264.quest_desc": [
    "Use assembling machine HV+ to make the octadic capacitor from 2 double-layer capacitors, vibrant crystal and 2 molten energetic alloy ingots. It is the great upgrade for powered spawner, that greatly up the working speed, but it consume more energy."
  ],
  "quest.1A00000000000264.title": "Octadic Capacitor",
  "quest.1A00000000000265.quest_desc": [
    "A part of some HV machines"
  ],
  "quest.1A00000000000265.title": "Field Generator (HV)",
  "quest.1A00000000000266.quest_desc": [
    "It is a mix of gold dust, soul sand and ashes. Use the mixer to make it."
  ],
  "quest.1A00000000000266.title": "Soularium Ingot",
  "quest.1A00000000000268.quest_desc": [
    "Crafting recipe is the same as for previous coil block tiers, but you have to use the tungstensteel ingots as root stuff."
  ],
  "quest.1A00000000000268.title": "Tungstensteel Coil Block",
  "quest.1A00000000000269.quest_desc": [
    "Height to search: 20 - 50 MAGNETITE vein (Magnetite, Iron, Vanadium Magnetite) or GOLD vein (Magnetite, Vanadium Magnetite, Gold). Use Centrifuge to separate the Vanadium Magnetite Dust."
  ],
  "quest.1A00000000000269.title": "Vanadium Dust",
  "quest.1A0000000000026A.quest_desc": [
    "...from QBit wafer by cutting saw."
  ],
  "quest.1A0000000000026A.title": "QBit Processing Unit",
  "quest.1A0000000000026B.quest_desc": [
    "This circuit assembling machine may create circuits up to (and including) ZPM tier."
  ],
  "quest.1A0000000000026B.title": "Advanced Circuit Assembling IV",
  "quest.1A0000000000026C.quest_desc": [
    "Energetic Alloy + Enderpearl"
  ],
  "quest.1A0000000000026C.title": "Vibrant Alloy",
  "quest.1A0000000000026D.quest_desc": [
    "Gold ingot + glowstone + molten redstone ->> to EBF."
  ],
  "quest.1A0000000000026D.title": "Energetic Alloy",
  "quest.1A0000000000026E.quest_desc": [
    "The main part of some energy components."
  ],
  "quest.1A0000000000026E.title": "Power IC",
  "quest.1A0000000000026F.quest_desc": [
    "Use lapis/lazurite/sodalite rods and plates, with energy crystal and EV circuits to craft the Lapotron Crystal. Also you may craft it by exquisite sapphire (use NEI)"
  ],
  "quest.1A0000000000026F.title": "Lapotron Crystal",
  "quest.1A00000000000270.quest_desc": [
    "You have to put electrical steel ingot to the EBF with obsidian dust to get the alloy named Dark steel."
  ],
  "quest.1A00000000000270.title": "Dark Steel",
  "quest.1A00000000000271.quest_desc": [
    "This is just the alloy of steel(3) and silicon(1) ingots. Use EBF to create it."
  ],
  "quest.1A00000000000271.title": "Electrical Steel",
  "quest.1A00000000000272.quest_desc": [
    "Just go the nether and find the nether fortress. There you have to find the \"Skeleton\" - it looks like nig... hmmm... black, and with sword instead of bow. You shouldn't to kill him or even hit him. You target is use the empty Soul Vial on him by RMB to catch him."
  ],
  "quest.1A00000000000272.title": "Soul Vial (full)",
  "quest.1A00000000000273.quest_desc": [
    "Go to the nether and find it."
  ],
  "quest.1A00000000000273.title": "Soul Sand",
  "quest.1A00000000000274.quest_desc": [
    "It is nice machine to keep an ocean of your energy. To complete this quest you may craft a buffer with 4 - 16 slots for batteries."
  ],
  "quest.1A00000000000274.title": "LuV Battery Buffer (4-16 slots)",
  "quest.1A00000000000275.quest_desc": [
    "The 32 k eu\\t battery"
  ],
  "quest.1A00000000000275.title": "Lapotronic Energy Orb Cluster",
  "quest.1A00000000000276.quest_desc": [
    "Configure the empty steel shape by hammer on the crafting table, to get the desired result."
  ],
  "quest.1A00000000000276.title": "Mold (Bottle)",
  "quest.1A00000000000277.quest_desc": [
    "Use Mold (Bottle) to make from glass dust the glass bottle with help of alloy smelter. Glass dust you may get just by broken the glass block in forge hammer."
  ],
  "quest.1A00000000000277.title": "Glass Bottle",
  "quest.1A00000000000278.quest_desc": [
    "Use fluid extractor (MV+) to pour the molten soularium to the chemical bath. Than put there the glass bottle to get the soul Vial. With help of it you may catch any mob."
  ],
  "quest.1A00000000000278.title": "Soul Vial",
  "quest.1A0000000000027D.quest_desc": [
    "Use EBF with HSS-G coil blocks to make te ingot from dust."
  ],
  "quest.1A0000000000027D.title": "Naquadah Ingot",
  "quest.1A0000000000027E.quest_desc": [
    "Height to search (only on the Mars) 10 - 20 - unique mars vein (Naquadah, Europium)"
  ],
  "quest.1A0000000000027E.title": "Naquadah Dust",
  "quest.1A0000000000027F.quest_desc": [
    "Use Nasa Workbench to craft the rocket. You can put 3 chests (to workbench) as storage for resources and items. also you have to craft and build the launch pad as quad 3 by 3 (9 in total) And finaly - craft the parachute, to safe fall down."
  ],
  "quest.1A0000000000027F.title": "Tier 1 Rocket (use 3 chests)",
  "quest.1A00000000000281.quest_desc": [
    "May be created from tungsten rod"
  ],
  "quest.1A00000000000281.title": "Tungsten Bolt",
  "quest.1A00000000000283.quest_desc": [
    "Radon + molten galium by fusion ->> duranium"
  ],
  "quest.1A00000000000283.title": "Duranium Plate",
  "quest.1A00000000000286.quest_desc": [
    "Use bender to make the plate from ingot."
  ],
  "quest.1A00000000000286.title": "Meteoric Iron Plate",
  "quest.1A00000000000287.quest_desc": [
    "Height to search (only on the MOON): 20 - 50 There you can find the unique moon vein (Sapphire, Meteoric Iron, Platinum, Iridium)."
  ],
  "quest.1A00000000000287.title": "Meteoric Iron Ingot",
  "quest.1A00000000000288.quest_desc": [
    "Height to search: 40 - 50 PLATINUM vein (Sheldonite, Palladium, Platinum, Iridium). But you should know that the chance to find this vein of ore is very small. In this case you may to use other way to get it. And this way named \"Platinum Group Sludge Dust\" (or PGS dust). You may get the info how to get it in quest set #6 - \"Polyethylene & PGS\""
  ],
  "quest.1A00000000000288.title": "Iridium Dust",
  "quest.1A00000000000289.quest_desc": [
    "Use implosion compressor to make the Heavy-Duty Plate from heavy duty alloy ingot."
  ],
  "quest.1A00000000000289.title": "Heavy-Duty Plate (tier 1)",
  "quest.1A0000000000028A.quest_desc": [
    "The basic wafer you may craft from diamond plate and coated circuit board, with help of molten soldering alloy by assembler. Other items should be more easy in crafting. Tin canister you may create by bending machine or extruder from compressed tin."
  ],
  "quest.1A0000000000028A.title": "Oxygen Concentrator",
  "quest.1A0000000000028B.quest_desc": [
    "Use double wires from naquadah ingots. Then by wrench and 8 double wires make the coil block. Create 16 coil blocks in total."
  ],
  "quest.1A0000000000028B.title": "Naquadah coil Block",
  "quest.1A0000000000028C.quest_desc": [
    "Collect the 53 cells with liquid air and put them to centrifuge. Among other things you will get the cell with argon."
  ],
  "quest.1A0000000000028C.title": "Argon Gas",
  "quest.1A0000000000028E.quest_desc": [
    "Use double wires from naquadah alloy ingots.Then by wrench and 8 double wires make the coil block. Create 16 coil blocks in total."
  ],
  "quest.1A0000000000028E.title": "Naquadah Alloy Coil Block",
  "quest.1A00000000000290.quest_desc": [
    "The main part of all ZPM machines (monoblocks)."
  ],
  "quest.1A00000000000290.title": "ZPM Machine Hull",
  "quest.1A00000000000291.quest_desc": [
