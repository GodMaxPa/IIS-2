  "quest.1A0000000000033D.title": "ME Dense Cable",
  "quest.1A0000000000033E.quest_desc": [
    "Better than previous models."
  ],
  "quest.1A0000000000033E.title": "Advanced Assembling Machine II",
  "quest.1A0000000000033F.quest_desc": [
    "Better than previous models. It may craft up to IV circuits."
  ],
  "quest.1A0000000000033F.title": "Advanced Circuit Assembling II",
  "quest.1A00000000000340.quest_desc": [
