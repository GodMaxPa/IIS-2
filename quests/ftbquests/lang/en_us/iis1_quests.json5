  "quest.1A000000000003B8.quest_desc": [
    "A part of Combustion Engine (multiblock)"
  ],
  "quest.1A000000000003B8.title": "Titanium Rotor",
  "quest.1A000000000003B9.quest_desc": [
    "A part of Combustion Engine (multiblock)"
  ],
  "quest.1A000000000003B9.title": "Titanium Gear box Casing",
  "quest.1A000000000003BA.quest_desc": [
    "A part of Combustion Engine (multiblock)"
  ],
  "quest.1A000000000003BA.title": "Titanium Gear",
  "quest.1A000000000003BD.quest_desc": [
    "It may be used as source of energy for multiblock generators. It may output up to 8192 eu/t without blowing up."
  ],
  "quest.1A000000000003BD.title": "IV Dynamo Hatch",
  "quest.1A000000000003BE.quest_desc": [
    "Multiblocks usually produce more than 512 eu/t. So they require at least EV dynamo hatch."
  ],
  "quest.1A000000000003BE.title": "EV Dynamo hatch",
  "quest.1A000000000003BF.quest_desc": [
