  ],
  "quest.1A00000000000391.title": "Advanced Autoclave II",
  "quest.1A00000000000392.quest_desc": [
    "Nice device to visit WC room at night without turning light on."
  ],
  "quest.1A00000000000392.title": "Nightvision Goggles",
  "quest.1A00000000000393.quest_desc": [
