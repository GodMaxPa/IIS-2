    "A part of turbine."
  ],
  "quest.1A000000000003CA.title": "Turbine Casing",
  "quest.1A000000000003CB.quest_desc": [
    "A part of large turbine"
  ],
  "quest.1A000000000003CB.title": "Stainles Steel Turbine Casing",
  "quest.1A000000000003CC.quest_desc": [
    "An alloy of magnesium and aluminium. May be produced in alloy smelter."
  ],
  "quest.1A000000000003CC.title": "Magnalium Plate",
  "quest.1A000000000003CE.quest_desc": [
    "A base for all EV machines"
