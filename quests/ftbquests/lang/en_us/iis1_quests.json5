  "quest.1A0000000000030B.quest_desc": [
    "A part of Heavy Duty Alloy Ingot"
  ],
  "quest.1A0000000000030B.title": "Double PTFE Sheet",
  "quest.1A0000000000030C.quest_desc": [
    "May be created from Stainless Steel rod."
  ],
  "quest.1A0000000000030C.title": "Stainless Steel Bolt",
  "quest.1A0000000000030D.quest_desc": [
    "The part of a rocket."
  ],
  "quest.1A0000000000030D.title": "Nose Cone",
  "quest.1A0000000000030E.quest_desc": [
    "The engine for 1 tier rocket."
  ],
  "quest.1A0000000000030E.title": "Tier 1 Rocket Engine",
  "quest.1A0000000000030F.quest_desc": [
    "It will allow you to fall down slowly and without breaking your legs."
  ],
  "quest.1A0000000000030F.title": "Parachute",
  "quest.1A00000000000310.quest_desc": [
    "The plates to build the rocket launch pad. Require 9 items in total."
