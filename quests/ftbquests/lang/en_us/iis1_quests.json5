  "quest.1A00000000000693.title": "[sb] Advanced Monster Repellator III",
  "quest.1A00000000000694.quest_desc": [
    "One of many single-block machines."
  ],
  "quest.1A00000000000694.title": "[sb] Advanced Monster Repellator IV",
