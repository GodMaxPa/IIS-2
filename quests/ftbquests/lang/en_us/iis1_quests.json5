  ],
  "quest.1A00000000000313.title": "Mixed Metall Ingot",
  "quest.1A00000000000314.quest_desc": [
    "Put it on yourself, before starting fly to the moon. But it is not enough. Also you have to craft other important things as parachute, oxygen gear and tank."
  ],
  "quest.1A00000000000314.title": "Oxygen Mask",
