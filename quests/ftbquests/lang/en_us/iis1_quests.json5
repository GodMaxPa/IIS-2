  ],
  "quest.1A000000000002DA.title": "Advanced Extruder",
  "quest.1A000000000002DB.quest_desc": [
    "Find any sea or large lake. There may spawn squids. Touch them by your sword or axe (use LMB). After this action some of them may give you a present =)"
  ],
  "quest.1A000000000002DB.title": "Ink Sac",
  "quest.1A000000000002DC.quest_desc": [
    "High tech machine to engrave the wafers or chips to craft powerful circuits."
  ],
  "quest.1A000000000002DC.title": "Advanced Precision Laser Engr.",
  "quest.1A000000000002DD.quest_desc": [
    "It is enough powerful to cut wafers for circuits."
  ],
  "quest.1A000000000002DD.title": "Advanced Cutting Machine",
  "quest.1A000000000002DE.quest_desc": [
    "The frame for MV machines"
  ],
  "quest.1A000000000002DE.title": "MV Machine Casing",
  "quest.1A000000000002DF.quest_desc": [
    "Works the same as Basic Steam Turbine but produce the 128 eu/t. You have to use copper wires or cables to transfer energy. DO NOT connect this turbine to LV machines, or it may call explosion."
  ],
  "quest.1A000000000002DF.title": "Advanced Steam Turbine",
