  ],
  "quest.1A00000000000360.title": "Titanium Frame Box",
  "quest.1A00000000000361.quest_desc": [
    "The controller of wonderful multiblock that will give you ability to have a rest instead digging ores. This machine may dig instead of you. But you have to feed it with mining pipes and by ore drilling fluid."
  ],
