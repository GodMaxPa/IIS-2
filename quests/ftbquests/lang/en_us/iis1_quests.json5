    "IV tier circuit"
  ],
  "quest.1A0000000000029A.title": "Crystalprocessor",
  "quest.1A0000000000029B.quest_desc": [
    "Put niobium and titanium ingots to EBF to make new alloy. Then use a wiremill to make a wires."
  ],
  "quest.1A0000000000029B.title": "Fine Niobium-Titanium Wire",
  "quest.1A0000000000029C.quest_desc": [
