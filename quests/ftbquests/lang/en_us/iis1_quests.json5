    "MV battry"
  ],
  "quest.1A0000000000034A.title": "Medium Lithium Battery",
  "quest.1A0000000000034B.quest_desc": [
    "It may be used as container for MV batteries."
  ],
  "quest.1A0000000000034B.title": "Medium Battery Hull",
  "quest.1A0000000000034F.quest_desc": [
